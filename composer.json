{
  "name": "la-mariuca/boutique",
  "description": "Magazin online modular La Măriuca Boutique",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-openssl": "*",
    "ext-session": "*",
    "ext-sodium": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.7",
    "twig/twig": "^3.21",
    "vlucas/phpdotenv": "^5.6",
    "symfony/mailer": "^7.3 || ^8.0",
    "symfony/mime": "^7.3 || ^8.0",
    "stripe/stripe-php": "^18.0",
    "symfony/polyfill-mbstring": "^1.33",
    "ezyang/htmlpurifier": "^4.19",
    "robthree/twofactorauth": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "@php bin/lint.php",
    "templates": "@php bin/compile-templates.php",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "check": ["@lint", "@templates", "@analyse", "@test"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
