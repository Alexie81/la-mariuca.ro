APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_BASE_PATH=
APP_TIMEZONE=Europe/Bucharest
APP_KEY=change-with-bin-generate-key
APP_INDEXING=false
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=

DB_DRIVER=sqlite
DB_DATABASE=storage/private/development.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=la_mariuca
DB_USER=root
DB_PASSWORD=

SESSION_NAME=lamariuca_session
SESSION_SECURE=false
# auto: SMTP în production, preview în celelalte medii; testing rămâne întotdeauna preview.
# smtp activează explicit expedierea și în development, fără a schimba APP_ENV.
MAIL_DELIVERY_MODE=auto
MAILER_DSN=null://null
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="La Mariuca Boutique"
# Limitare opțională pentru expediere: numai ID-uri mai mari decât pragul și tipurile enumerate.
# Pentru activare numai de acum înainte, păstrează pragul inițial și la repornirea workerului.
MAIL_SEND_AFTER_ID=0
MAIL_MESSAGE_TYPES=

STRIPE_ENABLED=false
COD_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ron

TAX_RATE_BASIS_POINTS=0
PRICES_INCLUDE_TAX=true

WHATSAPP_NUMBER=40763715974
WHATSAPP_MESSAGE="Bună! Aș dori mai multe informații despre produsele La Măriuca Boutique."
CONTACT_EMAIL=contact@la-mariuca.ro

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CREDENTIALS_FILE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notificări Web Push pentru administratori (cheile se generează privat cu bin/generate-vapid-keys.php)
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_FILE=storage/private/web-push-vapid.json
WEB_PUSH_VAPID_SUBJECT=mailto:contact@la-mariuca.ro
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
