{% set product_is_favorite = is_favorite(product.id) %}
<article class="boutique-product-card">
  <a class="boutique-product-media{{ product.image_path ? '' : ' is-placeholder' }}" href="{{ url('produs/' ~ product.slug ~ '/') }}">
    {% if product.image_path %}
      <img src="{{ url(product.image_path) }}" alt="{{ product.name }}" loading="lazy" decoding="async">
    {% else %}
      <span class="boutique-product-placeholder" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <path d="M25 79c17-39 57-55 77-26 17 25-7 52-39 47-27-4-48-30-38-50"></path>
          <path d="M62 40c-10-13-31 4 0 25 31-21 10-38 0-25Z"></path>
        </svg>
      </span>
    {% endif %}
    {% if show_recent_badge|default(false) %}
      <span class="boutique-product-recent-badge">
        <span class="boutique-product-recent-spark" aria-hidden="true">✦</span>
        <span class="boutique-product-recent-copy boutique-product-recent-copy--desktop">Recent adăugat</span>
        <span class="boutique-product-recent-copy boutique-product-recent-copy--mobile">Nou</span>
      </span>
    {% endif %}
    {% if product.category_name %}<span class="boutique-product-category">{{ product.category_name }}</span>{% endif %}
  </a>

  <form class="boutique-product-favorite{{ product_is_favorite ? ' is-selected' : '' }}" action="{{ url('favorite/') }}" method="post" data-storefront-favorite data-product-name="{{ product.name }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <input type="hidden" name="product_id" value="{{ product.id }}">
    <button type="submit" aria-label="{{ product_is_favorite ? 'Elimină ' ~ product.name ~ ' din favorite' : 'Adaugă ' ~ product.name ~ ' la favorite' }}" title="{{ product_is_favorite ? 'Elimină din favorite' : 'Adaugă la favorite' }}">
      <img class="boutique-product-favorite-icon" src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt="" aria-hidden="true">
    </button>
  </form>

  <div class="boutique-product-copy">
    <h3><a href="{{ url('produs/' ~ product.slug ~ '/') }}">{{ product.name }}</a></h3>
    <div class="boutique-product-price">
      <strong>{{ money(product.price_bani) }}</strong>
      {% if product.compare_price_bani and product.compare_price_bani > product.price_bani %}
        <del>{{ money(product.compare_price_bani) }}</del>
      {% endif %}
    </div>

    {% if product.available_quantity > 0 %}
      {% if product.variant_count == 1 and product.default_variant_id and product.required_personalization_count|default(0) == 0 %}
        {% set product_is_in_cart = is_variant_in_cart(product.default_variant_id) %}
        <form class="boutique-product-cart{{ product_is_in_cart ? ' is-added' : '' }}" action="{{ url('cos/adauga/') }}" method="post" data-storefront-cart data-cart-toggle data-cart-state="{{ product_is_in_cart ? 'added' : 'removed' }}" data-product-name="{{ product.name }}" data-product-url="{{ url('produs/' ~ product.slug ~ '/') }}"{% if product.image_path %} data-product-image="{{ url(product.image_path) }}"{% endif %} data-cart-url="{{ url('cos/') }}">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <input type="hidden" name="variant_id" value="{{ product.default_variant_id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="toggle_cart" value="1">
          <button type="submit" aria-pressed="{{ product_is_in_cart ? 'true' : 'false' }}" aria-label="{{ product_is_in_cart ? 'Scoate ' ~ product.name ~ ' din coș' : 'Adaugă ' ~ product.name ~ ' în coș' }}" title="{{ product_is_in_cart ? 'Scoate din coș' : 'Adaugă în coș' }}">
            <span class="boutique-product-cart-label">
              <svg class="boutique-product-cart-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3.5 5h2.1l1.2 9.2a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 1.9-1.4l1.4-5.8H6.2"></path>
                <circle cx="9.2" cy="19" r="1.25"></circle><circle cx="17" cy="19" r="1.25"></circle>
              </svg>
              <span class="boutique-product-cart-text">
                <span class="boutique-product-cart-copy boutique-product-cart-copy--default">Adaugă în coș</span>
                <span class="boutique-product-cart-copy boutique-product-cart-copy--added boutique-product-cart-copy--desktop">Adăugat în coș</span>
                <span class="boutique-product-cart-copy boutique-product-cart-copy--added boutique-product-cart-copy--mobile">Adăugat</span>
              </span>
            </span>
            <span class="boutique-product-cart-arrow" aria-hidden="true">
              <svg class="boutique-product-cart-chevron" viewBox="0 0 20 20"><path d="m7.6 4.8 5.2 5.2-5.2 5.2"></path></svg>
              <svg class="boutique-product-cart-check" viewBox="0 0 20 20">
                <path class="boutique-product-cart-check-mark" d="m4.7 10.2 3.5 3.6 7.2-8"></path>
                <path class="boutique-product-cart-check-spark" d="M15.8 2.8v2.4M14.6 4h2.4"></path>
              </svg>
            </span>
          </button>
        </form>
      {% else %}
        <a class="boutique-product-cart" href="{{ url('produs/' ~ product.slug ~ '/') }}">
          <span class="boutique-product-cart-label">
            {% if product.variant_count > 1 %}
              <svg class="boutique-product-cart-icon boutique-product-size-icon" viewBox="0 0 24 24" aria-hidden="true">
                <g transform="rotate(-45 12 12)">
                  <rect x="4.5" y="8.5" width="15" height="7" rx="1.15"></rect>
                  <path d="M7.5 8.5v2.6M10.5 8.5v1.7M13.5 8.5v2.6M16.5 8.5v1.7"></path>
                </g>
              </svg>
            {% else %}
              <svg class="boutique-product-cart-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3.5 5h2.1l1.2 9.2a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 1.9-1.4l1.4-5.8H6.2"></path>
                <circle cx="9.2" cy="19" r="1.25"></circle><circle cx="17" cy="19" r="1.25"></circle>
              </svg>
            {% endif %}
            {{ product.variant_count > 1 ? 'Alege' : 'Vezi opțiunile' }}
          </span>
          <span class="boutique-product-cart-arrow" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="m7.6 4.8 5.2 5.2-5.2 5.2"></path></svg>
          </span>
        </a>
      {% endif %}
    {% else %}
      <a class="boutique-product-cart is-sold-out" href="{{ url('produs/' ~ product.slug ~ '/') }}" aria-label="Stoc epuizat pentru {{ product.name }}. Vezi detaliile produsului">
        <span class="boutique-product-cart-label boutique-product-stock-label">
          <span class="boutique-product-stock-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M5.5 8.5 12 5l6.5 3.5v7L12 19l-6.5-3.5v-7Z"></path>
              <path d="m5.8 8.6 6.2 3.3 6.2-3.3M12 12v7M8.2 4.2l7.6 15.6"></path>
            </svg>
            <span></span>
          </span>
          <span class="boutique-product-stock-copy">
            <strong>Stoc epuizat</strong>
            <small>Vezi detalii</small>
          </span>
        </span>
        <span class="boutique-product-cart-arrow" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="m7.6 4.8 5.2 5.2-5.2 5.2"></path></svg>
        </span>
      </a>
    {% endif %}
  </div>
</article>
