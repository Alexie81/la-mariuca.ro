{% if order.return_requests %}<section class="tracking-card tracking-return" id="cererea-de-retur"><header class="tracking-card__head"><div><span class="tracking-kicker">Alături de tine și după livrare</span><h2>Cererea ta de retur</h2></div></header>{% for request in order.return_requests %}<article class="tracking-return__request"><div class="tracking-return__status is-{{ request.state }}"><span aria-hidden="true">{{ request.state == 'pending' ? '◷' : (request.state in ['accepted','partial'] ? '✓' : 'ⓘ') }}</span><div><strong>{{ request.label }}</strong><small>{{ request.created_at|date('d.m.Y · H:i','Europe/Bucharest') }}</small></div></div>{% if request.state == 'pending' %}<p>Am primit cererea și o analizăm. Te anunțăm prin email când avem un răspuns. Nu este nevoie să trimiți o altă solicitare.</p>{% endif %}<ul>{% for product in request.products %}<li><span>{{ product.name }}</span><strong>{% if product.accepted_quantity is defined %}{{ product.accepted_quantity }} / {{ product.quantity }} buc. acceptate{% else %}{{ product.quantity }} buc.{% endif %}</strong></li>{% endfor %}</ul><div class="tracking-return__reason"><span>Motivul cererii</span><p>{{ request.reason }}</p></div>{% if request.state != 'pending' and request.decision_reason and request.decision_reason != request.reason %}<div class="tracking-return__reason"><span>Răspunsul nostru</span><p>{{ request.decision_reason }}</p></div>{% endif %}{% if request.refund_method %}<p class="tracking-return__method">Restituire: <strong>{{ request.refund_method }}</strong></p>{% endif %}{% if request.settlement %}<dl class="tracking-return__amounts"><div><dt>Valoarea produselor acceptate</dt><dd>{{ money(request.settlement.base_bani) }}</dd></div>{% for cost in request.settlement.costs %}<div><dt>{{ cost.name }}</dt><dd>− {{ money(cost.amount_bani) }}</dd></div>{% endfor %}{% if request.settlement.adjustment_bani %}<div><dt>Ajustare sumă convenită</dt><dd>{{ money(request.settlement.adjustment_bani) }}</dd></div>{% endif %}<div class="is-total"><dt>De restituit</dt><dd>{{ money(request.settlement.refund_bani) }}</dd></div></dl><p class="tracking-return__footnote">Suma convenită pentru retur. Restituirea efectivă este afișată în starea plății comenzii.</p>{% endif %}</article>{% endfor %}</section>{% endif %}
