<div class="customer-return" data-customer-return>
  <header class="customer-return__head"><span class="customer-return__icon" aria-hidden="true">↶</span><div><span class="customer-return__eyebrow">{{ invoice.snapshot.order_number }} · Suntem aici pentru tine</span><h2 id="customer-return-title">Solicită un retur</h2><p>Alege produsele pe care dorești să le returnezi.</p></div><a class="customer-return__close" href="{{ url('urmarire-comanda/') }}" data-return-close aria-label="Închide solicitarea">×</a></header>
  {% if success %}<div class="customer-return__success" data-return-success><span>✓</span><h3>Cererea ta este în analiză</h3><p>Am primit produsele selectate și datele pentru restituire. Vei primi răspunsul prin email și îl vei vedea și în pagina comenzii.</p><a class="customer-return__submit" href="{{ url('urmarire-comanda/') }}">Vezi cererea în comandă →</a></div>
  {% elseif not eligibility.allowed %}<div class="customer-return__body"><div class="customer-return__notice">{{ eligibility.reason }}</div><a class="customer-return__submit" href="{{ url('urmarire-comanda/') }}">Înapoi la comandă →</a></div>
  {% else %}<form method="post" action="{{ url('urmarire-comanda/retur/'~invoice.id~'/') }}" data-customer-return-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ values.request_key|default(request_key) }}">
    <div class="customer-return__body">
      {% if error %}<p class="customer-return__error" role="alert" tabindex="-1">{{ error }}</p>{% endif %}
      <section class="customer-return__section"><div class="customer-return__section-title"><b>1</b><div><h3>Ce produse se întorc?</h3><p>Selectează cantitatea pentru fiecare produs.</p></div></div><div class="customer-return__products">
      {% for line in eligibility.lines %}<article class="customer-return__product"><div class="customer-return__photo">{% if line.snapshot.image_data|default('') %}<img src="{{ line.snapshot.image_data }}" alt="{{ line.name }}" width="64" height="78">{% elseif line.snapshot.image_path|default('') %}<img src="{{ url(line.snapshot.image_path) }}" alt="{{ line.name }}" width="64" height="78">{% else %}<span aria-hidden="true">♧</span>{% endif %}</div><div class="customer-return__product-copy"><strong>{{ line.name }}</strong><small>{{ line.snapshot.variant|default(line.sku,true) }}</small><span>{{ line.available_units/10000 }} buc. disponibile <i>·</i> {{ money((line.gross_bani*10000/line.quantity_units)|round) }} / buc.</span></div><label>Cantitate<select name="quantities[{{ line.id }}]" data-customer-return-quantity>{% for q in 0..(line.available_units/10000) %}<option value="{{ q }}"{{ values.quantities[line.id]|default(0) == q ? ' selected' : '' }}>{{ q == 0 ? 'Nu returnez' : q ~ ' buc.' }}</option>{% endfor %}</select></label></article>{% endfor %}</div></section>
      <section class="customer-return__section"><div class="customer-return__section-title"><b>2</b><div><h3>Cu ce te putem ajuta?</h3><p>Câteva detalii ne ajută să analizăm cererea.</p></div></div><label class="customer-return__field">Motivul returului<textarea name="reason" rows="2" minlength="3" maxlength="2000" required placeholder="De exemplu, mărimea nu se potrivește…">{{ values.reason|default('') }}</textarea></label></section>
      <section class="customer-return__section" data-refund-destination><div class="customer-return__section-title"><b>3</b><div><h3>Unde îți restituim banii?</h3><p>Restituirea se face după acceptarea returului.</p></div></div>
      {% if invoice.payment_method == 'stripe' %}<input type="hidden" name="refund_method" value="original_payment"><div class="customer-return__notice">Către metoda de plată folosită pentru comandă.</div>{% else %}<div class="return-methods"><label><input type="radio" name="refund_method" value="bank"{{ values.refund_method|default('bank') != 'cash' ? ' checked' : '' }}><span><strong>În cont bancar</strong><small>Recomandat · direct în contul tău</small></span></label><label><input type="radio" name="refund_method" value="cash"{{ values.refund_method|default('bank') == 'cash' ? ' checked' : '' }}><span><strong>În numerar</strong><small>Stabilim împreună detaliile</small></span></label></div><div class="customer-return__bank" data-bank-fields><label class="customer-return__field">Titularul contului<input name="holder" value="{{ values.holder|default('') }}" maxlength="190" placeholder="Nume și prenume" autocomplete="name" data-bank-required></label><label class="customer-return__field">Banca<input name="bank_name" value="{{ values.bank_name|default('') }}" maxlength="190" placeholder="Denumirea băncii" data-bank-required></label><label class="customer-return__field is-wide">IBAN<input name="iban" value="{{ values.iban|default('') }}" maxlength="42" placeholder="RO…" autocomplete="off" spellcheck="false" data-bank-required></label></div>{% endif %}</section>
      <p class="customer-return__hint">Datele tale sunt private. Îți confirmăm prin email înregistrarea cererii și decizia luată.</p><p class="customer-return__error" data-return-error role="alert" hidden></p>
    </div><footer class="customer-return__footer"><span data-customer-return-count>Alege produsele pentru retur</span><a href="{{ url('urmarire-comanda/') }}" data-return-close>Renunță</a><button type="submit" class="customer-return__submit">Trimite solicitarea <span aria-hidden="true">→</span></button></footer>
  </form>{% endif %}
</div>
