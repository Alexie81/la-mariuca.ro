{% if order.cancellation_request or order.can_request_cancellation %}
  <div class="tracking-cancellation" id="cerere-anulare">
    {% if order.cancellation_request %}
      <div class="tracking-cancellation__received" role="status">
        <strong><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>Cerere de anulare înregistrată</strong>
        <p>{% if order.status == 'cancelled' %}Comanda a fost anulată. Starea plății se afișează separat în rezumat.{% else %}Am primit solicitarea ta și o vom verifica. Comanda își păstrează statusul afișat până la confirmarea anulării.{% endif %}</p>
        <time datetime="{{ order.cancellation_request.created_at }}">Trimisă la {{ order.cancellation_request.created_at|date('d.m.Y, H:i', 'Europe/Bucharest') }}</time>
        <details><summary>Motivul trimis</summary><blockquote>{{ order.cancellation_request.reason }}</blockquote></details>
      </div>
    {% else %}
      <a class="tracking-cancellation__link" href="{{ url('urmarire-comanda/solicitare-anulare/') }}" data-tracking-cancel-open><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5M5 12h9a5 5 0 0 1 5 5"/></svg><span>Solicită anularea comenzii</span></a>
      <dialog class="tracking-cancel-dialog" data-tracking-cancel-dialog aria-labelledby="tracking-cancel-title">{% include 'storefront/partials/tracking-cancellation-form.twig' %}</dialog>
    {% endif %}
  </div>
{% endif %}
