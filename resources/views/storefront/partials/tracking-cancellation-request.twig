{% if order.cancellation_request or order.can_request_cancellation %}
  <div class="tracking-cancellation" id="cerere-anulare">
    {% if order.cancellation_request %}
      {% set cancellation = order.cancellation_request %}
      {% set cancellation_state = cancellation.status|default('pending') %}
      <div class="tracking-cancellation__received is-{{ cancellation_state }}" role="status">
        <div class="tracking-cancellation__heading"><span class="tracking-cancellation__status-icon" aria-hidden="true"><svg viewBox="0 0 24 24">{% if cancellation_state == 'accepted' %}<path d="m5 12 4 4L19 6"/>{% elseif cancellation_state == 'rejected' %}<path d="m7 7 10 10M17 7 7 17"/>{% else %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{% endif %}</svg></span><div><span>Solicitarea ta de anulare</span><strong>{{ cancellation_state == 'accepted' ? 'Anularea a fost acceptată' : (cancellation_state == 'rejected' ? 'Solicitarea nu a fost acceptată' : 'Cerere de anulare înregistrată') }}</strong></div></div>
        <p>{% if cancellation_state == 'accepted' %}Comanda a fost anulată conform solicitării tale. Îți trimitem confirmarea și prin email.{% elseif cancellation_state == 'rejected' %}Am verificat solicitarea ta. Mai jos găsești răspunsul nostru, trimis și prin email.{% elseif order.status == 'cancelled' %}Comanda a fost anulată. Echipa noastră verifică și solicitarea ta.{% else %}Am primit solicitarea ta și o vom verifica. Comanda își păstrează statusul afișat până la confirmarea anulării.{% endif %}</p>
        {% if cancellation_state != 'pending' and cancellation.decision_reason|default('') %}<div class="tracking-cancellation__response"><span>Răspunsul nostru</span><blockquote>{{ cancellation.decision_reason }}</blockquote></div>{% endif %}
        {% if cancellation_state == 'accepted' and order.payment_method == 'stripe' and order.payment_status in ['paid','partially_refunded'] %}<p class="tracking-cancellation__payment-note">Anularea nu reprezintă confirmarea rambursării. Starea plății este afișată separat în rezumatul comenzii.</p>{% endif %}
        <div class="tracking-cancellation__dates"><time datetime="{{ cancellation.created_at }}">Trimisă la {{ cancellation.created_at|date('d.m.Y, H:i', 'Europe/Bucharest') }}</time>{% if cancellation.resolved_at|default(null) %}<time datetime="{{ cancellation.resolved_at }}">Răspuns la {{ cancellation.resolved_at|date('d.m.Y, H:i', 'Europe/Bucharest') }}</time>{% endif %}</div>
        <details><summary>Vezi motivul trimis</summary><blockquote>{{ cancellation.reason }}</blockquote></details>
      </div>
    {% else %}
      <a class="tracking-cancellation__link" href="{{ url('urmarire-comanda/solicitare-anulare/') }}" data-tracking-cancel-open><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5M5 12h9a5 5 0 0 1 5 5"/></svg><span>Solicită anularea comenzii</span></a>
      <dialog class="tracking-cancel-dialog" data-tracking-cancel-dialog aria-labelledby="tracking-cancel-title">{% include 'storefront/partials/tracking-cancellation-form.twig' %}</dialog>
    {% endif %}
  </div>
{% endif %}
