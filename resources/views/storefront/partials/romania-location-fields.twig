{% set picker_id = location_id|default('delivery-location') %}
<div class="ro-location-picker account-form-full" data-ro-location-picker data-source="{{ url('assets/data/romania-localities.json') }}">
  <div class="ro-location-field" data-ro-location-field="county">
    <label for="{{ picker_id }}-county">Județ / Municipiul București *</label>
    <div class="ro-location-control">
      <input id="{{ picker_id }}-county" name="county" value="{{ county_value|default('') }}" autocomplete="address-level1" maxlength="120" placeholder="Alege județul" required data-ro-location-input role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="{{ picker_id }}-county-options">
      <button type="button" aria-label="Deschide lista județelor" aria-controls="{{ picker_id }}-county-options" aria-expanded="false" data-ro-location-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg></button>
    </div>
    <div class="ro-location-dropdown" data-ro-location-dropdown hidden>
      <div class="ro-location-dropdown__head"><strong>Alege județul</strong><button type="button" aria-label="Închide lista județelor" data-ro-location-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
      <label class="ro-location-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg><input type="search" aria-label="Caută județul" aria-controls="{{ picker_id }}-county-options" placeholder="Caută județul…" autocomplete="off" data-ro-location-search></label>
      <div class="ro-location-options" id="{{ picker_id }}-county-options" role="listbox" aria-label="Județe" data-ro-location-options></div>
      <small data-ro-location-status role="status" aria-live="polite"></small>
    </div>
  </div>
  <div class="ro-location-field" data-ro-location-field="locality">
    <label for="{{ picker_id }}-locality">Localitate / sector *</label>
    <div class="ro-location-control">
      <input id="{{ picker_id }}-locality" name="city" value="{{ city_value|default('') }}" autocomplete="address-level2" maxlength="160" placeholder="Alege întâi județul" required data-ro-location-input role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="{{ picker_id }}-locality-options">
      <button type="button" aria-label="Deschide lista localităților" aria-controls="{{ picker_id }}-locality-options" aria-expanded="false" data-ro-location-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg></button>
    </div>
    <div class="ro-location-dropdown" data-ro-location-dropdown hidden>
      <div class="ro-location-dropdown__head"><strong>Alege localitatea</strong><button type="button" aria-label="Închide lista localităților" data-ro-location-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
      <label class="ro-location-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg><input type="search" aria-label="Caută localitatea" aria-controls="{{ picker_id }}-locality-options" placeholder="Caută localitatea…" autocomplete="off" data-ro-location-search></label>
      <div class="ro-location-options" id="{{ picker_id }}-locality-options" role="listbox" aria-label="Localități" data-ro-location-options></div>
      <small data-ro-location-status role="status" aria-live="polite"></small>
    </div>
  </div>
</div>
