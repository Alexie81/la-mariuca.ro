{% macro submenu_tree(items, parent_slug, level) %}
  <div id="submenu-{{ parent_slug }}" class="submenu submenu-level-{{ level }}" data-submenu>
    <div class="submenu-content">
      {% for child in items %}
        <div class="submenu-item{{ child.children ? ' has-children' : '' }}">
          <a href="{{ url('categorie/' ~ child.path ~ '/') }}"{% if child.children %} class="has-children"{% endif %}>
            {% if child.image_path %}<span class="submenu-thumbnail" aria-hidden="true"><img src="{{ url(child.image_path) }}" alt="" loading="lazy" decoding="async"></span>{% endif %}
            <span>{{ child.name }}</span>
          </a>
          {% if child.children %}
            <button class="submenu-toggle" type="button" data-submenu-toggle aria-expanded="false" aria-controls="submenu-{{ child.slug }}" aria-label="Arată subcategoriile pentru {{ child.name }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg>
            </button>
            {{ _self.submenu_tree(child.children, child.slug, level + 1) }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endmacro %}
