{% extends 'storefront/layouts/base.twig' %}

{% block body_class %}register-page-body{% endblock %}

{% block head %}
  <script type="module" src="{{ url('assets/js/storefront/auth.js') }}?v=20261026-auth2"></script>
{% endblock %}

{% block content %}
  <section class="login-experience login-experience--register" aria-labelledby="register-page-title">
    <div class="container login-experience__inner">
      <div class="login-frame login-frame--register">
        <aside class="login-story login-story--register" aria-label="Avantajele contului La Măriuca">
          <span class="login-story__orbit login-story__orbit--one" aria-hidden="true"></span>
          <span class="login-story__orbit login-story__orbit--two" aria-hidden="true"></span>

          <header class="login-story__heading">
            <span class="login-story__mark" aria-hidden="true">
              <img src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt="">
            </span>
            <span class="login-eyebrow">Un loc al tău</span>
            <h1 id="register-page-title">Păstrează aproape <em>lucrurile dragi.</em></h1>
            <p>Creează-ți contul și continuă povestea familiei tale cu alegeri mai simple, păstrate într-un singur loc.</p>
          </header>

          <ul class="login-benefits">
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 4h8v3M8 11h8M8 15h5"></path></svg></span>
              <div><strong>Comenzi mai ușoare</strong><small>Datele tale rămân pregătite pentru data viitoare.</small></div>
            </li>
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20.2S4.2 16 4.2 9.6A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.8 2.3c0 6.4-7.8 10.6-7.8 10.6Z"></path></svg></span>
              <div><strong>Favorite mereu aproape</strong><small>Păstrezi inspirația pentru momentul potrivit.</small></div>
            </li>
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s7-3.7 7-10V5.5L12 3 5 5.5V10c0 6.3 7 10 7 10Z"></path><path d="m8.7 11.5 2.1 2.1 4.6-4.6"></path></svg></span>
              <div><strong>Creat cu grijă</strong><small>Un cont protejat pentru cumpărături liniștite.</small></div>
            </li>
          </ul>

          <div class="login-story__signature">
            <span aria-hidden="true">LM</span>
            <p><small>Începuturi frumoase</small><strong>păstrate cu drag</strong></p>
          </div>
        </aside>

        <div class="login-panel login-panel--register">
          <header class="login-panel__heading">
            <span class="login-panel__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><circle cx="13" cy="12" r="4"></circle><path d="M6.4 24.1c1.2-3.2 3.4-4.8 6.6-4.8 1.8 0 3.4.5 4.6 1.6M23 10v8M19 14h8"></path><circle cx="16" cy="16" r="12.5"></circle></svg>
            </span>
            <div>
              <span class="login-eyebrow">Bine ai venit</span>
              <h2>Creează cont</h2>
              <p>Completează datele de mai jos sau continuă rapid cu Google.</p>
            </div>
          </header>

          <a class="auth-google-button" href="{{ url('cont/google/') }}">
            <span class="auth-google-button__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.6h3.3c1.9-1.8 2.9-4.4 2.9-7.5Z"></path>
                <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.3l-3.3-2.6c-.9.6-2.1 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3v2.7A10 10 0 0 0 12 22Z"></path>
                <path fill="#FBBC05" d="M6.4 13.9A6 6 0 0 1 6.1 12c0-.7.1-1.3.3-1.9V7.4H3A10 10 0 0 0 2 12c0 1.7.4 3.2 1 4.6l3.4-2.7Z"></path>
                <path fill="#EA4335" d="M12 5.9c1.5 0 2.9.5 3.9 1.5l2.9-2.9A9.8 9.8 0 0 0 12 2a10 10 0 0 0-9 5.4l3.4 2.7C7.2 7.7 9.4 5.9 12 5.9Z"></path>
              </svg>
            </span>
            <strong>Continuă cu Google</strong>
            <i aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m7.5 5 5 5-5 5"></path></svg></i>
          </a>

          <div class="auth-divider"><span>sau creează contul cu email</span></div>

          <form class="login-form register-form" method="post">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

            <div class="register-fields">
              <label class="login-field" for="register-first-name">
                <span>Prenume</span>
                <span class="login-field__control">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20c.8-4 3-6 6.5-6s5.7 2 6.5 6"></path></svg>
                  <input id="register-first-name" name="first_name" autocomplete="given-name" placeholder="Prenumele tău" required>
                </span>
              </label>

              <label class="login-field" for="register-last-name">
                <span>Nume</span>
                <span class="login-field__control">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20c.8-4 3-6 6.5-6s5.7 2 6.5 6"></path></svg>
                  <input id="register-last-name" name="last_name" autocomplete="family-name" placeholder="Numele tău" required>
                </span>
              </label>
            </div>

            <div class="register-fields">
              <label class="login-field" for="register-email">
                <span>Email</span>
                <span class="login-field__control">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z"></path><path d="m4.5 7.5 7.5 6 7.5-6"></path></svg>
                  <input id="register-email" type="email" name="email" autocomplete="email" placeholder="numele@exemplu.ro" required>
                </span>
              </label>

              <label class="login-field" for="register-phone">
                <span>Telefon</span>
                <span class="login-field__control">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.8 10 7.7 8.5 9.2c1.1 2.5 2.9 4.3 5.4 5.4l1.5-1.5 3.9 2.8-.5 3.3c-.1.7-.8 1.2-1.5 1.2C10.1 20.4 3.6 13.9 3.6 6.7c0-.7.5-1.4 1.2-1.5l2.4-.4Z"></path></svg>
                  <input id="register-phone" type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="07xx xxx xxx" required>
                </span>
              </label>
            </div>

            <label class="login-field" for="register-password">
              <span>Parolă <small>minimum 8 caractere</small></span>
              <span class="login-field__control">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2.5"></path></svg>
                <input id="register-password" type="password" name="password" minlength="8" autocomplete="new-password" placeholder="Alege o parolă sigură" required>
                <button class="login-password-toggle" type="button" data-password-toggle aria-pressed="false" aria-label="Arată parola" title="Arată parola">
                  <svg class="login-password-toggle__show" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.8 12s3.3-5.5 9.2-5.5 9.2 5.5 9.2 5.5-3.3 5.5-9.2 5.5S2.8 12 2.8 12Z"></path><circle cx="12" cy="12" r="2.7"></circle></svg>
                  <svg class="login-password-toggle__hide" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4 20 20M9.5 7a9.8 9.8 0 0 1 2.5-.5c5.9 0 9.2 5.5 9.2 5.5a15.3 15.3 0 0 1-2.5 3.1M14.2 17.2c-.7.2-1.4.3-2.2.3-5.9 0-9.2-5.5-9.2-5.5a15 15 0 0 1 3-3.5"></path></svg>
                </button>
              </span>
            </label>

            <button class="login-submit" type="submit">
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M14 7l5 5-5 5"></path></svg></span>
              <strong>Creează contul</strong>
              <i aria-hidden="true">→</i>
            </button>
          </form>

          <div class="login-register-prompt login-register-prompt--login">
            <span class="login-register-prompt__icon" aria-hidden="true">
              <img src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt="">
            </span>
            <p><small>Ai deja un cont?</small><strong>Reia povestea de unde ai rămas.</strong></p>
            <a href="{{ url('cont/autentificare/') }}">Autentificare <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
