{% extends 'storefront/layouts/base.twig' %}{% block content %}<div class="container page-shell auth-shell"><form class="form-card" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><h1>Creează cont</h1><label>Prenume<input name="first_name" autocomplete="given-name" required></label><label>Nume<input name="last_name" autocomplete="family-name" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Parolă (minimum 12 caractere)<input type="password" name="password" minlength="12" autocomplete="new-password" required></label><button class="button button-wide">Creează cont</button></form></div>{% endblock %}
