{% extends 'storefront/layouts/base.twig' %}
{% block body_class %}product-page-body{% endblock %}
{% block head %}<script type="application/ld+json">{{ structured_data|raw }}</script>{% endblock %}
{% block content %}
{% set gallery_count = product.images|length %}
{% set default_variant = product.variants|first %}
{% set default_variant_is_in_cart = default_variant ? is_variant_in_cart(default_variant.id) : false %}
{% set product_is_favorite = is_favorite(product.id) %}
<main class="product-page">
  <div class="container product-page-shell">
    <nav class="breadcrumbs product-breadcrumbs" aria-label="Navigare ierarhică">
      <a href="{{ url('') }}">Acasă</a>
      {% for category in product_category_trail %}<span aria-hidden="true">/</span><a href="{{ url('categorie/' ~ category.path ~ '/') }}">{{ category.name }}</a>{% endfor %}
    </nav>

    <div class="product-detail">
      {% if product.image_path %}
        <section class="product-gallery-shell" data-product-gallery data-gallery-title="{{ product.name }}" aria-label="Galeria foto pentru {{ product.name }}">
          <div class="product-gallery-layout{{ gallery_count > 1 ? '' : ' is-single' }}">
            {% if gallery_count > 1 %}
              <div class="product-gallery-rail" aria-label="Miniaturi galerie">
                <button class="product-gallery-rail-control is-previous" type="button" data-gallery-rail-previous aria-label="Derulează miniaturile în sus">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 14 5-5 5 5"></path></svg>
                </button>
                <div class="product-gallery-thumbnails" data-gallery-thumbnails>
                  {% for image in product.images %}
                    <button class="product-gallery-thumbnail{{ loop.first ? ' is-active' : '' }}" type="button" data-product-gallery-thumbnail data-gallery-index="{{ loop.index0 }}" data-gallery-src="{{ url(image.image_path) }}" data-gallery-alt="{{ image.image_alt ?: product.name }}" aria-label="Afișează imaginea {{ loop.index }} din {{ gallery_count }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
                      <img src="{{ url(image.image_path) }}" alt="" width="140" height="140" loading="{{ loop.first ? 'eager' : 'lazy' }}" decoding="async">
                    </button>
                  {% endfor %}
                </div>
                <button class="product-gallery-rail-control is-next" type="button" data-gallery-rail-next aria-label="Derulează miniaturile în jos">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg>
                </button>
              </div>
            {% endif %}

            <div class="product-gallery-stage" data-gallery-stage>
              <figure class="product-gallery has-image">
                <img src="{{ url(product.image_path) }}" alt="{{ product.image_alt ?: product.name }}" width="1100" height="1100" decoding="async" fetchpriority="high" data-product-gallery-main>
              </figure>

              <form class="product-gallery-favorite boutique-product-favorite{{ product_is_favorite ? ' is-selected' : '' }}" action="{{ url('favorite/') }}" method="post" data-storefront-favorite data-product-name="{{ product.name }}">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <input type="hidden" name="product_id" value="{{ product.id }}">
                <button type="submit" aria-label="{{ product_is_favorite ? 'Elimină ' ~ product.name ~ ' din favorite' : 'Adaugă ' ~ product.name ~ ' la favorite' }}" title="{{ product_is_favorite ? 'Elimină din favorite' : 'Adaugă la favorite' }}">
                  <img class="boutique-product-favorite-icon icon-heart" src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt="" aria-hidden="true">
                </button>
              </form>

              {% if gallery_count > 1 %}
                <button class="product-gallery-arrow is-previous" type="button" data-gallery-previous aria-label="Imaginea precedentă">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6.5-5.5 5.5 5.5 5.5"></path></svg>
                </button>
                <button class="product-gallery-arrow is-next" type="button" data-gallery-next aria-label="Imaginea următoare">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
                </button>
              {% endif %}

              <button class="product-gallery-zoom" type="button" data-gallery-open aria-label="Mărește imaginea produsului">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.2"></circle><path d="m15.2 15.2 4.2 4.2M10.7 7.9v5.6M7.9 10.7h5.6"></path></svg>
                <span>Mărește</span>
              </button>

              {% if default_variant %}
                <span class="product-gallery-stock{{ default_variant.available_quantity > 0 ? ' is-available' : ' is-unavailable' }}" data-product-stock>
                  <i aria-hidden="true"></i><span>{{ default_variant.available_quantity > 0 ? 'În stoc' : 'Stoc epuizat' }}</span>
                </span>
              {% endif %}

              {% if gallery_count > 1 %}
                <div class="product-gallery-pagination" aria-label="Poziția în galerie">
                  {% for image in product.images %}
                    <button class="product-gallery-dot{{ loop.first ? ' is-active' : '' }}" type="button" data-gallery-dot data-gallery-index="{{ loop.index0 }}" aria-label="Imaginea {{ loop.index }} din {{ gallery_count }}" aria-current="{{ loop.first ? 'true' : 'false' }}"></button>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>

          <dialog class="product-gallery-lightbox" data-gallery-lightbox aria-label="Galerie mărită pentru {{ product.name }}">
            <div class="product-gallery-lightbox-header">
              <div>
                <span>Galerie produs</span>
                <strong>{{ product.name }}</strong>
              </div>
              <span class="product-gallery-lightbox-count"><b data-gallery-current>1</b> / {{ gallery_count }}</span>
              <div class="product-gallery-lightbox-tools">
                <button type="button" data-gallery-zoom-out aria-label="Micșorează imaginea">−</button>
                <output data-gallery-zoom-level>100%</output>
                <button type="button" data-gallery-zoom-in aria-label="Mărește imaginea">+</button>
                <button class="is-close" type="button" data-gallery-close aria-label="Închide galeria">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
                </button>
              </div>
            </div>
            <div class="product-gallery-lightbox-stage" data-gallery-lightbox-stage>
              <img src="{{ url(product.image_path) }}" alt="{{ product.image_alt ?: product.name }}" width="1400" height="1400" data-gallery-lightbox-image>
              {% if gallery_count > 1 %}
                <button class="product-gallery-lightbox-arrow is-previous" type="button" data-gallery-lightbox-previous aria-label="Imaginea precedentă">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6.5-5.5 5.5 5.5 5.5"></path></svg>
                </button>
                <button class="product-gallery-lightbox-arrow is-next" type="button" data-gallery-lightbox-next aria-label="Imaginea următoare">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
                </button>
              {% endif %}
            </div>
            <p class="product-gallery-lightbox-hint">Schimbă imaginea din butoanele laterale · pinch pentru zoom pe telefon · rotița pentru zoom pe desktop · trage pentru repoziționare</p>
          </dialog>
        </section>
      {% else %}
        <div class="product-gallery placeholder">Galeria foto va fi completată ulterior.</div>
      {% endif %}

      <section class="product-info" aria-labelledby="product-title">
        <div class="product-info-heading">
          <div class="product-heading-meta">
            {% if product.category_name %}<a class="product-category-kicker" href="{{ product_category_trail ? url('categorie/' ~ (product_category_trail|last).path ~ '/') : url('magazin/') }}">{{ product.category_name }}</a>{% endif %}
            {% if default_variant %}<span class="product-sku-pill" data-product-sku>{{ default_variant.sku }}</span>{% endif %}
          </div>
          <h1 id="product-title">{{ product.name }}</h1>
          <div class="product-intro-note">
            <span class="product-intro-icon" aria-hidden="true">
              <img src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt="">
            </span>
            <div>
              <span class="product-intro-kicker">Pe scurt</span>
              <p class="product-lead">{{ product.short_description }}</p>
            </div>
          </div>
        </div>

        {% if default_variant %}
          <div class="product-purchase-summary">
            <div class="product-price-wrap">
              <span class="product-price-label">Preț</span>
              <strong class="product-price" data-product-price>{{ money(default_variant.price_bani) }}</strong>
              <del data-product-compare-price{% if not default_variant.compare_price_bani or default_variant.compare_price_bani <= default_variant.price_bani %} hidden{% endif %}>{{ default_variant.compare_price_bani and default_variant.compare_price_bani > default_variant.price_bani ? money(default_variant.compare_price_bani) : '' }}</del>
            </div>
          </div>
        {% endif %}

        {% if product.variants %}
          {% set product_requires_selection = product.required_personalization_count|default(0) > 0 %}
          {% set product_initially_in_cart = product.variants|length == 1 and default_variant_is_in_cart %}
          <form class="product-buy-form{{ product_initially_in_cart ? ' is-added' : '' }}" action="{{ url('cos/adauga/') }}" method="post" data-cart-form data-storefront-cart data-cart-toggle data-cart-state="{{ product_initially_in_cart ? 'added' : 'removed' }}" data-product-name="{{ product.name }}" data-product-url="{{ url('produs/' ~ product.slug ~ '/') }}"{% if product.image_path %} data-product-image="{{ url(product.image_path) }}"{% endif %} data-cart-url="{{ url('cos/') }}" data-cart-ready="{{ product_requires_selection or default_variant.available_quantity <= 0 ? 'false' : 'true' }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <input type="hidden" name="toggle_cart" value="1">
            {% if product.variants|length > 1 %}
              {% if product.variant_groups|default([]) %}
                <div class="product-variant-groups" data-variant-groups aria-label="Opțiunile produsului">
                  {% for group in product.variant_groups %}
                    <label class="product-field" for="variant-option-{{ loop.index }}">
                      <span>{{ group.name }}</span>
                      <span class="product-select-shell">
                        <select id="variant-option-{{ loop.index }}" data-variant-option data-option-name="{{ group.name }}" aria-required="true">
                          <option value="" hidden>Selectează</option>
                          {% for value in group.values %}<option value="{{ value }}"{{ loop.first ? ' selected' : '' }}>{{ value }}</option>{% endfor %}
                        </select>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg>
                      </span>
                    </label>
                  {% endfor %}
                </div>
              {% endif %}
              <label class="product-field product-variant-fallback" for="variant">
                <span>Variantă</span>
                <span class="product-select-shell">
                  <select id="variant" name="variant_id" data-variant-select required>
                    <option value="" hidden>Selectează varianta</option>
                    {% for variant in product.variants %}
                      <option value="{{ variant.id }}" data-options="{{ variant.options_json|default('{}') }}" data-price="{{ variant.price_bani }}" data-compare-price="{{ variant.compare_price_bani ?: 0 }}" data-stock="{{ variant.available_quantity }}" data-sku="{{ variant.sku }}" data-in-cart="{{ is_variant_in_cart(variant.id) ? '1' : '0' }}"{{ variant.id == default_variant.id ? ' selected' : '' }}>{{ variant.option_summary ?: 'Variantă standard' }} — {{ money(variant.price_bani) }}</option>
                    {% endfor %}
                  </select>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg>
                </span>
              </label>
            {% else %}
              <input type="hidden" name="variant_id" value="{{ default_variant.id }}" data-variant-select data-price="{{ default_variant.price_bani }}" data-compare-price="{{ default_variant.compare_price_bani ?: 0 }}" data-stock="{{ default_variant.available_quantity }}" data-sku="{{ default_variant.sku }}" data-in-cart="{{ default_variant_is_in_cart ? '1' : '0' }}">
            {% endif %}

            {% for option in product.personalization_options %}
              <label class="product-field" for="option_{{ option.id }}">
                <span>{{ option.label }}{{ option.required ? ' *' }}</span>
                {% if option.type == 'select' %}
                  <span class="product-select-shell">
                    <select id="option_{{ option.id }}" name="option_{{ option.id }}" data-product-option {{ option.required ? 'required' }}>
                      <option value="">Alege</option>
                      {% for value in option.allowed_values_json|json_decode %}<option>{{ value }}</option>{% endfor %}
                    </select>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg>
                  </span>
                {% elseif option.type == 'checkbox' %}
                  <span class="product-checkbox"><input id="option_{{ option.id }}" type="checkbox" name="option_{{ option.id }}" value="da" data-product-option {{ option.required ? 'required' }}><span>Da, doresc această opțiune</span></span>
                {% else %}
                  <input id="option_{{ option.id }}" name="option_{{ option.id }}" maxlength="{{ option.max_length ?: 120 }}" data-product-option {{ option.required ? 'required' }}>
                {% endif %}
              </label>
            {% endfor %}

            <p class="product-selection-hint" data-product-selection-hint role="status" hidden></p>

            <div class="product-buy-row">
              <label class="product-quantity-label" for="quantity">Cantitate</label>
              <div class="product-quantity" data-product-quantity>
                <button type="button" data-quantity-decrease aria-label="Scade cantitatea">−</button>
                <input id="quantity" name="quantity" type="number" min="1" max="20" value="1" inputmode="numeric">
                <button type="button" data-quantity-increase aria-label="Crește cantitatea">+</button>
              </div>
              <button class="product-add-button" type="submit" aria-pressed="{{ product_initially_in_cart ? 'true' : 'false' }}" aria-label="{{ product_initially_in_cart ? 'Scoate ' ~ product.name ~ ' din coș' : 'Adaugă ' ~ product.name ~ ' în coș' }}"{{ product.variants|length == 1 and default_variant.available_quantity <= 0 ? ' disabled' : '' }}>
                <span class="product-add-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5h2.1l1.2 9.2a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 1.9-1.4l1.4-5.8H6.2"></path><circle cx="9.2" cy="19" r="1.25"></circle><circle cx="17" cy="19" r="1.25"></circle></svg></span>
                <span data-add-to-cart-label>{{ product_initially_in_cart ? 'În coș' : (default_variant.available_quantity > 0 ? 'Adaugă în coș' : 'Stoc epuizat') }}</span>
                <span class="product-add-arrow" aria-hidden="true">
                  <svg class="product-add-chevron" viewBox="0 0 20 20"><path d="m7.5 5 5 5-5 5"></path></svg>
                  <svg class="product-add-check" viewBox="0 0 20 20"><path class="product-add-check-mark" d="m4.7 10.2 3.5 3.6 7.2-8"></path><path class="product-add-check-spark" d="M15.8 2.8v2.4M14.6 4h2.4"></path></svg>
                </span>
              </button>
            </div>
          </form>
        {% endif %}

        <ul class="product-reassurance" aria-label="Avantaje">
          <li><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5h10v9H4zM14 10h3.2l2.8 3v3.5h-6z"></path><circle cx="8" cy="18" r="1.5"></circle><circle cx="17.5" cy="18" r="1.5"></circle></svg></span><div><strong>Livrare în România</strong><small>Pregătită cu grijă</small></div></li>
          <li><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s7-3.7 7-10V5.5L12 3 5 5.5V10c0 6.3 7 10 7 10Z"></path><path d="m8.8 11.5 2.1 2.1 4.5-4.5"></path></svg></span><div><strong>Ales cu atenție</strong><small>Pentru cei mici</small></div></li>
          <li><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 11.5a8 8 0 1 1 2.3 5.7L4 20v-8.5Z"></path><path d="M8.5 11.5h7M12 8v7"></path></svg></span><div><strong>Ai nevoie de ajutor?</strong><small>Îți răspundem cu drag</small></div></li>
        </ul>
      </section>
    </div>

    <section class="product-editorial" data-product-editorial aria-label="Informații despre produs">
      <div class="product-editorial-nav-shell" data-editorial-nav-shell>
        <nav class="product-editorial-nav" aria-label="Secțiunile produsului">
          <a class="is-active" href="#descriere-produs" data-editorial-link="descriere-produs" aria-current="location">Descriere</a>
          <a href="#informatii-produs" data-editorial-link="informatii-produs">Informații produs</a>
          <a href="#recenzii-produs" data-editorial-link="recenzii-produs">Recenzii</a>
        </nav>
      </div>

      <div class="product-editorial-sections">
        <article class="product-editorial-section product-description-section" id="descriere-produs" data-editorial-section>
          <header class="product-editorial-heading">
            <span class="eyebrow">Povestea produsului</span>
            <h2>Descriere</h2>
          </header>
          <div class="product-description-body" data-product-description-body>
            {{ (product.description ?: product.short_description)|product_description_html }}
            {% if product.package_contents %}
              <h3>Ce conține pachetul</h3>
              <p>{{ product.package_contents|nl2br }}</p>
            {% endif %}
            {% if product.excluded_accessories %}
              <p class="product-editorial-note"><strong>De reținut:</strong> {{ product.excluded_accessories }}</p>
            {% endif %}
          </div>
          <button class="product-description-toggle" type="button" data-product-description-toggle aria-expanded="false" hidden>
            <span data-description-toggle-label>Vezi mai mult</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5"></path></svg>
          </button>
        </article>

        <article class="product-editorial-section product-specifications-section" id="informatii-produs" data-editorial-section>
          <header class="product-editorial-heading">
            <span class="eyebrow">Detalii utile</span>
            <h2>Informații produs</h2>
          </header>
          <dl class="product-specifications">
            {% if default_variant %}<div><dt>Cod produs</dt><dd data-product-spec-sku>{{ default_variant.sku }}</dd></div>{% endif %}
            {% if product.category_name %}<div><dt>Categorie</dt><dd>{{ product.category_name }}</dd></div>{% endif %}
            {% for group in product.variant_groups|default([]) %}<div><dt>{{ group.name }}</dt><dd>{{ group.values|join(' · ') }}</dd></div>{% endfor %}
            {% if product.composition %}<div><dt>Compoziție</dt><dd>{{ product.composition }}</dd></div>{% endif %}
            {% if product.care_instructions %}<div><dt>Îngrijire</dt><dd>{{ product.care_instructions }}</dd></div>{% endif %}
            {% if product.size_guide %}<div><dt>Dimensiuni</dt><dd>{{ product.size_guide|nl2br }}</dd></div>{% endif %}
          </dl>
        </article>

        <article class="product-editorial-section product-reviews-section" id="recenzii-produs" data-editorial-section>
          <header class="product-editorial-heading">
            <span class="eyebrow">Păreri sincere</span>
            <h2>Recenzii</h2>
          </header>

          {% set review_count = review_summary.count|default(0) %}
          {% set review_average = review_summary.average|default(0) %}
          {% if review_count > 0 %}<div class="product-review-overview">
            <div class="product-review-score">
              <span class="product-review-score-kicker">Nota comunității</span>
              <div
                class="product-review-score-value"
                {% if review_count %}data-review-score data-review-score-value="{{ review_average|number_format(1, '.', '') }}" aria-label="{{ review_average|number_format(1, ',', '.') }} din 5"{% endif %}
              >{{ review_count ? review_average|number_format(1, ',', '.') : '—' }}</div>
              <div class="product-review-stars product-review-stars--average" aria-label="{{ review_count ? review_average|number_format(1, ',', '.') ~ ' din 5 stele' : 'Nicio notă încă' }}">
                {% for star in 1..5 %}
                  {% set star_fill = 0 %}
                  {% if review_average >= star %}
                    {% set star_fill = 100 %}
                  {% elseif review_average > star - 1 %}
                    {% set star_fill = (review_average - star + 1) * 100 %}
                  {% endif %}
                  {% set star_fill_step = ((star_fill / 10)|round) * 10 %}
                  <span class="{{ star_fill >= 100 ? 'is-filled' : (star_fill > 0 ? 'is-partial is-fill-' ~ star_fill_step : '') }}" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path class="product-review-star-base" d="m12 2.7 2.83 5.73 6.33.92-4.58 4.46 1.08 6.3L12 17.13l-5.66 2.98 1.08-6.3-4.58-4.46 6.33-.92L12 2.7Z"></path>
                      <path class="product-review-star-fill" d="m12 2.7 2.83 5.73 6.33.92-4.58 4.46 1.08 6.3L12 17.13l-5.66 2.98 1.08-6.3-4.58-4.46 6.33-.92L12 2.7Z"></path>
                    </svg>
                  </span>
                {% endfor %}
              </div>
              <p>{{ review_count }} {{ review_count == 1 ? 'recenzie afișată' : 'recenzii afișate' }}</p>
            </div>
            <div class="product-review-distribution" aria-label="Distribuția notelor">
              {% for star in [5, 4, 3, 2, 1] %}
                <div class="product-review-distribution-row">
                  <span>{{ star }} <i aria-hidden="true">★</i></span>
                  <progress value="{{ review_summary.distribution[star]|default(0) }}" max="{{ review_count > 0 ? review_count : 1 }}">{{ review_summary.distribution[star]|default(0) }}</progress>
                  <small>{{ review_summary.distribution[star]|default(0) }}</small>
                </div>
              {% endfor %}
            </div>
            <a class="product-review-write-link" href="#formular-recenzie" data-review-open>
              <span class="product-review-write-star" aria-hidden="true">★</span>
              <strong>Scrie o recenzie</strong>
              <i aria-hidden="true">→</i>
            </a>
          </div>{% endif %}

          <div class="product-review-layout">
            {% if product_reviews %}
              <div class="boutique-carousel product-review-carousel" data-product-carousel data-review-carousel data-item-label="Recenzia" data-autoplay-ms="6500" role="region" aria-roledescription="carusel" aria-label="Recenziile produsului {{ product.name }}">
                <div class="boutique-carousel-toolbar">
                  <span class="product-review-carousel-label"><i aria-hidden="true"><img class="product-review-carousel-heart" src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt=""></i> Povești de la comunitate</span>
                  <span class="boutique-carousel-progress" aria-hidden="true"><span data-carousel-progress></span></span>
                  <div class="boutique-carousel-controls">
                    <button class="boutique-carousel-button" type="button" data-carousel-prev aria-label="Recenzia precedentă">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6.5-5.5 5.5 5.5 5.5"></path></svg>
                    </button>
                    <span class="boutique-carousel-position" data-carousel-position aria-live="polite">01 / {{ '%02d'|format(product_reviews|length) }}</span>
                    <button class="boutique-carousel-button" type="button" data-carousel-next aria-label="Recenzia următoare">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
                    </button>
                  </div>
                </div>
                <div class="boutique-carousel-viewport" data-carousel-viewport tabindex="0">
                  <div class="boutique-carousel-track" data-carousel-track>
                    {% for review in product_reviews %}
                      <div class="boutique-carousel-slide" data-carousel-slide role="group" aria-roledescription="slide" aria-label="{{ loop.index }} din {{ product_reviews|length }}">
                        <article class="product-review-card{{ review.is_demo ? ' is-demo' : '' }}">
                          <header>
                            <span class="product-review-avatar" aria-hidden="true">{{ review.author_name|slice(0, 1)|upper }}</span>
                            <div class="product-review-author">
                              <strong>{{ review.author_name }}</strong>
                              <div class="product-review-stars product-review-stars--small" aria-label="{{ review.rating }} din 5 stele">
                                {% for star in 1..5 %}<span class="{{ star <= review.rating ? 'is-filled' : '' }}" aria-hidden="true">★</span>{% endfor %}
                              </div>
                            </div>
                            <time datetime="{{ review.created_at }}">{{ review.created_at|date('d.m.Y') }}</time>
                          </header>
                          {% if review.is_verified_purchase %}<div class="product-review-badges"><span class="is-verified">✓ Achiziție verificată</span></div>{% endif %}
                          {% if review.title %}<h3>{{ review.title }}</h3>{% endif %}
                          <p class="product-review-body" data-review-body>
                            <span data-review-excerpt>{{ review.body }}</span>
                            <button
                              class="product-review-more"
                              type="button"
                              data-review-expand
                              data-review-full="{{ review.body|e('html_attr') }}"
                              data-review-author="{{ review.author_name|e('html_attr') }}"
                              data-review-title="{{ review.title|default('')|e('html_attr') }}"
                              data-review-date="{{ review.created_at|e('html_attr') }}"
                              data-review-date-label="{{ review.created_at|date('d.m.Y') }}"
                              data-review-rating="{{ review.rating }}"
                              data-review-demo="{{ review.is_demo ? '1' : '0' }}"
                              data-review-verified="{{ review.is_verified_purchase ? '1' : '0' }}"
                              aria-label="Citește recenzia completă scrisă de {{ review.author_name }}"
                              hidden
                            >Vezi tot <span aria-hidden="true">→</span></button>
                          </p>
                        </article>
                      </div>
                    {% endfor %}
                  </div>
                </div>
                <p class="sr-only" data-carousel-announcement aria-live="polite"></p>
              </div>
            {% else %}
              <div class="product-reviews-empty">
                <span class="product-reviews-heart" aria-hidden="true"><img src="{{ url('assets/images/icon-favorite-hearts.png') }}" width="160" height="128" alt=""></span>
                <div class="product-reviews-empty-copy"><strong>Primele impresii se scriu aici</strong><p>Fii primul care povestește cum a fost experiența cu acest produs.</p></div>
                <a class="product-reviews-empty-action" href="#formular-recenzie" data-review-open>
                  <span aria-hidden="true">★</span>
                  <strong>Scrie prima recenzie</strong>
                  <i aria-hidden="true">→</i>
                </a>
              </div>
            {% endif %}

            <div class="product-review-modal-slot" id="formular-recenzie">
              <dialog class="product-review-dialog" data-review-dialog aria-labelledby="review-dialog-title" hidden>
                <div class="product-review-dialog-shell">
                  <header class="product-review-dialog-header">
                    <div><span class="eyebrow">Părerea ta contează</span><strong id="review-dialog-title">Scrie o recenzie</strong></div>
                    <button type="button" data-review-close aria-label="Închide formularul de recenzie">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
                    </button>
                  </header>
                  {% include 'storefront/components/product-review-form.twig' with {review_form_prefix: 'review-modal'} %}
                </div>
              </dialog>
              <noscript><div class="product-review-form-fallback">{% include 'storefront/components/product-review-form.twig' with {review_form_prefix: 'review-fallback'} %}</div></noscript>

              <dialog class="product-review-dialog product-review-detail-dialog" data-review-detail-dialog aria-labelledby="review-detail-dialog-title" hidden>
                <div class="product-review-dialog-shell">
                  <header class="product-review-dialog-header">
                    <div><span class="eyebrow">Poveste din comunitate</span><strong id="review-detail-dialog-title">Recenzia completă</strong></div>
                    <button type="button" data-review-detail-close aria-label="Închide recenzia completă">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
                    </button>
                  </header>
                  <article class="product-review-detail-content">
                    <header class="product-review-detail-person">
                      <span class="product-review-avatar" data-review-detail-avatar aria-hidden="true"></span>
                      <div>
                        <strong data-review-detail-author></strong>
                        <div class="product-review-stars product-review-stars--small" data-review-detail-stars aria-label=""></div>
                      </div>
                      <time data-review-detail-date></time>
                    </header>
                    <div class="product-review-badges" data-review-detail-badges>
                      <span class="is-verified" data-review-detail-verified hidden>✓ Achiziție verificată</span>
                    </div>
                    <h3 data-review-detail-title></h3>
                    <p data-review-detail-body></p>
                  </article>
                </div>
              </dialog>
            </div>
          </div>
        </article>

        {% if similar_products %}
          <section class="product-similar-section" aria-labelledby="produse-similare-title">
            <header class="product-similar-heading">
              <div>
                <span class="eyebrow">Descoperite pentru tine</span>
                <h2 id="produse-similare-title">S-ar potrivi <em>minunat împreună</em></h2>
              </div>
              <p>O selecție creată din aceeași poveste: categorie, stil, utilizare și apropierea de preț.</p>
            </header>
            <div class="boutique-carousel product-similar-carousel" data-product-carousel data-autoplay-ms="2800" role="region" aria-roledescription="carusel" aria-label="Produse similare cu {{ product.name }}">
              <div class="boutique-carousel-toolbar">
                <span class="boutique-carousel-progress" aria-hidden="true"><span data-carousel-progress></span></span>
                <div class="boutique-carousel-controls">
                  <button class="boutique-carousel-button" type="button" data-carousel-prev aria-label="Produs similar anterior">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6.5-5.5 5.5 5.5 5.5"></path></svg>
                  </button>
                  <span class="boutique-carousel-position" data-carousel-position aria-live="polite">01 / {{ '%02d'|format(similar_products|length) }}</span>
                  <button class="boutique-carousel-button" type="button" data-carousel-next aria-label="Următorul produs similar">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
                  </button>
                </div>
              </div>
              <div class="boutique-carousel-viewport" data-carousel-viewport tabindex="0">
                <div class="boutique-carousel-track" data-carousel-track>
                  {% for similar_product in similar_products %}
                    <div class="boutique-carousel-slide" data-carousel-slide role="group" aria-roledescription="slide" aria-label="{{ loop.index }} din {{ similar_products|length }}">
                      {% include 'storefront/components/boutique-product-card.twig' with {product: similar_product} %}
                    </div>
                  {% endfor %}
                </div>
              </div>
              <p class="sr-only" data-carousel-announcement aria-live="polite"></p>
            </div>
          </section>
        {% endif %}
      </div>
    </section>
  </div>
</main>
<script type="module" src="{{ url('assets/js/storefront/product-gallery.js') }}?v=20261025-gallery5"></script>
<script type="module" src="{{ url('assets/js/storefront/product-editorial.js') }}?v=20261025-editorial5"></script>
<script type="module" src="{{ url('assets/js/storefront/product-reviews.js') }}?v=20261025-review-modal4"></script>
{% endblock %}
