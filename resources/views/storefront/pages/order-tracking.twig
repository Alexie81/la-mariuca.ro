{% extends 'storefront/layouts/base.twig' %}
{% macro icon(name) %}<svg viewBox="0 0 24 24" aria-hidden="true">{% if name == 'truck' %}<path d="M3 5h11v12H3zM14 9h4l3 5v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>{% elseif name == 'gift' %}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8C5 8 5 3 8 3c3 0 4 5 4 5Zm0 0s1-5 4-5c3 0 3 5-4 5Z"/>{% elseif name == 'bag' %}<path d="M5 7h14l1 14H4L5 7ZM9 8V6a3 3 0 0 1 6 0v2"/>{% elseif name == 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>{% elseif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/>{% elseif name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>{% elseif name == 'lock' %}<rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>{% elseif name == 'download' %}<path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/>{% elseif name == 'pin' %}<path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>{% elseif name == 'refresh' %}<path d="M20 7v5h-5M4 17v-5h5M6 6a8 8 0 0 1 14 6M4 12a8 8 0 0 0 14 6"/>{% elseif name == 'heart' %}<path d="M20 5c-3-3-7-1-8 2-1-3-5-5-8-2-5 5 3 11 8 15 5-4 13-10 8-15Z"/>{% else %}<circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/>{% endif %}</svg>{% endmacro %}
{% block head %}<link rel="stylesheet" href="{{ url('assets/css/storefront/order-tracking.css?v=20261107-1') }}"><script src="{{ url('assets/js/order-tracking.js?v=20261107-1') }}" defer></script>{% endblock %}
{% block body_class %}tracking-body{% endblock %}
{% block content %}
<div class="tracking container" data-order-tracking>
  <nav class="tracking-nav" aria-label="Navigare urmărire"><a href="{{ url('magazin/') }}">{{ _self.icon('arrow') }} Înapoi în magazin</a><span>{{ _self.icon('lock') }} Detaliile tale, în siguranță</span></nav>
  {% if not tracking_order %}
  <section class="tracking-entry">
    <div class="tracking-entry__story">
      <span class="tracking-kicker">De la noi, către tine</span>
      <h1>O mică bucurie.<br><em>Un drum de urmărit.</em></h1>
      <p>Vezi unde a ajuns comanda ta și regăsește toate detaliile, într-un singur loc.</p>
      <div class="tracking-illustration" aria-hidden="true"><div class="tracking-orbit"></div><div class="tracking-parcel">{{ _self.icon('gift') }}<span>pregătit cu drag</span></div><span class="tracking-float is-one">{{ _self.icon('check') }} Cu grijă, la fiecare pas</span><span class="tracking-float is-two">{{ _self.icon('truck') }} Spre bucuria celor mici</span><i class="tracking-spark is-one"></i><i class="tracking-spark is-two"></i></div>
      <div class="tracking-entry__note"><img src="{{ url('assets/images/icon-favorite-hearts.png') }}" alt="" width="42" height="34"><span>De la prima alegere, până la primul zâmbet.</span></div>
    </div>
    <div class="tracking-lookup">
      <span class="tracking-icon">{{ _self.icon('search') }}</span><span class="tracking-kicker">Urmărire comandă</span>
      <h2>Hai să găsim comanda ta.</h2><p>Ai nevoie de două detalii din emailul de confirmare. Nu este necesar un cont.</p>
      {% if tracking_error %}<div class="tracking-error" role="alert">{{ _self.icon('info') }}<span>{{ tracking_error }}</span></div>{% endif %}
      <form action="{{ url('urmarire-comanda/') }}" method="post" data-tracking-lookup>
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <label for="tracking-number"><span>Numărul comenzii</span><div class="tracking-input"><span aria-hidden="true">#</span><input id="tracking-number" name="order_number" value="{{ tracking_number }}" placeholder="Ex. LM-2026-000123" required maxlength="100" autocapitalize="characters" spellcheck="false" autocomplete="off"></div><small>Îl găsești în emailul primit după plasarea comenzii.</small></label>
        <label for="tracking-email"><span>Adresa de email</span><div class="tracking-input">{{ _self.icon('mail') }}<input id="tracking-email" type="email" name="email" value="{{ tracking_email }}" placeholder="Emailul folosit la comandă" required maxlength="254" autocomplete="email"></div></label>
        <button class="tracking-button is-primary" type="submit"><span>Urmărește comanda</span>{{ _self.icon('arrow') }}</button>
      </form>
      <div class="tracking-lookup__help">Ai nevoie de ajutor? <a href="{{ url('pagina/contact/') }}">Suntem aici pentru tine.</a></div>
    </div>
  </section>
  {% else %}
  {% set order = tracking_order %}
  <header class="tracking-hero">
    <div><span class="tracking-kicker">Fiecare pas, mai aproape de tine</span><h1>Comanda ta,<br><em>în grija noastră.</em></h1><p>Bună, {{ order.first_name }}. Aici găsești cele mai recente detalii ale comenzii tale.</p></div>
    <div class="tracking-reference"><span>Comanda</span><strong>{{ order.order_number }}</strong><time datetime="{{ order.created_at }}">Plasată pe {{ order.created_at|date('d.m.Y, H:i', 'Europe/Bucharest') }}</time><div><span>{{ order.quantity }} {{ order.quantity == 1 ? 'bucată' : 'bucăți' }}</span><b>{{ money(order.total_bani) }}</b></div></div>
  </header>
  <section class="tracking-journey" aria-labelledby="tracking-status-title">
    <header>
      <div class="tracking-current"><span class="tracking-status-icon">{{ _self.icon(order.status_icon) }}</span><div>
        <span class="tracking-kicker">Statusul comenzii</span><h2 id="tracking-status-title">{{ order.status_label }}</h2><p>{{ order.status_description }}</p>
        {% if order.status_date %}<time class="tracking-status-date" datetime="{{ order.status_date }}">Din {{ order.status_date|date('d.m.Y, H:i', 'Europe/Bucharest') }}</time>{% endif %}
      </div></div>
      <a class="tracking-refresh" href="{{ url('urmarire-comanda/') }}" aria-label="Actualizează starea comenzii">{{ _self.icon('refresh') }}<span>Actualizează</span></a>
    </header>
    <ol class="tracking-timeline" aria-label="Parcursul comenzii">
      {% for step in order.timeline %}
      <li class="{{ step.done ? 'is-done' : '' }} {{ step.current ? 'is-current' : '' }}" {% if step.current %}aria-current="step"{% endif %}>
        <div class="tracking-step__marker">{{ _self.icon(step.done ? 'check' : step.icon) }}</div>
        <div class="tracking-step__copy">
          <span class="tracking-step__index">Pasul 0{{ loop.index }}</span><h3>{{ step.label }}</h3><p>{{ step.description }}</p>
          {% if step.date %}<time datetime="{{ step.date }}">{{ step.date|date('d.m.Y · H:i', 'Europe/Bucharest') }}</time>
          {% elseif step.done or step.current %}<span class="tracking-step__pending">Dată neînregistrată</span>
          {% else %}<span class="tracking-step__pending">{{ order.status in ['cancelled','returned','manual_review'] ? 'Neparcurs' : 'În așteptare' }}</span>{% endif %}
          {% if step.current %}<span class="tracking-step__now"><i></i> Etapa curentă</span>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
    {% if order.status in ['cancelled','returned','manual_review'] %}<div class="tracking-exception">{{ _self.icon('info') }}<p><strong>{{ order.status_label }}.</strong> {{ order.status_description }}</p></div>{% endif %}
  </section>
  <div class="tracking-layout">
    <div class="tracking-main">
      <section class="tracking-card tracking-products" aria-labelledby="tracking-products-title"><header class="tracking-card__head"><div><span class="tracking-kicker">Alegerile tale</span><h2 id="tracking-products-title">Bucuriile din colet</h2></div><span class="tracking-count">{{ order.quantity }} {{ order.quantity == 1 ? 'bucată' : 'bucăți' }}</span></header>
      <div class="tracking-products__list">{% for item in order.items %}<article class="tracking-product"><div class="tracking-product__image">{% if item.image_path %}<img src="{{ url(item.image_path) }}" alt="{{ item.product_name }}" width="84" height="104" loading="lazy">{% else %}{{ _self.icon('bag') }}{% endif %}<span>×{{ item.quantity }}</span></div><div class="tracking-product__copy"><h3>{{ item.product_name }}</h3>{% if item.variant_summary %}<p>{{ item.variant_summary }}</p>{% endif %}<span class="tracking-sku">SKU: {{ item.sku }}</span>{% for label,value in item.personalization %}<small>{{ label }}: {{ value }}</small>{% endfor %}<span class="tracking-unit">{{ item.quantity }} × {{ money(item.unit_price_bani) }} / buc.{% if item.personalization_bani > 0 %}<small>+ {{ money(item.personalization_bani) }} personalizare / buc.</small>{% endif %}</span></div><div class="tracking-product__price"><span>Total produs</span><strong>{{ money(item.line_total_bani) }}</strong></div></article>{% endfor %}</div></section>
      <section class="tracking-card tracking-delivery" aria-labelledby="tracking-delivery-title"><header class="tracking-card__head"><div><span class="tracking-kicker">Destinația bucuriei</span><h2 id="tracking-delivery-title">Livrare și contact</h2></div>{{ _self.icon('pin') }}</header><div class="tracking-delivery__grid"><div><span class="tracking-detail-label">Adresa de livrare</span><strong>{{ order.shipping_address.address|default('') }}</strong><p>{{ order.shipping_address.city|default('') }}{% if order.shipping_address.county|default('') %}, {{ order.shipping_address.county }}{% endif %}</p>{% if order.shipping_address.postal_code|default('') %}<p>{{ order.shipping_address.postal_code }}</p>{% endif %}<span class="tracking-shipping">{{ _self.icon('truck') }}{{ order.shipping_method_name|default('Livrare standard', true) }}</span></div><div><span class="tracking-detail-label">Date de contact</span><strong>{{ order.email }}</strong><p>{{ order.phone }}</p><p class="tracking-delivery__hint">Ai observat o greșeală? <a href="{{ url('pagina/contact/') }}">Scrie-ne</a> și te ajutăm.</p></div></div></section>
    </div>
    <aside class="tracking-side">
      <section class="tracking-card tracking-summary" aria-labelledby="tracking-summary-title"><header class="tracking-card__head"><div><span class="tracking-kicker">Totul, la vedere</span><h2 id="tracking-summary-title">Rezumatul comenzii</h2></div></header><dl><div><dt>Subtotal produse</dt><dd>{{ money(order.subtotal_bani) }}</dd></div>{% if order.discount_bani > 0 %}<div class="is-saving"><dt>Reducere produse</dt><dd>−{{ money(order.discount_bani) }}</dd></div>{% endif %}<div><dt>Livrare</dt><dd>{{ order.shipping_bani + order.shipping_discount_bani == 0 ? 'Gratuită' : money(order.shipping_bani + order.shipping_discount_bani) }}</dd></div>{% if order.shipping_discount_bani > 0 %}<div class="is-saving"><dt>Reducere livrare</dt><dd>−{{ money(order.shipping_discount_bani) }}</dd></div>{% endif %}{% if order.tax_bani > 0 %}<div><dt>Taxe</dt><dd>{{ money(order.tax_bani) }}</dd></div>{% endif %}</dl><div class="tracking-total"><span>Total comandă</span><strong>{{ money(order.total_bani) }}</strong></div><div class="tracking-payment"><span>{{ order.payment_method == 'cod' ? 'Plată la livrare' : 'Plată cu cardul' }}</span><strong>{{ order.payment_label }}</strong></div>{% if order.discount_bani + order.shipping_discount_bani > 0 %}<div class="tracking-savings">{{ _self.icon('gift') }} Ai economisit {{ money(order.discount_bani + order.shipping_discount_bani) }}</div>{% endif %}
      {% if order.invoices %}<div class="tracking-invoices">{% for invoice in order.invoices %}<a class="tracking-button is-secondary" href="{{ url('urmarire-comanda/factura/' ~ invoice.id ~ '/') }}">{{ _self.icon('download') }}<span>Descarcă factura {{ invoice.number }}</span></a>{% endfor %}</div>{% endif %}</section>
      <div class="tracking-help"><img src="{{ url('assets/images/icon-favorite-hearts.png') }}" alt="" width="52" height="42"><h3>Suntem aproape.</h3><p>O întrebare despre comanda ta?<br>Îți răspundem cu drag.</p><a href="{{ url('pagina/contact/') }}">Hai să vorbim {{ _self.icon('arrow') }}</a></div>
    </aside>
  </div>
  <footer class="tracking-bottom"><span>{{ _self.icon('lock') }} Detalii disponibile doar prin verificarea comenzii sau linkul tău privat.</span><form action="{{ url('urmarire-comanda/alta/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button class="tracking-other" type="submit">Caută altă comandă {{ _self.icon('arrow') }}</button></form></footer>
  {% endif %}
</div>
{% endblock %}
