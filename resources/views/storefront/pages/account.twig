{% extends 'storefront/layouts/base.twig' %}{% block content %}<div class="container page-shell"><div class="page-title"><div><h1>Contul meu</h1><p>{{ account.first_name }} {{ account.last_name }} · {{ account.email }}</p></div><form action="{{ url('cont/deconectare/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button>Deconectare</button></form></div><h2>Comenzi</h2><div class="table-wrap"><table><thead><tr><th>Număr</th><th>Data</th><th>Stare</th><th>Plată</th><th>Total</th></tr></thead><tbody>{% for order in orders %}<tr><td>{{ order.order_number }}</td><td>{{ order.created_at|date('d.m.Y') }}</td><td>{{ order.status }}</td><td>{{ order.payment_status }}</td><td>{{ money(order.total_bani) }}</td></tr>{% else %}<tr><td colspan="5">Nu există comenzi asociate contului verificat.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
