{% extends 'storefront/layouts/base.twig' %}
{% block head %}<script type="application/ld+json">{{ structured_data|raw }}</script>{% endblock %}
{% block content %}
  <div class="container page-shell shop-page category-page">
    <nav class="breadcrumbs category-breadcrumbs" aria-label="Navigare ierarhică">
      <a href="{{ url('') }}">Acasă</a>
      {% for trail_category in category_trail %}
        <span>/</span>
        {% if loop.last %}
          <span aria-current="page">{{ trail_category.name }}</span>
        {% else %}
          <a href="{{ url('categorie/' ~ trail_category.path ~ '/') }}">{{ trail_category.name }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <header class="shop-editorial category-editorial{{ category.image_path ? ' has-category-image' : '' }}" aria-labelledby="category-title">
      <span class="shop-editorial-glow shop-editorial-glow-one" aria-hidden="true"></span>
      <span class="shop-editorial-glow shop-editorial-glow-two" aria-hidden="true"></span>
      <span class="shop-editorial-line" aria-hidden="true">
        <svg viewBox="0 0 520 72" preserveAspectRatio="none">
          <path d="M2 46c78 0 86-30 155-30 72 0 76 40 148 40 53 0 76-27 123-27 35 0 56 14 90 13"></path>
          <path d="M430 29c10-18 36-10 30 8-5 13-22 21-22 21s-13-12-12-22c1-5 2-6 4-7Z"></path>
        </svg>
      </span>
      <div class="category-editorial-copy">
        <span class="category-editorial-eyebrow">{{ category.parent_id ? 'Subcategorie' : 'Categorie' }}</span>
        <h1 id="category-title">{{ category.name }}</h1>
        {% if category.description %}<p>{{ category.description }}</p>{% endif %}
      </div>
      {% if category.image_path %}
        <figure class="shop-cat-portrait category-editorial-portrait">
          <img src="{{ url(category.image_path) }}" alt="{{ category.image_alt ?: category.name }}" width="320" height="320" loading="eager" decoding="async">
        </figure>
      {% endif %}
    </header>

    {% include 'storefront/components/shop-catalog.twig' %}
  </div>
{% endblock %}
