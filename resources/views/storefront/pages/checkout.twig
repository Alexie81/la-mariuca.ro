{% extends 'storefront/layouts/base.twig' %}
{% macro icon(name) %}<svg viewBox="0 0 24 24" aria-hidden="true">{% if name == 'arrow' %}<path d="M4 12h15m-6-6 6 6-6 6"/>{% elseif name == 'bag' %}<path d="M5 7h14l1 14H4L5 7ZM9 8V6a3 3 0 0 1 6 0v2"/>{% elseif name == 'pin' %}<path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>{% elseif name == 'truck' %}<path d="M3 5h11v12H3zM14 9h4l3 5v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>{% elseif name == 'card' %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h4"/>{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>{% elseif name == 'lock' %}<rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>{% elseif name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>{% elseif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{% elseif name == 'heart' %}<path d="M20.8 5.6a5.5 5.5 0 0 0-8.8 1 5.5 5.5 0 0 0-8.8-1C-1 10.2 6 16.6 12 21c6-4.4 13-10.8 8.8-15.4Z"/>{% endif %}</svg>{% endmacro %}
{% block head %}
  <link rel="stylesheet" href="{{ url('assets/css/storefront/romania-locations.css') }}?v=20261103-locations3">
  <link rel="stylesheet" href="{{ url('assets/css/storefront/checkout.css') }}?v=20261103-checkout1">
{% endblock %}
{% block body_class %}checkout-page-body{% endblock %}
{% block content %}
{% set profile = checkout_customer.profile|default({}) %}
{% set saved_address = checkout_customer.default_address.details|default({}) %}
{% set values = checkout_has_old_input|default(false) ? checkout_values : saved_address|merge({email: profile.email|default(''), first_name: saved_address.first_name|default(profile.first_name|default('')), last_name: saved_address.last_name|default(profile.last_name|default('')), phone: saved_address.phone|default(profile.phone|default(''))}) %}
<div class="checkout-page container">
  <a class="checkout-back" href="{{ url('cos/') }}">{{ _self.icon('arrow') }} Înapoi la coș</a>
  <header class="checkout-intro">
    <div><span class="checkout-eyebrow">Ultimul pas, înainte de bucurie</span><h1>Finalizare comandă</h1><p>Câteva detalii și pregătim alegerile tale cu drag.</p></div>
    <ol class="checkout-progress" aria-label="Pașii comenzii"><li class="is-done"><span>{{ _self.icon('check') }}</span>Coșul tău</li><li class="is-current" aria-current="step"><span>2</span>Finalizare</li><li><span>3</span>Confirmare</li></ol>
  </header>
  {% if cart.items %}
  <div class="checkout-layout">
    <form id="checkout-form" class="checkout-form" action="{{ url('finalizare-comanda/') }}" method="post" data-checkout-form>
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="idempotency_key" value="{{ idempotency_key }}">
      {% if checkout_customer %}
        <div class="checkout-account-message is-connected"><span>{{ _self.icon('check') }}</span><div><strong>Bine ai revenit, {{ profile.first_name }}!</strong><p>Datele tale sunt deja completate. Le poți modifica pentru această comandă.</p></div></div>
      {% elseif not user %}
        <div class="checkout-account-message"><span>{{ _self.icon('heart') }}</span><div><strong>Ai deja un cont?</strong><p><a href="{{ url('cont/autentificare/') }}?continuare=comanda">Conectează-te</a> sau <a href="{{ url('cont/inregistrare/') }}?continuare=comanda">creează un cont</a> pentru a folosi adresele salvate.</p><small>Poți continua și fără cont.</small></div></div>
      {% endif %}
      <section class="checkout-section" aria-labelledby="checkout-contact-title">
        <header class="checkout-section-head"><span class="checkout-step">01</span><div><h2 id="checkout-contact-title">Să ne cunoaștem</h2><p>Aici îți trimitem detaliile comenzii.</p></div><span class="checkout-section-icon">{{ _self.icon('heart') }}</span></header>
        <div class="checkout-fields">
          <label for="checkout-first-name">Prenume <span>*</span><input id="checkout-first-name" name="first_name" value="{{ values.first_name|default('') }}" autocomplete="given-name" maxlength="100" placeholder="Prenumele tău" required></label>
          <label for="checkout-last-name">Nume <span>*</span><input id="checkout-last-name" name="last_name" value="{{ values.last_name|default('') }}" autocomplete="family-name" maxlength="100" placeholder="Numele tău" required></label>
          <label for="checkout-email">Email <span>*</span><input id="checkout-email" type="email" name="email" value="{{ values.email|default('') }}" autocomplete="email" maxlength="254" placeholder="nume@exemplu.ro" required><small>Confirmarea comenzii ajunge aici.</small></label>
          <label for="checkout-phone">Telefon <span>*</span><input id="checkout-phone" type="tel" name="phone" value="{{ values.phone|default('') }}" autocomplete="tel" maxlength="30" placeholder="07xx xxx xxx" required><small>Pentru detaliile livrării.</small></label>
        </div>
      </section>
      <section class="checkout-section checkout-address-section" aria-labelledby="checkout-address-title">
        <header class="checkout-section-head"><span class="checkout-step">02</span><div><h2 id="checkout-address-title">Unde trimitem bucuria?</h2><p>Completează adresa la care vrei să ajungă comanda.</p></div><span class="checkout-section-icon">{{ _self.icon('pin') }}</span></header>
        {% if checkout_customer %}
          <label class="checkout-saved-label" for="checkout-saved-address">Adresele tale
            <select id="checkout-saved-address" name="saved_address_id" data-checkout-saved-address>
              <option value=""{{ checkout_has_old_input|default(false) and not values.saved_address_id|default('') ? ' selected' : '' }}>Folosește o adresă nouă</option>
              {% for saved in checkout_customer.addresses %}
                <option value="{{ saved.id }}"{{ (checkout_has_old_input|default(false) ? values.saved_address_id|default('') == saved.id : saved.is_default) ? ' selected' : '' }} data-first-name="{{ saved.details.first_name|default(profile.first_name|default('')) }}" data-last-name="{{ saved.details.last_name|default(profile.last_name|default('')) }}" data-phone="{{ saved.details.phone|default(profile.phone|default('')) }}" data-address="{{ saved.details.address|default('') }}" data-city="{{ saved.details.city|default('') }}" data-county="{{ saved.details.county|default('') }}" data-postal-code="{{ saved.details.postal_code|default('') }}">{{ saved.label }} · {{ saved.details.city|default('') }}{{ saved.is_default ? ' · implicită' : '' }}</option>
              {% endfor %}
            </select>
          </label>
        {% endif %}
        <div class="checkout-postal" data-postal-lookup data-endpoint="{{ url('finalizare-comanda/cod-postal/') }}">
          <div class="checkout-postal-copy"><span>{{ _self.icon('search') }}</span><div><strong>Începe cu codul poștal</strong><p>Te ajută să completezi județul și localitatea.</p></div></div>
          <div class="checkout-postal-control"><label for="checkout-postal">Cod poștal <span>*</span></label><div><input id="checkout-postal" name="postal_code" value="{{ values.postal_code|default('') }}" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="6 cifre" required aria-describedby="checkout-postal-status"><button type="button" data-postal-search hidden>Caută {{ _self.icon('arrow') }}</button></div></div>
          <p id="checkout-postal-status" class="checkout-postal-status" data-postal-status role="status" aria-live="polite">Poți alege și manual județul și localitatea de mai jos.</p>
          <div class="checkout-postal-results" data-postal-results hidden></div>
          <small class="checkout-postal-source">Date poștale: <a href="https://www.geonames.org/" target="_blank" rel="noopener noreferrer">GeoNames</a> · strada și numărul se completează separat.</small>
        </div>
        <div class="checkout-fields">
          {% include 'storefront/partials/romania-location-fields.twig' with { location_id: 'checkout-address', county_value: values.county|default(''), city_value: values.city|default('') } %}
          <label for="checkout-street" class="checkout-full">Stradă și număr <span>*</span><input id="checkout-street" name="address" value="{{ values.address|default('') }}" autocomplete="street-address" maxlength="500" placeholder="Stradă, număr, bloc, scară, etaj, apartament" required><small>Adaugă toate detaliile necesare pentru o livrare ușoară.</small></label>
        </div>
        {% if checkout_customer %}
          <div class="checkout-save-address" data-checkout-save-address data-endpoint="{{ url('finalizare-comanda/adresa/') }}" hidden>
            <div><strong>Păstrează această adresă în cont</strong><p>O vei putea alege rapid la următoarea comandă.</p></div>
            <label for="checkout-address-label">Denumire adresă <small>opțional</small><input id="checkout-address-label" type="text" maxlength="80" placeholder="Acasă, la bunici, la birou…" data-address-label></label>
            <button type="button" data-address-save-button>{{ _self.icon('pin') }} Salvează adresa</button>
            <p role="status" aria-live="polite" data-address-save-status></p>
          </div>
          <noscript><p class="checkout-noscript">Poți salva o adresă nouă din <a href="{{ url('cont/#adrese') }}">contul tău</a> sau poți folosi direct adresa completată pentru această comandă.</p></noscript>
        {% endif %}
      </section>
      <section class="checkout-section" aria-labelledby="checkout-shipping-title">
        <header class="checkout-section-head"><span class="checkout-step">03</span><div><h2 id="checkout-shipping-title">Cum ajunge la tine?</h2><p>Alege metoda de livrare potrivită.</p></div><span class="checkout-section-icon">{{ _self.icon('truck') }}</span></header>
        {% if shipping_methods|default([]) %}
          <div class="checkout-options" role="radiogroup" aria-labelledby="checkout-shipping-title">
            {% for method in shipping_methods %}
              {% set estimate = method.estimated_min_days == method.estimated_max_days ? method.estimated_min_days ~ (method.estimated_min_days == 1 ? ' zi lucrătoare' : ' zile lucrătoare') : method.estimated_min_days ~ '–' ~ method.estimated_max_days ~ ' zile lucrătoare' %}
              <label class="checkout-option"><input type="radio" name="shipping_method_id" value="{{ method.id }}"{{ method.id == selected_shipping_method_id|default(default_shipping_method_id) ? ' checked' : '' }} data-shipping-name="{{ method.name }}" data-shipping-bani="{{ method.shipping_bani|default(method.price_bani) }}" data-total-bani="{{ method.total_bani|default(cart.total_bani + method.price_bani) }}" required><span class="checkout-option-content"><i class="checkout-option-icon">{{ _self.icon(method.type == 'pickup' or method.type == 'locker' ? 'pin' : 'truck') }}</i><span class="checkout-option-copy"><strong>{{ method.name }}</strong>{% if method.description %}<small>{{ method.description }}</small>{% endif %}<em>{{ _self.icon('clock') }}{{ estimate }}</em></span><span class="checkout-option-price">{% if method.shipping_discount_bani|default(0) %}<del>{{ money(method.price_bani) }}</del>{% endif %}<b>{{ method.shipping_bani|default(method.price_bani) == 0 ? 'Gratuit' : money(method.shipping_bani|default(method.price_bani)) }}</b></span><i class="checkout-radio">{{ _self.icon('check') }}</i></span></label>
            {% endfor %}
          </div>
        {% else %}<p class="checkout-notice" role="alert">Livrarea nu este disponibilă momentan. Te rugăm să revii puțin mai târziu.</p>{% endif %}
      </section>
      <section class="checkout-section" aria-labelledby="checkout-payment-title">
        <header class="checkout-section-head"><span class="checkout-step">04</span><div><h2 id="checkout-payment-title">Cum dorești să plătești?</h2><p>Tu alegi varianta care îți este comodă.</p></div><span class="checkout-section-icon">{{ _self.icon('card') }}</span></header>
        <div class="checkout-options checkout-payment-options" role="radiogroup" aria-labelledby="checkout-payment-title">
          <label class="checkout-option"><input type="radio" name="payment_method" value="cod"{{ values.payment_method|default('cod') != 'stripe' or not stripe_enabled ? ' checked' : '' }} required><span class="checkout-option-content"><i class="checkout-option-icon">{{ _self.icon('bag') }}</i><span class="checkout-option-copy"><strong>Ramburs</strong><small>Plătești la primirea comenzii.</small></span><i class="checkout-radio">{{ _self.icon('check') }}</i></span></label>
          <label class="checkout-option{{ not stripe_enabled ? ' is-unavailable' : '' }}"><input type="radio" name="payment_method" value="stripe"{{ values.payment_method|default('cod') == 'stripe' and stripe_enabled ? ' checked' : '' }}{{ not stripe_enabled ? ' disabled' : '' }}><span class="checkout-option-content"><i class="checkout-option-icon">{{ _self.icon('card') }}</i><span class="checkout-option-copy"><strong>Card online</strong><small>{{ stripe_enabled ? 'Plată securizată prin Stripe.' : 'Momentan indisponibil.' }}</small></span><i class="checkout-radio">{{ _self.icon('check') }}</i></span></label>
        </div>
      </section>
    </form>
    <aside class="checkout-summary" aria-labelledby="checkout-summary-title">
      <div class="checkout-summary-heading"><span class="checkout-eyebrow">Pregătite cu drag</span><h2 id="checkout-summary-title">Comanda ta</h2><span class="checkout-item-count">{{ cart.count }} {{ cart.count == 1 ? 'produs' : 'produse' }}</span></div>
      <div class="checkout-products">
        {% for item in cart.items %}<article class="checkout-product"><a class="checkout-product-image" href="{{ url('produs/' ~ item.slug ~ '/') }}" aria-label="Vezi {{ item.name }}">{% if item.image_path %}<img src="{{ url(item.image_path) }}" alt="" width="68" height="80" loading="lazy">{% else %}{{ _self.icon('bag') }}{% endif %}<span>{{ item.quantity }}</span></a><div><h3>{{ item.name }}</h3>{% if item.option_summary %}<p>{{ item.option_summary }}</p>{% endif %}{% if item.personalization %}{% for key, value in item.personalization %}<p>{{ key }}: {{ value }}</p>{% endfor %}{% endif %}<strong>{{ money(item.line_total_bani) }}</strong></div></article>{% endfor %}
      </div>
      <a class="checkout-edit-cart" href="{{ url('cos/') }}">Modifică produsele din coș {{ _self.icon('arrow') }}</a>
      <div class="checkout-calculation"><div><span>Subtotal produse</span><strong>{{ money(cart.subtotal_bani) }}</strong></div>{% if cart.discount_bani %}<div class="checkout-discount"><span>Reducere <small>{{ cart.discount_label|default('') }}</small></span><strong>−{{ money(cart.discount_bani) }}</strong></div>{% endif %}<div><span>Livrare <small data-checkout-shipping-name>{% for method in shipping_methods %}{% if method.id == selected_shipping_method_id|default(default_shipping_method_id) %}{{ method.name }}{% endif %}{% endfor %}</small></span><strong data-checkout-shipping>{{ shipping_methods|default([]) ? (checkout_totals.shipping_bani|default(0) == 0 ? 'Gratuit' : money(checkout_totals.shipping_bani)) : 'Indisponibilă' }}</strong></div></div>
      <div class="checkout-total" aria-live="polite" aria-atomic="true"><div><strong>Total de plată</strong><small>Produse și livrare incluse</small></div><strong data-checkout-total>{{ money(checkout_totals.total_bani|default(cart.total_bani)) }}</strong></div>
      <noscript><div class="checkout-nojs-total"><p>Totalul afișat include metoda de livrare selectată inițial. Dacă o schimbi, actualizează totalul înainte de a plasa comanda.</p><button type="submit" name="checkout_action" value="recalculate" form="checkout-form" formnovalidate>Actualizează totalul</button></div></noscript>
      <div class="checkout-confirmation">
        <label class="checkout-consent"><input type="checkbox" name="terms" value="1" form="checkout-form" required{{ values.terms|default('') ? ' checked' : '' }}><span>Am citit și accept <a href="{{ url('pagina/termeni-si-conditii/') }}" target="_blank" rel="noopener">termenii și condițiile</a>. <b>*</b></span></label>
        <label class="checkout-consent"><input type="checkbox" name="marketing" value="1" form="checkout-form"{{ values.marketing|default('') ? ' checked' : '' }}><span>Vreau noutăți și oferte pe email. <small>Opțional</small></span></label>
        <button class="checkout-submit" form="checkout-form" type="submit"{{ shipping_methods|default([]) ? '' : ' disabled' }}><span>Plasează comanda</span>{{ _self.icon('arrow') }}</button>
        <p class="checkout-obligation">Prin plasarea comenzii îți asumi obligația de plată.</p>
        <span class="checkout-security">{{ _self.icon('lock') }} Datele tale sunt folosite pentru comandă</span>
      </div>
      <div class="checkout-care">{{ _self.icon('heart') }}<p>Alese cu grijă.<br><strong>Pregătite pentru micile bucurii.</strong></p></div>
    </aside>
  </div>
  {% else %}<div class="checkout-empty">{{ _self.icon('bag') }}<h2>Un coș pregătit pentru bucurii</h2><p>Adaugă produsele preferate și revino aici pentru a finaliza comanda.</p><a class="checkout-submit" href="{{ url('magazin/') }}">Descoperă colecțiile {{ _self.icon('arrow') }}</a></div>{% endif %}
</div>
<script type="module" src="{{ url('assets/js/storefront/checkout-account.js') }}?v=20261103-checkout1"></script>
{% endblock %}
