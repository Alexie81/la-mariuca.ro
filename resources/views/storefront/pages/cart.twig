{% extends 'storefront/layouts/base.twig' %}
{% block content %}<div class="container page-shell narrow"><h1>Coșul meu</h1>{% if cart.items %}
<div class="cart-list">{% for item in cart.items %}<article class="cart-item"><div><h2><a href="{{ url('produs/' ~ item.slug ~ '/') }}">{{ item.name }}</a></h2><p>{{ item.option_summary }} · SKU {{ item.sku }}</p>{% for key,value in item.personalization %}<small>{{ key }}: {{ value }}</small>{% endfor %}</div><strong>{{ money(item.line_total_bani) }}</strong><form action="{{ url('cos/actualizeaza/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="item_id" value="{{ item.id }}"><label for="qty-{{ item.id }}">Cantitate</label><input id="qty-{{ item.id }}" type="number" name="quantity" min="0" max="20" value="{{ item.quantity }}"><button type="submit">Actualizează</button></form></article>{% endfor %}</div>
<form class="coupon-form" action="{{ url('cos/cupon/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><label for="coupon_code">Cupon</label><input id="coupon_code" name="coupon_code" value="{{ cart.coupon.code|default('') }}" placeholder="Cod cupon"><button type="submit">{{ cart.coupon ? 'Elimină sau schimbă' : 'Aplică' }}</button></form>
<div class="cart-summary"><span>Subtotal</span><strong>{{ money(cart.subtotal_bani) }}</strong>{% if cart.discount_bani %}<span>Reducere {{ cart.coupon.code }}</span><strong>−{{ money(cart.discount_bani) }}</strong><span>După reducere</span><strong>{{ money(cart.total_bani) }}</strong>{% endif %}<small>Transportul și costul final se calculează la checkout după reducere.</small><a class="button" href="{{ url('finalizare-comanda/') }}">Continuă spre finalizare</a></div>
{% else %}<div class="empty"><h2>Coșul este gol</h2><p>Adaugă un produs pentru a începe comanda.</p><a class="button" href="{{ url('') }}">Descoperă produsele</a></div>{% endif %}</div>{% endblock %}
