{% import 'admin/partials/nir-ui.twig' as n %}
<nav class="iv-section-nav" aria-label="În această factură"><a href="#date-factura">{{ n.icon('document') }}Datele facturii</a><a href="#produse-factura">{{ n.icon('box') }}Produse <b>{{ doc.lines|length }}</b></a><a href="#istoric-factura">{{ n.icon('clock') }}Istoric</a></nav><div class="iv-detail-grid"><div class="iv-detail-main"><section class="iv-panel" id="date-factura"><header class="iv-section-head"><div><span class="iv-eyebrow">Partenerii documentului</span><h2>Emitent și client</h2></div>{{ n.icon('shield') }}</header><div class="iv-parties"><article><small>Furnizor</small><h3>{{ doc.snapshot.company.trade_name|default(doc.snapshot.company.legal_name) }}</h3><p>{{ doc.snapshot.company.legal_name }}</p><dl><div><dt>CUI</dt><dd>{{ doc.snapshot.company.tax_id }}</dd></div><div><dt>Sediu</dt><dd>{{ doc.snapshot.company.registered_address }}<br>{{ doc.snapshot.company.city }}, {{ doc.snapshot.company.county }}</dd></div><div><dt>Contact</dt><dd>{{ doc.snapshot.company.email }}<br>{{ doc.snapshot.company.phone }}</dd></div></dl></article><article><small>{{ doc.customer.type == 'company' ? 'Client · persoană juridică' : 'Client · persoană fizică' }}</small><h3>{{ doc.customer.name }}</h3>{% if doc.customer.type == 'company' %}<p>{{ doc.customer.company.name|default(doc.customer.company.company_name) }} · {{ doc.customer.company.tax_id|default(doc.customer.company.cui) }}</p>{% endif %}<dl><div><dt>Email</dt><dd><a href="mailto:{{ doc.customer.email }}">{{ doc.customer.email }}</a><button class="iv-icon" data-iv-copy="{{ doc.customer.email }}" aria-label="Copiază emailul">{{ n.icon('copy') }}</button></dd></div><div><dt>Telefon</dt><dd>{{ doc.customer.phone }}<button class="iv-icon" data-iv-copy="{{ doc.customer.phone }}" aria-label="Copiază telefonul">{{ n.icon('copy') }}</button></dd></div><div><dt>Facturare</dt><dd>{{ doc.customer.address.address|default(doc.customer.address.street|default('')) }}<br>{{ doc.customer.address.city|default('') }}, {{ doc.customer.address.county|default('') }} {{ doc.customer.address.postal_code|default('') }}</dd></div></dl></article></div></section>
<section class="iv-panel iv-products-panel" id="produse-factura"><header class="iv-section-head"><div><span class="iv-eyebrow">Pozițiile facturii</span><h2>{{ negative ? 'Produsele și valorile returnate' : 'Ce conține factura' }}</h2></div><span class="iv-chip">{{ doc.lines|length }} {{ doc.lines|length == 1 ? 'poziție' : 'poziții' }}</span></header><div class="iv-lines">{% for line in doc.lines %}<article class="iv-line"><div class="iv-line-main"><button class="iv-product-image" type="button"{% if line.snapshot.image_data|default('') %} data-iv-image="{{ line.snapshot.image_data }}" data-title="{{ line.name }}" aria-label="Mărește imaginea {{ line.name }}"{% else %} disabled aria-label="Fără imagine"{% endif %}>{% if line.snapshot.image_data|default('') %}<img src="{{ line.snapshot.image_data }}" alt=""><span>{{ n.icon('search') }}</span>{% else %}{{ n.icon(line.kind == 'product' ? 'box' : 'document') }}{% endif %}</button><div class="iv-line-title"><h3>{{ line.name }}</h3><small>{{ line.snapshot.variant|default('') }} {{ line.sku }}</small><div class="iv-line-meta"><span class="iv-chip">{{ line.quantity_display }} {{ line.unit }}</span>{% if line.snapshot.product_slug|default('') %}<a href="{{ url('produs/'~line.snapshot.product_slug~'/') }}" target="_blank" rel="noopener">Vezi produsul {{ n.icon('external') }}</a>{% endif %}</div></div><div class="iv-line-price"><strong>{{ line.total_display }}</strong><small>cu TVA inclus</small></div></div><details class="iv-line-details"><summary>{{ doc.can_view_acquisition_cost and line.kind == 'product' ? 'Preț, TVA și cost de achiziție' : 'Preț și TVA' }} {{ n.icon('chevron') }}</summary><div class="iv-line-breakdown"><span>Preț unitar fără TVA <b>{{ line.unit_net|decimal_ro }} {{ doc.currency }}</b></span><span>Reducere <b>{{ (line.discount_bani/100)|number_format(2,',','.') }} {{ doc.currency }}</b></span><span>TVA {{ (line.vat_basis_points/100)|decimal_ro }}% <b>{{ (line.tax_bani/100)|number_format(2,',','.') }} {{ doc.currency }}</b></span><span>Fără TVA <b>{{ (line.net_bani/100)|number_format(2,',','.') }} {{ doc.currency }}</b></span></div>{% include 'admin/invoices/acquisition-trace.twig' %}{% if line.pending_units > 0 %}<p class="iv-soft-note">{{ n.icon('clock') }}{{ (line.pending_units/10000)|decimal_ro }} buc. așteaptă înregistrarea achiziției pentru stabilirea costului. Cantitatea a fost deja scăzută.</p>{% endif %}</details></article>{% endfor %}</div></section>
{% if doc.receipt %}<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Retur verificat</span><h2>Ce a revenit de la client</h2><p>{{ doc.receipt.received_at|date('d.m.Y, H:i','Europe/Bucharest') }}</p></div>{{ n.icon('box') }}</header><div class="iv-lines">{% for received in doc.receipt.lines %}<article class="iv-line"><h3>{{ received.name }}</h3><div class="iv-line-breakdown"><span>Primite efectiv <b>{{ (received.received_units/10000)|decimal_ro }} buc.</b></span><span>Bune pentru stoc <b>{{ (received.restock_units/10000)|decimal_ro }} buc.</b></span><span>Nevandabile, evidență separată <b>{{ (received.quarantine_units/10000)|decimal_ro }} buc.</b></span><span>Nu au fost primite <b>{{ (received.missing_units/10000)|decimal_ro }} buc.</b></span></div></article>{% endfor %}{% if doc.receipt.notes %}<p class="iv-preserve">{{ doc.receipt.notes }}</p>{% endif %}</div></section>{% endif %}{% include 'admin/invoices/requests.twig' with {can_manage:false} %}{% if doc.parent or doc.related %}<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Același dosar</span><h2>Documente asociate</h2></div>{{ n.icon('link') }}</header><div class="iv-related">{% if doc.parent %}<a href="{{ url('admin/facturi/'~doc.parent.id~'/') }}">{{ n.icon('document') }}<span><small>Document original</small><strong>{{ doc.parent.series_code }} {{ doc.parent.number }}</strong><small>{{ doc.parent.issued_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small></span>{{ n.icon('arrow') }}</a>{% endif %}{% for related in doc.related %}<a href="{{ url('admin/facturi/'~related.id~'/') }}">{{ n.icon(related.gross_bani < 0 ? 'return' : 'document') }}<span><small>{{ related.kind_label }}</small><strong>{{ related.display_number }}</strong><small>{{ related.date_display }}</small></span><b>{{ related.total_display }}</b>{{ n.icon('arrow') }}</a>{% endfor %}</div></section>{% endif %}
{% if doc.notes or doc.reason %}<section class="iv-panel iv-padded"><span class="iv-eyebrow">Mențiuni</span>{% if doc.reason %}<h3>Motivul documentului</h3><p class="iv-preserve">{{ doc.reason }}</p>{% endif %}{% if doc.notes %}<h3>Note pe factură</h3><p class="iv-preserve">{{ doc.notes }}</p>{% endif %}</section>{% endif %}
<section class="iv-panel" id="istoric-factura"><header class="iv-section-head"><div><span class="iv-eyebrow">Pas cu pas</span><h2>Istoricul facturii</h2></div>{{ n.icon('clock') }}</header><ol class="iv-history">{% for event in doc.audit|reverse %}<li><span>{{ n.icon(event.action == 'issued' ? 'document' : (event.action == 'physically_received' ? 'box' : 'edit')) }}</span><div><strong>{{ {'issued':'Factura a fost emisă','edited':'Date actualizate','email_queued':'Email pus în așteptare','payment_recorded':'Plată / restituire înregistrată','physically_received':'Primirea produselor a fost verificată','public_link_created':'Link privat creat','public_link_revoked':'Link privat revocat','deleted':'Document eliminat','return_requested':'Solicitare de retur înregistrată','return_decided':'Solicitare de retur analizată','fiscal_queued':'Document pregătit pentru transmiterea fiscală','fiscal_attempted':'Transmitere fiscală inițiată','fiscal_result':'Răspuns fiscal înregistrat'}[event.action]|default('Activitate înregistrată') }}</strong><small>{{ event.created_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small>{% if event.reason %}<p>{{ event.reason }}</p>{% endif %}</div></li>{% endfor %}</ol></section></div>
<aside class="iv-detail-aside"><section class="iv-summary"><header><span>{{ n.icon('money') }}{{ negative ? 'Total retur / corecție' : 'Total factură' }}</span><strong>{{ doc.total_display }}</strong><p>{{ negative ? 'Documentul valoric nu restochează automat produsele.' : 'Valoarea păstrată la emiterea documentului.' }}</p></header><dl><div><dt>Fără TVA</dt><dd>{{ (doc.net_bani/100)|number_format(2,',','.') }}</dd></div><div><dt>TVA</dt><dd>{{ (doc.tax_bani/100)|number_format(2,',','.') }}</dd></div>{% if doc.discount_bani %}<div><dt>Reduceri incluse</dt><dd>{{ (doc.discount_bani/100)|number_format(2,',','.') }}</dd></div>{% endif %}<div><dt>{{ negative ? 'Restituit' : 'Încasat' }}</dt><dd>{{ ((negative ? doc.refunded_bani|default(0) : doc.paid_bani)/100)|number_format(2,',','.') }}</dd></div><div><dt>Scadență</dt><dd>{{ doc.due_date|date('d.m.Y') }}</dd></div></dl></section>
<section class="iv-assurance">{{ n.icon('shield') }}<div><strong>Datele istorice sunt protejate</strong><p>Schimbarea firmei, produselor sau seriei nu rescrie automat această factură.</p><small>{{ doc.fiscal_attempted_at ? 'Document blocat pentru modificări după transmiterea fiscală.' : 'Starea transmiterii este afișată în panoul SPV.' }}</small></div></section></aside></div>