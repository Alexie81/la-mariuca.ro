{% import 'admin/partials/nir-ui.twig' as n %}
<dialog class="iv-picker" data-iv-picker aria-labelledby="iv-picker-title">
  <header class="iv-picker-head"><span class="iv-mark">{{ n.icon('box') }}</span><div><span class="iv-eyebrow">Catalog La Măriuca</span><h2 id="iv-picker-title">Alege produsul</h2><p>Fotografia, mărimea și prețul te ajută să alegi varianta potrivită.</p></div><button type="button" class="iv-icon" data-iv-picker-close aria-label="Închide selectorul de produse">{{ n.icon('close') }}</button></header>
  <div class="iv-picker-search"><label for="iv-picker-query" class="iv-sr">Caută după nume sau SKU</label><div>{{ n.icon('search') }}<input type="search" id="iv-picker-query" data-iv-picker-query placeholder="Caută după nume sau SKU…" autocomplete="off" spellcheck="false"><button type="button" class="iv-icon" data-iv-picker-clear aria-label="Șterge căutarea" hidden>{{ n.icon('close') }}</button></div><p data-iv-picker-status role="status" aria-live="polite">Alege un produs pentru a-l adăuga.</p></div>
  <div class="iv-picker-scroll"><div class="iv-picker-results" data-iv-picker-results></div><button type="button" class="iv-btn iv-picker-more" data-iv-picker-more hidden>Arată mai multe produse {{ n.icon('chevron') }}</button></div>
  <footer><span>{{ n.icon('info') }}Prețul este preluat automat din catalog.</span><button type="button" class="iv-btn" data-iv-picker-close>Înapoi la editare</button></footer>
  <template data-iv-choice-template><button type="button" class="iv-product-choice"><span class="iv-choice-photo">{{ n.icon('image') }}<img hidden alt=""></span><span class="iv-choice-copy"><strong></strong><span class="iv-choice-variant"></span><small></small><b class="iv-choice-price"></b></span><span class="iv-choice-add">{{ n.icon('plus') }}</span></button></template>
</dialog>
