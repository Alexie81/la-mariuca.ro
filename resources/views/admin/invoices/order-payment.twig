{% import 'admin/partials/nir-ui.twig' as n %}
<input type="hidden" name="order_id" value="{{ edit_order.id }}"><input type="hidden" name="order_version" value="{{ edit_order.payment_version }}">
<section class="iv-payment-total"><span>{{ n.icon('money') }}Total de plată</span><strong>{{ money(edit_order.payment_total) }}</strong><small>Înregistrat până acum: {{ money(edit_order.cash.received) }}</small></section>
{% if edit_order.payment_method == 'cod' %}
<section class="iv-form-step"><header><div><h3>Starea încasării</h3><p>Alege situația reală a încasării ramburs.</p></div></header>
<div class="iv-payment-options">
{% for option in [{value:'pending',label:'Neplătită',help:'Nu s-a încasat nicio sumă.',icon:'clock'},{value:'partial',label:'Plătită parțial',help:'Ai primit o parte din total.',icon:'money'},{value:'paid',label:'Achitată integral',help:'Toată suma a fost încasată.',icon:'check'}] %}
<label class="iv-payment-option"><input type="radio" name="payment_status" value="{{ option.value }}" required{{ edit_order.payment_status == option.value ? ' checked' : '' }} data-iv-payment-state><span class="iv-payment-option__icon">{{ n.icon(option.icon) }}</span><span><strong>{{ option.label }}</strong><small>{{ option.help }}</small></span><i aria-hidden="true"></i></label>
{% endfor %}
</div>
<label class="iv-payment-partial" data-iv-payment-amount>Total primit până acum, Lei<input name="amount" inputmode="decimal" value="{{ (edit_order.cash.received/100)|number_format(2,'.','') }}"><small>Se folosește numai când alegi „Plătită parțial”.</small></label>
</section>
<div class="iv-soft-note">{{ n.icon('shield') }}Salvarea actualizează evidența plății și factura încă netransmisă. Nu încasează și nu transferă bani.</div>
{% else %}<div class="iv-notice iv-notice--inline">{{ n.icon('shield') }}<p>Starea plății cu cardul vine din Stripe. O plată reușită este marcată automat după confirmarea procesatorului.</p></div>{% endif %}
