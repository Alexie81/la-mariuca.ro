{% import 'admin/partials/nir-ui.twig' as n %}
<form method="post" action="{{ form_action }}" class="iv-form" data-iv-form data-kind="cancellation">
  <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="document_version" value="{{ plan.version }}"><input type="hidden" name="decision" value="{{ decision }}">
  <header class="iv-form-head"><span class="iv-mark">{{ n.icon('document') }}</span><div><span class="iv-eyebrow">{{ order.order_number }} · comandă anulată</span><h2>{{ decision == 'delete' ? 'Șterge factura emisă' : 'Emite factura de retur' }}</h2><p>Rezolvă documentele acestei anulări.</p></div><a class="iv-icon" href="{{ back_url }}" data-iv-close aria-label="Închide">{{ n.icon('close') }}</a></header>
  <div class="iv-form-body"><div class="iv-error" data-iv-errors role="alert" tabindex="-1" hidden></div>
    <section class="iv-payment-total"><span>{{ n.icon('document') }}{{ plan.documents|length == 1 ? 'Factura emisă' : 'Facturile emise' }}</span><strong>{% for document in plan.documents %}{{ document.number }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</strong><small>{{ order.first_name }} {{ order.last_name }}</small></section>
    <section class="iv-form-step"><h3>{{ decision == 'delete' ? 'Numărul devine disponibil' : 'Produsele se verifică separat' }}</h3><p>{{ decision == 'delete' ? 'Ștergem factura și anulăm ieșirea ei din stocul contabil. Comanda rămâne anulată.' : 'Factura inițială se păstrează. Emitem factura de retur pentru cantitățile rămase, apoi vei putea verifica produsele și genera NIR-ul. Comanda rămâne anulată și nu mai poate fi reluată.' }}</p><p>Restituirea efectivă a banilor se înregistrează separat.</p></section>
    {% if decision == 'credit' %}<label class="iv-edit-notify"><span class="iv-switch"><input type="checkbox" name="notify_customer" value="1" role="switch" checked><span></span></span><span><strong>Trimite factura de retur pe email</strong><small>Clientul o poate deschide direct din mesaj.</small></span></label>{% endif %}
  </div>
  <footer class="iv-form-footer"><a class="iv-btn" href="{{ back_url }}" data-iv-close>Renunță</a><span>Modificarea rămâne în istoric.</span><button type="submit" class="iv-btn iv-btn--primary">{{ n.icon('check') }}{{ decision == 'delete' ? 'Șterge document' : 'Emite factura de retur' }}</button></footer>
</form>
