{% import 'admin/partials/nir-ui.twig' as n %}{% set doc = invoice|default({}) %}{% set titles = {'issue':'Emite o factură','edit':'Actualizează factura','return':'Retur pentru client','correct':'Corectează prin documente noi','receive':'Verifică produsele primite','payment':(doc.gross_bani|default(0) < 0 ? 'Înregistrează restituirea' : 'Înregistrează încasarea'),'delete':'Ștergi această factură?','email':'Trimite factura clientului','link':'Link privat pentru client'} %}
{% set titles = titles|merge({'order-edit':'Pregătește comanda pentru facturare','request':'Înregistrează o solicitare de retur','decide':'Analizează solicitarea de retur','policy':'Condițiile solicitării de retur'}) %}
{% set descriptions = {'issue':'Alege comanda și verifică datele înainte de emitere.','edit':'Actualizează detaliile, păstrând seria și numărul.','return':'Selectează produsele și cantitățile returnate.','correct':'Păstrăm originalul și emitem documentele de corecție.','receive':'Verifică ce a sosit și ce poate reveni în stoc.','payment':'Păstrează evidența sumelor încasate sau restituite.','delete':'Verifică documentul înainte de eliminare.','email':'Factura PDF ajunge la adresa clientului.','link':'O copie a facturii, accesibilă printr-un link privat.','policy':'Alege când poate clientul solicita un retur.','request':'Notează produsele și motivul solicitării.','decide':'Alege cantitățile acceptate și explică diferențele.','order-edit':'Pregătește informațiile care vor apărea pe factură.'} %}
{% set choosing_order = action == 'issue' and not preview %}
<form method="{{ choosing_order ? 'get' : 'post' }}" action="{{ form_action }}" class="iv-form" data-iv-form data-kind="{{ action }}">{% if not choosing_order %}<input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="version" value="{{ doc.row_version|default(0) }}">
{% endif %}
<header class="iv-form-head"><span class="iv-mark">{{ n.icon(action in ['return','correct'] ? 'return' : (action == 'receive' ? 'box' : (action == 'delete' ? 'trash' : 'document'))) }}</span><div><span class="iv-eyebrow">{{ doc.display_number|default('Facturare La Măriuca') }}</span><h2>{{ titles[action] }}</h2><p>{{ descriptions[action] }}</p></div><a class="iv-icon" href="{{ back_url }}" data-iv-close aria-label="Închide">{{ n.icon('close') }}</a></header>
<div class="iv-form-body"><div class="iv-error" data-iv-errors role="alert" tabindex="-1" hidden></div>
{% if action == 'policy' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('info') }}<p>Aceste setări stabilesc disponibilitatea formularului online. Cererile deja înregistrate rămân în istoric și se analizează individual.</p></div>
<label>Termen după livrare, zile<input type="number" name="days" min="1" max="365" required value="{{ return_policy.days }}"></label>
<label class="iv-choice"><input type="checkbox" name="allow_companies" value="1"{{ return_policy.allow_companies ? ' checked' : '' }}>Permite solicitări pentru achiziții pe firmă</label>
<label class="iv-choice"><input type="checkbox" name="allow_personalized" value="1"{{ return_policy.allow_personalized ? ' checked' : '' }}>Permite solicitări pentru produse personalizate</label>
{% elseif action == 'order-edit' %}
<section class="iv-form-step"><header><b>1</b><div><h3>Datele clientului</h3><p>Corectează datele înainte de emiterea facturii.</p></div></header>{% include 'admin/invoices/billing-fields.twig' %}</section>{% include 'admin/invoices/order-items.twig' %}
{% elseif action == 'decide' %}
<input type="hidden" name="return_request_id" value="{{ return_request.id }}"><div class="iv-notice iv-notice--inline">{{ n.icon('return') }}<div><strong>Mesajul clientului</strong><p>{{ return_request.reason }}</p><small>{{ return_request.created_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small></div></div>
{% for line in return_request.details.lines %}<section class="iv-form-step"><h3>{{ line.name }}</h3><p>{{ line.sku }} · {{ line.quantity_units/10000 }} buc. solicitate</p><div class="iv-fields"><label>Cantitate acceptată<input type="number" name="decisions[{{ line.line_id }}][quantity]" min="0" max="{{ line.quantity_units/10000 }}" step="1" value="{{ line.quantity_units/10000 }}" required></label><label>Motivul refuzului / observații<input name="decisions[{{ line.line_id }}][reason]" placeholder="Obligatoriu dacă accepți mai puține bucăți" maxlength="500"></label></div></section>{% endfor %}
<label class="iv-choice"><input type="checkbox" name="refund_shipping" value="1">Restituie și livrarea inițială, numai la retur integral</label><div class="iv-fields"><label>Cost reținut, Lei<input name="retention" value="0" inputmode="decimal"></label><label>Denumirea costului<input name="retention_name" value="Transport retur"></label></div>
<p class="iv-soft-note">Cantitate 0 înseamnă refuz pentru acel produs. Un refuz integral nu emite factură de retur.</p>
{% elseif action == 'request' %}
<section class="iv-form-step"><h3>Produsele solicitate</h3>{% for line in doc.lines %}{% if line.kind == 'product' and line.available_units > 0 %}<div class="iv-select-line"><label class="iv-switch"><input type="checkbox" role="switch" data-iv-select aria-label="Selectează {{ line.name }}"><span></span></label><div><strong>{{ line.name }}</strong><small>{{ line.sku }}</small></div><label>Cantitate<input name="quantities[{{ line.id }}]" type="number" min="0" max="{{ line.available_units/10000 }}" step="1" value="0" data-iv-quantity data-default="{{ line.available_units/10000 }}"></label></div>{% endif %}{% endfor %}</section>
{% if doc.payment_method == 'stripe' %}<p>Restituire către metoda inițială de plată.</p>{% else %}<input type="hidden" name="refund_method" value="bank"><div class="iv-fields"><label>IBAN<input name="iban" required></label><label>Titularul contului<input name="holder" required></label></div>{% endif %}
{% elseif action == 'issue' %}
<section class="iv-form-step"><header><b>1</b><div><h3>Alege comanda</h3><p>Poți factura comenzile ramburs și comenzile achitate online.</p></div></header><label>Comanda<select name="order_id" required data-iv-order data-preview-url="{{ url('admin/facturi/emite/') }}"><option value="">Selectează o comandă</option>{% for order in orders %}<option value="{{ order.id }}"{{ order_id == order.id ? ' selected' : '' }}>{{ order.order_number }} · {{ order.first_name }} {{ order.last_name }} · {{ (order.total_bani/100)|number_format(2,',','.') }} Lei</option>{% endfor %}</select></label>{% if not orders %}<p class="iv-soft-note">Nu sunt comenzi eligibile fără factură.</p>{% endif %}<label>Gestiune<select name="warehouse_id" required>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}"{{ (warehouse_id ? warehouse.id == warehouse_id : warehouse.is_default) ? ' selected' : '' }}>{{ warehouse.name }}</option>{% endfor %}</select><small>De aici se înregistrează ieșirea contabilă a produselor.</small></label></section>
{% if preview %}<section class="iv-form-step"><header><b>2</b><div><h3>Verifică datele clientului</h3><p>Aceste date vor rămâne în factura emisă.</p></div></header>{% include 'admin/invoices/billing-fields.twig' %}</section><section class="iv-form-step"><header><b>3</b><div><h3>Rezumat înainte de emitere</h3><p>Prețurile și reducerile provin din comanda salvată.</p></div></header>{% for line in preview.lines %}<div class="iv-preview-line"><span>{{ line.name }}<small>{{ (line.quantity_units/10000)|decimal_ro }} {{ line.unit }} · {{ line.sku }}</small></span><strong>{{ (line.gross_bani/100)|number_format(2,',','.') }} Lei</strong></div>{% endfor %}<div class="iv-soft-note">{{ n.icon('shield') }}Numărul se atribuie automat. O comandă primește o singură factură inițială.</div></section>{% endif %}
{% elseif action in ['edit','correct'] %}
{% if action == 'correct' %}<div class="iv-notice iv-notice--inline">{{ n.icon('info') }}<p>Factura originală rămâne în istoric. Se emit un storno și o factură corectată, cu numere noi. Dacă produsele nu se întorc fizic, nu înregistra o primire în stoc.</p></div>{% endif %}
<section class="iv-form-step"><header><b>1</b><div><h3>Datele de facturare</h3><p>{{ action == 'edit' ? 'Seria și numărul rămân aceleași.' : 'Datele corecte apar pe documentul nou.' }}</p></div></header>{% include 'admin/invoices/billing-fields.twig' %}</section>
{% if action == 'correct' %}<section class="iv-form-step"><h3>Pozițiile de corectat</h3><p>Selectează cantitățile greșite; celelalte rămân pe factura originală. Mai jos ajustezi comanda completă.</p><input type="hidden" name="quantities[0]" value="0">{% for line in doc.lines %}<div class="iv-select-line"><label class="iv-switch"><input type="checkbox" role="switch" data-iv-select aria-label="Corectează {{ line.name }}"><span></span></label><div><strong>{{ line.name }}</strong><small>{{ line.sku }}</small></div><label>Cantitate<input type="number" name="quantities[{{ line.id }}]" min="0" max="{{ line.quantity_units/10000 }}" step="0.0001" value="0" data-iv-quantity data-default="{{ line.quantity_units/10000 }}"></label></div>{% endfor %}</section>{% endif %}
{% include 'admin/invoices/order-items.twig' %}{% if action == 'edit' %}<label>Note pe factură<textarea name="notes" rows="3" maxlength="5000">{{ doc.notes }}</textarea></label>{% endif %}
{% elseif action == 'return' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('info') }}<p>Se emite o factură cu valorile returnate. Produsele revin în stoc doar după verificarea primirii lor, într-un pas separat.</p></div>
<section class="iv-form-step"><header><b>1</b><div><h3>Ce returnează clientul?</h3><p>Activează pozițiile și alege cantitățile. Folosim prețurile și reducerile originale.</p></div></header><div class="iv-select-lines">{% for line in doc.lines %}{% if line.available_units > 0 %}<div class="iv-select-line"><label class="iv-switch"><input type="checkbox" role="switch" data-iv-select aria-label="Returnează {{ line.name }}"><span></span></label><div><strong>{{ line.name }}</strong><small>{{ line.sku }} · {{ (line.available_units/10000)|decimal_ro }} {{ line.unit }} disponibile</small>{% if line.kind == 'shipping' %}<small>Livrarea poate fi restituită la returul integral.</small>{% endif %}</div><label>Cantitate<input name="quantities[{{ line.id }}]" type="number" min="0" max="{{ line.available_units/10000 }}" step="0.0001" value="0" data-iv-quantity data-default="{{ line.available_units/10000 }}"></label></div>{% endif %}{% endfor %}</div></section><section class="iv-form-step"><header><b>2</b><div><h3>Cost reținut, dacă este cazul</h3><p>Lasă zero dacă nu se reține niciun cost din valoarea returului.</p></div></header><div class="iv-fields"><label>Denumirea costului<input name="retention_name" maxlength="200" placeholder="De exemplu, transportul returului"></label><label>Valoare, Lei<input name="retention" inputmode="decimal" value="0"></label></div></section>
{% elseif action == 'receive' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('box') }}<p>Verifică produsele ajunse efectiv. Doar cantitatea «Bune pentru stoc» revine în evidență. Diferența rămâne separată ca produse nevandabile.</p></div><div class="iv-receive-lines">{% for line in doc.lines %}{% if line.kind == 'product' and line.quantity_units < 0 %}<section class="iv-form-step"><h3>{{ line.name }}</h3><p>{{ line.sku }} · Retur: {{ (line.quantity_units|abs/10000)|decimal_ro }} {{ line.unit }}</p><div class="iv-fields"><label>Primite efectiv<input type="number" name="received[{{ line.id }}]" value="0" min="0" max="{{ line.quantity_units|abs/10000 }}" step="0.0001" required></label><label>Bune pentru stoc<input type="number" name="restock[{{ line.id }}]" value="0" min="0" max="{{ line.quantity_units|abs/10000 }}" step="0.0001" required></label></div></section>{% endif %}{% endfor %}</div>
{% elseif action == 'payment' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('money') }}<p>{{ doc.gross_bani < 0 ? 'Înregistrează aici banii restituiți efectiv. Această acțiune păstrează evidența și nu trimite bani prin Stripe sau bancă.' : 'Completează suma ramburs deja încasată. Poți înregistra și o încasare parțială.' }}</p></div><label>Suma, Lei<input name="amount" inputmode="decimal" required placeholder="0,00"></label>
{% elseif action == 'delete' %}
<div class="iv-decision"><h3>{{ doc.display_number }}</h3><p>Se inversează efectul documentului asupra stocului, iar numărul devine disponibil. Istoricul operațiunii rămâne păstrat.</p>{% if doc.delete_blocker %}<div class="iv-error">{{ doc.delete_blocker }}</div>{% else %}<div class="iv-soft-note">{{ n.icon('shield') }}Este ultimul document emis și nu are un blocaj fiscal.</div>{% endif %}</div>
{% elseif action == 'email' %}
<div class="iv-decision"><h3>{{ doc.customer.name }}</h3><p>{{ doc.customer.email }}</p><div class="iv-preview-line"><span>{{ n.icon('document') }}Factura {{ doc.display_number }}<small>PDF atașat · {{ doc.total_display }}</small></span>{{ n.icon('check') }}</div><p>Emailul este pregătit separat de confirmarea comenzii. Dacă expedierea eșuează, factura rămâne emisă.</p></div>
{% elseif action == 'link' %}
<div class="iv-decision"><h3>O copie, doar pentru client</h3><p>Generează o adresă privată pentru descărcarea PDF-ului. Linkul nou îl înlocuiește pe cel vechi.</p></div><label class="iv-choice"><input type="checkbox" name="revoke" value="1">Revocă accesul existent fără a crea un link nou</label><div data-iv-link-result hidden><label>Link privat<input readonly data-iv-public-link></label><button type="button" class="iv-btn" data-iv-copy-link>{{ n.icon('copy') }}Copiază linkul</button></div>
{% endif %}
{% if action in ['edit','return','correct','receive','payment','delete','order-edit','request','decide'] %}<label class="iv-reason">{{ action == 'payment' ? 'Referință / detalii înregistrare' : (action == 'receive' ? 'Observații despre produsele verificate' : 'Motivul operațiunii') }}<span class="iv-required">Obligatoriu</span><textarea name="reason" rows="3" minlength="3" maxlength="2000" required placeholder="Scrie pe scurt ce s-a schimbat și de ce."></textarea></label>{% endif %}
</div><footer class="iv-form-footer"><a class="iv-btn" href="{{ back_url }}" data-iv-close>Renunță</a><span>{{ action == 'issue' ? 'Verifică datele înainte de emitere.' : 'Modificările sunt înregistrate în istoric.' }}</span><button type="submit" class="iv-btn {{ action in ['delete','return','correct'] ? 'iv-btn--rose' : 'iv-btn--primary' }}"{% if action == 'delete' and doc.delete_blocker %} disabled{% endif %}>{{ n.icon(action == 'delete' ? 'trash' : 'check') }}{{ choosing_order ? 'Verifică detaliile' : {'issue':'Emite factura','edit':'Salvează modificările','return':'Emite factura de retur','correct':'Emite corecția','receive':'Confirmă verificarea','payment':'Salvează înregistrarea','delete':'Da, șterge','email':'Trimite emailul','link':'Continuă','policy':'Salvează condițiile','order-edit':'Salvează comanda','request':'Înregistrează solicitarea','decide':'Salvează decizia'}[action] }}</button></footer></form>
