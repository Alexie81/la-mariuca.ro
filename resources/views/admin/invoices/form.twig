{% import 'admin/partials/nir-ui.twig' as n %}{% set doc = invoice|default({}) %}{% set titles = {'issue':'Emite o factură','edit':'Actualizează factura','return':'Retur pentru client','correct':'Corectează prin documente noi','receive':'Verifică produsele primite','payment':(doc.gross_bani|default(0) < 0 ? 'Înregistrează restituirea' : 'Înregistrează încasarea'),'delete':'Ștergi această factură?','email':'Trimite factura clientului','link':'Link privat pentru client'} %}
{% set titles = titles|merge({'issue':'Confirmă emiterea facturii','order-payment':'Starea plății','order-edit':'Editează comanda','decide':'Analizează solicitarea de retur','policy':'Condițiile solicitării de retur'}) %}
{% set descriptions = {'issue':'Alege comanda și verifică datele înainte de emitere.','edit':'Actualizează detaliile, păstrând seria și numărul.','return':'Selectează produsele și cantitățile returnate.','correct':'Păstrăm originalul și emitem documentele de corecție.','receive':'Confirmarea generează NIR-ul de retur și actualizează stocul.','payment':'Păstrează evidența sumelor încasate sau restituite.','delete':'Verifică documentul înainte de eliminare.','email':'Factura PDF ajunge la adresa clientului.','link':'Copiază linkul sau trimite factura direct clientului.','policy':'Alege când poate clientul solicita un retur.','decide':'Alege cantitățile acceptate și explică diferențele.','order-edit':'Pregătește informațiile care vor apărea pe factură.'} %}
{% if action == 'receive' and doc.receipt and not doc.receipt_nir %}{% set titles = titles|merge({'receive':'Generează NIR-ul recepției'}) %}{% set descriptions = descriptions|merge({'receive':'NIR-ul va prelua cantitățile deja verificate și data recepției.'}) %}{% endif %}
{% set choosing_order = action == 'issue' and not preview %}
{% set titles = titles|merge({'return-reconcile': decision|default('invoice') == 'restore' ? 'Revino după anularea returului' : 'Emite factura returului înregistrat'}) %}
{% set descriptions = descriptions|merge({'return-reconcile':'Completează pasul lipsă, fără să înregistrezi cantitățile de două ori.'}) %}
{% set descriptions = descriptions|merge({'issue': preview ? 'Emiți documentul pentru comanda salvată.' : 'Alege comanda pentru care emiți factura.','order-payment':'Înregistrează încasările și rambursările efectuate, direct în comandă.','order-edit':'Datele se actualizează în comandă și în factura încă modificabilă.'}) %}
<form method="{{ choosing_order ? 'get' : 'post' }}" action="{{ form_action }}" class="iv-form" data-iv-form data-kind="{{ action }}">{% if not choosing_order %}<input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="version" value="{{ doc.row_version|default(0) }}">
{% endif %}
{% if return_to_order|default(false) %}<input type="hidden" name="return_to" value="order">{% endif %}
{% if return_to_orders|default(false) %}<input type="hidden" name="return_to" value="orders">{% endif %}
<header class="iv-form-head"><span class="iv-mark">{{ n.icon(action in ['return','correct'] ? 'return' : (action == 'receive' ? 'box' : (action == 'delete' ? 'trash' : (action == 'order-payment' ? 'money' : 'document')))) }}</span><div><span class="iv-eyebrow">{{ action == 'order-payment' ? edit_order.order_number : doc.display_number|default('Facturare La Măriuca') }}</span><h2>{{ titles[action] }}</h2><p>{{ descriptions[action] }}</p></div><a class="iv-icon" href="{{ back_url }}" data-iv-close aria-label="Închide">{{ n.icon('close') }}</a></header>
<div class="iv-form-body"><div class="iv-error" data-iv-errors role="alert" tabindex="-1" hidden></div>
{% if action == 'policy' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('info') }}<p>Aceste setări stabilesc disponibilitatea formularului online. Cererile deja înregistrate rămân în istoric și se analizează individual.</p></div>
<label>Termen după livrare, zile<input type="number" name="days" min="1" max="365" required value="{{ return_policy.days }}"></label>
<label class="iv-choice"><input type="checkbox" name="allow_companies" value="1"{{ return_policy.allow_companies ? ' checked' : '' }}>Permite solicitări pentru achiziții pe firmă</label>
<label class="iv-choice"><input type="checkbox" name="allow_personalized" value="1"{{ return_policy.allow_personalized ? ' checked' : '' }}>Permite solicitări pentru produse personalizate</label>
{% elseif action == 'order-payment' %}{% include 'admin/invoices/order-payment.twig' %}
{% elseif action == 'return-reconcile' %}
<input type="hidden" name="order_id" value="{{ edit_order.id }}"><input type="hidden" name="order_version" value="{{ edit_order.edit_version }}"><input type="hidden" name="return_id" value="{{ reconciliation.id }}"><input type="hidden" name="decision" value="{{ decision }}">
<div class="iv-decision"><h3>{{ edit_order.order_number }} · retur înregistrat</h3><p>{{ reconciliation.reason }}</p><p>{{ decision == 'restore' ? 'Returul este marcat ca anulat în istoric, cantitățile redevin disponibile pentru un retur nou și comanda revine la starea de dinaintea returului. Nu se modifică stocul sau încasările.' : 'Emitem factura de retur pentru cantitățile deja înregistrate. Dacă lipsește factura inițială, aceasta se emite înaintea documentului de retur. Recepția fizică și NIR-ul rămân un pas separat.' }}</p></div>
{% if decision == 'restore' and reconciliation.restore_blocker %}<p class="iv-soft-note">{{ reconciliation.restore_blocker }}</p>{% endif %}
{% if decision == 'invoice' %}<label class="iv-choice"><input type="checkbox" name="notify_customer" value="1" checked>Trimite factura de retur clientului prin email</label>{% endif %}
{% elseif action == 'order-edit' %}
<input type="hidden" name="order_version" value="{{ edit_order.edit_version }}"><input type="hidden" name="order_id" value="{{ edit_order.id }}"><input type="hidden" name="edit_focus" value="{{ edit_focus }}">
{% if invoice %}<div class="iv-notice iv-notice--inline">{{ n.icon('document') }}<p>Factura <strong>{{ doc.display_number }}</strong> se actualizează odată cu comanda. Seria și numărul se păstrează.</p></div>{% endif %}
<section class="iv-form-step"><header><b>1</b><div><h3>Datele clientului și facturarea</h3><p>Informațiile salvate vor apărea și pe factură.</p></div></header>{% include 'admin/invoices/billing-fields.twig' %}</section>
{% if order_actions.edit_delivery.allowed %}{% include 'admin/invoices/shipping-fields.twig' %}{% endif %}
{% if order_actions.edit_items.allowed %}{% include 'admin/invoices/order-items.twig' %}{% else %}<div class="iv-soft-note">{{ n.icon('shield') }}{{ order_actions.edit_items.reason }}</div>{% endif %}
{% elseif action == 'decide' %}<input type="hidden" name="reason" value="{{ return_request.reason }}">
<input type="hidden" name="return_request_id" value="{{ return_request.id }}"><div class="iv-notice iv-notice--inline">{{ n.icon('return') }}<div><strong>Mesajul clientului</strong><p>{{ return_request.reason }}</p><small>{{ return_request.created_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small></div></div>
{% for line in return_request.details.lines %}<section class="iv-form-step"><h3>{{ line.name }}</h3><p>{{ line.sku }} · {{ line.quantity_units/10000 }} buc. solicitate</p><div class="iv-fields"><label>Cantitate acceptată<input type="number" data-return-value data-gross="{{ line.gross_bani }}" data-units="{{ line.quantity_units }}" data-already="0" name="decisions[{{ line.line_id }}][quantity]" min="0" max="{{ line.quantity_units/10000 }}" step="1" value="{{ line.quantity_units/10000 }}" required></label><label>Motivul refuzului / observații<input name="decisions[{{ line.line_id }}][reason]" placeholder="Obligatoriu dacă accepți mai puține bucăți" maxlength="500"></label></div></section>{% endfor %}
{% include 'admin/partials/return-destination.twig' with {destination: return_request.details, original_payment: doc.payment_method == 'stripe'} %}{% for line in doc.lines %}{% if line.kind == 'shipping' and line.available_units > 0 %}<label class="iv-choice"><input type="checkbox" name="refund_shipping" value="1" data-return-shipping data-gross="{{ line.gross_bani }}">Restituie și livrarea inițială, numai la retur integral</label>{% endif %}{% endfor %}{% include 'admin/partials/return-settlement.twig' %}
<p class="iv-soft-note">Cantitate 0 înseamnă refuz pentru acel produs. Un refuz integral nu emite factură de retur.</p>
{% elseif action == 'issue' %}
{% if not preview %}
<section class="iv-form-step"><header><b>1</b><div><h3>{{ return_to_order|default(false) ? 'Comanda pentru facturare' : 'Alege comanda' }}</h3><p>{{ return_to_order|default(false) ? 'Factura se emite pentru comanda deschisă.' : 'Poți factura comenzile ramburs și comenzile achitate online.' }}</p></div></header>
{% if return_to_order|default(false) %}<input type="hidden" name="order_id" value="{{ order_id }}"><div class="iv-preview-line"><span>{{ preview.snapshot.order_number }}<small>{{ preview.snapshot.customer.name }}</small></span>{{ n.icon('document') }}</div>
{% else %}<label>Comanda<select name="order_id" required data-iv-order data-preview-url="{{ url('admin/facturi/emite/') }}"><option value="">Selectează o comandă</option>{% for order in orders %}<option value="{{ order.id }}"{{ order_id == order.id ? ' selected' : '' }}>{{ order.order_number }} · {{ order.first_name }} {{ order.last_name }} · {{ (order.total_bani/100)|number_format(2,',','.') }} Lei</option>{% endfor %}</select></label>{% if not orders %}<p class="iv-soft-note">Nu sunt comenzi eligibile fără factură.</p>{% endif %}{% endif %}
<label>Gestiune<select name="warehouse_id" required>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}"{{ (warehouse_id ? warehouse.id == warehouse_id : warehouse.is_default) ? ' selected' : '' }}>{{ warehouse.name }}</option>{% endfor %}</select><small>De aici se înregistrează ieșirea contabilă a produselor.</small></label></section>
{% endif %}
{% if preview %}{% include 'admin/invoices/issue-confirmation.twig' %}{% endif %}
{% elseif action in ['edit','correct'] %}
{% if action == 'correct' %}<div class="iv-notice iv-notice--inline">{{ n.icon('info') }}<p>Factura originală rămâne în istoric. Se emit o factură de retur și o factură corectată, cu numere noi. Dacă produsele nu se întorc fizic, nu înregistra o primire în stoc.</p></div>{% endif %}
<section class="iv-form-step"><header><b>1</b><div><h3>Datele de facturare</h3><p>{{ action == 'edit' ? 'Seria și numărul rămân aceleași.' : 'Datele corecte apar pe documentul nou.' }}</p></div></header>{% include 'admin/invoices/billing-fields.twig' %}</section>
{% if action == 'correct' %}<section class="iv-form-step iv-correction-lines"><h3>Pozițiile de corectat</h3><p>Selectează cantitățile greșite; celelalte rămân pe factura originală. Mai jos ajustezi comanda completă.</p><input type="hidden" name="quantities[0]" value="0">{% for line in doc.lines %}<div class="iv-select-line"><label class="iv-switch"><input type="checkbox" role="switch" data-iv-select aria-label="Corectează {{ line.name }}"><span></span></label><span class="iv-edit-photo">{% if line.snapshot.image_data|default('') %}<img src="{{ line.snapshot.image_data }}" alt="{{ line.name }}">{% else %}{{ n.icon(line.kind == 'product' ? 'image' : 'document') }}{% endif %}</span><div><strong>{{ line.name }}</strong><small>{{ line.sku }}</small></div><label>Cantitate<input type="number" name="quantities[{{ line.id }}]" min="0" max="{{ line.quantity_units/10000 }}" step="0.0001" value="0" data-iv-quantity data-default="{{ line.quantity_units/10000 }}"></label></div>{% endfor %}</section>{% endif %}
{% include 'admin/invoices/order-items.twig' %}{% if action == 'edit' %}<label>Note pe factură<textarea name="notes" rows="3" maxlength="5000">{{ doc.notes }}</textarea></label>{% endif %}
{% elseif action == 'return' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('info') }}<p>Se emite o factură cu valorile returnate. Produsele revin în stoc doar după verificarea primirii lor, într-un pas separat.</p></div>
<section class="iv-form-step"><header><b>1</b><div><h3>Ce returnează clientul?</h3><p>Activează pozițiile și alege cantitățile. Folosim prețurile și reducerile originale.</p></div></header><div class="iv-select-lines">{% for line in doc.lines %}{% if line.available_units > 0 %}<div class="iv-select-line"><label class="iv-switch"><input type="checkbox" role="switch" data-iv-select aria-label="Returnează {{ line.name }}"><span></span></label><div><strong>{{ line.name }}</strong><small>{{ line.sku }} · {{ (line.available_units/10000)|decimal_ro }} {{ line.unit }} disponibile</small>{% if line.kind == 'shipping' %}<small>Livrarea poate fi restituită la returul integral.</small>{% endif %}</div><label>Cantitate<input data-return-value data-gross="{{ line.gross_bani }}" data-units="{{ line.quantity_units }}" data-already="{{ line.quantity_units-line.available_units }}" name="quantities[{{ line.id }}]" type="number" min="0" max="{{ line.available_units/10000 }}" step="0.0001" value="0" data-iv-quantity data-default="{{ line.available_units/10000 }}"></label></div>{% endif %}{% endfor %}</div></section>{% include 'admin/partials/return-settlement.twig' %}
{% elseif action == 'receive' %}
<section class="iv-form-step iv-receive-date">
  <div><span class="iv-eyebrow">Recepție retur client</span><h3>Când au ajuns produsele?</h3><p>Alege data și ora recepției, ora României.</p></div>
  <label for="iv-received-at">Data și ora recepției</label>
  <div class="iv-receive-date__field"><input id="iv-received-at" type="datetime-local" name="received_at" value="{{ (doc.receipt ? doc.receipt.received_at : 'now')|date('Y-m-d\\TH:i', 'Europe/Bucharest') }}" required><button type="button" class="iv-btn" data-iv-received-now hidden>{{ n.icon('clock') }}Acum</button></div>
  <div class="iv-receive-reference">{{ n.icon('document') }}<span>Factură de retur <strong>{{ doc.display_number }}</strong> · {{ doc.issued_at|date('d.m.Y', 'Europe/Bucharest') }}<small>Data facturii se păstrează în NIR. PDF-ul se atașează automat la documentele justificative.</small></span></div>
</section>
<div class="iv-notice iv-notice--inline">{{ n.icon('box') }}<p>Verifică produsele ajunse efectiv. Doar cantitatea «Bune pentru stoc» revine în evidență. Diferența rămâne separată ca produse nevandabile.</p></div><div class="iv-receive-lines">{% for line in doc.lines %}{% if line.kind == 'product' and line.quantity_units < 0 %}<section class="iv-form-step"><h3>{{ line.name }}</h3><p>{{ line.sku }} · Retur: {{ (line.quantity_units|abs/10000)|decimal_ro }} {{ line.unit }}</p><div class="iv-fields"><label>Primite efectiv<input type="number" name="received[{{ line.id }}]" value="{{ (doc.receipt ? doc.receipt_quantities[line.id].received_units : line.quantity_units|abs)/10000 }}"{% if doc.receipt %} readonly{% endif %} min="0" max="{{ line.quantity_units|abs/10000 }}" step="0.0001" required></label><label>Bune pentru stoc<input type="number" name="restock[{{ line.id }}]" value="{{ (doc.receipt ? doc.receipt_quantities[line.id].restock_units : line.quantity_units|abs)/10000 }}"{% if doc.receipt %} readonly{% endif %} min="0" max="{{ line.quantity_units|abs/10000 }}" step="0.0001" required></label></div></section>{% endif %}{% endfor %}</div>
{% elseif action == 'payment' %}
<div class="iv-notice iv-notice--inline">{{ n.icon('money') }}<p>{{ doc.gross_bani < 0 ? 'Înregistrează aici banii restituiți efectiv. Această acțiune păstrează evidența și nu trimite bani prin Stripe sau bancă.' : 'Completează suma ramburs deja încasată. Poți înregistra și o încasare parțială.' }}</p></div><label>Suma, Lei<input name="amount" inputmode="decimal" required placeholder="0,00"></label>
{% elseif action == 'delete' %}
<div class="iv-decision"><h3>{{ doc.display_number }}</h3><p>Se inversează efectul documentului asupra stocului, iar numărul devine disponibil. Istoricul operațiunii rămâne păstrat.</p>{% if doc.delete_blocker %}<div class="iv-error">{{ doc.delete_blocker }}</div>{% else %}<div class="iv-soft-note">{{ n.icon('shield') }}Documentul poate fi șters.</div>{% endif %}</div>
{% elseif action == 'email' %}
<div class="iv-decision"><h3>{{ doc.customer.name }}</h3><p>{{ doc.customer.email }}</p><div class="iv-preview-line"><span>{{ n.icon('document') }}Factura {{ doc.display_number }}<small>PDF atașat · {{ doc.total_display }}</small></span>{{ n.icon('check') }}</div><p>Emailul este pregătit separat de confirmarea comenzii. Dacă expedierea eșuează, factura rămâne emisă.</p></div>
{% elseif action == 'link' %}
{% include 'admin/invoices/share-link.twig' %}
{% endif %}
{% if action in ['edit','return','correct','payment','delete','order-edit'] %}<label class="iv-reason">{{ action == 'payment' ? 'Referință / detalii înregistrare' : 'Motivul operațiunii' }}<span class="iv-required">Obligatoriu</span><textarea name="reason" rows="3" minlength="3" maxlength="2000" required placeholder="Scrie pe scurt ce s-a schimbat și de ce."></textarea></label>{% endif %}
{% if action == 'order-edit' %}<label class="iv-edit-notify"><span class="iv-switch"><input type="checkbox" name="notify_customer" value="1" role="switch"><span></span></span><span><strong>Anunță clientul prin email</strong><small>Primește datele și produsele actualizate, cu rezumatul modificărilor, la adresa salvată în comandă.</small></span></label>{% endif %}
{% if action == 'return' or (action == 'payment' and doc.gross_bani < 0) %}<input type="hidden" name="notify_customer" value="0"><label class="iv-choice"><input type="checkbox" name="notify_customer" value="1" checked>Trimite clientului un email despre această operațiune</label>{% endif %}</div>{% if action == 'link' %}<footer class="iv-form-footer"><a class="iv-btn" href="{{ back_url }}" data-iv-close>Închide</a><span>Acces direct, fără autentificare.</span><button type="submit" class="iv-btn iv-btn--primary" data-iv-share-submit>{{ n.icon('mail') }}<span>{{ public_link|default('') ? 'Trimite pe email' : 'Pregătește linkul' }}</span></button></footer>{% else %}<footer class="iv-form-footer"><a class="iv-btn" href="{{ back_url }}" data-iv-close>Renunță</a><span>{{ action == 'issue' ? 'Verifică datele înainte de emitere.' : 'Modificările sunt înregistrate în istoric.' }}</span><button type="submit" class="iv-btn {{ action in ['delete','return','correct'] ? 'iv-btn--rose' : 'iv-btn--primary' }}"{% if (action == 'delete' and doc.delete_blocker) or (action == 'order-payment' and edit_order.payment_method != 'cod') %} disabled{% endif %}>{{ n.icon(action == 'delete' ? 'trash' : 'check') }}{{ choosing_order ? 'Verifică detaliile' : {'issue':'Emite factura','edit':'Salvează modificările','return':'Emite factura de retur','correct':'Emite corecția','receive':doc.receipt ? 'Generează NIR-ul' : 'Confirmă verificarea','payment':'Salvează înregistrarea','delete':'Șterge document','email':'Trimite emailul','link':'Continuă','policy':'Salvează condițiile','return-reconcile':'Confirmă operațiunea','order-payment':'Salvează starea plății','order-edit':'Salvează comanda','decide':'Salvează decizia'}[action] }}</button></footer>{% endif %}</form>
