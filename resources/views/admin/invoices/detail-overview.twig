{% import 'admin/partials/nir-ui.twig' as n %}
<header class="iv-sheet-hero">
  <div class="iv-sheet-title"><span class="iv-register-symbol">{{ n.icon(negative ? 'return' : 'document') }}</span><div><span class="iv-eyebrow">{{ doc.kind_label }}</span><h1>{{ doc.display_number }}<button class="iv-icon" type="button" data-iv-copy="{{ doc.display_number }}" aria-label="Copiază numărul facturii">{{ n.icon('copy') }}</button></h1><p><a href="{{ url('admin/comenzi/'~doc.order_id~'/') }}">{{ doc.order_number }}</a> · {{ doc.date_display }}</p>{% if doc.parent %}<p class="iv-original-reference">Retur pentru factura <a href="{{ url('admin/facturi/'~doc.parent.id~'/') }}">{{ doc.parent.series_code }} {{ doc.parent.number }}</a> · {{ doc.parent.issued_at|date('d.m.Y','Europe/Bucharest') }}</p>{% endif %}</div></div>
  <div class="iv-sheet-total"><span class="iv-status {{ doc.payment_state == 'paid' ? 'is-green' : (negative ? 'is-rose' : 'is-gold') }}">{{ doc.payment_label }}</span><small>{{ negative ? 'Total factură de retur' : 'Total factură' }}</small><strong>{{ doc.total_display }}</strong></div>
</header>
<div class="iv-document-states">
  <section class="iv-fiscal-state is-{{ doc.fiscal.tone }}"><span class="iv-state-icon">{{ n.icon(doc.fiscal.icon) }}</span><div><span class="iv-state-caption">SPV · RO e-Factura{% if doc.fiscal_job %} · {{ doc.fiscal_job.environment == 'test' ? 'Mediu de test' : 'Producție' }}{% endif %}</span><h2>{{ doc.fiscal.label }}</h2><p>{{ doc.fiscal.description }}</p>{% if doc.fiscal_reference %}<span class="iv-fiscal-reference">Referință ANAF <b>{{ doc.fiscal_reference }}</b><button class="iv-icon" type="button" data-iv-copy="{{ doc.fiscal_reference }}" aria-label="Copiază referința ANAF">{{ n.icon('copy') }}</button></span>{% endif %}{% if doc.fiscal_state == 'scheduled' and doc.fiscal_job.available_at|default('') %}<small>{{ doc.fiscal_job.available_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small>{% endif %}{% if doc.fiscal_job.last_error|default('') %}<details><summary>Detaliile răspunsului</summary><p>{{ doc.fiscal_job.last_error }}</p></details>{% endif %}</div>{% if can_manage_spv %}<a class="iv-icon" href="{{ url('admin/spv-efactura/') }}#document-{{ doc.id }}" aria-label="Gestionează transmiterea SPV" title="Gestionează transmiterea SPV">{{ n.icon('arrow') }}</a>{% endif %}</section>
  <section class="iv-delivery-state is-{{ doc.email.tone }}"><span class="iv-state-icon">{{ n.icon('mail') }}</span><div><span class="iv-state-caption">Comunicare cu clientul</span><h2>{{ doc.email.label }}</h2><p>{{ doc.customer.email }}</p>{% if doc.email_state == 'sent' %}<small>Acceptat de serverul de email.</small>{% endif %}</div>{% if can_manage %}<a class="iv-icon" href="{{ url('admin/facturi/'~doc.id~'/email/') }}" data-iv-modal aria-label="Trimite factura pe email" title="Trimite factura pe email">{{ n.icon('arrow') }}</a>{% endif %}</section>
</div>
{% if doc.receipt_expected %}
<section class="iv-receipt-banner {{ doc.receipt_nir ? 'is-received' : 'is-pending' }}"><span class="iv-mark">{{ n.icon(doc.receipt_nir ? 'warehouse' : 'warning') }}</span><div><span class="iv-eyebrow">Recepție retur client</span><h2>{{ doc.receipt_nir ? 'NIR-ul de retur este înregistrat' : 'Lipsește NIR-ul de retur' }}</h2><p>{{ doc.receipt_nir ? 'Recepția este confirmată. NIR-ul păstrează cantitățile și înregistrările de stoc.' : (doc.receipt ? 'Produsele au fost verificate, dar documentul de recepție lipsește. Finalizează generarea NIR-ului.' : 'Confirmă produsele primite și cantitățile bune pentru stoc. Verificarea generează automat NIR-ul.') }}</p>{% if doc.receipt_nir %}<small>{{ doc.receipt_nir.number }} · {{ doc.receipt_nir.received_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small>{% endif %}</div>{% if doc.receipt_nir %}<a class="iv-btn" href="{{ url('admin/nir-uri/'~doc.receipt_nir.id~'/') }}">Deschide NIR-ul {{ n.icon('arrow') }}</a>{% elseif can_manage %}<a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/'~doc.id~'/receive/') }}" data-iv-modal>{{ doc.receipt ? 'Generează NIR-ul' : 'Verifică și recepționează' }} {{ n.icon('arrow') }}</a>{% endif %}</section>
{% endif %}
