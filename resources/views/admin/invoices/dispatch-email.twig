{% import 'admin/partials/nir-ui.twig' as n %}
<form method="post" action="{{ form_action }}" class="iv-form" data-iv-form data-kind="dispatch-email">
  <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="dispatch_note_id" value="{{ note.id }}"><input type="hidden" name="version" value="{{ note.row_version }}">
  <header class="iv-form-head"><span class="iv-mark">{{ n.icon('mail') }}</span><div><span class="iv-eyebrow">Aviz de însoțire</span><h2>Trimite avizul clientului</h2><p>PDF atașat și acces direct printr-un link privat.</p></div><a class="iv-icon" href="{{ back_url }}" data-iv-close aria-label="Închide">{{ n.icon('close') }}</a></header>
  <div class="iv-form-body"><div class="iv-error" data-iv-errors role="alert" tabindex="-1" hidden></div>
    <section class="iv-payment-total"><span>{{ n.icon('document') }}Documentul pregătit</span><strong>{{ note.reference }}</strong><small>Comanda {{ note.snapshot.order_reference }}</small></section>
    <section class="iv-form-step"><h3>{{ note.snapshot.customer.name }}</h3><p>{{ note.snapshot.customer.email }}</p></section>
    <label class="iv-reason">Mesaj personalizat <small>opțional</small><textarea name="personal_message" rows="3" maxlength="2000" placeholder="Adaugă câteva cuvinte pentru client…"></textarea></label>
  </div>
  <footer class="iv-form-footer"><a class="iv-btn" href="{{ back_url }}" data-iv-close>Renunță</a><span>Poți retrimite documentul oricând.</span><button type="submit" class="iv-btn iv-btn--primary">{{ n.icon('mail') }}Trimite avizul pe email</button></footer>
</form>
