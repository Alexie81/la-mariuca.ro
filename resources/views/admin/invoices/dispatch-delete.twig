{% import 'admin/partials/nir-ui.twig' as n %}
<form method="post" action="{{ form_action }}" class="iv-form" data-iv-form data-kind="dispatch-delete">
  <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="dispatch_note_id" value="{{ note.id }}"><input type="hidden" name="version" value="{{ note.row_version }}">
  <header class="iv-form-head"><span class="iv-mark">{{ n.icon('trash') }}</span><div><span class="iv-eyebrow">Aviz de însoțire</span><h2>Ștergi acest aviz?</h2><p>Verifică documentul înainte de confirmare.</p></div><a class="iv-icon" href="{{ back_url }}" data-iv-close aria-label="Închide">{{ n.icon('close') }}</a></header>
  <div class="iv-form-body"><div class="iv-error" data-iv-errors role="alert" tabindex="-1" hidden></div>
    <section class="iv-payment-total"><span>{{ n.icon('document') }}Avizul selectat</span><strong>{{ note.reference }}</strong><small>Comanda {{ note.snapshot.order_reference }} · {{ note.snapshot.customer.name }}</small></section>
    <div class="iv-decision"><h3>{{ note.can_delete ? 'Avizul poate fi șters' : 'Avizul nu poate fi șters' }}</h3>{% if note.can_delete %}<p>Avizul va fi eliminat din documentele comenzii. Istoricul operațiunii rămâne păstrat.</p>{% else %}<div class="iv-error">{{ note.delete_blocker }}</div>{% endif %}</div>
  </div>
  <footer class="iv-form-footer"><a class="iv-btn" href="{{ back_url }}" data-iv-close>Renunță</a><span>Verificăm din nou eligibilitatea la confirmare.</span><button type="submit" class="iv-btn iv-btn--rose"{{ not note.can_delete ? ' disabled' : '' }}>{{ n.icon('trash') }}Șterge avizul</button></footer>
</form>
