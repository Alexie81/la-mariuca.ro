<!DOCTYPE html>
<html lang="ro"><head><meta charset="UTF-8"><title>Model aviz · {{ company.trade_name }}</title>
<style>
@font-face{font-family:'Nunito PDF';font-weight:400;src:url('{{ font_regular }}') format('truetype')}
@font-face{font-family:'Nunito PDF';font-weight:700;src:url('{{ font_bold }}') format('truetype')}
@page{margin:28pt 28pt 49pt}
*{box-sizing:border-box}body{margin:0;font-family:'Nunito PDF',sans-serif;font-size:8.5pt;line-height:11.5pt;color:#4c3c48}
table{width:100%;border-collapse:collapse;table-layout:fixed}td{vertical-align:top}strong{font-weight:700}p,h1,h2{margin:0}
.top-line{height:5pt;background:#805369;border-radius:3pt;margin-bottom:7pt}
.brand td{vertical-align:middle;padding:0}.logo{width:160pt;height:54pt}.heading{width:56%;text-align:right}.eyebrow{font-size:7pt;letter-spacing:1.5pt;color:#a3778e;font-weight:700}.heading h1{font-size:26pt;line-height:28pt;color:#573d51;margin:4pt 0 2pt}.subtitle{font-size:12pt;line-height:15pt;color:#896679}
.identification{margin:9pt 0 9pt;border:.7pt solid #e9d5e1;border-radius:12pt;background:#fcf5f8;padding:7pt 10pt;page-break-inside:avoid}.identification td{padding:0 10pt;border-right:.6pt solid #e6d6e0;vertical-align:middle}.identification td:first-child{padding-left:0}.identification td:last-child{border:0;padding-right:0}.label{font-size:7pt;letter-spacing:.5pt;color:#9b7b8f;line-height:10pt}.identification strong{display:block;margin-top:4pt;color:#71465f;font-size:11pt;line-height:13pt}
.parties{page-break-inside:avoid}.parties .left{width:50%;padding-right:6pt}.parties .right{width:50%;padding-left:6pt}.party{border:.7pt solid #e5d3df;border-radius:11pt;overflow:hidden}.party-head{padding:6pt 10pt;background:#fcf0f5;border-bottom:.6pt solid #efdee7;border-radius:10pt 10pt 0 0}.party-caption{font-size:7.2pt;letter-spacing:.8pt;font-weight:700;color:#a26080;margin-bottom:6pt}.party h2{font-size:12.5pt;line-height:15pt;color:#573b4e;margin-bottom:4pt}.party-subtitle{font-size:8pt;line-height:10pt;color:#927988}.buyer .party-head{background:#f5f0f8;border-color:#e8dfea}.buyer .party-caption{color:#896b96}.party-body{padding:6pt 10pt}.party-address{height:34pt;margin-bottom:4pt}.party-address .label{margin-bottom:3pt}.contact td{padding:1pt 0;font-size:8pt;line-height:10pt}.contact .key{width:34pt;color:#9b7b8f;font-size:7.5pt}.company-id{margin:6pt 0 8pt;border:.6pt solid #eadfe6;border-radius:8pt;padding:4pt 10pt;background:#fcfafc;font-size:7.5pt;color:#90778a}.company-id strong{color:#73556a}
.section-heading{margin:7pt 0 5pt}.section-heading td{padding:0;color:#715068;font-weight:700;font-size:9pt}.section-heading .hint{text-align:right;color:#a08294;font-size:7.5pt;font-weight:400}
.products thead{display:table-header-group}.products th{background:#62465c;color:#fff;font-size:7pt;line-height:10pt;padding:7pt 4pt;font-weight:700;text-align:left}.products th:first-child{border-radius:8pt 0 0 0}.products th:last-child{border-radius:0 8pt 0 0}.products td{padding:4pt 4pt;border-bottom:.5pt solid #eadfe7;vertical-align:middle;font-size:8.4pt;line-height:11pt}.products tr{page-break-inside:avoid}.products tbody tr:nth-child(even) td{background:#fcf9fb}.products .center{text-align:center}.products .amount{text-align:right;white-space:nowrap}.products .number{color:#a36b86}.photo{width:28pt;height:33pt;border-radius:6pt}.product-name{font-size:9.3pt;line-height:12pt;font-weight:700;color:#52394c}.sku{color:#998093;font-size:7pt;line-height:10pt;margin-top:4pt}.value{font-weight:700;color:#70475f}
.closing{page-break-inside:avoid}.total{margin-top:9pt;border:.7pt solid #e6d5e1;border-radius:11pt;overflow:hidden}.total td{padding:6pt 12pt;vertical-align:middle}.total .count{width:52%;background:#faf5f8;color:#8f7485;font-size:8pt}.total .count strong{font-size:11pt;color:#79526c}.total .sum{width:48%;background:#73506a;color:white;text-align:right}.total .sum small{display:block;color:#ead8e5;font-size:7pt;letter-spacing:.8pt;margin-bottom:4pt}.total .sum strong{font-size:18pt;line-height:21pt}
.dispatch{margin-top:8pt;border:.7pt solid #e5d7e2;border-radius:11pt;padding:7pt 10pt}.dispatch-title{color:#78526d;font-size:9pt;font-weight:700;margin-bottom:6pt}.dispatch table{table-layout:fixed}.dispatch td{padding:0 8pt 0 0}.dispatch td:last-child{padding-right:0}.field{background:#faf7fa;border:.6pt solid #e8dfe7;border-radius:7pt;padding:4pt 6pt}.field .label{font-size:6.5pt;letter-spacing:.3pt;line-height:9pt;margin-bottom:4pt}.field .field-value{font-size:8pt;color:#715a6b;line-height:11pt;min-height:12pt}.dispatch .second-row td{padding-top:7pt}
.signatures{margin-top:8pt;page-break-inside:avoid}.signatures td{padding:0 12pt 0 0}.signatures td:last-child{padding:0}.signature{border:.6pt solid #e5d6e1;border-radius:9pt;padding:6pt 9pt;height:36pt}.signature .label{font-size:7pt;font-weight:700;color:#8b627a}.signature .name{font-size:8pt;line-height:11pt;margin-top:4pt;color:#725a6b}.signature .line{height:5pt;border-bottom:.6pt solid #d6c3d1;margin-top:3pt}.stamp{text-align:center;color:#b296a8;font-size:7pt;line-height:10pt;padding-top:6pt}
.thanks{margin-top:9pt;border:.7pt solid #e6d6e1;border-top:3pt solid #b97a97;border-radius:10pt;padding:6pt 9pt;page-break-inside:avoid}.thanks td{padding:0;vertical-align:middle}.thanks .seal-cell{width:9%}.thanks .message{width:62%}.seal{width:29pt;height:29pt}.thanks strong{font-size:11pt;line-height:14pt;color:#724961}.thanks p{margin-top:3pt;font-size:8pt;color:#9a7c8e}.thanks .contact-cell{width:29%;border-left:.6pt solid #e6d9e1;padding-left:10pt;font-size:7.5pt;line-height:11pt;color:#9d6480}
.footer{position:fixed;bottom:-29pt;left:0;right:0;padding-top:7pt;border-top:.6pt solid #e5d8e1;font-size:6.7pt;line-height:9pt;color:#957e8f}.footer strong{color:#79566e}.footer span{margin-left:10pt;font-size:6.2pt;letter-spacing:.25pt}
{% if lines|length > 20 %}.products td{padding:3pt 4pt}.photo{width:24pt;height:29pt}.sku{margin-top:2pt}{% endif %}
</style></head><body>
<div class="footer"><strong>{{ reference }}</strong><span>MODEL · CLIENT ȘI PRODUSE DEMONSTRATIVE · DOCUMENT NEEMIS</span></div>
<div class="top-line"></div>
<table class="brand"><tr><td><img class="logo" src="{{ logo }}" alt="La Măriuca Boutique"></td><td class="heading"><div class="eyebrow">LA MĂRIUCA BOUTIQUE</div><h1>AVIZ</h1><div class="subtitle">de însoțire a mărfii</div></td></tr></table>
<div class="identification"><table><tr><td style="width:18%"><div class="label">SERIE</div><strong>{{ series }}</strong></td><td style="width:13%"><div class="label">NUMĂR</div><strong>{{ number }}</strong></td><td style="width:27%"><div class="label">DATA EMITERII</div><strong>{{ date }}</strong></td><td style="width:42%"><div class="label">COMANDĂ DE REFERINȚĂ</div><strong>{{ order_reference }}</strong></td></tr></table></div>
<table class="parties"><tr><td class="left"><div class="party"><div class="party-head"><div class="party-caption">FURNIZOR / EXPEDITOR</div><h2>{{ company.trade_name ?: company.legal_name }}</h2><div class="party-subtitle">{{ company.trade_name ? company.legal_name : 'Expeditor' }}</div></div><div class="party-body"><div class="party-address"><div class="label">Sediu social</div>{{ company.registered_address }}<br>{{ company.postal_code }} {{ company.city }}{% if company.county and company.county not in company.city %}, {{ company.county }}{% endif %}{% if company.country %}, {{ company.country }}{% endif %}</div><table class="contact"><tr><td class="key">Telefon</td><td>{{ company.phone ?: '-' }}</td></tr><tr><td class="key">Email</td><td>{{ company.email ?: '-' }}</td></tr></table></div></div></td>
<td class="right"><div class="party buyer"><div class="party-head"><div class="party-caption">CUMPĂRĂTOR / DESTINATAR</div><h2>{{ customer.name }}</h2><div class="party-subtitle">{{ customer.type }}</div></div><div class="party-body"><div class="party-address"><div class="label">Adresă de livrare</div>{{ customer.address }}</div><table class="contact"><tr><td class="key">Telefon</td><td>{{ customer.phone }}</td></tr><tr><td class="key">Email</td><td>{{ customer.email }}</td></tr></table></div></div></td></tr></table>
<div class="company-id">CUI furnizor &nbsp;<strong>{{ company.tax_id ?: '-' }}</strong> &nbsp;&nbsp;·&nbsp;&nbsp; Registrul Comerțului &nbsp;<strong>{{ company.trade_register ?: '-' }}</strong></div>
<table class="section-heading"><tr><td>Produsele expediate</td><td class="hint">{{ lines|length }} {{ lines|length == 1 ? 'poziție' : 'poziții' }} · Valori în Lei{{ company.is_vat_payer ? ', cu TVA inclus' : '' }}</td></tr></table>
{% for group in line_groups %}
<table class="products"{% if not loop.first %} style="page-break-before:always"{% endif %}><thead><tr><th class="center" style="width:5%">NR.</th><th style="width:9%">IMAGINE</th><th style="width:35%">PRODUS</th><th class="center" style="width:7%">U.M.</th><th class="center" style="width:10%">CANT.</th><th class="amount" style="width:16%">PREȚ UNITAR</th><th class="amount" style="width:18%">VALOARE</th></tr></thead><tbody>
{% for line in group %}<tr><td class="center number">{{ line.position }}</td><td><img class="photo" src="{{ line.image_data }}" alt=""></td><td><div class="product-name">{{ line.name }}</div><div class="sku">SKU {{ line.sku }}</div></td><td class="center">{{ line.unit }}</td><td class="center">{{ line.quantity }}</td><td class="amount">{{ line.unit_price }}</td><td class="amount value">{{ line.value }}</td></tr>{% endfor %}
</tbody></table>
{% endfor %}
<div class="closing">
<div class="total"><table><tr><td class="count"><strong>{{ quantity }} bucăți</strong><br>{{ lines|length }} {{ lines|length == 1 ? 'poziție în document' : 'poziții în document' }}</td><td class="sum"><small>VALOARE TOTALĂ</small><strong>{{ total }}</strong></td></tr></table></div>
<div class="dispatch"><div class="dispatch-title">Date privind expediția</div><table><tr><td style="width:36%"><div class="field"><div class="label">NUMELE DELEGATULUI</div><div class="field-value">{{ dispatch.delegate ?: '........................................' }}</div></div></td><td style="width:28%"><div class="field"><div class="label">CI - SERIE ȘI NUMĂR</div><div class="field-value">{{ dispatch.identity ?: '............................' }}</div></div></td><td style="width:36%"><div class="field"><div class="label">MIJLOC DE TRANSPORT / NR.</div><div class="field-value">{{ dispatch.vehicle ?: '........................................' }}</div></div></td></tr></table><table class="second-row"><tr><td style="width:25%"><div class="field"><div class="label">ORA LIVRĂRII</div><div class="field-value">{{ dispatch.time ?: '........................' }}</div></div></td><td style="width:75%"><div class="field"><div class="label">LOCUL ÎNCĂRCĂRII</div><div class="field-value">{{ dispatch.loading_place ?: '.....................................................................' }}</div></div></td></tr></table></div>
<table class="signatures"><tr><td style="width:39%"><div class="signature"><div class="label">EXPEDITOR</div><div class="name">{{ company.trade_name ?: company.legal_name }}</div><div class="line"></div></div></td><td style="width:39%"><div class="signature"><div class="label">PRIMIREA MĂRFII</div><div class="name">Nume și semnătură</div><div class="line"></div></div></td><td style="width:22%"><div class="signature stamp">ȘTAMPILĂ<br>dacă este cazul</div></td></tr></table>
<div class="thanks"><table><tr><td class="seal-cell"><img class="seal" src="{{ monogram }}" alt="LM"></td><td class="message"><strong>Mulțumim că ai ales La Măriuca!</strong><p>Cu grijă pentru fiecare mică bucurie.</p></td><td class="contact-cell">{{ company.website_display ?: 'La Măriuca Boutique' }}<br>{{ company.email }}</td></tr></table></div>
</div>
</body></html>
