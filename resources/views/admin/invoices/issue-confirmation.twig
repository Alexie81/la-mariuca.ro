{% import 'admin/partials/nir-ui.twig' as n %}
<input type="hidden" name="confirmation_hash" value="{{ preview.confirmation_hash }}">
<input type="hidden" name="expected_number" value="{{ preview.series }} {{ preview.number }}">
<input type="hidden" name="order_id" value="{{ order_id }}">
<div class="iv-issue-order"><span>{{ n.icon('box') }}{{ preview.snapshot.order_number }}</span><small>Comanda pentru care emiți factura</small></div>
<section class="iv-issue-summary">
  <div><span class="iv-eyebrow">Factura care urmează</span><strong>{{ preview.series }} {{ preview.number }}</strong><small>Numărul se rezervă la confirmare.</small></div>
  <div><span>Total de facturat</span><strong>{{ (preview.total/100)|number_format(2,',','.') }} <small>Lei</small></strong></div>
</section>
<label class="iv-issue-email">
  <span class="iv-issue-email__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></span>
  <span class="iv-issue-email__copy"><strong>Trimite factura prin email</strong><span>{{ preview.snapshot.customer.email }}</span><small>Clientul primește un link privat pentru deschidere și factura PDF atașată.</small></span>
  <span class="iv-switch"><input type="checkbox" role="switch" name="send_email" value="1" checked aria-label="Trimite factura prin email clientului"><span></span></span>
</label>
{% if warehouses|length > 1 %}<label>Gestiune<select name="warehouse_id" required>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}"{{ (warehouse_id ? warehouse.id == warehouse_id : warehouse.is_default) ? ' selected' : '' }}>{{ warehouse.name }}</option>{% endfor %}</select></label>{% elseif warehouses|length == 1 %}<input type="hidden" name="warehouse_id" value="{{ warehouses[0].id }}">{% endif %}
<section class="iv-form-step iv-issue-customer">
  <header><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><div><h3>{{ preview.snapshot.customer.name }}</h3><p>{{ preview.snapshot.customer.email }}</p></div></header>
  <p>{{ preview.snapshot.customer.address.address|default(preview.snapshot.customer.address.street|default('')) }} · {{ preview.snapshot.customer.address.city }} · {{ preview.snapshot.customer.address.county }}</p>
  <small>Datele provin din comandă. Pentru corectare, închide acest mesaj și alege „Editează comanda”.</small>
</section>
<div class="iv-issue-effects">
  <div>{{ n.icon('document') }}<span><strong>Document fiscal</strong><small>Se păstrează datele comenzii, prețurile și reducerile.</small></span></div>
  <div>{{ n.icon('box') }}<span><strong>Stoc contabil actualizat</strong><small>Produsele urmărite contabil se scad la emitere. Soldul poate deveni negativ dacă intrarea nu a fost încă înregistrată.</small></span></div>
</div>
<details class="iv-issue-lines" data-iv-disclosure>
  <summary>
    <span class="iv-issue-lines__icon">{{ n.icon('box') }}</span>
    <span class="iv-issue-lines__heading"><strong>Produse și valori</strong><small>Verifică detaliile facturii</small></span>
    <span class="iv-issue-lines__count">{{ preview.lines|length }} {{ preview.lines|length == 1 ? 'poziție' : 'poziții' }}</span>
    <span class="iv-issue-lines__arrow">{{ n.icon('chevron') }}</span>
  </summary>
  <div class="iv-issue-lines__body">
    {% for line in preview.lines %}
      <div class="iv-preview-line">
        <span class="iv-issue-lines__number" aria-hidden="true">{{ loop.index }}</span>
        <span class="iv-issue-lines__product">{{ line.name }}<small>{{ (line.quantity_units/10000)|decimal_ro }} {{ line.unit }}{% if line.sku %} · {{ line.sku }}{% endif %}</small></span>
        <strong>{{ (line.gross_bani/100)|number_format(2,',','.') }} <small>Lei</small></strong>
      </div>
    {% endfor %}
  </div>
</details>
