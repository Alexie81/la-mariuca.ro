<section class="order-card order-next"><header class="order-card__head"><div><span class="order-kicker">Documente</span><h2>Facturare</h2></div></header><div class="order-next__links">
{% if order.issued_invoices %}{% for invoice in order.issued_invoices %}<a href="{{ url('admin/facturi/'~invoice.id~'/') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM9 12h6M9 16h6"/></svg><span>{{ invoice.series_code }} {{ invoice.number }}{{ invoice.gross_bani < 0 ? ' · Retur / corecție' : '' }}</span></a>{% endfor %}
{% elseif order.status not in ['cancelled','returned','manual_review'] %}<a href="{{ url('admin/facturi/emite/?order='~order.id) }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM9 12h6M12 9v6"/></svg><span>Emite factura</span></a><a href="{{ url('admin/facturi/0/order-edit/?order='~order.id) }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16 12-12 4 4L8 20H4z"/></svg><span>Pregătește datele pentru facturare</span></a>{% endif %}</div></section>
