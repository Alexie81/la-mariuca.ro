{% if doc.return_requests %}<section class="iv-panel" id="solicitari-retur"><header class="iv-section-head"><div><span class="iv-eyebrow">Solicitările clientului</span><h2>Retururi de analizat</h2></div>{{ n.icon('return') }}</header><div class="iv-related">{% for request in doc.return_requests %}<article class="iv-request"><div><span class="iv-status {{ request.state == 'pending' ? 'is-gold' : 'is-green' }}">{{ {'pending':'Așteaptă răspuns','accepted':'Acceptată','partial':'Acceptată parțial','rejected':'Respinsă'}[request.state] }}</span><small>{{ request.created_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small><p class="iv-preserve">{{ request.reason }}</p>{% if request.credit_invoice_id %}<a class="iv-btn" href="{{ url('admin/facturi/'~request.credit_invoice_id~'/') }}">Deschide factura de retur {{ n.icon('arrow') }}</a>{% endif %}</div>{% if request.state == 'pending' and can_manage %}<a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/'~doc.id~'/decide/?request='~request.id) }}" data-iv-modal>Analizează solicitarea {{ n.icon('arrow') }}</a>{% endif %}</article>{% endfor %}</div></section>{% endif %}
