{% set customer = invoice.customer|default(preview.snapshot.customer|default({})) %}
<div class="iv-fields"><label>Tip client<select name="billing[type]" data-iv-customer-type><option value="person"{{ customer.type|default('person') == 'person' ? ' selected' : '' }}>Persoană fizică</option><option value="company"{{ customer.type|default('') == 'company' ? ' selected' : '' }}>Persoană juridică</option></select></label><label>Nume complet<input name="billing[name]" value="{{ customer.name|default('') }}" required maxlength="200" autocomplete="name"></label><label>Email<input name="billing[email]" type="email" value="{{ customer.email|default('') }}" required maxlength="254" autocomplete="email"></label><label>Telefon<input name="billing[phone]" type="tel" value="{{ customer.phone|default('') }}" maxlength="40" autocomplete="tel"></label><label class="iv-wide">Strada și numărul<input name="billing[address][address]" value="{{ customer.address.address|default(customer.address.street|default('')) }}" required maxlength="500" autocomplete="street-address"></label><label>Localitate<input name="billing[address][city]" value="{{ customer.address.city|default('') }}" required maxlength="120"></label><label>Județ<input name="billing[address][county]" value="{{ customer.address.county|default('') }}" required maxlength="120"></label><label>Cod poștal<input name="billing[address][postal_code]" value="{{ customer.address.postal_code|default('') }}" maxlength="20"></label><label>Țară<input name="billing[address][country]" value="{{ customer.address.country|default('România') }}" required maxlength="100"></label></div>
<fieldset class="iv-company-fields" data-iv-company-fields><legend>Date pentru persoană juridică</legend><div class="iv-fields"><label>Denumire firmă<input name="billing[company][name]" value="{{ customer.company.name|default(customer.company.company_name|default('')) }}" maxlength="200"></label><label>CUI<input name="billing[company][tax_id]" value="{{ customer.company.tax_id|default(customer.company.cui|default('')) }}" maxlength="40"></label><label>Registrul Comerțului<input name="billing[company][trade_register]" value="{{ customer.company.trade_register|default('') }}" maxlength="80"></label></div></fieldset>
