<!DOCTYPE html>
<html lang="ro"><head><meta charset="UTF-8"><title>{{ preview ? "Model factură" : document_title }} · {{ company.trade_name }}</title>
<style>
@font-face {font-family:'Nunito PDF';font-weight:400;src:url('{{ font_regular }}') format('truetype')}
@font-face {font-family:'Nunito PDF';font-weight:700;src:url('{{ font_bold }}') format('truetype')}
@page {margin:28pt 28pt 81pt}
* {box-sizing:border-box} body {margin:0;font-family:'Nunito PDF',sans-serif;font-size:8.4pt;line-height:11pt;color:#453640}
table {width:100%;border-collapse:collapse;table-layout:fixed} td {vertical-align:top} strong,b {font-weight:700} p {margin:0}
.top-line {height:5pt;background:#805369;border-radius:3pt;margin-bottom:8pt}
.brand td {padding:0;vertical-align:middle;height:52pt}.logo {width:166pt;height:56pt}.heading {text-align:right;width:42%}
.eyebrow {font-size:7pt;letter-spacing:1.5pt;color:#9a808d;font-weight:700}.heading h1 {font-size:25pt;line-height:29pt;color:#4f3649;margin:4pt 0 3pt}.number {font-size:13pt;color:#b55375;font-weight:700}
.status {border:.7pt solid #ead8e2;border-radius:12pt;background:#fcf5f8;margin-top:7pt;padding:6pt 8pt;page-break-inside:avoid}
.status-grid td {padding:0;vertical-align:middle}.status-grid .status-label {width:52%;padding-right:8pt}.status-grid .date-cell {width:24%;padding-left:6pt}
.status-identity {position:relative;padding-left:40pt}.status-symbol {position:absolute;left:0;top:0;width:29pt;height:29pt;border:.7pt solid #ebcbd8;border-radius:15pt;background:#fff}
.status-clock {position:absolute;left:6pt;top:6pt;width:15pt;height:15pt;border:1.2pt solid #ad5275;border-radius:9pt}.clock-hour {position:absolute;left:6.5pt;top:3pt;width:1.2pt;height:5pt;background:#ad5275;border-radius:.6pt}.clock-minute {position:absolute;left:6.5pt;top:7pt;width:4.5pt;height:1.2pt;background:#ad5275;border-radius:.6pt}
.status-title {font-size:11.5pt;line-height:14pt;font-weight:700;color:#8e4162}.status-copy {margin-top:3pt;font-size:8pt;line-height:11pt;color:#846876}
.date-card {background:#fff;border:.6pt solid #e9dce5;border-radius:8pt;padding:4pt 5pt 5pt;text-align:center}.date-card.due-date {border-color:#dfcedd;background:#f8f1f7}.date-caption {font-size:8pt;line-height:10pt;color:#927887}.date-card strong {display:block;font-size:11pt;line-height:13pt;margin-top:3pt;color:#63445b;white-space:nowrap}
.order-ref {text-align:right;font-size:7pt;color:#98808d;margin:5pt 0 6pt}
.identities {page-break-inside:avoid}
.parties-grid > tbody > tr > td,.parties-grid > tr > td {padding:0;vertical-align:top}
.parties-grid .seller-col {width:50%;padding-right:6pt}.parties-grid .buyer-col {width:50%;padding-left:6pt}
.party-card {border:.7pt solid #e8d6df;border-radius:11pt;overflow:hidden;background:#fff}
.party-head {background:#fcf0f4;border-bottom:.6pt solid #f0e0e8;padding:6pt 11pt;border-radius:10pt 10pt 0 0}
.party-card.client {border-color:#dfd4e3}.client .party-head {background:#f5f0f7;border-bottom-color:#e8dfec}
.party-caption {font-size:7.2pt;line-height:9pt;color:#a25578;letter-spacing:1pt;font-weight:700;margin-bottom:5pt}
.client .party-caption {color:#87658f}.party-head h2 {font-size:12.5pt;line-height:15pt;margin:0 0 4pt;color:#57394e}
.party-subtitle {font-size:8pt;line-height:10pt;color:#927a88}
.party-body {padding:6pt 11pt;font-size:8.5pt;line-height:11pt;color:#584650}
.party-address {min-height:32pt;margin-bottom:4pt}.party-address .address-label {font-size:7.5pt;line-height:9pt;color:#9d8191;margin-bottom:3pt}
.party-contact {table-layout:auto}.party-contact td {padding:1pt 0;font-size:8.3pt;line-height:10pt}
.party-contact .contact-label {width:33pt;font-size:7.5pt;color:#9d8191}
.seller-reference {border:.6pt solid #eadfe5;border-radius:8pt;background:#fcf9fb;margin-top:6pt;padding:5pt 10pt;color:#927988;font-size:7.6pt;line-height:10pt}
.seller-reference table {table-layout:fixed}.seller-reference td {padding:0;vertical-align:middle}.seller-reference .fiscal {width:55%;padding-right:10pt}.seller-reference .bank {width:45%;border-left:.6pt solid #e8dde4;padding-left:12pt}
.seller-reference strong {color:#745366;font-weight:700}.seller-reference .second-line {margin-top:4pt}.seller-reference .bank-iban {font-size:8.3pt;letter-spacing:.2pt;color:#745366}
.section-heading {margin:8pt 0 6pt}.section-heading td {font-size:8pt;letter-spacing:1pt;font-weight:700;color:#705067}.section-heading .count {text-align:right;letter-spacing:0;font-size:7.5pt;color:#a06881}
.product-wrap {border:.7pt solid #ded1db;border-radius:9pt;overflow:hidden}.products th {background:#62465c;color:white;font-size:7.4pt;font-weight:700;text-align:center;padding:6pt 3pt;line-height:10pt}.products th small {color:#e6d7e1;font-size:6.5pt}.products th:first-child {border-radius:8pt 0 0 0}.products th:last-child {border-radius:0 8pt 0 0}.products td {padding:4pt 4pt;vertical-align:middle;border-top:.5pt solid #eee5eb;font-size:8pt}.products tr {page-break-inside:avoid}.products .idx {text-align:center;color:#b16585}.products .center {text-align:center}.products .amount {text-align:right;white-space:nowrap;font-size:7.7pt}.products .name {font-size:9pt;color:#543c4e;font-weight:700;line-height:10pt}.sku {font-size:6.9pt;color:#957a8b;margin-top:4pt}.photo {width:26pt;height:31pt;border-radius:6pt}.vat-pill {display:block;width:24pt;margin:0 auto;background:#f4edf2;border-radius:8pt;color:#80516e;font-size:7pt;line-height:10pt;text-align:center;white-space:nowrap;padding:1.25pt 0 2.75pt}.products .last {color:#68435b;font-weight:700}.products tbody tr:nth-child(even) td {background:#fcfafb}
.lower {margin-top:10pt}.lower .instructions-col {width:54%;padding-right:12pt}.lower .totals-col {width:46%;padding-left:0}.payment {border:.7pt solid #e0d4dc;border-top:3pt solid #b76a87;border-radius:9pt;overflow:hidden}.card-head {background:#faf0f4;padding:6pt 9pt;font-size:7pt;letter-spacing:.8pt;color:#8c4e6b;font-weight:700}.card-head span {float:right;font-size:6pt;letter-spacing:0}.payment-body {padding:3pt 9pt 5pt}.payment td {line-height:10pt;padding:1pt 0;border-bottom:.5pt solid #ece3e9;font-size:7.6pt}.payment .key {width:30%;font-size:6.5pt;color:#917b89;letter-spacing:.4pt;font-weight:700}.payment .ref {color:#9a5375;font-weight:700}.payment .bank-row td {border-bottom:0}.iban {font-size:6.8pt!important;white-space:nowrap}
.mentions {border:.7pt solid #ead8e1;border-radius:8pt;background:#fcf6f8;margin-top:7pt;padding:7pt 9pt}.mentions .title {font-size:6.7pt;letter-spacing:1pt;font-weight:700;color:#9c607c;margin-bottom:5pt}.mention-row {border-left:2pt solid #c789a2;padding-left:6pt;font-size:7.2pt;color:#796370;line-height:10pt}.mention-row+.mention-row {margin-top:6pt}.mention-row strong {font-size:6.4pt;letter-spacing:.3pt;color:#9b6d83}
.vat-summary {font-size:7pt;color:#95808e}.vat-summary td,.vat-summary th {padding:3pt 3pt;border-bottom:.6pt solid #e9e0e6}.vat-summary th {font-weight:700;text-align:right}.vat-summary th:first-child {text-align:left}.right-text {text-align:right}.totals {margin-top:6pt}.totals td {line-height:10pt;padding:3pt 3pt;border-bottom:.5pt solid #eee6eb;font-size:9pt}.totals .total td {font-weight:700;font-size:10pt;border:0;padding-top:7pt}.due {background:#754860;color:#fff;border-radius:10pt;margin-top:7pt;padding:8pt 9pt}.due td {vertical-align:middle;padding:0}.due .due-label {font-size:7pt;letter-spacing:1pt;font-weight:700}.due .due-value {text-align:right;font-size:17pt;font-weight:700;line-height:22pt}.due-note {font-size:6.5pt;text-align:right;color:#ae8e9e;margin-top:4pt}
.thanks {margin-top:8pt;border:.7pt solid #e3d5df;border-top:3pt solid #b77892;border-radius:10pt;padding:5pt 9pt}.thanks table {table-layout:auto}.thanks td {vertical-align:middle}.thanks .seal-cell {width:42pt}.seal {width:28pt;height:28pt}.thanks .message {width:58%;padding-right:10pt}.thanks .message strong {font-size:11pt;color:#63445a}.thanks .message p {line-height:9pt;font-size:7.6pt;color:#97808d;margin-top:3pt}.thanks .contact {line-height:9pt;border-left:.6pt solid #e8dde4;padding-left:10pt}.contact .label {line-height:7pt;font-size:6pt;letter-spacing:1pt;color:#a08395;font-weight:700}.contact a {line-height:9pt;text-decoration:none;color:#a45f7f;font-size:8pt;font-weight:700}
.footer {position:fixed;bottom:-52pt;left:0;right:0;border-top:.6pt solid #ded1dc;padding-top:6pt}.legal {font-size:5.5pt;line-height:7.5pt;color:#8b7986;text-align:center}.footer-id {font-size:6.5pt;color:#826879;margin-top:7pt;font-weight:700;letter-spacing:.3pt}
</style></head><body>
<div class="footer">
<p class="legal">{% if fiscal_accepted|default(false) %}Exemplarul electronic original este documentul XML validat prin sistemul fiscal. {% endif %}Factura ține loc de document justificativ pentru garanție. Solicitări: {{ company.email }}. Drepturile legale se acordă conform OUG nr. 140/2021.</p>
<div class="footer-id">{{ number }} &nbsp; | &nbsp; {% if preview %}MODEL · FĂRĂ VALOARE FISCALĂ{% else %}{{ company.trade_name ?: company.legal_name }}{% endif %}</div></div>
<div class="top-line"></div>
<table class="brand"><tr><td><img class="logo" src="{{ logo }}" alt="La Măriuca Boutique"></td><td class="heading"><div class="eyebrow">{{ preview ? "MODEL DE FACTURĂ" : "LA MĂRIUCA BOUTIQUE" }}</div><h1>{{ document_title|default("FACTURĂ") }}</h1><div class="number">{{ number }}</div></td></tr></table>
<div class="status"><table class="status-grid"><tr>
<td class="status-label"><div class="status-identity"><div class="status-symbol"><div class="status-clock"><div class="clock-hour"></div><div class="clock-minute"></div></div></div><div class="status-title">{{ payment_label|default("Neplătită") }}</div><div class="status-copy">{{ payment_copy|default("Ramburs, la primirea comenzii.") }}</div></div></td>
<td class="date-cell"><div class="date-card"><div class="date-caption">Data emiterii</div><strong>{{ date }}</strong></div></td>
<td class="date-cell"><div class="date-card due-date"><div class="date-caption">Scadență</div><strong>{{ due_date }}</strong></div></td>
</tr></table></div>
<div class="order-ref">Comandă {{ order_number|default("LM-DEMO") }}{% if preview %} &nbsp; · &nbsp; Exemplu de prezentare{% elseif original_reference|default("") %} &nbsp; · &nbsp; {{ original_reference }}{% endif %}</div>
<div class="identities">
<table class="parties-grid"><tr>
<td class="seller-col"><div class="party-card">
  <div class="party-head"><div class="party-caption">FURNIZOR</div><h2>{{ company.trade_name ?: company.legal_name }}</h2><div class="party-subtitle">{% if company.trade_name %}{{ company.legal_name }}{% endif %}</div></div>
  <div class="party-body">
    <div class="party-address"><div class="address-label">Sediu social</div>{{ company.registered_address }}<br>{{ company.postal_code }} {{ company.city }}{% if company.county and company.county not in company.city %}, {{ company.county }}{% endif %}{% if company.country %}, {{ company.country }}{% endif %}</div>
    <table class="party-contact"><tr><td class="contact-label">Telefon</td><td>{{ company.phone }}</td></tr><tr><td class="contact-label">Email</td><td>{{ company.email }}</td></tr></table>
  </div>
</div></td>
<td class="buyer-col"><div class="party-card client">
  <div class="party-head"><div class="party-caption">CLIENT</div><h2>{{ customer.name }}</h2><div class="party-subtitle">{{ customer.type_label|default("Persoană fizică · Date demonstrative") }}{% if customer.tax_id|default("") %} · CUI {{ customer.tax_id }}{% endif %}</div></div>
  <div class="party-body">
    <div class="party-address"><div class="address-label">Adresă de facturare</div>{% for part in customer.address|split(', ', 2) %}{{ part }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
    <table class="party-contact"><tr><td class="contact-label">Telefon</td><td>{{ customer.phone }}</td></tr><tr><td class="contact-label">Email</td><td>{{ customer.email }}</td></tr></table>
  </div>
</div></td>
</tr></table>
<div class="seller-reference"><table><tr>
<td class="fiscal">CUI furnizor <strong>{{ company.tax_id }}</strong> &nbsp;·&nbsp; Reg. com. <strong>{{ company.trade_register }}</strong><div class="second-line">Capital social <strong>{{ company.capital_display }}</strong></div></td>
<td class="bank">Banca furnizorului <strong>{{ company.bank_name }}</strong><div class="second-line bank-iban">{{ company.iban_display }}</div></td>
</tr></table></div>
</div>
<table class="section-heading"><tr><td>DETALII FACTURĂ</td><td class="count">{{ lines|length }} poziții</td></tr></table>
<div class="product-wrap"><table class="products"><thead><tr><th style="width:3%">#</th><th style="width:9%">Foto</th><th style="width:25%">Articol facturat</th><th style="width:6%">U.M.</th><th style="width:6%">Cant.</th><th style="width:13%">Preț unitar<br><small>fără TVA</small></th><th style="width:6%">TVA</th><th style="width:15%">Valoare<br><small>fără TVA</small></th><th style="width:17%">Total</th></tr></thead><tbody>
{% for line in lines %}<tr><td class="idx">{{ loop.index }}</td><td class="center">{% if line.image_data %}<img class="photo" src="{{ line.image_data }}">{% endif %}</td><td><div class="name">{{ line.name }}</div><div class="sku">{{ line.sku }}{% if line.discount_display|default("") %}<br>Reducere: {{ line.discount_display }}{% endif %}</div></td><td class="center">{{ line.unit|default("buc.") }}</td><td class="center">{{ line.quantity }}</td><td class="amount">{{ line.unit_net }}</td><td class="center"><span class="vat-pill">{{ line.vat|default(vat) }}%</span></td><td class="amount">{{ line.net }}</td><td class="amount last">{{ line.total }}</td></tr>{% endfor %}
</tbody></table></div>
<table class="lower"><tr><td class="instructions-col"><div class="payment"><div class="card-head">INSTRUCȚIUNI DE PLATĂ <span>{{ payment_method_label|default("RAMBURS LA CURIER") }}</span></div><div class="payment-body"><table><tr><td class="key">Metodă</td><td>{{ payment_method_label|default("Ramburs la curier") }}</td></tr><tr><td class="key">Referință</td><td class="ref">{{ number }}</td></tr><tr><td class="key">IBAN</td><td class="iban">{{ company.iban_display }}</td></tr><tr class="bank-row"><td class="key">Banca</td><td>{{ company.bank_name }}</td></tr></table></div></div>
<div class="mentions"><div class="title">MENȚIUNI · INFORMAȚII UTILE</div><div class="mention-row"><strong>REGIM FISCAL</strong><br>{% if company.is_vat_payer %}Societate înregistrată în scopuri de TVA. Cotă aplicată: {{ vat }}%.{% else %}Societate neînregistrată în scopuri de TVA. TVA aplicată: 0%.{% endif %}</div>{% if notes %}<div class="mention-row"><strong>NOTE</strong><br>{{ notes|nl2br }}</div>{% endif %}</div></td>
<td class="totals-col"><table class="vat-summary"><tr><th>Sumar TVA</th><th>Bază</th><th>TVA</th></tr>{% for group in vat_groups|default([{rate:vat,net:net,tax:tax}]) %}<tr><td>TVA {{ group.rate }}%</td><td class="right-text">{{ group.net }}</td><td class="right-text">{{ group.tax }}</td></tr>{% endfor %}</table><table class="totals"><tr><td>Subtotal fără TVA</td><td class="right-text">{{ net }}</td></tr><tr><td>Total TVA</td><td class="right-text">{{ tax }}</td></tr><tr class="total"><td>Total factură</td><td class="right-text">{{ total }}</td></tr></table><div class="due"><table><tr><td class="due-label">{{ balance_label|default("DE PLATĂ") }}</td><td class="due-value">{{ balance_display|default(total) }}</td></tr></table></div><div class="due-note">Sume exprimate în RON</div></td></tr></table>
<div class="thanks"><table><tr><td class="seal-cell"><img class="seal" src="{{ monogram }}"></td><td class="message"><strong>Mulțumim că ai ales La Măriuca.</strong><p>Cu grijă pentru fiecare mică bucurie.</p></td><td class="contact"><div class="label">ONLINE</div><a href="{{ company.website }}">{{ company.website_display }}</a><div class="label" style="margin-top:4pt">CONTACT</div><a href="mailto:{{ company.email }}">{{ company.email }}</a></td></tr></table></div>

</body></html>
