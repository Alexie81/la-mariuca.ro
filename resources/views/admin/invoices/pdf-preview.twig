<!DOCTYPE html>
<html lang="ro"><head><meta charset="UTF-8"><title>Model factură · {{ company.trade_name }}</title>
<style>
@font-face {font-family:'Nunito PDF';font-weight:400;src:url('{{ font_regular }}') format('truetype')}
@font-face {font-family:'Nunito PDF';font-weight:700;src:url('{{ font_bold }}') format('truetype')}
@page {margin:28pt 28pt 81pt}
* {box-sizing:border-box} body {margin:0;font-family:'Nunito PDF',sans-serif;font-size:8.4pt;line-height:11pt;color:#453640}
table {width:100%;border-collapse:collapse;table-layout:fixed} td {vertical-align:top} strong,b {font-weight:700} p {margin:0}
.top-line {height:5pt;background:#805369;border-radius:3pt;margin-bottom:11pt}
.brand td {padding:0;vertical-align:middle;height:52pt}.logo {width:166pt;height:56pt}.heading {text-align:right;width:42%}
.eyebrow {font-size:7pt;letter-spacing:1.5pt;color:#9a808d;font-weight:700}.heading h1 {font-size:25pt;line-height:29pt;color:#4f3649;margin:4pt 0 3pt}.number {font-size:13pt;color:#b55375;font-weight:700}
.status {border:0.6pt solid #e9d6df;border-radius:10pt;background:#fcf4f6;margin-top:9pt}.status td {padding:6pt 10pt;vertical-align:middle}.status-label {width:62%}.date {width:19%;border-left:0.6pt solid #ead8df;text-align:center}.small {font-size:7pt;color:#8a7580}.date strong {display:block;font-size:10pt;margin-top:3pt;color:#755063}
.pill {display:inline-block;background:#b95675;border-radius:15pt;padding:3pt 12pt;color:#fff;font-size:7.2pt;font-weight:700;letter-spacing:.7pt}.status-copy {margin-top:5pt;font-size:8.5pt;color:#765064}.order-ref {text-align:right;font-size:7pt;color:#98808d;margin:5pt 0 10pt}
.identities {border:.7pt solid #e5d9e1;border-radius:11pt;padding:9pt 12pt;background:#fff;page-break-inside:avoid}
.identities table {table-layout:fixed}.identities td {padding:0;vertical-align:top}
.identities .seller {width:50%;padding-right:13pt}.identities .buyer {width:50%;padding-left:13pt;border-left:.7pt solid #e8dde4}
.identity-heading {min-height:42pt}.identity-heading .cap {font-size:6.7pt;line-height:8pt;letter-spacing:1pt;font-weight:700;color:#a1617e;margin-bottom:5pt}.buyer .cap {color:#76566e}
.identity-heading h2 {font-size:12pt;line-height:14pt;margin:0 0 3pt;color:#51394b}.identity-subtitle {font-size:7.6pt;line-height:9pt;color:#8a7580}
.identity-address {border-top:.6pt solid #eee5eb;padding-top:4pt;margin-top:5pt;min-height:37pt}
.field-label {font-size:6.5pt;line-height:8pt;color:#9b8492;letter-spacing:.35pt;margin-bottom:2pt;font-weight:700}
.field-value {font-size:8pt;line-height:10pt;color:#574450;word-wrap:break-word}
.identity-contact {margin-top:5pt}.identity-contact .phone {width:42%;padding-right:5pt}.identity-contact .email {width:58%}.identity-contact .field-value {font-size:7.5pt}
.identity-meta {border-top:.6pt solid #eee5eb;margin-top:5pt;padding-top:4pt}.identity-meta .field-value {font-size:7.4pt;line-height:9pt}.identity-meta .fiscal-id {width:28%}.identity-meta .registration {width:43%}.identity-meta .capital {width:29%}.identity-meta .field-label {font-size:6pt;letter-spacing:0}
.identity-bank {font-size:7pt;line-height:9pt;color:#8a7580;margin-top:5pt}.identity-bank strong {font-weight:700;color:#77586c}.identity-bank .bank-iban {font-size:7.2pt}
.section-heading {margin:10pt 0 6pt}.section-heading td {font-size:8pt;letter-spacing:1pt;font-weight:700;color:#705067}.section-heading .count {text-align:right;letter-spacing:0;font-size:7.5pt;color:#a06881}
.product-wrap {border:.7pt solid #ded1db;border-radius:9pt;overflow:hidden}.products th {background:#62465c;color:white;font-size:7.4pt;font-weight:700;text-align:center;padding:6pt 3pt;line-height:10pt}.products th small {color:#e6d7e1;font-size:6.5pt}.products th:first-child {border-radius:8pt 0 0 0}.products th:last-child {border-radius:0 8pt 0 0}.products td {padding:4pt 4pt;vertical-align:middle;border-top:.5pt solid #eee5eb;font-size:8pt}.products tr {page-break-inside:avoid}.products .idx {text-align:center;color:#b16585}.products .center {text-align:center}.products .amount {text-align:right;white-space:nowrap;font-size:7.7pt}.products .name {font-size:9pt;color:#543c4e;font-weight:700;line-height:10pt}.sku {font-size:6.9pt;color:#957a8b;margin-top:4pt}.photo {width:26pt;height:31pt;border-radius:6pt}.vat-pill {display:block;width:24pt;margin:0 auto;background:#f4edf2;border-radius:8pt;color:#80516e;font-size:7pt;line-height:10pt;text-align:center;white-space:nowrap;padding:1.25pt 0 2.75pt}.products .last {color:#68435b;font-weight:700}.products tbody tr:nth-child(even) td {background:#fcfafb}
.lower {margin-top:10pt}.lower .instructions-col {width:54%;padding-right:12pt}.lower .totals-col {width:46%;padding-left:0}.payment {border:.7pt solid #e0d4dc;border-top:3pt solid #b76a87;border-radius:9pt;overflow:hidden}.card-head {background:#faf0f4;padding:6pt 9pt;font-size:7pt;letter-spacing:.8pt;color:#8c4e6b;font-weight:700}.card-head span {float:right;font-size:6pt;letter-spacing:0}.payment-body {padding:3pt 9pt 5pt}.payment td {line-height:10pt;padding:2pt 0;border-bottom:.5pt solid #ece3e9;font-size:7.6pt}.payment .key {width:30%;font-size:6.5pt;color:#917b89;letter-spacing:.4pt;font-weight:700}.payment .ref {color:#9a5375;font-weight:700}.payment .bank-row td {border-bottom:0}.iban {font-size:6.8pt!important;white-space:nowrap}
.mentions {border:.7pt solid #ead8e1;border-radius:8pt;background:#fcf6f8;margin-top:7pt;padding:7pt 9pt}.mentions .title {font-size:6.7pt;letter-spacing:1pt;font-weight:700;color:#9c607c;margin-bottom:5pt}.mention-row {border-left:2pt solid #c789a2;padding-left:6pt;font-size:7.2pt;color:#796370;line-height:10pt}.mention-row+.mention-row {margin-top:6pt}.mention-row strong {font-size:6.4pt;letter-spacing:.3pt;color:#9b6d83}
.vat-summary {font-size:7pt;color:#95808e}.vat-summary td,.vat-summary th {padding:3pt 3pt;border-bottom:.6pt solid #e9e0e6}.vat-summary th {font-weight:700;text-align:right}.vat-summary th:first-child {text-align:left}.right-text {text-align:right}.totals {margin-top:6pt}.totals td {line-height:10pt;padding:3pt 3pt;border-bottom:.5pt solid #eee6eb;font-size:9pt}.totals .total td {font-weight:700;font-size:10pt;border:0;padding-top:7pt}.due {background:#754860;color:#fff;border-radius:10pt;margin-top:7pt;padding:8pt 9pt}.due td {vertical-align:middle;padding:0}.due .due-label {font-size:7pt;letter-spacing:1pt;font-weight:700}.due .due-value {text-align:right;font-size:17pt;font-weight:700;line-height:22pt}.due-note {font-size:6.5pt;text-align:right;color:#ae8e9e;margin-top:4pt}
.thanks {margin-top:8pt;border:.7pt solid #e3d5df;border-top:3pt solid #b77892;border-radius:10pt;padding:7pt 9pt}.thanks table {table-layout:auto}.thanks td {vertical-align:middle}.thanks .seal-cell {width:42pt}.seal {width:33pt;height:33pt}.thanks .message {width:58%;padding-right:10pt}.thanks .message strong {font-size:11pt;color:#63445a}.thanks .message p {line-height:9pt;font-size:7.6pt;color:#97808d;margin-top:3pt}.thanks .contact {line-height:9pt;border-left:.6pt solid #e8dde4;padding-left:10pt}.contact .label {line-height:7pt;font-size:6pt;letter-spacing:1pt;color:#a08395;font-weight:700}.contact a {line-height:9pt;text-decoration:none;color:#a45f7f;font-size:8pt;font-weight:700}
.footer {position:fixed;bottom:-52pt;left:0;right:0;border-top:.6pt solid #ded1dc;padding-top:6pt}.legal {font-size:5.5pt;line-height:7.5pt;color:#8b7986;text-align:center}.footer-id {font-size:6.5pt;color:#826879;margin-top:7pt;font-weight:700;letter-spacing:.3pt}
</style></head><body>
<div class="footer">
<p class="legal">Factura aferentă acestui document se transmite prin sistemul național RO e-Factura, în format XML. Exemplarul original al facturii electronice se consideră fișierul XML însoțit de sigiliul electronic al Ministerului Finanțelor, conform art. 4 alin. (6) din OUG nr. 120/2021. Factura ține loc de document justificativ pentru garanție. Solicitări: {{ company.email }}. Drepturile legale se acordă conform OUG nr. 140/2021.</p>
<div class="footer-id">{{ number }} &nbsp; | &nbsp; MODEL · FĂRĂ VALOARE FISCALĂ</div></div>
<div class="top-line"></div>
<table class="brand"><tr><td><img class="logo" src="{{ logo }}" alt="La Măriuca Boutique"></td><td class="heading"><div class="eyebrow">MODEL DE FACTURĂ</div><h1>FACTURĂ</h1><div class="number">{{ number }}</div></td></tr></table>
<table class="status"><tr><td class="status-label"><span class="pill">NEPLĂTITĂ</span><div class="status-copy">Plată ramburs, la primirea comenzii.</div></td><td class="date"><span class="small">Data emiterii</span><strong>{{ date }}</strong></td><td class="date"><span class="small">Scadență</span><strong>{{ due_date }}</strong></td></tr></table>
<div class="order-ref">Comandă LM-DEMO &nbsp; · &nbsp; Exemplu de prezentare</div>
<div class="identities"><table><tr><td class="seller">
<div class="identity-heading"><div class="cap">FURNIZOR</div><h2>{{ company.trade_name ?: company.legal_name }}</h2><div class="identity-subtitle">{% if company.trade_name %}{{ company.legal_name }}{% endif %}</div></div>
<div class="identity-address"><div class="field-label">SEDIU SOCIAL</div><div class="field-value">{{ company.registered_address }}<br>{{ company.postal_code }} {{ company.city }}{% if company.county and company.county not in company.city %}, {{ company.county }}{% endif %}{% if company.country %}, {{ company.country }}{% endif %}</div></div>
<table class="identity-contact"><tr><td class="phone"><div class="field-label">TELEFON</div><div class="field-value">{{ company.phone }}</div></td><td class="email"><div class="field-label">EMAIL</div><div class="field-value">{{ company.email }}</div></td></tr></table>
<div class="identity-meta"><table><tr><td class="fiscal-id"><div class="field-label">CUI</div><div class="field-value">{{ company.tax_id }}</div></td><td class="registration"><div class="field-label">REGISTRUL COMERȚULUI</div><div class="field-value">{{ company.trade_register }}</div></td><td class="capital"><div class="field-label">CAPITAL SOCIAL</div><div class="field-value">{{ company.capital_display }}</div></td></tr></table></div>
<div class="identity-bank"><strong>{{ company.bank_name }}</strong> &nbsp;·&nbsp; <span class="bank-iban">{{ company.iban_display }}</span></div>
</td><td class="buyer">
<div class="identity-heading"><div class="cap">CLIENT</div><h2>{{ customer.name }}</h2><div class="identity-subtitle">Persoană fizică · Date demonstrative</div></div>
<div class="identity-address"><div class="field-label">ADRESĂ DE FACTURARE</div><div class="field-value">{{ customer.address }}</div></div>
<table class="identity-contact"><tr><td class="phone"><div class="field-label">TELEFON</div><div class="field-value">{{ customer.phone }}</div></td><td class="email"><div class="field-label">EMAIL</div><div class="field-value">{{ customer.email }}</div></td></tr></table>
</td></tr></table></div>
<table class="section-heading"><tr><td>DETALII FACTURĂ</td><td class="count">{{ lines|length }} poziții</td></tr></table>
<div class="product-wrap"><table class="products"><thead><tr><th style="width:3%">#</th><th style="width:9%">Foto</th><th style="width:25%">Articol facturat</th><th style="width:6%">U.M.</th><th style="width:6%">Cant.</th><th style="width:13%">Preț unitar<br><small>fără TVA</small></th><th style="width:6%">TVA</th><th style="width:15%">Valoare<br><small>fără TVA</small></th><th style="width:17%">Total</th></tr></thead><tbody>
{% for line in lines %}<tr><td class="idx">{{ loop.index }}</td><td class="center"><img class="photo" src="{{ line.image_data }}"></td><td><div class="name">{{ line.name }}</div><div class="sku">{{ line.sku }}</div></td><td class="center">buc.</td><td class="center">{{ line.quantity }}</td><td class="amount">{{ line.unit_net }}</td><td class="center"><span class="vat-pill">{{ vat }}%</span></td><td class="amount">{{ line.net }}</td><td class="amount last">{{ line.total }}</td></tr>{% endfor %}
</tbody></table></div>
<table class="lower"><tr><td class="instructions-col"><div class="payment"><div class="card-head">INSTRUCȚIUNI DE PLATĂ <span>RAMBURS LA CURIER</span></div><div class="payment-body"><table><tr><td class="key">Metodă</td><td>Ramburs la curier</td></tr><tr><td class="key">Referință</td><td class="ref">{{ number }}</td></tr><tr><td class="key">IBAN</td><td class="iban">{{ company.iban_display }}</td></tr><tr class="bank-row"><td class="key">Banca</td><td>{{ company.bank_name }}</td></tr></table></div></div>
<div class="mentions"><div class="title">MENȚIUNI · INFORMAȚII UTILE</div><div class="mention-row"><strong>REGIM FISCAL</strong><br>{% if company.is_vat_payer %}Societate înregistrată în scopuri de TVA. Cotă aplicată în model: {{ vat }}%.{% else %}Societate neînregistrată în scopuri de TVA. TVA aplicată: 0%.{% endif %}</div>{% if notes %}<div class="mention-row"><strong>NOTE</strong><br>{{ notes|nl2br }}</div>{% endif %}</div></td>
<td class="totals-col"><table class="vat-summary"><tr><th>Sumar TVA</th><th>Bază</th><th>TVA</th></tr><tr><td>TVA {{ vat }}%</td><td class="right-text">{{ net }}</td><td class="right-text">{{ tax }}</td></tr></table><table class="totals"><tr><td>Subtotal fără TVA</td><td class="right-text">{{ net }}</td></tr><tr><td>Total TVA</td><td class="right-text">{{ tax }}</td></tr><tr class="total"><td>Total factură</td><td class="right-text">{{ total }}</td></tr></table><div class="due"><table><tr><td class="due-label">DE PLATĂ</td><td class="due-value">{{ total }}</td></tr></table></div><div class="due-note">Sume exprimate în RON</div></td></tr></table>
<div class="thanks"><table><tr><td class="seal-cell"><img class="seal" src="{{ monogram }}"></td><td class="message"><strong>Mulțumim că ai ales La Măriuca.</strong><p>Cu grijă pentru fiecare mică bucurie.</p></td><td class="contact"><div class="label">ONLINE</div><a href="{{ company.website }}">{{ company.website_display }}</a><div class="label" style="margin-top:4pt">CONTACT</div><a href="mailto:{{ company.email }}">{{ company.email }}</a></td></tr></table></div>

</body></html>
