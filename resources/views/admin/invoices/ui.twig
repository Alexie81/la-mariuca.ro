{% macro pagination(data) %}{% import 'admin/partials/nir-ui.twig' as n %}<nav class="iv-pagination" aria-label="Paginare facturi"><span><b>{{ data.from }}–{{ data.to }}</b> din {{ data.total }} documente</span><div>{% if data.previous_url %}<a class="iv-icon" href="{{ data.previous_url }}" aria-label="Pagina anterioară">{{ n.icon('back') }}</a>{% else %}<button class="iv-icon" disabled aria-label="Pagina anterioară">{{ n.icon('back') }}</button>{% endif %}<span>{{ data.page }} / {{ data.pages }}</span>{% if data.next_url %}<a class="iv-icon" href="{{ data.next_url }}" aria-label="Pagina următoare">{{ n.icon('arrow') }}</a>{% else %}<button class="iv-icon" disabled aria-label="Pagina următoare">{{ n.icon('arrow') }}</button>{% endif %}</div></nav>{% endmacro %}
{% macro shell() %}{% import 'admin/partials/nir-ui.twig' as n %}<dialog class="iv-dialog" data-iv-dialog aria-label="Administrare factură"><div data-iv-dialog-content></div></dialog><dialog class="iv-discard" data-iv-discard aria-labelledby="iv-discard-title"><span class="iv-mark">{{ n.icon('edit') }}</span><h2 id="iv-discard-title">Păstrăm modificările?</h2><p>Ai date nesalvate. Dacă închizi acum, ele se pierd.</p><div class="iv-actions"><button class="iv-btn" data-iv-keep>Continuă editarea</button><button class="iv-btn iv-btn--rose" data-iv-abandon>Renunță la modificări</button></div></dialog><dialog class="iv-loader" data-iv-loader aria-label="Pregătim documentul"><span class="iv-spinner"><img src="{{ url('assets/images/favicon-lm-192.png') }}" alt="La Măriuca"></span><strong>Pregătim documentele</strong><p>Mai durează un moment.</p></dialog><dialog class="iv-lightbox" data-iv-lightbox aria-label="Imagine produs"><button class="iv-icon" data-iv-lightbox-close aria-label="Închide imaginea">{{ n.icon('close') }}</button><img src="" alt=""><span></span></dialog><div class="iv-toast" role="status" data-iv-toast hidden>{{ n.icon('check') }}<span></span></div>{% endmacro %}
