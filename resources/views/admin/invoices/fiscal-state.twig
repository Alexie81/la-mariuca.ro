{% import 'admin/partials/nir-ui.twig' as n %}
<section class="iv-fiscal-state is-{{ doc.fiscal.tone }}" data-spv-document data-spv-can-delete="{{ doc.can_delete ? '1' : '0' }}" data-spv-locked="{{ doc.fiscal_attempted_at ? '1' : '0' }}" data-spv-state="{{ doc.fiscal_state }}"><span class="iv-state-icon">{{ n.icon(doc.fiscal.icon) }}</span><div><span class="iv-state-caption">SPV · RO e-Factura{% if spv or doc.fiscal_job %} · {{ (spv.environment|default(doc.fiscal_job.environment|default('test'))) == 'test' ? 'Mediu de test' : 'Producție' }}{% endif %}</span><h2>{{ doc.fiscal.label }}</h2><p>{{ doc.fiscal.description }}</p>{% if doc.fiscal_reference %}<span class="iv-fiscal-reference">Referință ANAF <b>{{ doc.fiscal_reference }}</b><button class="iv-icon" type="button" data-iv-copy="{{ doc.fiscal_reference }}" aria-label="Copiază referința ANAF">{{ n.icon('copy') }}</button></span>{% endif %}{% include 'admin/invoices/spv-schedule.twig' with {schedule:doc.spv_schedule} %}{% if doc.fiscal_job.last_error|default('') %}<details><summary>Detaliile răspunsului</summary><p>{{ doc.fiscal_job.last_error }}</p></details>{% endif %}{% if can_manage_spv and spv %}{% include 'admin/invoices/spv-actions.twig' %}{% endif %}</div>{% if can_manage_spv %}<a class="iv-icon" href="{{ url('admin/spv-efactura/') }}" aria-label="Setări SPV" title="Setări SPV">{{ n.icon('arrow') }}</a>{% endif %}</section>
