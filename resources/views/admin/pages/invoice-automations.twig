{% extends 'admin/layouts/base.twig' %}
{% import 'admin/partials/company-ui.twig' as ui %}
{% macro payment_icon(method) %}<svg viewBox="0 0 24 24" aria-hidden="true">{% if method == 'card' %}<rect x="3" y="5" width="18" height="14" rx="4"/><path d="M3 10h18M7 15h3"/>{% else %}<path d="m12 3 9 6v11H3V9l9-6Z"/><path d="M8 11h8M8 15h5"/>{% endif %}</svg>{% endmacro %}
{% block title %}Automatizări{% endblock %}
{% block content %}
<div class="ia-page">
  <header class="ia-hero">
    <div class="ia-hero-copy"><span class="ia-eyebrow">Facturare · Mai puțini pași</span><h1>Automatizări</h1><p>Tu alegi regulile. Factura urmează plata și starea comenzii.</p></div>
    <div class="ia-hero-art" aria-hidden="true"><span class="ia-orbit"></span><span class="ia-bolt"><svg viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8 10-13h-7l1-7Z"/></svg></span><span class="ia-mini">{{ ui.icon('document') }}</span></div>
  </header>
  <aside class="ia-ready"><span class="ia-ready-icon">{{ ui.icon('document') }}</span><div><strong>Factura se ocupă de următorul pas</strong><p>Regulile alese se aplică următoarelor comenzi eligibile. Facturile și emailurile se procesează pe server, chiar dacă această pagină este închisă.</p></div><span class="ia-stage">Conectat la comenzi</span></aside>
  <form action="{{ url('admin/automatizari/') }}" method="post" data-invoice-automations>
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="revision" value="{{ settings.revision }}">
    <div class="ia-error" role="alert" tabindex="-1" data-ia-error{% if not error %} hidden{% endif %}><span data-ia-error-text>{{ error }}</span><button type="button" data-ia-reload hidden>Reîncarcă setările</button></div>
    <div class="ia-section-heading"><div><span class="ia-eyebrow">După metoda de plată</span><h2>Când emitem și trimitem factura?</h2></div><span class="ia-count"><strong data-ia-count>{{ settings.card_issue + settings.card_email + settings.cod_issue + settings.cod_email }}</strong> din 4 reguli selectate</span></div>
    <div class="ia-methods">
    {% for method, title in {'card':'Card online', 'cod':'Ramburs'} %}
      {% set issue = attribute(settings, method ~ '_issue') %}{% set email = attribute(settings, method ~ '_email') %}
      <section class="ia-method ia-method--{{ method }}" aria-labelledby="ia-title-{{ method }}">
        <header class="ia-method-head"><span class="ia-method-icon">{{ _self.payment_icon(method) }}</span><div><span class="ia-eyebrow">{{ method == 'card' ? 'Plată online' : 'Plată la livrare' }}</span><h3 id="ia-title-{{ method }}">{{ title }}</h3></div><span class="ia-method-number" aria-hidden="true">{{ method == 'card' ? '01' : '02' }}</span></header>
        <div class="ia-trigger"><span class="ia-trigger-dot"></span><p>{{ method == 'card' ? 'După ce plata este reușită și comanda este confirmată.' : 'Când o comandă ramburs este plasată și intră în starea Nouă.' }}</p></div>
        <div class="ia-rules">
          <label class="ia-rule" for="ia-{{ method }}-issue" data-ia-row="{{ method }}_issue">
            <span class="ia-rule-mark">{{ ui.icon('document') }}</span>
            <span class="ia-rule-copy"><strong>Emite factura automat</strong><span>{{ method == 'card' ? 'Numai după confirmarea plății de către procesator.' : 'Creează factura pentru noua comandă ramburs.' }}</span><small class="ia-rule-state" data-ia-state="{{ method }}_issue">{{ issue ? 'Selectată' : 'Oprită' }}</small></span>
            <input type="checkbox" role="switch" id="ia-{{ method }}-issue" name="{{ method }}_issue" value="1" aria-label="Emite factura automat pentru {{ title }}"{% if issue %} checked{% endif %}>
            <span class="ia-switch" aria-hidden="true"><i>{{ ui.icon('check') }}</i></span>
          </label>
          <label class="ia-rule ia-rule--email{{ not issue ? ' is-locked' : '' }}" for="ia-{{ method }}-email" data-ia-row="{{ method }}_email">
            <span class="ia-rule-mark">{{ ui.icon('mail') }}</span>
            <span class="ia-rule-copy"><strong>Trimite factura pe email</strong><span>După emitere, într-un email separat de confirmarea comenzii.</span><small class="ia-rule-state" data-ia-state="{{ method }}_email">{{ not issue ? 'Activează mai întâi emiterea' : (email ? 'Selectată' : 'Oprită') }}</small></span>
            <input type="checkbox" role="switch" id="ia-{{ method }}-email" name="{{ method }}_email" value="1" aria-label="Trimite factura pe email pentru {{ title }}"{% if email %} checked{% endif %}{% if not issue %} disabled{% endif %}>
            <span class="ia-switch" aria-hidden="true"><i>{{ ui.icon('check') }}</i></span>
          </label>
        </div>
        <div class="ia-flow" aria-hidden="true"><span>{{ method == 'card' ? 'Plată reușită' : 'Comandă nouă' }}</span><i>{{ ui.icon('arrow') }}</i><span>Factură</span><i>{{ ui.icon('arrow') }}</i><span>Email</span></div>
      </section>
    {% endfor %}
    </div>
    <aside class="ia-protection"><span>{{ ui.icon('shield') }}</span><div><strong>O singură factură pentru fiecare comandă</strong><p>Emiterea și emailul sunt pași separați. Dacă trimiterea eșuează, se reia doar emailul, fără o nouă factură. Activarea unei reguli nu emite facturi pentru comenzile mai vechi.</p></div></aside>
    <footer class="ia-save-note"><div><span class="ia-save-dot" aria-hidden="true"></span><div><strong data-ia-save-title>Setările se păstrează pe server</strong><p data-ia-save-copy>Alegeri separate pentru card și ramburs.</p></div></div><a href="{{ url('admin/configurator-factura/') }}">{{ ui.icon('document') }}<span>Configurator factură</span>{{ ui.icon('arrow') }}</a></footer>
    <button class="ia-fallback-save" type="submit" data-ia-manual-save>Salvează regulile</button>
    <noscript><p class="ia-noscript">Apasă „Salvează regulile” după modificări. Pentru a activa și emailul, salvează întâi emiterea automată.</p></noscript>
  </form>
</div>
{% endblock %}
