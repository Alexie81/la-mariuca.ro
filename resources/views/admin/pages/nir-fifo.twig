{% extends 'admin/layouts/base.twig' %}{% import 'admin/partials/nir-ui.twig' as ui %}{% block title %}Stoc contabil și FIFO{% endblock %}
{% block content %}<div class="nir-admin"><a class="nir-back" href="{{ url('admin/nir-uri/') }}">{{ ui.icon('back') }}Registrul NIR</a>
<header class="nir-detail-hero"><div><span class="nir-eyebrow">Trasabilitate · gestiuni</span><h1>Stoc contabil și FIFO</h1><p>Loturile rămase și cantitățile justificate de documente.</p></div>{% if permissions.opening|default(false) %}<a class="nir-button nir-button--primary" href="{{ url('admin/nir-uri/sold-initial/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/sold-initial/modal/') }}">{{ ui.icon('plus') }}Sold inițial</a>{% endif %}</header>
{% for pending_return in pending_returns|default([]) %}{% if not pending_return.dismissed|default(false) %}<section class="nir-return-reminder"><span>{{ ui.icon('return') }}</span><div><span class="nir-eyebrow">Retur client de recepționat</span><h3>{{ pending_return.order_number }}</h3><p>{{ pending_return.reason|default('Produse returnate, încă nerecepționate contabil.') }}</p>{% if not pending_return.eligible|default(false) %}<small>Recepția necesită o factură de retur și trasabilitatea costurilor originale.</small>{% endif %}</div><div class="nir-actions">{% if permissions.confirm|default(false) and pending_return.eligible|default(false) %}<a class="nir-button nir-button--primary" href="{{ url('admin/nir-uri/retururi/' ~ pending_return.return_id ~ '/receptie/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/retururi/' ~ pending_return.return_id ~ '/receptie/modal/') }}">{{ ui.icon('box') }}Recepționează returul</a>{% endif %}<form method="post" action="{{ url('admin/nir-uri/retururi/' ~ pending_return.return_id ~ '/amanare/') }}"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button class="nir-button nir-button--cancel" type="submit">Ascunde pentru astăzi</button></form></div></section>{% endif %}{% endfor %}
<section class="nir-panel nir-fifo-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Verificarea loturilor</span><h2>Reconciliere</h2><p>Stocul contabil trebuie să fie egal cu suma cantităților disponibile în loturi.</p></div></header><div class="nir-table-wrap"><table class="nir-table"><thead><tr><th>Produs / variantă</th><th>Gestiune</th><th>Stoc contabil</th><th>Disponibil FIFO</th><th>Diferență</th></tr></thead><tbody>{% for row in reconciliation|default([]) %}<tr><td data-label="Produs"><strong>{{ row.product_name|default(row.sku|default(row.variant_id|default('Produs'))) }}</strong><small>{{ row.sku|default('') }}</small></td><td data-label="Gestiune">{{ row.warehouse_name|default(row.warehouse_id) }}</td><td data-label="Contabil">{{ row.stock_quantity|default('0') }}</td><td data-label="FIFO">{{ row.fifo_quantity|default('0') }}</td><td data-label="Diferență"><span class="nir-badge {{ row.balanced|default(row.difference|default(0) == 0) ? 'is-sage' : 'is-rose' }}">{{ row.balanced|default(row.difference|default(0) == 0) ? 'În echilibru' : row.difference }}</span></td></tr>{% else %}<tr><td colspan="5"><div class="nir-muted-empty">{{ ui.icon('layers') }}<p>Loturile apar după confirmarea primei recepții sau înregistrarea soldului inițial.</p></div></td></tr>{% endfor %}</tbody></table></div></section>
<section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">De la intrare la consum</span><h2>Loturi și trasabilitate</h2><p>Primul lot recepționat este primul folosit. Deschide un lot pentru detalii.</p></div>{{ ui.icon('layers') }}</header><div class="nir-lot-list">{% for layer in layers|default([]) %}<details class="nir-lot"><summary><span class="nir-document-icon is-sage">{{ ui.icon('box') }}</span><span><strong>{{ layer.product_name }}</strong><small>{{ layer.sku }} · {{ layer.number|default('Sold inițial') }}</small></span><span class="nir-lot-quantity"><strong>{{ layer.remaining_quantity|decimal_ro }}</strong><small>din {{ layer.initial_quantity|decimal_ro }} disponibile</small></span>{{ ui.icon('chevron') }}</summary><div class="nir-lot-content"><dl class="nir-info-grid"><div><dt>Furnizor</dt><dd>{{ layer.supplier_name|default('Sold inițial') }}</dd></div><div><dt>Factură / cod furnizor</dt><dd>{{ layer.invoice_number|default('—') }} · {{ layer.supplier_code|default('—') }}</dd></div><div><dt>Recepționat la</dt><dd>{{ layer.display_received_at|default(layer.received_at) }}</dd></div>{% if permissions.costs|default(false) %}<div><dt>Cost unitar contabil</dt><dd>{{ layer.unit_cost_ron|decimal_ro }} RON</dd></div>{% endif %}</dl>{% if layer.nir_id %}<a class="nir-text-link" href="{{ url('admin/nir-uri/' ~ layer.nir_id ~ '/') }}">Deschide recepția{{ ui.icon('arrow') }}</a>{% endif %}{% if layer.consumptions|default([]) %}<h4>Consumul acestui lot</h4><div class="nir-consumption-list">{% for consumption in layer.consumptions %}<div><span>{{ consumption.order_number|default(consumption.reason|default('Ieșire din stoc')) }}</span><strong>{{ consumption.quantity|default((consumption.quantity_units|default(0)/10000)|number_format(4,',','.')) }}</strong><small>{{ consumption.display_created_at|default(consumption.created_at) }}</small></div>{% endfor %}</div>{% else %}<p class="nir-lot-empty">Acest lot nu are consum înregistrat.</p>{% endif %}</div></details>{% else %}<div class="nir-muted-empty">{{ ui.icon('layers') }}<p>Niciun lot contabil înregistrat încă.</p></div>{% endfor %}</div></section>
{% if pending|default([]) %}<section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Recepții de completat</span><h2>Consumuri în așteptare</h2><p>Se reconciliază automat când este confirmată o recepție eligibilă.</p></div></header><div class="nir-table-wrap"><table class="nir-table"><thead><tr><th>Produs</th><th>Comandă</th><th>Cantitate în așteptare</th><th>Înregistrat la</th></tr></thead><tbody>{% for item in pending %}<tr><td data-label="Produs">{{ item.product_name|default(item.sku|default('Produs')) }}</td><td data-label="Comandă">{{ item.order_number|default(item.order_id) }}</td><td data-label="Cantitate">{{ item.quantity|default((item.quantity_units|default(0)/10000)|number_format(4,',','.')) }}</td><td data-label="Data">{{ item.display_created_at|default(item.created_at) }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if permissions.references|default(false) and references|default([]) %}<section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Asocieri memorate</span><h2>Referințele furnizorilor</h2><p>Codurile de pe facturi rămân legate de produsul potrivit. Orice reasociere cere o explicație.</p></div>{{ ui.icon('link') }}</header><div class="nir-lot-list">{% for reference in references %}<details class="nir-lot"><summary><span class="nir-document-icon">{{ ui.icon('link') }}</span><span><strong>{{ reference.supplier_code|default('Fără cod') }} · {{ reference.supplier_name|default(reference.invoice_name|default(reference.normalized_name)) }}</strong><small>{{ reference.supplier_alias|default('Furnizor #' ~ reference.supplier_id) }} · {{ reference.product_name|default('Produs #' ~ reference.product_id) }}</small></span>{{ ui.icon('chevron') }}</summary><form class="nir-reference-form" action="{{ url('admin/nir-uri/referinte/' ~ reference.id ~ '/reasociere/') }}" method="post" data-nir-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><div class="nir-form-errors" data-nir-errors hidden role="alert"></div><div class="nir-fields"><label class="nir-field nir-field--wide"><span>Produsul și varianta corectă <b>*</b></span><select name="variant_id" required><option value="">Alege produsul</option>{% for product in products|default([]) %}<option value="{{ product.variant_id }}"{{ reference.variant_id|default('') == product.variant_id ? ' selected' : '' }}>{{ product.product_name }} · {{ product.option_summary|default(product.sku) }}</option>{% endfor %}</select></label>{{ ui.field('reason','Motivul reasocierii','',{}, {type:'textarea',required:true,wide:true,placeholder:'Explică de ce această referință trebuie legată de alt produs.'}) }}</div><button class="nir-button nir-button--soft" type="submit">{{ ui.icon('link') }}Salvează reasocierea</button></form></details>{% endfor %}</div></section>{% endif %}
{{ ui.modal_shell() }}</div>{% endblock %}
