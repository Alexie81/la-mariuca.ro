{% extends 'admin/layouts/base.twig' %}
{% import 'admin/invoices/ui.twig' as iv %}
{% import 'admin/partials/nir-ui.twig' as n %}

{% block title %}Comenzi{% endblock %}

{% block content %}
<div class="orders-workspace" data-iv-page>
  <section class="admin-orders-hero" aria-labelledby="admin-orders-title">
    <div>
      <span class="admin-eyebrow"><i aria-hidden="true"></i> Activitatea boutique-ului</span>
      <h1 id="admin-orders-title">Comenzi</h1>
      <p>Urmărește fiecare comandă, clientul, plata și starea livrării dintr-o singură privire.</p>
    </div>
    <div class="admin-orders-hero__tools">
      <a class="order-notification-trigger order-notification-trigger--desktop" href="{{ url('admin/comenzi/notificari/') }}" data-order-notifications-open data-modal-url="{{ url('admin/comenzi/notificari/modal/') }}" aria-label="Setări notificări de comenzi" title="Setări notificări de comenzi">
        {% include 'admin/partials/order-notification-gear.twig' %}
      </a>
    <div class="admin-orders-hero__summary" aria-label="Total comenzi">
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span>
      <strong>{{ pagination.total }}</strong>
      <small>{% if has_filters %}{{ pagination.total == 1 ? 'comandă relevantă' : 'comenzi relevante' }}{% else %}{{ pagination.total == 1 ? 'comandă înregistrată' : 'comenzi înregistrate' }}{% endif %}</small>
    </div>
    </div>
  </section>

  <section class="admin-orders-card" aria-labelledby="admin-orders-table-title">
    <header class="admin-orders-card__head">
      <div>
        <span class="admin-eyebrow">Registrul comenzilor</span>
        <div class="admin-orders-title-line"><h2 id="admin-orders-table-title">Toate comenzile</h2>
          <a class="order-notification-trigger order-notification-trigger--mobile" href="{{ url('admin/comenzi/notificari/') }}" data-order-notifications-open data-modal-url="{{ url('admin/comenzi/notificari/modal/') }}" aria-label="Setări notificări de comenzi" title="Setări notificări de comenzi">{% include 'admin/partials/order-notification-gear.twig' %}</a>
        </div>
      </div>
      {% if pagination.total > 0 %}
        <div class="orders-register-navigation"><p><strong>{{ pagination.from }}–{{ pagination.to }}</strong> din {{ pagination.total }} comenzi</p>
          {% if pagination.total_pages > 1 %}<nav class="orders-page-control" aria-label="Navigare rapidă între pagini"><span>Pagina <strong>{{ pagination.page }}</strong> / {{ pagination.total_pages }}</span>
            {% if pagination.page > 1 %}<a href="{{ url('admin/comenzi/?pagina=' ~ (pagination.page - 1) ~ (filters_query ? '&' ~ filters_query : '')) }}" aria-label="Pagina precedentă">{{ n.icon('back') }}</a>{% else %}<span class="is-disabled" aria-hidden="true">{{ n.icon('back') }}</span>{% endif %}
            {% if pagination.page < pagination.total_pages %}<a href="{{ url('admin/comenzi/?pagina=' ~ (pagination.page + 1) ~ (filters_query ? '&' ~ filters_query : '')) }}" aria-label="Pagina următoare din registru">{{ n.icon('arrow') }}</a>{% else %}<span class="is-disabled" aria-hidden="true">{{ n.icon('arrow') }}</span>{% endif %}
          </nav>{% endif %}
        </div>
      {% endif %}
    </header>

    <form class="admin-orders-filters" action="{{ url('admin/comenzi/') }}" method="get" role="search">
      <label class="admin-orders-search">
        <span class="sr-only">Caută în comenzi</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
        <input type="search" name="cautare" value="{{ search }}" placeholder="Număr, client, email, telefon, produs, SKU…" autocomplete="off">
      </label>
      <label class="admin-orders-status">
        <span class="sr-only">Filtrează după status</span>
        <select name="status">
          <option value="">Toate statusurile</option>
          {% for status_value, status_label in status_options %}
            <option value="{{ status_value }}"{{ selected_status == status_value ? ' selected' : '' }}>{{ status_label }}</option>
          {% endfor %}
        </select>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"/></svg>
      </label>
      <button type="submit" class="admin-orders-filter-button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span>Filtrează</span>
      </button>
      {% if has_filters %}
        <a class="admin-orders-filter-reset" href="{{ url('admin/comenzi/') }}" aria-label="Șterge toate filtrele">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg>
          <span>Resetează</span>
        </a>
      {% endif %}
    </form>

    {% if has_filters and pagination.total > 0 %}
      <p class="admin-orders-filter-summary">
        <span aria-hidden="true"></span>
        {{ pagination.total }} {{ pagination.total == 1 ? 'rezultat relevant' : 'rezultate relevante' }}{% if search %} pentru „{{ search }}”{% endif %}
      </p>
    {% endif %}

    {% if orders %}
      <div class="orders-register-wrap">
        <table class="orders-register">
          <caption class="sr-only">Comenzi, clienți, starea plății și facturi</caption>
          <thead><tr><th>Comandă</th><th>Client</th><th>Status</th><th>Plată</th><th>Total</th><th>Factură</th><th><span class="sr-only">Deschide comanda</span></th></tr></thead>
          <tbody>
          {% for order in orders %}
            <tr>
              <td class="orders-register__identity" data-label="Comandă">
                <a class="orders-register__number" href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}">{{ order.order_number ?: '#' ~ order.id }}</a>
                <time datetime="{{ order.created_at }}">{{ order.display_created_at }}</time>
                {% if order.cancellation_requested %}<a class="order-cancellation-badge" href="{{ url('admin/comenzi/' ~ order.id ~ '/#cerere-anulare') }}">Anulare solicitată</a>{% endif %}
              </td>
              <td class="orders-register__client" data-label="Client">
                <div class="orders-client-name"><strong>{{ order.first_name }} {{ order.last_name }}</strong><abbr title="{{ order.customer_type == 'company' ? 'Persoană juridică' : 'Persoană fizică' }}">{{ order.customer_type == 'company' ? 'PJ' : 'PF' }}</abbr></div>
                <div class="orders-contact-list">
                  {% if order.phone %}<a class="orders-contact" href="tel:{{ order.phone|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ order.phone }}</a>{% endif %}
                  {% if order.email %}<a class="orders-contact" href="mailto:{{ order.email }}">{{ order.email }}</a>{% endif %}
                </div>
              </td>
              <td class="orders-register__status" data-label="Status"><span class="orders-status orders-status--{{ order.status }}"><i aria-hidden="true"></i>{{ order.status_label }}</span></td>
              <td class="orders-register__payment" data-label="Plată"><div class="orders-payment">
                <span class="orders-payment__method orders-payment__method--{{ order.payment_method }}">{% if order.payment_method == 'stripe' %}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h3"/></svg>{% else %}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="3"/><circle cx="12" cy="12" r="3"/><path d="M6 11v2m12-2v2"/></svg>{% endif %}{{ order.payment_method_label }}</span>
                <span class="orders-payment__state orders-payment__state--{{ order.payment_status }}"><i aria-hidden="true"></i>{{ order.payment_status_label }}</span>
              </div></td>
              <td class="orders-register__total" data-label="Total"><strong>{{ money(order.total_bani) }}</strong></td>
              <td class="orders-register__invoice" data-label="Factură">
                {% if order.invoice %}<a class="orders-invoice orders-invoice--issued" href="{{ url('admin/facturi/' ~ order.invoice.id ~ '/') }}" aria-label="Deschide factura {{ order.invoice.series_code }} {{ order.invoice.number }}">{{ n.icon('document') }}<span>{{ order.invoice.series_code }} {{ order.invoice.number }}</span></a>
                {% elseif can_invoice and order.invoice_action.allowed %}<a class="orders-invoice orders-invoice--issue" data-iv-modal href="{{ url('admin/facturi/emite/?order=' ~ order.id ~ '&return_to=orders') }}" aria-label="Emite factura pentru comanda {{ order.order_number }}">{{ n.icon('document') }}<span>Emite</span></a>
                {% else %}<span class="orders-invoice-note{{ order.invoice_action.reason == 'Așteaptă confirmarea plății cu cardul.' ? ' orders-invoice-note--waiting' : '' }}" title="{{ can_invoice ? order.invoice_action.reason : 'Nu ai drept de emitere a facturilor.' }}">{{ order.invoice_action.reason == 'Așteaptă confirmarea plății cu cardul.' ? 'Așteaptă plata' : (can_invoice ? 'Indisponibilă' : 'Neemisă') }}</span>{% endif %}
              </td>
              <td class="orders-register__open"><a href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}" aria-label="Deschide comanda {{ order.order_number ?: '#' ~ order.id }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pagination.total_pages > 1 %}
        <nav class="admin-pagination" aria-label="Paginarea comenzilor">
          {% if pagination.page > 1 %}
            <a class="admin-pagination__arrow" href="{{ url('admin/comenzi/?pagina=' ~ (pagination.page - 1) ~ (filters_query ? '&' ~ filters_query : '')) }}" aria-label="Pagina anterioară"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></a>
          {% else %}
            <span class="admin-pagination__arrow is-disabled" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"/></svg></span>
          {% endif %}

          <div class="admin-pagination__pages">
            {% for page_number in pagination.page_numbers %}
              <a href="{{ url('admin/comenzi/?pagina=' ~ page_number ~ (filters_query ? '&' ~ filters_query : '')) }}" class="{{ pagination.page == page_number ? 'is-active' : '' }}"{% if pagination.page == page_number %} aria-current="page"{% endif %}>{{ page_number }}</a>
            {% endfor %}
          </div>

          {% if pagination.page < pagination.total_pages %}
            <a class="admin-pagination__arrow" href="{{ url('admin/comenzi/?pagina=' ~ (pagination.page + 1) ~ (filters_query ? '&' ~ filters_query : '')) }}" aria-label="Pagina următoare"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a>
          {% else %}
            <span class="admin-pagination__arrow is-disabled" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></span>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      <div class="admin-orders-empty">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span>
        {% if has_filters %}
          <strong>Nu am găsit comenzi relevante</strong>
          <p>Încearcă numărul comenzii, clientul, telefonul, produsul, SKU-ul ori o stare precum „plătită” sau „expediată”.</p>
          <a href="{{ url('admin/comenzi/') }}">Vezi toate comenzile</a>
        {% else %}
          <strong>Nu există încă nicio comandă</strong>
          <p>Primele comenzi plasate în magazin vor apărea automat aici.</p>
        {% endif %}
      </div>
    {% endif %}
  </section>
  <dialog class="order-notification-dialog" data-order-notifications-dialog aria-labelledby="order-notifications-title">
    <button class="order-notification-close" type="button" aria-label="Închide setările" data-order-notifications-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    <div class="order-notification-content" data-order-notifications-content><div class="order-notification-loading"><span aria-hidden="true"></span><h2 id="order-notifications-title">Notificări de comenzi</h2><p>Se încarcă setările…</p></div></div>
  </dialog>
  {{ iv.shell() }}
</div>
{% endblock %}
