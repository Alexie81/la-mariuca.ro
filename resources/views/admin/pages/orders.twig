{% extends 'admin/layouts/base.twig' %}{% block title %}Comenzi{% endblock %}{% block content %}<div class="admin-title"><div><h1>Comenzi</h1><p>Tranzițiile actualizează rezervările și stocul exact o dată.</p></div></div><div class="panel table-wrap"><table><thead><tr><th>Comandă</th><th>Client</th><th>Total</th><th>Stare</th><th>Plată</th><th>Acțiuni</th></tr></thead><tbody>{% for order in orders %}<tr><td><a class="admin-order-number-link" href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}">{{ order.order_number }}</a><br><small>{{ order.created_at }}</small></td><td>{{ order.first_name }} {{ order.last_name }}<br><small>{{ order.email }}</small></td><td>{{ money(order.total_bani) }}</td><td>{{ order.status }}</td><td>{{ order.payment_method }} / {{ order.payment_status }}</td><td><form class="inline-form" action="{{ url('admin/comenzi/' ~ order.id ~ '/actiune/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><select name="action"><option value="confirm">Confirmă</option><option value="prepare">Pregătește</option><option value="ship">Expediază</option><option value="deliver">Marchează livrată</option><option value="cancel">Anulează</option></select><input name="awb" placeholder="AWB manual"><button>Aplică</button></form></td></tr>{% else %}<tr><td colspan="6">Nu există comenzi.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
