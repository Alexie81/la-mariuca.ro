{% extends 'admin/layouts/base.twig' %}

{% block title %}{{ category ? 'Editare categorie' : 'Categorie nouă' }}{% endblock %}

{% block content %}
  <section class="admin-category-page-editor">
    <header class="admin-category-page-editor__hero">
      <div><a href="{{ url('admin/categorii/') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>CRM categorii</a><span class="admin-eyebrow"><i aria-hidden="true"></i> {{ category ? 'Poziție în arbore' : 'Ramură nouă' }}</span><h1>{{ category ? 'Editează categoria' : 'Adaugă o categorie' }}</h1><p>Urmează pașii în ordine. Câmpurile se completează automat unde este sigur și pot fi ajustate manual.</p></div>
    </header>
    {% include 'admin/partials/category-form-fields.twig' %}
  </section>
{% endblock %}
