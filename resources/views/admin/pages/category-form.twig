{% extends 'admin/layouts/base.twig' %}{% block title %}{{ category ? 'Editare categorie' : 'Categorie nouă' }}{% endblock %}{% block content %}<div class="admin-title"><div><h1>{{ category ? 'Editare categorie' : 'Categorie nouă' }}</h1><p>Publicarea generează automat pagina server-rendered și URL-ul permanent.</p></div></div><form class="panel form" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><div class="form-grid"><label>Nume *<input name="name" value="{{ category.name|default('') }}" required></label><label>Slug<input name="slug" value="{{ category.slug|default('') }}" placeholder="generat din nume"></label><label>Părinte<select name="parent_id"><option value="">Fără părinte</option>{% for item in categories %}{% if not category or item.id != category.id %}<option value="{{ item.id }}" {{ category and category.parent_id == item.id ? 'selected' }}>{{ item.name }}</option>{% endif %}{% endfor %}</select></label><label>Ordine<input type="number" name="position" value="{{ category.position|default(0) }}"></label><label>Stare<select name="status"><option value="draft" {{ category.status|default('draft') == 'draft' ? 'selected' }}>Draft</option><option value="published" {{ category.status|default('') == 'published' ? 'selected' }}>Publicată</option><option value="archived" {{ category.status|default('') == 'archived' ? 'selected' }}>Arhivată</option></select></label><label>Vizibilitate<select name="visibility"><option value="public">Publică</option><option value="hidden" {{ category.visibility|default('') == 'hidden' ? 'selected' }}>Ascunsă</option></select></label><label class="full">Descriere<textarea name="description" rows="5">{{ category.description|default('') }}</textarea></label><label>Titlu SEO<input name="seo_title" value="{{ category.seo_title|default('') }}"></label><label>Meta description<input name="meta_description" value="{{ category.meta_description|default('') }}"></label><label class="choice full"><input type="checkbox" name="indexable" {{ not category or category.indexable ? 'checked' }}> Eligibilă pentru indexare când are ofertă utilă</label></div><button class="button">Salvează categoria</button></form>{% endblock %}
