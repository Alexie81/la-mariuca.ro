{% extends 'admin/layouts/base.twig' %}
{% import 'admin/partials/spv-icons.twig' as ui %}
{% block title %}SPV · RO e-Factura{% endblock %}
{% block content %}
<div class="spv-page" data-spv-live>
{% if notice %}<div class="spv-feedback {{ notice.ok ? 'is-success' : 'is-error' }}" role="status">{{ ui.icon(notice.ok ? 'check' : 'info') }}<p>{{ notice.text }}</p></div>{% endif %}
<header class="spv-hero"><div class="spv-hero-top"><div class="spv-logo"><img src="{{ url('assets/images/anaf-ro.png') }}" width="285" height="77" alt="ANAF — Agenția Națională de Administrare Fiscală"></div><span class="spv-connection-badge"><i></i>{{ connection.ready ? 'Conexiune autorizată' : 'Neconectat' }}</span></div><div class="spv-hero-content"><div><span class="spv-eyebrow">Facturare electronică</span><h1>SPV · RO e-Factura</h1><p>Conectează firma la ANAF și stabilește regulile de transmitere a facturilor.</p></div><div class="spv-hero-seal" aria-hidden="true">{{ ui.icon('shield') }}</div></div><div class="spv-hero-foot"><span>{{ ui.icon('shield') }} Autorizare păstrată criptat pe server</span><span>{{ settings.environment == 'production' ? 'Producție' : 'Mediu de test' }}</span></div></header>
<section class="spv-connection"><div class="spv-connection-top"><span class="spv-icon spv-icon--mint">{{ ui.icon('shield') }}</span><div class="spv-connection-copy"><h2>{{ connection.connected ? (connection.expired ? 'Reconectează certificatul' : 'Firma este conectată') : 'Conectează firma la ANAF' }}</h2><p>{% if connection.checked_at %}Ultima verificare: {{ connection.checked_at|date('d.m.Y, H:i','Europe/Bucharest') }}{% else %}Autorizarea se face prin certificatul digital, în pagina ANAF.{% endif %}</p></div><div class="spv-connection-actions">
{% for operation,label in connection.connected ? {'conecteaza':'Reconectează certificatul','testeaza':'Testează conexiunea','deconecteaza':'Deconectează'} : {'conecteaza':'Conectează certificatul'} %}<form action="{{ url('admin/spv-efactura/'~operation~'/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button class="spv-button {{ operation == 'deconecteaza' ? 'spv-button--outline' : 'spv-button--soft' }}" {{ not connection.configured and operation != 'deconecteaza' ? 'disabled' : '' }}>{{ ui.icon(operation == 'deconecteaza' ? 'power' : 'key') }}{{ label }}</button></form>{% endfor %}</div></div>
{% if connection.problem %}<div class="spv-feedback"><p><strong>{{ connection.problem }}</strong>{% if not connection.configured %} Sunt necesare Client ID și Client Secret, păstrate în configurația privată a serverului. Adresa de retur pentru înregistrarea aplicației: <code>{{ callback }}</code>{% endif %}</p></div>{% endif %}
{% if connection.connected %}<div class="spv-tokens"><div class="spv-token"><span class="spv-token-icon">{{ ui.icon('refresh') }}</span><div><span class="spv-eyebrow">Acces</span><strong>Reînnoire automată</strong><p>{{ connection.expires_at ? connection.expires_at|date('d.m.Y, H:i','Europe/Bucharest') : 'Expirare indisponibilă' }}</p></div></div><div class="spv-token"><span class="spv-token-icon">{{ ui.icon('key') }}</span><div><span class="spv-eyebrow">Autorizare</span><strong>Valabilitate</strong><p>{{ connection.refresh_expires_at ? connection.refresh_expires_at|date('d.m.Y, H:i','Europe/Bucharest') : 'Verificată la reînnoire de ANAF' }}</p></div></div></div>{% endif %}</section>
<form action="{{ url('admin/spv-efactura/salveaza/') }}" method="post" class="spv-settings"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="revision" value="{{ settings.revision }}">
<section class="spv-environment"><div class="spv-section-head"><div class="spv-section-title"><span class="spv-section-number">01</span><div><span class="spv-eyebrow">Mediu de transmitere</span><h2>Unde trimiți documentele</h2></div></div></div><fieldset class="spv-environments"><legend class="spv-sr-only">Mediu ANAF</legend>{% for value,label in {'test':'Test ANAF','production':'Producție'} %}<label><input type="radio" name="environment" value="{{ value }}" {{ settings.environment == value ? 'checked' : '' }} {{ value == 'production' and not settings.production_allowed ? 'disabled' : '' }}><span>{{ ui.icon(value == 'test' ? 'flask' : 'globe') }}<span><strong>{{ label }}</strong><small>{{ value == 'test' ? 'Verificare înainte de lansare' : (settings.production_allowed ? 'Transmitere oficială' : 'Dezactivată pe acest server') }}</small></span><i>{{ ui.icon('check') }}</i></span></label>{% endfor %}</fieldset>{% if settings.production_allowed and settings.environment != 'production' %}<label class="spv-production-confirm"><input type="checkbox" name="confirm_production" value="1"> Confirm trecerea la transmiterea oficială în producție.</label>{% endif %}</section>
<section><div class="spv-section-head"><div class="spv-section-title"><span class="spv-section-number">02</span><div><span class="spv-eyebrow">Reguli automate</span><h2>Când pleacă facturile</h2></div></div></div><div class="spv-rule-grid">
{% for type,title in {'sale':'Facturi emise','return':'Facturi de retur și corecție'} %}<section class="spv-rule spv-rule--{{ type == 'sale' ? 'issued' : 'returned' }}" data-spv-rule><header class="spv-rule-head"><span class="spv-icon">{{ ui.icon(type == 'sale' ? 'upload' : 'return') }}</span><div><h3>{{ title }}</h3><p>{{ type == 'sale' ? 'Documentele pozitive din vânzări' : 'Documentele negative legate de factura originală' }}</p></div></header><fieldset class="spv-modes"><legend class="spv-sr-only">Regula pentru {{ title }}</legend>{% for mode,label in {'manual':'Manual','instant':'La emitere','scheduled':'Programat'} %}<label><input type="radio" name="{{ type }}_mode" value="{{ mode }}" {{ attribute(settings,type~'_mode') == mode ? 'checked' : '' }}><span><i class="spv-radio">{{ ui.icon('check') }}</i><strong>{{ label }}</strong><small>{{ {'manual':'Trimiți din fișa facturii','instant':'Se adaugă imediat în coadă','scheduled':'După intervalul ales'}[mode] }}</small></span></label>{% endfor %}</fieldset><div class="spv-schedule" data-spv-schedule><div class="spv-schedule-heading"><span class="spv-eyebrow">Trimite după</span></div><fieldset class="spv-days"><legend class="spv-sr-only">Număr de zile lucrătoare</legend>{% for day in 1..5 %}<label><input type="radio" name="{{ type }}_days" value="{{ day }}" {{ attribute(settings,type~'_days') == day ? 'checked' : '' }}><span>{{ day }}</span></label>{% endfor %}</fieldset><p>zile lucrătoare de la emitere</p></div></section>{% endfor %}</div></section>
<label class="spv-alert"><span class="spv-icon">{{ ui.icon('bell') }}</span><span class="spv-alert-copy"><strong>Alerte înainte de termen</strong><span>Semnalează documentele netransmise când mai sunt cel mult 2 zile lucrătoare din termenul configurat.</span></span><input type="checkbox" role="switch" name="alerts" value="1" {{ settings.alerts ? 'checked' : '' }}><span class="spv-switch" aria-hidden="true"><i>{{ ui.icon('check') }}</i></span></label>
<footer class="spv-footer"><p>{{ ui.icon('shield') }}<span><strong>Documentele transmise rămân protejate</strong><span>Schimbările recalculează doar programările fără încercări de trimitere.</span></span></p><button class="spv-button spv-button--primary">{{ ui.icon('save') }}Salvează și recalculează coada</button></footer></form>
</div>
{% endblock %}
