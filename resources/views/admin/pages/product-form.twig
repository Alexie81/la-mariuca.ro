{% extends 'admin/layouts/base.twig' %}

{% block title %}{{ product ? 'Editare produs' : 'Produs nou' }}{% endblock %}

{% block content %}
  <section class="admin-product-form-page">
    <header class="admin-product-form-page__hero">
      <div>
        <a href="{{ url('admin/produse/') }}" class="admin-product-form-page__back">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
          Catalog
        </a>
        <span class="admin-eyebrow"><i aria-hidden="true"></i> {{ product ? 'Atelier de editare' : 'Produs nou' }}</span>
        <h1>{{ product ? 'Finisează produsul' : 'Adaugă o poveste nouă' }}</h1>
        <p>Informațiile sunt grupate firesc, de la identitate și stoc până la poveste și vizibilitate.</p>
      </div>
    </header>
    <div class="admin-product-form-page__card">
      {% include 'admin/partials/product-form-fields.twig' with { modal_form: false } %}
    </div>
  </section>
{% endblock %}
