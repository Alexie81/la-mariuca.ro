{% extends 'admin/layouts/base.twig' %}
{% import 'admin/partials/review-icons.twig' as r %}
{% block title %}Moderare recenzii{% endblock %}
{% block content %}
<div class="rv-workspace" data-review-workspace>
  <header class="rv-hero">
    <div class="rv-hero__identity"><span class="rv-mark">{{ r.icon('message') }}</span><div><span class="rv-eyebrow">Relația cu clienții</span><h1>Moderare recenzii</h1><p>Păreri autentice, răspunsuri atente. Totul, într-un singur loc.</p></div></div>
    <div class="rv-score"><span class="rv-score__star">{{ r.icon('star') }}</span><div><strong>{{ summary.approved ? summary.average|number_format(1,',','.') : '—' }} <small>/ 5</small></strong><span>Media celor {{ summary.approved }} recenzii publice</span></div></div>
  </header>
  <section class="rv-registry" aria-label="Registrul recenziilor">
    <div class="rv-registry__top"><div><h2>Toate părerile, la un loc</h2><span>{{ summary.total }} recenzii înregistrate · {{ summary.responded }} cu răspuns</span></div><span class="rv-private-note">{{ r.icon('shield') }} Publicate după aprobare</span></div>
    <nav class="rv-tabs" aria-label="Filtrează recenziile după stare">
      {% for key,label in {'':'Toate','pending':'De verificat','approved':'Publice','rejected':'Respinse'} %}
        <a href="{{ url('admin/recenzii/') }}?{{ filters|merge({'stare':key,'pagina':1})|url_encode }}"{% if filters.stare == key %} aria-current="page"{% endif %}>{{ label }}<span>{{ key == '' ? summary.total : attribute(summary,key) }}</span></a>
      {% endfor %}
    </nav>
    <form class="rv-filters" method="get" action="{{ url('admin/recenzii/') }}" role="search">
      <input type="hidden" name="stare" value="{{ filters.stare }}">
      <label class="rv-search"><span>Caută în recenzii</span><span class="rv-search__input">{{ r.icon('search') }}<input type="search" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Produs, client, comandă sau text…"></span></label>
      <div class="rv-filter-options" id="rv-filter-options" data-review-filter-options>
      <label><span>Evaluare</span><select name="nota"><option value="">Toate notele</option>{% for rating in 5..1 %}<option value="{{ rating }}"{{ filters.nota == rating ? ' selected' : '' }}>{{ rating }} {{ rating == 1 ? 'stea' : 'stele' }}</option>{% endfor %}</select></label>
      <label><span>Răspuns</span><select name="raspuns"><option value="">Toate</option><option value="no"{{ filters.raspuns == 'no' ? ' selected' : '' }}>Fără răspuns</option><option value="yes"{{ filters.raspuns == 'yes' ? ' selected' : '' }}>Cu răspuns</option></select></label>
      <label><span>Ordonează</span><select name="sortare">{% for key,label in {'priority':'De verificat întâi','newest':'Cele mai noi','oldest':'Cele mai vechi','rating':'Nota descrescător'} %}<option value="{{ key }}"{{ filters.sortare == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
      <label class="rv-page-size"><span>Pe pagină</span><select name="per_page">{% for size in [10,20,50] %}<option value="{{ size }}"{{ filters.per_page == size ? ' selected' : '' }}>{{ size }}</option>{% endfor %}</select></label>
      </div>
      <button class="rv-button rv-filter-toggle" type="button" hidden data-review-filter-toggle aria-controls="rv-filter-options" aria-expanded="false">{{ r.icon('filter') }} Filtre</button>
      <button class="rv-button rv-button--primary" type="submit">{{ r.icon('filter') }}<span>Aplică</span></button>
    </form>
    {% if filters.q or filters.stare or filters.nota or filters.raspuns %}<div class="rv-filter-result"><span>{{ total }} {{ total == 1 ? 'recenzie găsită' : 'recenzii găsite' }}{% if filters.q %} pentru „{{ filters.q }}”{% endif %}</span><a href="{{ url('admin/recenzii/') }}">{{ r.icon('close') }} Resetează filtrele</a></div>{% endif %}
    <div class="rv-table-wrap">
      <table class="rv-table"><caption class="rv-sr-only">Recenzii produse, evaluări și starea moderării</caption>
        <thead><tr><th scope="col">Produs & client</th><th scope="col">Recenzie</th><th scope="col">Evaluare</th><th scope="col">Stare</th><th scope="col"><span class="rv-sr-only">Acțiuni</span></th></tr></thead>
        <tbody>{% for review in reviews %}
          {% set detail_url = url('admin/recenzii/' ~ review.id ~ '/') ~ '?' ~ filters|url_encode %}
          <tr id="recenzie-{{ review.id }}" data-review-row="{{ review.id }}">
            <td><div class="rv-product"><a class="rv-product__image" href="{{ url('admin/produse/' ~ review.product_id ~ '/') }}" aria-label="Fișa produsului {{ review.product_name }}">{% if review.product_image %}<img src="{{ url(review.product_image) }}" alt="" loading="lazy">{% else %}{{ r.icon('box') }}{% endif %}</a><div><a class="rv-product__name" href="{{ detail_url }}" data-review-open>{{ review.product_name }}</a><span class="rv-client">{{ review.author_name }}{% if review.is_verified_purchase %}<span title="Achiziție verificată" aria-label="Achiziție verificată">{{ r.icon('shield') }}</span>{% endif %}</span><small>{{ review.created_at|date('d.m.Y · H:i','Europe/Bucharest') }}{% if review.is_demo %} · Demo{% endif %}</small></div></div></td>
            <td class="rv-table__review"><a href="{{ detail_url }}" data-review-open class="rv-excerpt">{{ review.body|length > 125 ? review.body|slice(0,125) ~ '…' : review.body }}</a>{% if review.admin_response %}<a class="rv-reply-tag" href="{{ detail_url }}&panel=reply" data-review-open>{{ r.icon('reply') }} Răspuns publicat</a>{% else %}<span class="rv-unanswered">Fără răspuns</span>{% endif %}</td>
            <td><span class="rv-rating" aria-label="{{ review.rating }} din 5 stele">{{ r.icon('star') }}<strong>{{ review.rating }}</strong><small>/ 5</small></span></td>
            <td>{{ r.status(review.status) }}</td>
            <td><div class="rv-row-actions"><a class="rv-icon-button" href="{{ detail_url }}" data-review-open aria-label="Deschide recenzia de la {{ review.author_name }}" title="Detalii și moderare">{{ r.icon('eye') }}</a><a class="rv-icon-button rv-icon-button--rose" href="{{ detail_url }}&panel=reply" data-review-open aria-label="Răspunde recenziei de la {{ review.author_name }}" title="Răspuns public">{{ r.icon('reply') }}</a></div></td>
          </tr>
        {% else %}<tr><td colspan="5"><div class="rv-empty"><span class="rv-mark">{{ r.icon('search') }}</span><h3>{{ summary.total ? 'Nicio recenzie pentru aceste filtre' : 'Primele păreri vor apărea aici' }}</h3><p>{{ summary.total ? 'Încearcă un alt cuvânt sau elimină un filtru.' : 'Vei putea verifica recenziile și răspunde clienților din acest registru.' }}</p>{% if summary.total %}<a class="rv-button" href="{{ url('admin/recenzii/') }}">Vezi toate recenziile</a>{% endif %}</div></td></tr>{% endfor %}</tbody>
      </table>
    </div>
    <footer class="rv-pagination"><p><strong>{{ from }}–{{ to }}</strong> din {{ total }} recenzii <span>· Pagina {{ page }} / {{ pages }}</span></p><nav aria-label="Paginarea recenziilor">
      {% if page > 1 %}<a href="{{ url('admin/recenzii/') }}?{{ filters|merge({'pagina':page-1})|url_encode }}" aria-label="Pagina anterioară">{{ r.icon('left') }}</a>{% else %}<span class="is-disabled" aria-disabled="true" aria-label="Pagina anterioară">{{ r.icon('left') }}</span>{% endif %}
      {% if page_numbers|first > 1 %}<a href="{{ url('admin/recenzii/') }}?{{ filters|merge({'pagina':1})|url_encode }}">1</a>{% if page_numbers|first > 2 %}<span>…</span>{% endif %}{% endif %}
      {% for number in page_numbers %}<a href="{{ url('admin/recenzii/') }}?{{ filters|merge({'pagina':number})|url_encode }}"{% if number == page %} aria-current="page"{% endif %} aria-label="Pagina {{ number }}">{{ number }}</a>{% endfor %}
      {% if page_numbers|last < pages %}{% if page_numbers|last < pages-1 %}<span>…</span>{% endif %}<a href="{{ url('admin/recenzii/') }}?{{ filters|merge({'pagina':pages})|url_encode }}">{{ pages }}</a>{% endif %}
      {% if page < pages %}<a href="{{ url('admin/recenzii/') }}?{{ filters|merge({'pagina':page+1})|url_encode }}" aria-label="Pagina următoare">{{ r.icon('right') }}</a>{% else %}<span class="is-disabled" aria-disabled="true" aria-label="Pagina următoare">{{ r.icon('right') }}</span>{% endif %}
    </nav></footer>
  </section>
  {% include 'admin/partials/review-dialogs.twig' %}
</div>
{% endblock %}
