{% extends 'admin/layouts/base.twig' %}
{% import 'admin/partials/nir-ui.twig' as ui %}
{% block title %}NIR-uri{% endblock %}
{% block content %}
<div class="nir-admin" data-nir-page>
 <header class="nir-hero"><div class="nir-hero__copy"><span class="nir-eyebrow">Stoc și achiziții · Recepții</span><h1>Fiecare intrare,<br><em>în ordine.</em></h1><p>De la factura furnizorului la stocul recepționat.<br>Documente clare, produse verificate, totul la îndemână.</p><div class="nir-actions">{% if permissions.create|default(false) %}<a class="nir-button nir-button--primary" href="{{ url('admin/nir-uri/nou/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/nou/modal/') }}">{{ ui.icon('plus') }}<span>Adaugă NIR</span></a>{% endif %}{% if permissions.export|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/export/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/export/modal/') }}">{{ ui.icon('download') }}<span>Exportă registrul</span></a>{% endif %}</div></div><div class="nir-hero__art" aria-hidden="true"><div class="nir-art-paper"><span class="nir-art-mark">{{ ui.icon('box') }}</span><span class="nir-art-label">RECEPȚIE MARFĂ</span><i></i><i></i><div><span></span><span></span><span></span></div><b>{{ ui.icon('check') }}Totul, în ordine</b></div><span class="nir-art-seal">{{ ui.icon('shield') }}</span></div></header>
 <div class="nir-stats" aria-label="Rezumatul registrului"><article><span class="nir-stat-icon">{{ ui.icon('document') }}</span><div><strong>{{ summary.total|default(0) }}</strong><span>{{ summary.total|default(0) == 1 ? 'document înregistrat' : 'documente înregistrate' }}</span></div></article><article><span class="nir-stat-icon is-amber">{{ ui.icon('edit') }}</span><div><strong>{{ summary.draft|default(0) }}</strong><span>{{ summary.draft|default(0) == 1 ? 'recepție în lucru' : 'recepții în lucru' }}</span></div></article><article><span class="nir-stat-icon is-sage">{{ ui.icon('check') }}</span><div><strong>{{ summary.confirmed|default(0) }}</strong><span>{{ summary.confirmed|default(0) == 1 ? 'recepție confirmată' : 'recepții confirmate' }}</span></div></article></div>
 <section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Registrul recepțiilor</span><h2>NIR-uri</h2><p>Salvezi întâi în lucru. Stocul contabil se actualizează doar la confirmare.</p></div>{% if permissions.fifo|default(false) %}<a class="nir-text-link" href="{{ url('admin/nir-uri/stoc/') }}">{{ ui.icon('layers') }}Evidența stocului{{ ui.icon('chevron') }}</a>{% endif %}</header>
 <form class="nir-search" method="get" action="{{ url('admin/nir-uri/') }}" role="search"><label>{{ ui.icon('search') }}<span><small>Găsește un document</small><input type="search" name="cautare" value="{{ filters.search|default('') }}" placeholder="Număr NIR, furnizor, CUI sau factură…" aria-label="Caută în registrul NIR"></span></label><input type="hidden" name="status" value="{{ filters.status|default('') }}"><button class="nir-button nir-button--primary" type="submit">Caută{{ ui.icon('arrow') }}</button></form>
 <div class="nir-filterbar"><div class="nir-filters" aria-label="Filtrează documentele">{% for state,label in {'':'Toate','draft':'În lucru','confirmed':'Confirmate','supplier_return':'Storno / retur'} %}<a class="{{ filters.status|default('') == state ? 'is-active' : '' }}" href="{{ url('admin/nir-uri/?status=' ~ state ~ '&cautare=' ~ (filters.search|default('')|url_encode) ~ '&per_page=' ~ filters.per_page|default(20)) }}"{% if filters.status|default('') == state %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</div><form method="get"><input type="hidden" name="cautare" value="{{ filters.search|default('') }}"><input type="hidden" name="status" value="{{ filters.status|default('') }}"><label class="nir-page-size">Pe pagină<select name="per_page" data-nir-autosubmit>{% for n in [10,20,50,100] %}<option value="{{ n }}"{{ filters.per_page|default(20) == n ? ' selected' : '' }}>{{ n }}</option>{% endfor %}</select></label><noscript><button class="nir-button" type="submit">Aplică</button></noscript></form></div>
 {{ ui.pagination(pagination,filters) }}
 {% if documents %}<div class="nir-table-wrap"><table class="nir-table"><thead><tr><th>Document & furnizor</th><th>Factură</th><th>Recepție</th><th>Stare</th>{% if permissions.costs|default(false) %}<th class="nir-align-right">Total</th>{% endif %}<th><span class="sr-only">Deschide documentul</span></th></tr></thead><tbody>{% for row in documents %}<tr><td data-label="Document"><a class="nir-document-link" href="{{ url('admin/nir-uri/' ~ row.id ~ '/') }}"><span class="nir-document-icon{{ row.status == 'confirmed' ? ' is-sage' : '' }}">{{ ui.icon(row.operation_type|default('') == 'supplier_return' ? 'return' : 'document') }}</span><span><strong>{{ row.number|default(row.final_number|default(row.temporary_number|default('În lucru'))) }}</strong><small>{{ row.supplier_name|default(row.supplier.alias|default('Furnizor neales')) }}</small></span></a></td><td data-label="Factură"><strong>{{ row.invoice_series }} {{ row.invoice_number|default('Necompletată') }}</strong><small>{{ row.display_invoice_date|default(row.invoice_date) }}</small></td><td data-label="Recepție"><strong>{{ row.display_nir_at|default(row.nir_at) }}</strong><small>{{ row.line_count|default(0) }} {{ row.line_count|default(0) == 1 ? 'poziție' : 'poziții' }} · {{ row.warehouse_name|default('Gestiune') }}</small></td><td data-label="Stare">{{ ui.badge(row.status,row.operation_type|default('')) }}{% if row.reversal_status|default('none') != 'none' %}<small>{{ row.reversal_status == 'full' ? 'Stornat integral' : 'Stornat parțial' }}</small>{% endif %}</td>{% if permissions.costs|default(false) %}<td class="nir-align-right" data-label="Total"><strong class="nir-table-money">{{ (row.total_bani|default(0) / 100)|number_format(2,',','.') }} <span>{{ row.currency|default('RON') }}</span></strong><small>{{ {'supplier_return':'Retur furnizor','customer_return':'Retur client','opening_balance':'Sold inițial'}[row.operation_type|default('')] | default('Recepție furnizor') }}</small></td>{% endif %}<td class="nir-table-actions"><a class="nir-icon-button" href="{{ url('admin/nir-uri/' ~ row.id ~ '/') }}" aria-label="Deschide {{ row.number|default('NIR') }}">{{ ui.icon('arrow') }}</a></td></tr>{% endfor %}</tbody></table></div>{{ ui.pagination(pagination,filters) }}
 {% else %}<div class="nir-empty"><span class="nir-empty__mark">{{ ui.icon('box') }}</span><span class="nir-eyebrow">{{ filters.search|default('') or filters.status|default('') ? 'Niciun rezultat' : 'Un început bine organizat' }}</span><h3>{{ filters.search|default('') or filters.status|default('') ? 'Nu am găsit documente aici' : 'Prima recepție începe cu o factură' }}</h3><p>{{ filters.search|default('') or filters.status|default('') ? 'Încearcă un alt număr, furnizor sau filtru.' : 'Alege furnizorul, verifică produsele primite și salvează documentul. Te ghidăm la fiecare pas.' }}</p>{% if permissions.create|default(false) %}<a class="nir-button nir-button--primary" href="{{ url('admin/nir-uri/nou/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/nou/modal/') }}">{{ ui.icon('plus') }}Adaugă NIR</a>{% endif %}<div class="nir-empty-steps"><span><i>1</i>Factura</span>{{ ui.icon('arrow') }}<span><i>2</i>Produsele</span>{{ ui.icon('arrow') }}<span><i>3</i>Confirmarea</span></div></div>{% endif %}
 </section>{{ ui.modal_shell() }}
</div>
{% endblock %}
