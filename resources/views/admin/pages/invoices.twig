{% extends 'admin/layouts/base.twig' %}
{% import 'admin/partials/nir-ui.twig' as n %}{% import 'admin/invoices/ui.twig' as iv %}
{% block title %}Facturi de ieșire{% endblock %}
{% block content %}<div class="iv-workspace iv-register" data-iv-page>
<header class="iv-register-hero">
  <div><span class="iv-eyebrow">Facturare · La Măriuca</span><h1>Facturi de ieșire</h1><p>Documente, încasări și retururi. Vezi dintr-o privire ce mai este de făcut.</p>
    <div class="iv-actions">{% if can_manage %}<a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/emite/') }}" data-iv-modal>{{ n.icon('plus') }}Emite o factură</a>{% endif %}<a class="iv-btn" href="{{ url('admin/configurator-factura/') }}">{{ n.icon('settings') }}Serii și setări</a>{% if can_manage_spv %}<a class="iv-btn" href="{{ url('admin/spv-efactura/') }}">{{ n.icon('shield') }}SPV · e-Factura</a>{% endif %}{% if can_manage %}<a class="iv-btn" href="{{ url('admin/facturi/0/policy/') }}" data-iv-modal>{{ n.icon('return') }}Condiții de retur</a>{% endif %}</div>
  </div><span class="iv-register-seal" aria-hidden="true">{{ n.icon('document') }}</span>
</header>
<div class="iv-register-metrics">
  <article><span class="iv-mark">{{ n.icon('document') }}</span><div><small>Documente emise</small><strong>{{ summary.count }}</strong><span>Facturi și facturi de retur</span></div></article>
  <article><span class="iv-mark iv-mark--gold">{{ n.icon('clock') }}</span><div><small>Rămas de încasat</small><strong>{{ (summary.outstanding/100)|number_format(2,',','.') }} <em>Lei</em></strong><span>După plăți, retururi și corecții</span></div></article>
  <article><span class="iv-mark iv-mark--green">{{ n.icon('check') }}</span><div><small>Încasat</small><strong>{{ (summary.collected/100)|number_format(2,',','.') }} <em>Lei</em></strong><span>Încasări nete, fără valoarea returnată</span></div></article>
  <article><span class="iv-mark iv-mark--rose">{{ n.icon('return') }}</span><div><small>Valoare retururi</small><strong>{{ (summary.credits/100)|number_format(2,',','.') }} <em>Lei</em></strong><span>{{ summary.credit_count }} {{ summary.credit_count == 1 ? 'factură de retur' : 'facturi de retur' }}</span></div></article>
</div>
<section class="iv-register-tools" aria-label="Căutare și filtrare facturi">
<form method="get" class="iv-search-form" id="invoice-filters"><div class="iv-search">{{ n.icon('search') }}<label><span>Caută în facturi</span><input type="search" name="cautare" value="{{ filters.cautare|default('') }}" placeholder="Factură, comandă, client, CUI sau referință ANAF…" autocomplete="off"></label><button type="button" class="iv-icon" data-iv-clear aria-label="Golește căutarea"{% if not filters.cautare|default('') %} hidden{% endif %}>{{ n.icon('close') }}</button><button class="iv-btn iv-btn--primary">Caută {{ n.icon('arrow') }}</button></div>
<div class="iv-register-quick">{% for filter in quick_filters %}<a href="{{ filter.url }}" class="{{ filter.active ? 'is-active' : '' }}"{% if filter.active %} aria-current="page"{% endif %}>{{ filter.label }}</a>{% endfor %}</div>{% if filters.spv_group|default('') %}<input type="hidden" name="spv_group" value="{{ filters.spv_group }}">{% endif %}<input type="hidden" name="per_page" value="{{ per_page }}"><details class="iv-filter-details"{% if filters.from|default('') or filters.to|default('') or filters.kind|default('') or filters.payment_state|default('') or filters.payment_method|default('') or filters.customer_type|default('') or filters.receipt|default('') or filters.email_state|default('') or filters.fiscal_state|default('') %} open{% endif %}><summary>Rafinează rezultatele {{ n.icon('chevron') }}</summary><div class="iv-filters"><label>De la<input type="date" name="from" value="{{ filters.from|default('') }}"></label><label>Până la<input type="date" name="to" value="{{ filters.to|default('') }}"></label><label>Document<select name="kind"><option value="">Toate tipurile</option>{% for key,label in {'sale':'Factură','return':'Retur','correction_negative':'Retur pentru corecție','corrected_positive':'Factură corectată'} %}<option value="{{ key }}"{{ filters.kind|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Plată<select name="payment_state"><option value="">Orice stare</option>{% for key,label in {'paid':'Achitată','partial':'Parțial','unpaid':'Neachitată','credit':'Retur / corecție'} %}<option value="{{ key }}"{{ filters.payment_state|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Metodă<select name="payment_method"><option value="">Toate metodele</option><option value="stripe"{{ filters.payment_method|default('') == 'stripe' ? ' selected' : '' }}>Card online</option><option value="cod"{{ filters.payment_method|default('') == 'cod' ? ' selected' : '' }}>Ramburs</option></select></label><label>Email<select name="email_state"><option value="">Toate</option>{% for key,label in {'not_sent':'Netrimis','queued':'În așteptare','sent':'Trimis','previewed':'Previzualizat local','failed':'Eșuat','needs_resend':'Necesită retrimitere'} %}<option value="{{ key }}"{{ filters.email_state|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Client<select name="customer_type"><option value="">Toți clienții</option><option value="person"{{ filters.customer_type|default('') == 'person' ? ' selected' : '' }}>Persoană fizică</option><option value="company"{{ filters.customer_type|default('') == 'company' ? ' selected' : '' }}>Persoană juridică</option></select></label><label>Primire retur<select name="receipt"><option value="">Toate documentele</option><option value="pending"{{ filters.receipt|default('') == 'pending' ? ' selected' : '' }}>NIR de retur lipsă</option><option value="received"{{ filters.receipt|default('') == 'received' ? ' selected' : '' }}>NIR de retur generat</option></select></label><label>Transmitere SPV<select name="fiscal_state"><option value="">Toate stările</option>{% for key,label in {'unconfigured':'Necesită configurare','not_sent':'Netrimisă','queued':'În așteptare','scheduled':'Programată','awaiting_configuration':'Așteaptă configurarea','processing':'În curs','submitted':'Trimisă, așteaptă validarea','accepted':'Acceptată de ANAF','rejected':'Respinsă de ANAF','transient_error':'Eroare de transmitere','uncertain':'Răspuns de verificat'} %}<option value="{{ key }}"{{ filters.fiscal_state|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label></div><div class="iv-actions"><button class="iv-btn">Aplică filtrele</button><a href="{{ url('admin/facturi/') }}">Resetează</a></div></details></form>

<div class="iv-register-controls"><span>{{ total }} {{ total == 1 ? 'document găsit' : 'documente găsite' }}</span><a class="iv-btn iv-btn--export" href="{{ url('admin/facturi/export/') }}?{{ export_query }}" data-iv-modal>{{ n.icon('download') }}Exportă facturile</a></div>
</section>
<div class="iv-register-pager"><form method="get" class="iv-page-size">{% for key,value in filters %}{% if key not in ['page','per_page'] and value is not iterable %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endif %}{% endfor %}<label for="invoice-page-size">Pe pagină</label><select id="invoice-page-size" name="per_page" data-iv-page-size>{% for size in [10,15,25,50] %}<option value="{{ size }}"{{ size == per_page ? ' selected' : '' }}>{{ size }}</option>{% endfor %}</select><button class="iv-btn iv-page-size-apply">Aplică</button></form>{{ iv.pagination(_context) }}</div>
<div class="iv-register-list">
{% for item in items %}
<article class="iv-register-row{{ item.gross_bani < 0 ? ' is-credit' : '' }}">
  <span class="iv-register-symbol">{{ n.icon(item.gross_bani < 0 ? 'return' : 'document') }}</span>
  <div class="iv-register-info">
    <div class="iv-register-badges"><a class="iv-register-number" href="{{ url('admin/facturi/'~item.id~'/') }}">{{ item.display_number }}</a><span class="iv-status {{ item.payment_state == 'paid' ? 'is-green' : (item.payment_state == 'credit' ? 'is-rose' : 'is-gold') }}">{{ item.payment_label }}</span><span class="iv-status is-{{ item.fiscal.tone }}" title="{{ item.fiscal.description }}">{{ n.icon(item.fiscal.icon) }}{{ item.fiscal.label }}</span>{% if item.fiscal_environment == 'test' %}<span class="iv-status is-reference">Test ANAF</span>{% endif %}{% if item.fiscal_reference %}<span class="iv-status is-reference">Ref. ANAF {{ item.fiscal_reference }}</span>{% endif %}{% if item.kind in ['return','correction_negative'] and item.has_return_products %}{% if item.receipt_nir_id %}<a class="iv-status is-green" href="{{ url('admin/nir-uri/'~item.receipt_nir_id~'/') }}">{{ n.icon('warehouse') }}{{ item.receipt_nir_number }}</a>{% else %}<a class="iv-status is-gold" href="{{ url('admin/facturi/'~item.id~'/') }}">{{ n.icon('warning') }}NIR retur lipsă</a>{% endif %}{% endif %}</div>
    <h2>{{ item.customer.name }}</h2>
    <p>{{ item.kind_label }} · <a href="{{ url('admin/comenzi/'~item.order_id~'/') }}">{{ item.order_number }}</a> · {{ item.date_display }} · {{ item.payment_method == 'stripe' ? 'Card online' : 'Ramburs' }}</p>
    <div class="iv-register-email is-{{ item.email.tone }}">{{ n.icon('mail') }}<span>{{ item.email.label }}{% if item.customer.email %}<span class="iv-register-recipient"> · {{ item.customer.email }}</span>{% endif %}</span></div>
  </div>
  <div class="iv-register-value"><small>{{ item.gross_bani < 0 ? 'Total retur' : 'Total factură' }}</small><strong>{{ item.total_display }}</strong><div><a class="iv-icon" href="{{ url('admin/facturi/'~item.id~'/pdf/') }}" data-iv-download aria-label="Descarcă PDF {{ item.display_number }}" title="Descarcă PDF">{{ n.icon('download') }}</a><a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/'~item.id~'/') }}">Deschide fișa {{ n.icon('arrow') }}</a></div></div>
</article>
{% else %}<div class="iv-panel iv-empty"><span class="iv-mark">{{ n.icon('search') }}</span><h2>Nicio factură de afișat</h2><p>Modifică filtrele sau caută după un alt număr, client ori comandă.</p><a class="iv-btn" href="{{ url('admin/facturi/') }}">Resetează filtrele</a></div>{% endfor %}
</div>
{% if total > 0 %}{{ iv.pagination(_context) }}{% endif %}{{ iv.shell() }}</div>{% endblock %}
