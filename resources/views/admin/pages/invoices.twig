{% extends 'admin/layouts/base.twig' %}{% import 'admin/partials/nir-ui.twig' as n %}{% import 'admin/invoices/ui.twig' as iv %}
{% block title %}Facturi de ieșire{% endblock %}
{% block content %}<div class="iv-workspace" data-iv-page>{% if can_manage %}<div class="iv-policy-link"><a class="iv-btn" href="{{ url('admin/facturi/0/policy/') }}" data-iv-modal>{{ n.icon('settings') }}Condiții de retur</a></div>{% endif %}
<header class="iv-hero"><div class="iv-hero-copy"><span class="iv-eyebrow">Facturare · La Măriuca</span><h1>Facturile, în ordine.</h1><p>De la comanda clientului la documentul final. Toate detaliile rămân împreună.</p><div class="iv-actions">{% if can_manage %}<a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/emite/') }}" data-iv-modal>{{ n.icon('plus') }}Emite o factură</a>{% endif %}<a class="iv-btn" href="{{ url('admin/configurator-factura/') }}">{{ n.icon('document') }}Serii și setări</a></div></div><div class="iv-hero-total"><span>{{ n.icon('document') }} Documente emise</span><strong>{{ summary.count }}</strong><small>Fiecare factură păstrează datele de la emitere.</small></div></header>
<div class="iv-metrics"><article><span class="iv-mark">{{ n.icon('money') }}</span><div><small>Facturat</small><strong>{{ (summary.sales/100)|number_format(2,',','.') }} <em>Lei</em></strong></div></article><article><span class="iv-mark iv-mark--rose">{{ n.icon('return') }}</span><div><small>Retururi și corecții</small><strong>{{ (summary.credits/100)|number_format(2,',','.') }} <em>Lei</em></strong></div></article><article><span class="iv-mark iv-mark--gold">{{ n.icon('clock') }}</span><div><small>Rămas de încasat</small><strong>{{ (summary.outstanding/100)|number_format(2,',','.') }} <em>Lei</em></strong></div></article></div>
{% if pending_receipts %}<section class="iv-notice"><span class="iv-mark iv-mark--gold">{{ n.icon('box') }}</span><div><strong>{{ pending_receipts|length }} {{ pending_receipts|length == 1 ? 'retur așteaptă' : 'retururi așteaptă' }} verificarea produselor</strong><p>Factura de retur a fost emisă. Înregistrează separat ce a sosit și ce poate reveni în stoc.</p><div class="iv-actions">{% for pending in pending_receipts %}<a class="iv-chip" href="{{ url('admin/facturi/'~pending.id~'/receive/') }}" data-iv-modal>{{ pending.display_number }} {{ n.icon('arrow') }}</a>{% endfor %}</div></div><form method="post" action="{{ url('admin/facturi/0/dismiss/') }}"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button class="iv-icon" aria-label="Ascunde pentru astăzi">{{ n.icon('close') }}</button></form></section>{% endif %}
<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Registrul documentelor</span><h2>Toate facturile</h2><p>Găsește un client, o comandă sau un produs facturat.</p></div><div class="iv-exports"><a href="{{ url('admin/facturi/export/xlsx/') }}?{{ export_query }}" data-iv-download>{{ n.icon('download') }}Registru Excel</a><a href="{{ url('admin/facturi/export/zip/') }}?{{ export_query }}" data-iv-download>{{ n.icon('layers') }}Dosar complet</a></div></header>
<form method="get" class="iv-search-form"><div class="iv-search">{{ n.icon('search') }}<label><span>Caută în facturi</span><input type="search" name="cautare" value="{{ filters.cautare|default('') }}" placeholder="Număr, client, email, CUI, produs sau SKU…" autocomplete="off"></label><button type="button" class="iv-icon" data-iv-clear aria-label="Golește căutarea"{% if not filters.cautare|default('') %} hidden{% endif %}>{{ n.icon('close') }}</button><button class="iv-btn iv-btn--primary">Caută {{ n.icon('arrow') }}</button></div>
<details class="iv-filter-details"{% if filters.from|default('') or filters.to|default('') or filters.kind|default('') or filters.payment_state|default('') or filters.customer_type|default('') or filters.receipt|default('') or filters.email_state|default('') or filters.fiscal_state|default('') %} open{% endif %}><summary>Rafinează rezultatele {{ n.icon('chevron') }}</summary><div class="iv-filters"><label>De la<input type="date" name="from" value="{{ filters.from|default('') }}"></label><label>Până la<input type="date" name="to" value="{{ filters.to|default('') }}"></label><label>Document<select name="kind"><option value="">Toate tipurile</option>{% for key,label in {'sale':'Factură','return':'Retur','correction_negative':'Corecție storno','corrected_positive':'Factură corectată'} %}<option value="{{ key }}"{{ filters.kind|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Plată<select name="payment_state"><option value="">Orice stare</option>{% for key,label in {'paid':'Achitată','partial':'Parțial','unpaid':'Neachitată','credit':'Retur / corecție'} %}<option value="{{ key }}"{{ filters.payment_state|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Metodă<select name="payment_method"><option value="">Toate metodele</option><option value="stripe"{{ filters.payment_method|default('') == 'stripe' ? ' selected' : '' }}>Card online</option><option value="cod"{{ filters.payment_method|default('') == 'cod' ? ' selected' : '' }}>Ramburs</option></select></label><label>Email<select name="email_state"><option value="">Toate</option>{% for key,label in {'not_sent':'Netrimis','queued':'În așteptare','sent':'Trimis','previewed':'Previzualizat local','failed':'Eșuat','needs_resend':'Necesită retrimitere'} %}<option value="{{ key }}"{{ filters.email_state|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Client<select name="customer_type"><option value="">Toți clienții</option><option value="person"{{ filters.customer_type|default('') == 'person' ? ' selected' : '' }}>Persoană fizică</option><option value="company"{{ filters.customer_type|default('') == 'company' ? ' selected' : '' }}>Persoană juridică</option></select></label><label>Primire retur<select name="receipt"><option value="">Toate documentele</option><option value="pending"{{ filters.receipt|default('') == 'pending' ? ' selected' : '' }}>Așteaptă produsele</option><option value="received"{{ filters.receipt|default('') == 'received' ? ' selected' : '' }}>Produse verificate</option></select></label><label>Transmitere fiscală<select name="fiscal_state"><option value="">Toate stările</option>{% for key,label in {'unconfigured':'Neconfigurată','not_sent':'Netrimisă','processing':'În curs','submitted':'Trimisă','accepted':'Acceptată','rejected':'Respinsă','transient_error':'Necesită verificare'} %}<option value="{{ key }}"{{ filters.fiscal_state|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label></div><div class="iv-actions"><button class="iv-btn">Aplică filtrele</button><a href="{{ url('admin/facturi/') }}">Resetează</a></div></details></form>
{{ iv.pagination(_context) }}
<div class="iv-table-wrap"><table class="iv-table"><thead><tr><th>Document</th><th>Client și comandă</th><th>Valoare</th><th>Plată</th><th>Email</th><th><span class="iv-sr">Acțiuni</span></th></tr></thead><tbody>{% for item in items %}<tr class="{{ item.gross_bani < 0 ? 'is-credit' : '' }}"><td data-label="Document"><a class="iv-document-link" href="{{ url('admin/facturi/'~item.id~'/') }}"><span class="iv-mark">{{ n.icon(item.gross_bani < 0 ? 'return' : 'document') }}</span><span><strong>{{ item.display_number }}</strong><small>{{ item.kind_label }} · {{ item.date_display }}</small></span></a></td><td data-label="Client"><strong>{{ item.customer.name }}</strong><small>{{ item.customer.type == 'company' ? 'Persoană juridică' : 'Persoană fizică' }} · {{ item.customer.email }}</small><a class="iv-sub-link" href="{{ url('admin/comenzi/'~item.order_id~'/') }}">{{ item.order_number }}</a></td><td data-label="Valoare"><strong class="iv-amount">{{ item.total_display }}</strong><small>{{ item.currency }}</small></td><td data-label="Plată"><span class="iv-status {{ item.payment_state == 'paid' ? 'is-green' : (item.payment_state == 'credit' ? 'is-rose' : 'is-gold') }}">{{ item.payment_label }}</span><small>{{ item.payment_method == 'stripe' ? 'Card online' : 'Ramburs' }}</small></td><td data-label="Email"><span>{{ {'not_sent':'Netrimis','queued':'În așteptare','sent':'Trimis','previewed':'Preview local','failed':'Necesită verificare','needs_resend':'De retrimis'}[item.email_state]|default(item.email_state) }}</span><small>{{ {'unconfigured':'Fiscal: neconfigurat','not_sent':'Fiscal: netrimis','processing':'Fiscal: în curs','submitted':'Fiscal: trimis','accepted':'Fiscal: acceptat','rejected':'Fiscal: respins','transient_error':'Fiscal: de verificat'}[item.fiscal_state]|default(item.fiscal_state) }}</small></td><td><div class="iv-actions"><a class="iv-icon" href="{{ url('admin/facturi/'~item.id~'/pdf/') }}" data-iv-download aria-label="Descarcă PDF {{ item.display_number }}">{{ n.icon('download') }}</a><a class="iv-icon" href="{{ url('admin/facturi/'~item.id~'/') }}" aria-label="Deschide {{ item.display_number }}">{{ n.icon('arrow') }}</a></div></td></tr>{% else %}<tr><td colspan="6"><div class="iv-empty"><span class="iv-mark">{{ n.icon('document') }}</span><h3>{{ filters.cautare|default('') ? 'Nicio factură găsită' : 'Aici începe evidența facturilor' }}</h3><p>{{ filters.cautare|default('') ? 'Încearcă un nume, un număr sau un interval diferit.' : 'Alege o comandă și verifică detaliile. Numărul facturii se atribuie automat.' }}</p>{% if can_manage %}<a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/emite/') }}" data-iv-modal>{{ n.icon('plus') }}Emite o factură</a>{% endif %}</div></td></tr>{% endfor %}</tbody></table></div>
{{ iv.pagination(_context) }}</section>{{ iv.shell() }}</div>{% endblock %}
