{% extends 'admin/layouts/base.twig' %}
{% block title %}Fișa produsului · {{ product.name }}{% endblock %}
{% block content %}
<div class="stock-page stock-detail" data-stock-detail>
  <a class="stock-back" href="{{ url('admin/stoc/') }}"><span>←</span>Înapoi la stocuri</a>
  <section class="stock-detail-hero">
    <div class="stock-detail-hero__identity"><span class="stock-product__photo stock-product__photo--large">{% if product.image_path %}<img src="{{ url(product.image_path|trim('/')) }}" alt="">{% else %}<svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM7 15l3-3 2 2 2-3 3 4"/></svg>{% endif %}</span><div><span class="stock-eyebrow">Stocuri / Fișa produsului</span><h1>{{ product.name }}</h1><p>{{ product.primary_sku ?: 'Fără SKU' }}{% if product.category %} · {{ product.category }}{% endif %}{% if product.image_fallback %}<span class="stock-image-note">Imagine reprezentativă din categorie</span>{% endif %}</p></div></div>
    <div class="stock-detail-hero__actions"><a class="stock-btn" href="{{ url('produs/' ~ product.slug ~ '/') }}" target="_blank" rel="noopener">Vezi produsul ↗</a><a class="stock-btn stock-btn--export" href="{{ url('admin/stoc/' ~ product.id ~ '/export/xlsx/?from=' ~ filters.from ~ '&to=' ~ filters.to) }}" data-stock-download>Exportă fișa</a></div>
  </section>
  <section class="stock-kpis"><article><span>Stoc online</span><strong>{% if online_mode == 'unlimited' %}∞ Nelimitat{% elseif online_mode == 'mixed' %}Mixt{% elseif online_mode == 'inactive' %}Inactiv{% else %}{{ online }} <small>buc.</small>{% endif %}</strong><small>{% if online_mode == 'mixed' %}nelimitat + {{ online }} buc. numeric{% elseif online_mode == 'numeric' %}{{ online_physical }} fizic · {{ online_reserved }} rezervat{% else %}disponibilitate magazin{% endif %}</small></article><article><span>Stoc contabil</span><strong class="{{ current_units < 0 ? 'is-negative' : '' }}">{{ (current_units/10000)|decimal_ro }} <small>buc.</small></strong><small>NIR-uri minus facturi</small></article><article class="stock-kpi--in"><span>Intrări prin NIR</span><strong>+{{ (incoming_units/10000)|decimal_ro }}</strong><small>în tot istoricul</small></article><article class="stock-kpi--out"><span>Ieșiri prin facturi</span><strong>{{ outgoing_units ? '−' : '' }}{{ (outgoing_units/10000)|decimal_ro }}</strong><small>în tot istoricul</small></article></section>
  <div class="stock-guidance"><span class="stock-guidance__icon"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4 3 8 7 10 4-2 7-6 7-10V6zM9 12l2 2 4-4"/></svg></span><div><strong>{% if online_mode == 'unlimited' %}Produs cu stoc online nelimitat{% elseif online_mode == 'mixed' %}Produs cu variante numerice și nelimitate{% else %}Stoc online numeric, separat de cel contabil{% endif %}</strong><p>{% if online_mode == 'unlimited' %}Comenzile, retururile și NIR-urile nu modifică o cantitate online. Soldul contabil rămâne calculat exclusiv din documente.{% else %}Comanda scade disponibilul online imediat; NIR-ul sau recepția returului îl adaugă înapoi. Contabil, numai NIR-urile adaugă și numai facturile scad.{% endif %}</p></div></div>
  {% if not consistent %}<div class="stock-warning"><strong>Sold de verificat</strong><p>Soldul jurnalului diferă de soldul contabil curent. Verifică documentele și înregistrările anterioare.</p></div>{% endif %}
  <section class="stock-card stock-entries" data-stock-section="entries">
    <header class="stock-card__head"><div><span class="stock-eyebrow">01 · Documente de intrare</span><h2>Intrări din NIR-uri</h2><p>Deschide documentul pentru cantități, furnizor și valorile de achiziție.</p></div><span class="stock-count">{{ entries.total }} intrări</span></header>
    <div class="stock-entry-list">{% for entry in entries.items %}<a class="stock-entry" href="{{ url(entry.document_path) }}"><span class="stock-entry__icon"><svg viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5zM14 3v5h5M8 12h8M8 16h5"/></svg></span><span><strong>{{ entry.document }}</strong><small>{{ entry.date_display }} · {{ entry.partner ?: entry.label }}</small><small>{{ entry.warehouse }} · {{ entry.sku }}</small></span><span class="stock-entry__amount"><b>+{{ entry.quantity|decimal_ro }} buc.</b><small>{{ entry.cost_bani is not null ? money(entry.cost_bani) : 'Cost neasociat' }}</small></span><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></a>{% else %}<div class="stock-empty stock-empty--small"><h3>Nicio intrare înregistrată</h3><p>Aici vor apărea NIR-urile confirmate pentru acest produs.</p></div>{% endfor %}</div>
    {% include 'admin/partials/stock-pagination.twig' with {pager:entries,label:'Paginare intrări din NIR'} %}
    <p class="stock-section-note">Costurile afișate provin din documentele de achiziție, nu din prețul actual al catalogului.</p>
  </section>
  <section class="stock-card stock-card--journal" data-stock-section="journal">
    <header class="stock-card__head"><div><span class="stock-eyebrow">02 · Jurnal complet</span><h2>Mișcări de stoc</h2><p>Document, moment, operator și sold după fiecare operațiune.</p></div><span class="stock-count">{{ journal.total }} înregistrări</span></header>
    <div class="stock-journal__totals"><span>Sold inițial <b>{{ (opening_units/10000)|decimal_ro }}</b></span><span>Sold la finalul perioadei <b>{{ (closing_units/10000)|decimal_ro }}</b></span></div>
    {% if journal.items %}<div class="stock-journal">{% for movement in journal.items %}<article class="stock-movement stock-movement--{{ movement.quantity_units >= 0 ? 'in' : 'out' }}"><span class="stock-movement__rail"><i></i></span><div class="stock-movement__body"><header><div><span>{{ movement.label }}</span><strong>{% if movement.document_path %}<a href="{{ url(movement.document_path) }}">{{ movement.document }} ↗</a>{% else %}{{ movement.document }}{% endif %}</strong></div><time>{{ movement.date_display }}</time></header><div class="stock-movement__meta"><span>{{ movement.warehouse }}</span>{% if movement.partner %}<span>{{ movement.partner }}</span>{% endif %}<span>{{ movement.operator }}</span></div>{% if movement.pending_cost_units %}<div class="stock-cost-pending"><strong>Cost de achiziție neasociat · {{ (movement.pending_cost_units/10000)|decimal_ro }} buc.</strong><span>Costul se completează automat când confirmi achiziția.</span></div>{% endif %}</div><div class="stock-movement__numbers"><strong>{{ movement.quantity_units > 0 ? '+' : '' }}{{ movement.quantity|decimal_ro }}</strong><small>sold {{ movement.balance|decimal_ro }} buc.</small>{% if movement.cost_bani is not null %}<span>Cost {{ money(movement.cost_bani) }}</span>{% endif %}{% if movement.sale_value_bani is not null %}<span>Vânzare {{ money(movement.sale_value_bani) }}</span>{% endif %}</div></article>{% endfor %}</div>{% else %}<div class="stock-empty stock-empty--small"><h3>Nicio mișcare înregistrată</h3><p>Intrările și ieșirile vor apărea aici împreună cu documentele lor.</p></div>{% endif %}
    {% include 'admin/partials/stock-pagination.twig' with {pager:journal,label:'Paginare mișcări de stoc'} %}
  </section>
</div>
{% endblock %}
