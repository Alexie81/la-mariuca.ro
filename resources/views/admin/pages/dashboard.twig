{% extends 'admin/layouts/base.twig' %}
{% block title %}Prezentare generală{% endblock %}
{% block content %}
  {% set ranges = {
    '7z':'7 zile',
    'saptamana':'Săptămâna curentă',
    '1l':'O lună',
    '3l':'3 luni',
    '6l':'6 luni',
    '1a':'Un an',
    'tot':'Tot timpul'
  } %}

  <section class="admin-dashboard-hero admin-dashboard-hero--compact" aria-labelledby="dashboard-title" data-admin-reveal>
    <div class="admin-dashboard-hero__copy">
      <span class="admin-eyebrow"><i aria-hidden="true"></i> Centrul boutique-ului</span>
      <h1 id="dashboard-title">{{ greeting }}, <em>{{ admin_user.first_name|default('Paula') }}</em>.</h1>
      <p>Aici vezi pulsul magazinului tău — simplu, limpede și mereu la îndemână.</p>
      <div class="admin-hero-meta">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg> Actualizat în timp real</span>
        <span><i aria-hidden="true"></i> Date live</span>
      </div>
    </div>
    <div class="admin-dashboard-hero__art" aria-hidden="true">
      <span class="admin-orbit admin-orbit--one"></span>
      <span class="admin-orbit admin-orbit--two"></span>
      <span class="admin-hero-heart"><svg viewBox="0 0 24 24"><path d="M20.8 4.8a5.6 5.6 0 0 0-7.9 0L12 5.7l-.9-.9a5.6 5.6 0 0 0-7.9 7.9l.9.9L12 21l7.9-7.4.9-.9a5.6 5.6 0 0 0 0-7.9Z"/></svg></span>
      <span class="admin-hero-spark admin-hero-spark--one">✦</span>
      <span class="admin-hero-spark admin-hero-spark--two">✦</span>
      <span class="admin-hero-script">cu drag</span>
    </div>
  </section>

  <header class="admin-overview-head" data-admin-reveal>
    <div>
      <span class="admin-eyebrow"><i aria-hidden="true"></i> Bun venit în atelier</span>
      <h1>Prezentare <em>generală</em></h1>
      <p>Vezi rapid ce se întâmplă în magazin și ce necesită atenție.</p>
    </div>
    <div class="admin-overview-now" aria-label="Data și ora curentă">
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>{{ today }}</span>
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><b data-admin-clock>--:--:--</b></span>
    </div>
  </header>

  <section class="admin-period" aria-label="Perioada raportului" data-admin-reveal>
    <nav class="admin-period__options" aria-label="Alege perioada">
      {% for key, label in ranges %}
        <a href="{{ url('admin') }}?perioada={{ key }}" class="{{ period.key == key ? 'is-active' : '' }}" {% if period.key == key %}aria-current="page"{% endif %}>{{ label }}</a>
      {% endfor %}
      <details class="admin-period__custom" {{ period.key == 'personalizat' ? 'open' : '' }}>
        <summary class="{{ period.key == 'personalizat' ? 'is-active' : '' }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 3v4M17 3v4M5 7v13h14V7M8 12h3M13 12h3M8 16h3"/></svg>
          Personalizat
        </summary>
        <form class="admin-period__popover" action="{{ url('admin') }}" method="get">
          <input type="hidden" name="perioada" value="personalizat">
          <label><span>De la</span><input type="date" name="de_la" value="{{ period.start_input }}" required></label>
          <label><span>Până la</span><input type="date" name="pana_la" value="{{ period.end_input }}" required></label>
          <button type="submit">Aplică perioada <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></span></button>
        </form>
      </details>
    </nav>
    <p><span aria-hidden="true"></span>{{ period.display }}</p>
  </section>

  <section class="admin-overview-kpis" aria-label="Indicatori principali">
    <article class="admin-overview-kpi admin-overview-kpi--sales" data-admin-reveal>
      <div class="admin-overview-kpi__top">
        <span class="admin-overview-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V8M10 18V4M16 18v-6M22 18H2"/></svg></span>
        <small>Vânzări</small>
      </div>
      <strong data-money-count-up="{{ stats.net_sales }}">{{ money(stats.net_sales) }}</strong>
      <i aria-hidden="true"></i>
    </article>
    <article class="admin-overview-kpi admin-overview-kpi--orders" data-admin-reveal>
      <div class="admin-overview-kpi__top">
        <span class="admin-overview-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14v13H5V7Z"/><path d="M8 7a4 4 0 0 1 8 0M8 12h8"/></svg></span>
        <small>Comenzi</small>
      </div>
      <strong data-count-up="{{ stats.orders }}">{{ stats.orders }}</strong>
      <i aria-hidden="true"></i>
    </article>
    <article class="admin-overview-kpi admin-overview-kpi--clients" data-admin-reveal>
      <div class="admin-overview-kpi__top">
        <span class="admin-overview-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 19c.7-4 2.7-6 6-6s5.3 2 6 6M17 7v6M14 10h6"/></svg></span>
        <small>Clienți noi</small>
      </div>
      <strong data-count-up="{{ stats.new_customers }}">{{ stats.new_customers }}</strong>
      <i aria-hidden="true"></i>
    </article>
    <article class="admin-overview-kpi admin-overview-kpi--stock" data-admin-reveal>
      <div class="admin-overview-kpi__top">
        <span class="admin-overview-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16v11H4V8Z"/><path d="m8 8 1-4h6l1 4M12 11v4M12 17v.1"/></svg></span>
        <small>Stoc redus</small>
      </div>
      <strong data-count-up="{{ stats.low_stock }}">{{ stats.low_stock }}</strong>
      <i aria-hidden="true"></i>
    </article>
  </section>

  <div class="admin-analytics-grid">
    <section class="admin-overview-card admin-sales-card" aria-labelledby="sales-chart-title" data-admin-reveal>
      <div class="admin-overview-card__head">
        <div><span class="admin-eyebrow">Evoluție</span><h2 id="sales-chart-title">Vânzări nete</h2></div>
        <span>{{ period.display }}</span>
      </div>
      <div class="admin-chart-shell">
        {% if chart.scrollable %}
          <button class="admin-chart-arrow admin-chart-arrow--left" type="button" aria-label="Derulează graficul spre stânga" data-chart-scroll="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 7-5 5 5 5"/></svg></button>
        {% endif %}
        <div class="admin-sales-chart" data-admin-chart-scroll tabindex="0" aria-label="Grafic vânzări pentru {{ period.display }}">
          <div class="admin-sales-chart__plot" style="--chart-columns:{{ chart.points|length }}">
            {% for point in chart.points %}
              <div class="admin-sales-chart__point" style="--bar-height:{{ point.percent }}%" title="{{ point.label }} · {{ money(point.value) }}">
                <span class="admin-sales-chart__value">{{ point.value > 0 ? money(point.value) : '0 lei' }}</span>
                <i data-chart-bar></i>
                <small>{{ point.label }}</small>
              </div>
            {% endfor %}
          </div>
        </div>
        {% if chart.scrollable %}
          <button class="admin-chart-arrow admin-chart-arrow--right" type="button" aria-label="Derulează graficul spre dreapta" data-chart-scroll="1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 7 5 5-5 5"/></svg></button>
        {% endif %}
      </div>
      {% if chart.max == 0 %}
        <p class="admin-chart-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V9M10 18v-4M16 18V6M22 18H2"/></svg>Vânzările confirmate vor desena povestea acestei perioade.</p>
      {% endif %}
    </section>

    <section class="admin-overview-card admin-notifications" aria-labelledby="notifications-title" data-admin-reveal>
      <div class="admin-overview-card__head">
        <div><span class="admin-eyebrow">Acțiuni</span><h2 id="notifications-title">Notificări</h2></div>
        <a href="{{ url('admin/comenzi/') }}">Vezi toate <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></span></a>
      </div>
      <div class="admin-notifications__list">
        {% for notification in notifications %}
          <a href="{{ url('admin/comenzi/' ~ notification.order_id ~ '/') }}" class="admin-notification">
            <span class="admin-notification__icon admin-notification__icon--{{ notification.type }}">
              {% if notification.type == 'payment' %}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M3 10h18M16 15h2"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14v13H5V7Z"/><path d="M8 7a4 4 0 0 1 8 0"/></svg>
              {% endif %}
            </span>
            <span><strong>{{ notification.title }}</strong><small>{{ notification.detail }} · {{ money(notification.total_bani) }}</small></span>
            <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></i>
          </a>
        {% else %}
          <div class="admin-notifications__empty">
            <span class="admin-standard-heart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.8a5.6 5.6 0 0 0-7.9 0L12 5.7l-.9-.9a5.6 5.6 0 0 0-7.9 7.9l.9.9L12 21l7.9-7.4.9-.9a5.6 5.6 0 0 0 0-7.9Z"/></svg></span>
            <strong>Totul este liniștit</strong><p>Comenzile și plățile noi vor apărea aici.</p>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>

  <section class="admin-overview-card admin-recent-table-card" aria-labelledby="recent-orders-title" data-admin-reveal>
    <div class="admin-overview-card__head">
      <div><span class="admin-eyebrow">Ultimele înregistrări</span><h2 id="recent-orders-title">Comenzi recente</h2></div>
      <a href="{{ url('admin/comenzi/') }}">Toate comenzile <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></span></a>
    </div>
    {% if recent_orders %}
      <div class="admin-overview-table-wrap">
        <table class="admin-overview-table">
          <thead><tr><th>Comandă</th><th>Client</th><th>Data</th><th>Status</th><th>Total</th><th><span class="sr-only">Deschide</span></th></tr></thead>
          <tbody>
          {% for order in recent_orders %}
            <tr>
              <td data-label="Comandă"><strong><a class="admin-order-number-link" href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}">{{ order.order_number ?: '#' ~ order.id }}</a></strong></td>
              <td data-label="Client"><span>{{ order.first_name }} {{ order.last_name }}</span><small>{{ order.email }}</small></td>
              <td data-label="Data"><span>{{ order.display_date }}</span></td>
              <td data-label="Status"><span class="admin-order-badge admin-order-badge--{{ order.status_tone }}">{{ order.status_label }}</span></td>
              <td data-label="Total"><strong>{{ money(order.total_bani) }}</strong></td>
              <td><a class="admin-table-open" href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}" aria-label="Deschide comanda {{ order.order_number ?: '#' ~ order.id }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="admin-table-empty"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14v13H5V7Z"/><path d="M8 7a4 4 0 0 1 8 0"/></svg></span><div><strong>Încă nu sunt comenzi</strong><p>Prima comandă va apărea aici, cu toate detaliile importante.</p></div></div>
    {% endif %}
  </section>
{% endblock %}
