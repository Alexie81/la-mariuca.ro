{% extends 'admin/layouts/base.twig' %}{% block title %}Categorii{% endblock %}{% block content %}<div class="admin-title"><div><h1>Categorii</h1><p>Taxonomie ierarhică independentă de meniul vizual.</p></div><a class="button" href="{{ url('admin/categorii/noua/') }}">Categorie nouă</a></div><div class="panel table-wrap"><table><thead><tr><th>Nume</th><th>Părinte</th><th>Slug</th><th>Stare</th><th>Indexare</th><th></th></tr></thead><tbody>{% for category in categories %}<tr><td>{{ category.name }}</td><td>{{ category.parent_name|default('—') }}</td><td>{{ category.slug }}</td><td>{{ category.status }}</td><td>{{ category.indexable ? 'Da' : 'Nu' }}</td><td><a href="{{ url('admin/categorii/' ~ category.id ~ '/editare/') }}">Editează</a></td></tr>{% else %}<tr><td colspan="6">Nu există categorii.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
