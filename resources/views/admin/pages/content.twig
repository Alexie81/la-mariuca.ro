{% extends 'admin/layouts/base.twig' %}
{% block title %}Conținut{% endblock %}
{% block content %}
<div class="admin-title"><div><h1>Homepage și pagini</h1><p>Editorul folosește secțiuni predefinite; paginile juridice rămân marcate pentru verificare.</p></div><a class="button" href="{{ url('admin/pagini/noua/') }}">Pagină nouă</a></div>
<div class="two-columns">
  <section class="panel"><h2>Secțiuni homepage</h2>{% for section in sections %}<div class="list-row"><span>{{ section.position }}. {{ section.type }} — {{ section.title }}<br><small>{{ section.enabled ? 'Activă' : 'Inactivă' }}</small></span><form class="inline-form" action="{{ url('admin/continut/sectiuni/' ~ section.id ~ '/actiune/') }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button name="action" value="up" title="Mută sus">↑</button><button name="action" value="down" title="Mută jos">↓</button><button name="action" value="toggle">{{ section.enabled ? 'Dezactivează' : 'Activează' }}</button></form></div>{% else %}<p>Nicio secțiune.</p>{% endfor %}</section>
  <section class="panel"><h2>Pagini</h2>{% for page in pages %}<div class="list-row"><span>{{ page.title }}<br><small>{{ page.status }}{{ page.legal_review_required ? ' · necesită verificare' }}</small></span><a href="{{ url('admin/pagini/' ~ page.id ~ '/editare/') }}">Editează</a></div>{% else %}<p>Nicio pagină.</p>{% endfor %}</section>
</div>
{% endblock %}
