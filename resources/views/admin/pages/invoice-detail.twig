{% extends 'admin/layouts/base.twig' %}{% import 'admin/partials/nir-ui.twig' as n %}{% import 'admin/invoices/ui.twig' as iv %}
{% block title %}Factura {{ invoice.display_number }}{% endblock %}
{% block content %}{% set doc = invoice %}{% set negative = doc.kind in ['return','correction_negative'] %}<div class="iv-workspace{{ negative ? ' iv-workspace--return' : '' }}" data-iv-page>
<a class="iv-back" href="{{ url('admin/facturi/') }}"><span>{{ n.icon('back') }}</span>Înapoi la facturi</a>
<header class="iv-detail-header"><div class="iv-document-heading"><span class="iv-mark">{{ n.icon(negative ? 'return' : 'document') }}</span><div><span class="iv-eyebrow">{{ doc.kind_label }}</span><h1>{{ doc.display_number }}<button class="iv-icon" data-iv-copy="{{ doc.display_number }}" aria-label="Copiază numărul facturii">{{ n.icon('copy') }}</button></h1><p>{{ doc.date_display }} · <a href="{{ url('admin/comenzi/'~doc.order_id~'/') }}">{{ doc.order_number }}</a></p></div><span class="iv-status {{ doc.payment_state == 'paid' ? 'is-green' : (negative ? 'is-rose' : 'is-gold') }}">{{ doc.payment_label }}</span></div>
<div class="iv-progress"><div class="is-complete"><i>{{ n.icon('check') }}</i><span><strong>Document emis</strong><small>Datele sunt păstrate</small></span></div><div class="{{ negative and not doc.receipt ? 'is-current' : 'is-complete' }}"><i>{{ n.icon('warehouse') }}</i><span><strong>{{ negative ? (doc.receipt ? 'Produse verificate' : 'Verifică produsele primite') : 'Ieșire din stoc înregistrată' }}</strong><small>{{ negative ? 'Primirea fizică este separată' : 'Costurile se leagă de achiziții' }}</small></span></div><div class="{{ doc.email_state == 'sent' ? 'is-complete' : '' }}"><i>{{ n.icon('document') }}</i><span><strong>{{ doc.email_state == 'sent' ? 'Factura a fost trimisă' : 'Pregătită pentru client' }}</strong><small>{{ doc.email_state == 'previewed' ? 'Preview salvat local' : 'PDF și email la îndemână' }}</small></span></div></div>
<div class="iv-toolbar"><div class="iv-actions">{% if can_manage %}{% if doc.editable %}<a class="iv-btn" href="{{ url('admin/facturi/'~doc.id~'/edit/') }}" data-iv-modal>{{ n.icon('edit') }}Editează</a>{% endif %}<a class="iv-btn iv-btn--primary" href="{{ url('admin/facturi/'~doc.id~'/email/') }}" data-iv-modal>{{ n.icon('document') }}Trimite factura</a>{% if negative and not doc.receipt %}<a class="iv-btn iv-btn--green" href="{{ url('admin/facturi/'~doc.id~'/receive/') }}" data-iv-modal>{{ n.icon('box') }}Verifică returul</a>{% endif %}{% endif %}</div><div class="iv-exports">{% for format,label in {'pdf':'PDF','xlsx':'Excel','zip':'Dosar ZIP'} %}<a href="{{ url('admin/facturi/'~doc.id~'/'~format~'/') }}" data-iv-download>{{ n.icon('download') }}{{ label }}</a>{% endfor %}</div></div></header>
<div class="iv-detail-grid"><main class="iv-detail-main"><section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Partenerii documentului</span><h2>Emitent și client</h2></div>{{ n.icon('shield') }}</header><div class="iv-parties"><article><small>Furnizor</small><h3>{{ doc.snapshot.company.trade_name|default(doc.snapshot.company.legal_name) }}</h3><p>{{ doc.snapshot.company.legal_name }}</p><dl><div><dt>CUI</dt><dd>{{ doc.snapshot.company.tax_id }}</dd></div><div><dt>Sediu</dt><dd>{{ doc.snapshot.company.registered_address }}<br>{{ doc.snapshot.company.city }}, {{ doc.snapshot.company.county }}</dd></div><div><dt>Contact</dt><dd>{{ doc.snapshot.company.email }}<br>{{ doc.snapshot.company.phone }}</dd></div></dl></article><article><small>{{ doc.customer.type == 'company' ? 'Client · persoană juridică' : 'Client · persoană fizică' }}</small><h3>{{ doc.customer.name }}</h3>{% if doc.customer.type == 'company' %}<p>{{ doc.customer.company.name|default(doc.customer.company.company_name) }} · {{ doc.customer.company.tax_id|default(doc.customer.company.cui) }}</p>{% endif %}<dl><div><dt>Email</dt><dd><a href="mailto:{{ doc.customer.email }}">{{ doc.customer.email }}</a><button class="iv-icon" data-iv-copy="{{ doc.customer.email }}" aria-label="Copiază emailul">{{ n.icon('copy') }}</button></dd></div><div><dt>Telefon</dt><dd>{{ doc.customer.phone }}<button class="iv-icon" data-iv-copy="{{ doc.customer.phone }}" aria-label="Copiază telefonul">{{ n.icon('copy') }}</button></dd></div><div><dt>Facturare</dt><dd>{{ doc.customer.address.address|default(doc.customer.address.street|default('')) }}<br>{{ doc.customer.address.city|default('') }}, {{ doc.customer.address.county|default('') }} {{ doc.customer.address.postal_code|default('') }}</dd></div></dl></article></div></section>
<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Pozițiile facturii</span><h2>{{ negative ? 'Produsele și valorile returnate' : 'Ce conține factura' }}</h2></div><span class="iv-chip">{{ doc.lines|length }} {{ doc.lines|length == 1 ? 'poziție' : 'poziții' }}</span></header><div class="iv-lines">{% for line in doc.lines %}<article class="iv-line"><div class="iv-line-main"><button class="iv-product-image" type="button"{% if line.snapshot.image_data|default('') %} data-iv-image="{{ line.snapshot.image_data }}" data-title="{{ line.name }}" aria-label="Mărește imaginea {{ line.name }}"{% else %} disabled aria-label="Fără imagine"{% endif %}>{% if line.snapshot.image_data|default('') %}<img src="{{ line.snapshot.image_data }}" alt=""><span>{{ n.icon('search') }}</span>{% else %}{{ n.icon(line.kind == 'product' ? 'box' : 'document') }}{% endif %}</button><div class="iv-line-title"><h3>{{ line.name }}</h3><small>{{ line.snapshot.variant|default('') }} {{ line.sku }}</small><div class="iv-line-meta"><span class="iv-chip">{{ line.quantity_display }} {{ line.unit }}</span>{% if line.snapshot.product_slug|default('') %}<a href="{{ url('produs/'~line.snapshot.product_slug~'/') }}" target="_blank" rel="noopener">Vezi produsul {{ n.icon('external') }}</a>{% endif %}</div></div><div class="iv-line-price"><strong>{{ line.total_display }}</strong><small>cu TVA inclus</small></div></div><details class="iv-line-details"><summary>Preț, TVA și traseul produsului {{ n.icon('chevron') }}</summary><div class="iv-line-breakdown"><span>Preț unitar fără TVA <b>{{ line.unit_net|decimal_ro }} {{ doc.currency }}</b></span><span>Reducere <b>{{ (line.discount_bani/100)|number_format(2,',','.') }} {{ doc.currency }}</b></span><span>TVA {{ (line.vat_basis_points/100)|decimal_ro }}% <b>{{ (line.tax_bani/100)|number_format(2,',','.') }} {{ doc.currency }}</b></span><span>Fără TVA <b>{{ (line.net_bani/100)|number_format(2,',','.') }} {{ doc.currency }}</b></span></div>{% if line.trace %}<div class="iv-trace"><p>Din ce achiziții provin produsele facturate</p>{% for trace in line.trace %}<div>{{ n.icon('layers') }}<span><a href="{{ url('admin/nir-uri/'~trace.nir_id~'/') }}">{{ trace.nir_number }}</a><small>{{ trace.warehouse_name }} · {{ trace.received_at|date('d.m.Y H:i','Europe/Bucharest') }}</small></span><b>{{ (trace.quantity_units/10000)|decimal_ro }} buc. × {{ trace.unit_cost_ron|decimal_ro }} Lei</b></div>{% endfor %}</div>{% endif %}{% if line.pending_units > 0 %}<p class="iv-soft-note">{{ n.icon('clock') }}{{ (line.pending_units/10000)|decimal_ro }} buc. așteaptă înregistrarea achiziției pentru stabilirea costului. Cantitatea a fost deja scăzută.</p>{% endif %}</details></article>{% endfor %}</div></section>
{% if doc.receipt %}<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Retur verificat</span><h2>Ce a revenit de la client</h2><p>{{ doc.receipt.received_at|date('d.m.Y, H:i','Europe/Bucharest') }}</p></div>{{ n.icon('box') }}</header><div class="iv-lines">{% for received in doc.receipt.lines %}<article class="iv-line"><h3>{{ received.name }}</h3><div class="iv-line-breakdown"><span>Primite efectiv <b>{{ (received.received_units/10000)|decimal_ro }} buc.</b></span><span>Bune pentru stoc <b>{{ (received.restock_units/10000)|decimal_ro }} buc.</b></span><span>Nevandabile, evidență separată <b>{{ (received.quarantine_units/10000)|decimal_ro }} buc.</b></span><span>Nu au fost primite <b>{{ (received.missing_units/10000)|decimal_ro }} buc.</b></span></div></article>{% endfor %}{% if doc.receipt.notes %}<p class="iv-preserve">{{ doc.receipt.notes }}</p>{% endif %}</div></section>{% endif %}{% include 'admin/invoices/requests.twig' %}{% if doc.parent or doc.related %}<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Același dosar</span><h2>Documente asociate</h2></div>{{ n.icon('link') }}</header><div class="iv-related">{% if doc.parent %}<a href="{{ url('admin/facturi/'~doc.parent.id~'/') }}">{{ n.icon('document') }}<span><small>Document original</small><strong>{{ doc.parent.series_code }} {{ doc.parent.number }}</strong><small>{{ doc.parent.issued_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small></span>{{ n.icon('arrow') }}</a>{% endif %}{% for related in doc.related %}<a href="{{ url('admin/facturi/'~related.id~'/') }}">{{ n.icon(related.gross_bani < 0 ? 'return' : 'document') }}<span><small>{{ related.kind_label }}</small><strong>{{ related.display_number }}</strong><small>{{ related.date_display }}</small></span><b>{{ related.total_display }}</b>{{ n.icon('arrow') }}</a>{% endfor %}</div></section>{% endif %}
{% if doc.notes or doc.reason %}<section class="iv-panel iv-padded"><span class="iv-eyebrow">Mențiuni</span>{% if doc.reason %}<h3>Motivul documentului</h3><p class="iv-preserve">{{ doc.reason }}</p>{% endif %}{% if doc.notes %}<h3>Note pe factură</h3><p class="iv-preserve">{{ doc.notes }}</p>{% endif %}</section>{% endif %}
<section class="iv-panel"><header class="iv-section-head"><div><span class="iv-eyebrow">Pas cu pas</span><h2>Istoricul facturii</h2></div>{{ n.icon('clock') }}</header><ol class="iv-history">{% for event in doc.audit|reverse %}<li><span>{{ n.icon(event.action == 'issued' ? 'document' : (event.action == 'physically_received' ? 'box' : 'edit')) }}</span><div><strong>{{ {'issued':'Factura a fost emisă','edited':'Date actualizate','email_queued':'Email pus în așteptare','payment_recorded':'Plată / restituire înregistrată','physically_received':'Primirea produselor a fost verificată','public_link_created':'Link privat creat','public_link_revoked':'Link privat revocat','deleted':'Document eliminat'}[event.action]|default(event.action) }}</strong><small>{{ event.created_at|date('d.m.Y, H:i','Europe/Bucharest') }}</small>{% if event.reason %}<p>{{ event.reason }}</p>{% endif %}</div></li>{% endfor %}</ol></section></main>
<aside class="iv-detail-aside"><section class="iv-summary"><header><span>{{ n.icon('money') }}{{ negative ? 'Total retur / corecție' : 'Total factură' }}</span><strong>{{ doc.total_display }}</strong><p>{{ negative ? 'Documentul valoric nu restochează automat produsele.' : 'Valoarea păstrată la emiterea documentului.' }}</p></header><dl><div><dt>Fără TVA</dt><dd>{{ (doc.net_bani/100)|number_format(2,',','.') }}</dd></div><div><dt>TVA</dt><dd>{{ (doc.tax_bani/100)|number_format(2,',','.') }}</dd></div>{% if doc.discount_bani %}<div><dt>Reduceri incluse</dt><dd>{{ (doc.discount_bani/100)|number_format(2,',','.') }}</dd></div>{% endif %}<div><dt>{{ negative ? 'Restituit' : 'Încasat' }}</dt><dd>{{ ((negative ? doc.refunded_bani|default(0) : doc.paid_bani)/100)|number_format(2,',','.') }}</dd></div><div><dt>Scadență</dt><dd>{{ doc.due_date|date('d.m.Y') }}</dd></div></dl></section>
{% if can_manage %}<section class="iv-panel iv-padded"><span class="iv-eyebrow">La îndemână</span><h2>Acțiuni</h2><div class="iv-quick">{% if negative or doc.payment_method == 'cod' and doc.payment_state != 'paid' %}<a href="{{ url('admin/facturi/'~doc.id~'/payment/') }}" data-iv-modal>{{ n.icon('money') }}{{ negative ? 'Înregistrează restituirea' : 'Înregistrează încasarea' }}{{ n.icon('chevron') }}</a>{% endif %}{% if not negative %}<a href="{{ url('admin/facturi/'~doc.id~'/request/') }}" data-iv-modal>{{ n.icon('return') }}Înregistrează cerere de retur{{ n.icon('chevron') }}</a><a href="{{ url('admin/facturi/'~doc.id~'/return/') }}" data-iv-modal>{{ n.icon('return') }}Retur integral sau parțial{{ n.icon('chevron') }}</a>{% if doc.kind == 'sale' and not doc.related %}<a href="{{ url('admin/facturi/'~doc.id~'/correct/') }}" data-iv-modal>{{ n.icon('edit') }}Emite o corecție{{ n.icon('chevron') }}</a>{% endif %}{% endif %}<a href="{{ url('admin/facturi/'~doc.id~'/link/') }}" data-iv-modal>{{ n.icon('link') }}Link pentru client{{ n.icon('chevron') }}</a>{% if not doc.delete_blocker %}<a class="is-danger" href="{{ url('admin/facturi/'~doc.id~'/delete/') }}" data-iv-modal>{{ n.icon('trash') }}Șterge ultimul document{{ n.icon('chevron') }}</a>{% endif %}</div></section>{% endif %}
<section class="iv-assurance">{{ n.icon('shield') }}<div><strong>Datele istorice sunt protejate</strong><p>Schimbarea firmei, produselor sau seriei nu rescrie automat această factură.</p><small>{{ doc.fiscal_attempted_at ? 'Document blocat pentru modificări după transmiterea fiscală.' : 'Integrarea fiscală electronică nu este configurată.' }}</small></div></section></aside></div>{{ iv.shell() }}</div>{% endblock %}
