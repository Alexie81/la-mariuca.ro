{% extends 'admin/layouts/base.twig' %}{% block title %}Produse{% endblock %}{% block content %}<div class="admin-title"><div><h1>Produse</h1><p>Prețurile sunt stocate în bani întregi; stocul aparține variantei.</p></div><a class="button" href="{{ url('admin/produse/nou/') }}">Produs nou</a></div><div class="panel table-wrap"><table><thead><tr><th>Produs</th><th>SKU</th><th>Categorie</th><th>Preț</th><th>Fizic / rezervat</th><th>Stare</th><th>Homepage</th><th></th></tr></thead><tbody>{% for product in products %}<tr><td>{{ product.name }}</td><td>{{ product.sku }}</td><td>{{ product.category_name }}</td><td>{{ money(product.price_bani) }}</td><td>{{ product.physical_quantity|default(0) }} / {{ product.reserved_quantity|default(0) }}</td><td>{{ product.status }}</td><td>{{ product.featured ? 'Ales cu drag' : '—' }}</td><td><a href="{{ url('admin/produse/' ~ product.id ~ '/editare/') }}">Editează</a></td></tr>{% else %}<tr><td colspan="8">Nu există produse.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
