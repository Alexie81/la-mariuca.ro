<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="theme-color" content="#fffaf7">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ url('assets/images/favicon-lm-32.png') }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ url('assets/images/favicon-lm-192.png') }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ url('assets/images/apple-touch-icon-lm.png') }}">
  <link rel="manifest" href="{{ url('admin-manifest.webmanifest') }}">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title>{% block title %}Dashboard{% endblock %} · Administrare La Măriuca</title>
  <link rel="stylesheet" href="{{ url('assets/css/admin.css?v=20261031-option-cards-v3') }}">
</head>
{% set operator = admin_user|default(current_user()) %}
{% set first_name = operator.first_name|default('Administrator') %}
{% set last_name = operator.last_name|default('') %}
{% set initials = (first_name|slice(0, 1) ~ last_name|slice(0, 1))|upper %}
{% set active_admin_section = admin_section|default('dashboard') %}
<body class="admin-body">
  <a class="admin-skip-link" href="#admin-content">Sari la conținut</a>

  <header class="admin-topbar">
    <div class="admin-topbar__leading">
      <button class="admin-icon-button admin-menu-toggle" type="button" aria-label="Deschide meniul" aria-controls="admin-sidebar" aria-expanded="false" data-admin-menu-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14M5 12h14M5 16h14"/></svg>
      </button>
      <a class="admin-topbar__brand" href="{{ url('admin') }}" aria-label="Dashboard La Măriuca">
        <img src="{{ url('assets/images/logo-la-mariuca-transparent.png') }}" width="1000" height="337" alt="La Măriuca Boutique">
      </a>
      <span class="admin-topbar__divider" aria-hidden="true"></span>
      <div class="admin-topbar__context"><small>Panou de administrare</small><strong>{{ admin_context|default('Dashboard') }}</strong></div>
    </div>
    <div class="admin-topbar__actions">
      <span class="admin-live-time" data-admin-clock aria-label="Ora curentă">--:--</span>
      <a class="admin-store-link" href="{{ url('') }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5 6 4h12l2 5.5M5 10v9h14v-9M9 19v-5h6v5M3 9.5h18"/></svg>
        <span>Vezi magazinul</span>
      </a>
      <span class="admin-avatar admin-avatar--logo" title="{{ first_name }} {{ last_name }}">
        <img src="{{ url('assets/images/favicon-lm-192.png') }}" width="192" height="192" alt="" aria-hidden="true">
      </span>
    </div>
  </header>

  <div class="admin-app-shell">
    <aside class="admin-sidebar" id="admin-sidebar" aria-label="Navigare administrare" data-admin-sidebar>
      <div class="admin-sidebar__brand-row">
        <a class="admin-sidebar__brand" href="{{ url('admin') }}" aria-label="Dashboard La Măriuca">
          <img class="admin-sidebar__brand-full" src="{{ url('assets/images/logo-la-mariuca-transparent.png') }}" width="1000" height="337" alt="La Măriuca Boutique">
          <img class="admin-sidebar__brand-mark" src="{{ url('assets/images/favicon-lm-192.png') }}" width="192" height="192" alt="" aria-hidden="true">
        </a>
        <button class="admin-sidebar__collapse" type="button" aria-label="Restrânge bara laterală" aria-controls="admin-sidebar" aria-expanded="true" data-admin-sidebar-collapse>
          <svg class="admin-sidebar__collapse-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><path d="M10 8v8M15 9l-3 3 3 3"/></svg>
          <svg class="admin-sidebar__expand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          <svg class="admin-sidebar__close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg>
        </button>
      </div>
      <div class="admin-sidebar__caption">Administrare magazin</div>

      <nav class="admin-nav" aria-label="Secțiuni">
        <span class="admin-nav__label">Activitate zilnică</span>
        <a class="admin-nav__item{{ active_admin_section == 'dashboard' ? ' is-active' : '' }}" href="{{ url('admin') }}"{% if active_admin_section == 'dashboard' %} aria-current="page"{% endif %}>
          <span class="admin-nav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg></span>
          <span><strong>Dashboard</strong><small>Privire de ansamblu</small></span>
        </a>
        <a class="admin-nav__item{{ active_admin_section == 'orders' ? ' is-active' : '' }}" href="{{ url('admin/comenzi/') }}"{% if active_admin_section == 'orders' %} aria-current="page"{% endif %}>
          <span class="admin-nav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2M8 12h8"/></svg></span>
          <span><strong>Comenzi</strong><small>Clienți, plăți și status</small></span>
        </a>
        <a class="admin-nav__item{{ active_admin_section == 'notifications' ? ' is-active' : '' }}" href="{{ url('admin/notificari/') }}"{% if active_admin_section == 'notifications' %} aria-current="page"{% endif %}>
          <span class="admin-nav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 7h18s-3 0-3-7"/><path d="M10 20h4"/></svg></span>
          <span><strong>Notificări</strong><small>Evenimente importante</small></span>
          {% if admin_unread_count|default(0) > 0 %}
            <b class="admin-nav__count" aria-label="{{ admin_unread_count }} notificări necitite">{{ admin_unread_count > 99 ? '99+' : admin_unread_count }}</b>
          {% endif %}
        </a>
        <span class="admin-nav__label admin-nav__label--section">Produse și clienți</span>
        <a class="admin-nav__item{{ active_admin_section == 'products' ? ' is-active' : '' }}" href="{{ url('admin/produse/') }}"{% if active_admin_section == 'products' %} aria-current="page"{% endif %}>
          <span class="admin-nav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 7.5 7.5-4 7.5 4v9L12 21l-7.5-4.5v-9Z"/><path d="m4.8 7.7 7.2 4.1 7.2-4.1M12 11.8V21"/></svg></span>
          <span><strong>Produse</strong><small>Catalog, preț și stoc</small></span>
        </a>
        <a class="admin-nav__item{{ active_admin_section == 'suppliers' ? ' is-active' : '' }}" href="{{ url('admin/furnizori/') }}"{% if active_admin_section == 'suppliers' %} aria-current="page"{% endif %}>
          <span class="admin-nav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 7 3-2 3 2-3 7-3-1V7ZM22 7l-3-2-3 2 3 7 3-1V7Z"/><path d="M8 7h3M16 7h-3.4a2 2 0 0 0-1.4.6l-2.6 2.5a1.5 1.5 0 0 0 2.1 2.1l1.3-1.3 5.4 4.8a1.5 1.5 0 0 1-2 2.2L12 15M5 14l5.4 5a1.5 1.5 0 0 0 2.1-2.1M14 17l.7.6a1.5 1.5 0 0 1-2 2.2L11 18.3M19 14l-1.6 1.7"/></svg></span>
          <span><strong>Furnizori</strong><small>Parteneri și contacte</small></span>
        </a>
      </nav>

      <div class="admin-sidebar__spacer"></div>
      <div class="admin-security-note">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8.2 7 10 4.2-1.8 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <div><strong>Sesiune protejată</strong><small>Datele sunt accesibile doar echipei.</small></div>
      </div>
      <div class="admin-sidebar__profile">
        <span class="admin-avatar admin-avatar--logo">
          <img src="{{ url('assets/images/favicon-lm-192.png') }}" width="192" height="192" alt="" aria-hidden="true">
        </span>
        <span><strong>{{ first_name }} {{ last_name }}</strong><small>{{ operator.role == 'operator' ? 'Operator' : 'Administrator' }}</small></span>
        <form action="{{ url('admin/deconectare/') }}" method="post">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <button class="admin-logout-button" type="submit" aria-label="Deconectare" title="Deconectare">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"/></svg>
          </button>
        </form>
      </div>
    </aside>

    <button class="admin-sidebar-backdrop" type="button" aria-label="Închide meniul" data-admin-menu-close></button>

    <main class="admin-main" id="admin-content" tabindex="-1">
      {% set messages = flash_messages() %}
      {% if messages %}
        <div class="admin-toast-stack" aria-live="polite">
          {% for item in messages %}
            <div class="admin-toast admin-toast--{{ item.type }}" data-admin-toast>
              <span class="admin-toast__icon" aria-hidden="true">{{ item.type == 'error' ? '!' : '✓' }}</span>
              <p>{{ item.message }}</p>
              <button class="admin-toast__close" type="button" aria-label="Închide notificarea" data-admin-toast-close>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8 8 8M16 8l-8 8"/></svg>
              </button>
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% block content %}{% endblock %}
    </main>
  </div>

  <script src="{{ url('assets/js/admin.js?v=20261031-option-cards-v3') }}" defer></script>
</body>
</html>
