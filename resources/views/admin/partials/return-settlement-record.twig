{% if settlement %}<div class="return-settlement-record"><div><span>Valoare produse</span><strong>{{ money(settlement.base_bani) }}</strong></div>{% for cost in settlement.costs %}<div><span>{{ cost.name }}</span><span>− {{ money(cost.amount_bani) }}</span></div>{% endfor %}{% if settlement.adjustment_bani %}<div><span>Ajustare manuală</span><span>{{ money(settlement.adjustment_bani) }}</span></div>{% endif %}<div><span>De restituit clientului</span><strong>{{ money(settlement.refund_bani) }}</strong></div>{% if settlement.destination.refund_method|default('') == 'bank' %}<div class="return-record-bank">{{ settlement.destination.holder }} · {{ settlement.destination.bank_name }}<br>{{ settlement.destination.iban }}</div>{% elseif settlement.destination.refund_method|default('') %}<div class="return-record-bank">{{ settlement.destination.refund_method == 'cash' ? 'Restituire în numerar' : 'Restituire către metoda inițială de plată' }}</div>{% endif %}</div>{% endif %}
