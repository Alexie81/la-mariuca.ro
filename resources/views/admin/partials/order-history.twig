{% macro icon(name) %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    {% if name == 'bag' %}<path d="M5 7h14l1 13H4L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/><path d="M20 13a8 8 0 1 1-8-9"/>
    {% elseif name == 'package' %}<path d="m12 3 9 5v9l-9 5-9-5V8l9-5ZM3 8l9 5 9-5M12 13v9M7.5 5.5l9 5"/>
    {% elseif name == 'truck' %}<path d="M3 5h11v12H3V5ZM14 9h4l3 5v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {% elseif name == 'heart' %}<path d="M20 5c-3-3-7-1-8 2-1-3-5-5-8-2-5 5 3 11 8 15 5-4 13-10 8-15Z"/>
    {% elseif name == 'cancel' %}<circle cx="12" cy="12" r="9"/><path d="m8 8 8 8m0-8-8 8"/>
    {% elseif name == 'return' %}<path d="M9 5 4 10l5 5M4 10h10a6 6 0 0 1 0 12"/>
    {% elseif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/>
    {% elseif name == 'request' %}<path d="M20 11a8 8 0 0 1-8 8H7l-4 3V11a8 8 0 0 1 17 0Z"/><path d="M12 7v5m0 3h.01"/>
    {% elseif name == 'card' %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h3"/>
    {% elseif name == 'alert' %}<path d="m10.3 4-8 14a2 2 0 0 0 1.7 3h16a2 2 0 0 0 1.7-3l-8-14a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4m0 4h.01"/>
    {% elseif name == 'calendar' %}<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18M7 15h3"/>
    {% elseif name == 'client' or name == 'admin' %}<circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>{% if name == 'admin' %}<path d="m18 7 2 2 3-4"/>{% endif %}
    {% elseif name == 'system' %}<path d="m12 3 2 3 3-.3.3 3 3 2-3 2-.3 3-3-.3-2 3-2-3-3 .3-.3-3-3-2 3-2 .3-3 3 .3 2-3Z"/><circle cx="12" cy="11" r="2.5"/>
    {% else %}<path d="M3 12h4l3-7 4 14 3-7h4"/>{% endif %}
  </svg>
{% endmacro %}
<section class="order-card order-history" aria-labelledby="order-history-title" data-order-history>
  <header class="order-history__header" data-history-header>
    <span class="order-history__clock" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path class="order-history__clock-hand" d="M12 7v5l3 2"/><path d="M12 1v2m11 9h-2M12 23v-2M1 12h2"/></svg></span>
    <div class="order-history__heading"><span class="order-kicker">Pas cu pas</span><h2 id="order-history-title">Istoricul comenzii</h2><p>Fiecare actualizare, în ordine.</p></div>
    <span class="order-history__count"><strong>{{ order.history_timeline|length }}</strong><span>{{ order.history_timeline|length == 1 ? 'moment' : 'momente' }}</span></span>
  </header>
  <ol class="order-history__list" aria-label="Actualizările comenzii, în ordine cronologică">
    {% for event in order.history_timeline %}
      <li class="order-history__event order-history__event--{{ event.tone }}{{ event.is_latest ? ' is-latest' : '' }}" data-history-event>
        <span class="order-history__marker" aria-hidden="true">{{ _self.icon(event.icon) }}</span>
        <article class="order-history__entry">
          <div class="order-history__entry-heading"><h3>{{ event.label }}</h3>{% if event.is_latest %}<span class="order-history__latest"><i aria-hidden="true"></i>Ultima actualizare</span>{% endif %}</div>
          <div class="order-history__meta">
            <time datetime="{{ event.created_at }}">{{ _self.icon('calendar') }}<span>{{ event.display_date }}</span><span class="order-history__time-divider" aria-hidden="true"></span><strong>{{ event.display_time }}</strong></time>
            <span class="order-history__actor">{{ _self.icon(event.actor_kind) }}<span>{{ event.actor_label }}</span></span>
          </div>
          {% if event.reason %}<div class="order-history__note"><span>{{ event.reason_label }}</span><p>{{ event.reason }}</p></div>{% endif %}
        </article>
      </li>
    {% endfor %}
  </ol>
</section>
