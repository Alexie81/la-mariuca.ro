{% macro icon(name) %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    {% if name == 'building' %}<path d="M4 21V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v16M17 9h3v12M2 21h20M8 7h1m3 0h1M8 11h1m3 0h1M8 15h1m3 0h1M9 21v-3h3v3"/>
    {% elseif name == 'warehouse' %}<path d="m3 9 9-6 9 6v12H3V9ZM7 21V11h10v10M7 15h10M7 18h10"/>
    {% elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
    {% elseif name == 'edit' %}<path d="m4 20 4.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20ZM14.5 7.5l3 3"/>
    {% elseif name == 'trash' %}<path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>
    {% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
    {% elseif name == 'star' %}<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
    {% elseif name == 'pin' %}<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/>
    {% elseif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/>
    {% elseif name == 'phone' %}<path d="M7 4h3l2 5-2 1.5a14 14 0 0 0 3.5 3.5L15 12l5 2v3c0 1.7-1.3 3-3 3C9.8 20 4 14.2 4 7c0-1.7 1.3-3 3-3Z"/>
    {% elseif name == 'globe' %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a17 17 0 0 1 0 18 17 17 0 0 1 0-18Z"/>
    {% elseif name == 'bank' %}<path d="m3 8 9-5 9 5H3ZM5 11v7M10 11v7M14 11v7M19 11v7M3 21h18"/>
    {% elseif name == 'stamp' %}<path d="M7 15h10l3 4v2H4v-2l3-4ZM9 15V9a4 4 0 1 1 6 0v6M4 19h16"/>
    {% elseif name == 'image' %}<rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 5-5 4 4 4-6 5 7"/>
    {% elseif name == 'upload' %}<path d="M12 16V3m-5 5 5-5 5 5M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/>
    {% elseif name == 'arrow' %}<path d="M5 12h14m-5-5 5 5-5 5"/>
    {% elseif name == 'back' %}<path d="M19 12H5m5-5-5 5 5 5"/>
    {% elseif name == 'close' %}<path d="m6 6 12 12M18 6 6 18"/>
    {% elseif name == 'shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>
    {% else %}<path d="M8 3h8l4 4v14H4V3h4ZM15 3v5h5M8 12h8M8 16h5"/>{% endif %}
  </svg>
{% endmacro %}

{% macro field(name, label, value, errors, options = {}) %}
  <label class="company-field{{ options.wide|default(false) ? ' company-field--wide' : '' }}" for="company-field-{{ name }}">
    <span>{{ label }}{% if options.required|default(false) %}<em aria-hidden="true">*</em>{% endif %}</span>
    {% if options.type|default('text') == 'textarea' %}
      <textarea id="company-field-{{ name }}" name="{{ name }}" rows="{{ options.rows|default(2) }}" maxlength="{{ options.max|default(1000) }}"{% if options.placeholder|default('') %} placeholder="{{ options.placeholder }}"{% endif %}{% if options.required|default(false) %} required{% endif %} aria-describedby="company-error-{{ name }}"{% if attribute(errors, name)|default('') %} aria-invalid="true"{% endif %}>{{ value }}</textarea>
    {% else %}
      <input id="company-field-{{ name }}" type="{{ options.type|default('text') }}" name="{{ name }}" value="{{ value }}" maxlength="{{ options.max|default(190) }}"{% if options.placeholder|default('') %} placeholder="{{ options.placeholder }}"{% endif %}{% if options.inputmode|default('') %} inputmode="{{ options.inputmode }}"{% endif %}{% if options.autocomplete|default('') %} autocomplete="{{ options.autocomplete }}"{% endif %}{% if options.required|default(false) %} required{% endif %} aria-describedby="company-error-{{ name }}"{% if attribute(errors, name)|default('') %} aria-invalid="true"{% endif %}>
    {% endif %}
    <small class="company-field__error" id="company-error-{{ name }}" data-field-error="{{ name }}"{% if not attribute(errors, name)|default('') %} hidden{% endif %}>{{ attribute(errors, name)|default('') }}</small>
  </label>
{% endmacro %}

{% macro detail(label, value, wide = false) %}
  <div class="company-detail{{ wide ? ' company-detail--wide' : '' }}"><dt>{{ label }}</dt><dd{% if not value %} class="is-empty"{% endif %}>{{ value ?: 'Necompletat' }}</dd></div>
{% endmacro %}
