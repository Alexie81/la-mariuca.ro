{% import 'admin/partials/company-ui.twig' as ui %}
<form class="payment-fee-form" action="{{ form_action }}" method="post" data-payment-fee-form>
  <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
  <header class="payment-fee-form__head"><span class="payment-fee-mark{{ is_delete ? ' is-danger' : '' }}">{{ ui.icon(is_delete ? 'trash' : 'document') }}</span><div><span class="payment-methods-eyebrow">{{ is_delete ? 'Confirmă alegerea' : 'Cost operațional' }}</span><h2 id="payment-fee-title">{{ form_title }}</h2><p>{{ is_delete ? 'Comenzile existente își păstrează sumele.' : 'O denumire clară și o sumă fixă, la vedere.' }}</p></div><a href="{{ back_url }}" class="payment-fee-close" data-payment-fee-close aria-label="Închide">{{ ui.icon('close') }}</a></header>
  <div class="payment-fee-form__body"><div class="payment-methods-error" role="alert" tabindex="-1" data-payment-fee-error{% if not error %} hidden{% endif %}>{{ error }}</div>
    {% if is_delete %}<div class="payment-fee-delete-summary"><span>{{ ui.icon('document') }}</span><div><strong>{{ fee.name }}</strong><small>{{ fee.payment_method == 'stripe' ? 'Card online' : 'Ramburs' }}</small></div><b>{{ money(fee.amount_bani) }}</b></div><p class="payment-fee-guidance">Acest cost nu va mai fi adăugat comenzilor viitoare. Îl poți configura din nou oricând.</p>
    {% else %}<div class="payment-fee-context">{{ ui.icon('check') }}<span>Se aplică pentru <strong>{{ values.payment_method == 'stripe' ? 'Card online' : 'Ramburs' }}</strong>, o singură dată pe comandă.</span></div><input type="hidden" name="payment_method" value="{{ values.payment_method }}">
    <label class="payment-fee-field"><span><i>1</i>Denumirea afișată clientului</span><input name="name" value="{{ values.name }}" required maxlength="100" placeholder="De exemplu: Ambalare cadou" autocomplete="off"><small>Folosește un nume scurt, care explică serviciul oferit.</small></label>
    <label class="payment-fee-field"><span><i>2</i>Valoarea costului</span><div class="payment-fee-amount"><input name="price" value="{{ values.price }}" required inputmode="decimal" maxlength="12" pattern="[0-9]+([,.][0-9]{1,2})?" placeholder="0,00"><span>Lei</span></div><small>Sumă fixă, cu cel mult două zecimale. Va fi inclusă în totalul comenzii.</small></label>
    <div class="payment-fee-preview"><span>Previzualizare în rezumat</span><div><strong data-fee-preview-name>{{ values.name ?: 'Denumirea costului' }}</strong><b data-fee-preview-price>{{ values.price ?: '0,00' }} Lei</b></div></div>{% endif %}
  </div>
  <footer class="payment-fee-form__foot"><a class="payment-fee-button is-secondary" href="{{ back_url }}" data-payment-fee-close>Renunță</a><button class="payment-fee-button{{ is_delete ? ' is-danger' : '' }}" type="submit">{{ ui.icon(is_delete ? 'trash' : 'check') }}<span>{{ is_delete ? 'Elimină costul' : 'Salvează costul' }}</span></button></footer>
</form>
