<dialog class="stock-dialog stock-sheet-dialog" data-stock-dialog aria-labelledby="stock-sheet-title">
  <header class="stock-dialog__head" data-stock-dialog-head><div><span class="stock-eyebrow">Stocuri</span><h2 id="stock-sheet-title">Fișa produsului</h2></div><button type="button" class="stock-icon-btn" data-stock-close aria-label="Închide fișa"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
  <div class="stock-dialog__body" data-stock-dialog-body></div>
  <footer class="stock-dialog__foot"><span>Documentele justificative păstrează istoricul stocului.</span><button type="button" class="stock-btn" data-stock-close>Închide</button></footer>
</dialog>
<dialog class="stock-dialog stock-export-dialog" data-stock-export-dialog aria-labelledby="stock-export-title">
  <header class="stock-dialog__head"><span class="stock-dialog__symbol"><svg viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5zM14 3v5h5M12 11v6m-3-3 3 3 3-3"/></svg></span><div><span class="stock-eyebrow">Export contabil de stoc</span><h2 id="stock-export-title">Toată evidența, într-un Excel</h2><p>Rezumat, stoc, fișe de magazie, mișcări și documente-sursă.</p></div><button type="button" class="stock-icon-btn" data-stock-export-close aria-label="Închide exportul"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
  <form action="{{ url('admin/stoc/export/xlsx/') }}" method="get" data-stock-export-form>
    <div class="stock-dialog__body"><div class="stock-step-title"><span>01</span><div><h3>Pentru ce perioadă?</h3><p>Alege un interval rapid sau completează datele.</p></div></div>
      <div class="stock-period-options">
        {% for key,option in {'all':['Toată perioada','De la prima înregistrare','M5 3h14v18H5zM8 8h8M8 12h8M8 16h5'],'year':['Tot anul','De la 1 ianuarie','M4 5h16v16H4zM8 3v4M16 3v4M4 10h16'],'six':['6 luni','Ultimele șase luni','M12 8v4l3 2M21 12a9 9 0 1 1-9-9'],'three':['3 luni','Ultimele trei luni','M12 8v4l3 2M21 12a9 9 0 1 1-9-9'],'previous':['Luna trecută','Luna calendaristică anterioară','M4 5h16v16H4zM8 3v4M16 3v4M4 10h16'],'month':['Luna curentă','De la începutul lunii','M4 5h16v16H4zM8 3v4M16 3v4M4 10h16M9 15l2 2 4-4'],'custom':['Interval ales','Selectează exact datele','M4 7h16M4 17h16M8 4v6M16 14v6']} %}
        <label class="stock-period-option"><input type="radio" name="period" value="{{ key }}"{{ key == 'month' ? ' checked' : '' }}><span class="stock-period-option__icon"><svg viewBox="0 0 24 24"><path d="{{ option[2] }}"/></svg></span><span><strong>{{ option[0] }}</strong><small>{{ option[1] }}</small></span><i></i></label>
        {% endfor %}
      </div>
      <div class="stock-custom-dates" data-stock-custom hidden><label>De la<input type="date" name="from" disabled></label><span>→</span><label>Până la<input type="date" name="to" disabled></label></div>
      <div class="stock-export-preview"><span class="stock-guidance__icon"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span><div><strong>Registru Excel complet</strong><span data-stock-period-preview></span><small>6 foi organizate · numai mișcări cu documente confirmate</small></div></div>
    </div>
    <footer class="stock-dialog__foot"><button type="button" class="stock-btn" data-stock-export-close>Renunță</button><button type="submit" class="stock-btn stock-btn--export"><svg viewBox="0 0 24 24"><path d="M12 3v12m-4-4 4 4 4-4M4 18v3h16v-3"/></svg>Generează Excel</button></footer>
  </form>
</dialog>
