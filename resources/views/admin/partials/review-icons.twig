{% macro icon(name) %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% if name == 'message' %}<path d="M21 11a8 8 0 0 1-8 8H6l-4 3V10a8 8 0 0 1 8-8h3a8 8 0 0 1 8 8Z"/><path d="M7 8h9M7 12h6"/>{% elseif name == 'star' %}<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>{% elseif name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>{% elseif name == 'shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>{% elseif name == 'reply' %}<path d="m9 4-6 6 6 6M3 10h10a7 7 0 0 1 7 7v3"/>{% elseif name == 'eye' %}<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>{% elseif name == 'filter' %}<path d="M4 7h16M7 12h10M10 17h4"/>{% elseif name == 'close' %}<path d="m6 6 12 12M18 6 6 18"/>{% elseif name == 'left' %}<path d="m14 6-6 6 6 6"/>{% elseif name == 'right' %}<path d="m10 6 6 6-6 6"/>{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>{% elseif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{% elseif name == 'archive' %}<path d="M4 8h16v12H4V8ZM3 4h18v4H3V4ZM9 12h6"/>{% elseif name == 'box' %}<path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm-9 5 9 5 9-5M12 13v9M7.5 5.5l9 5"/>{% endif %}</svg>{% endmacro %}
{% macro status(status) %}<span class="rv-status is-{{ status }}"><i></i>{{ status == 'approved' ? 'Publică' : (status == 'pending' ? 'De verificat' : 'Respinsă') }}</span>{% endmacro %}
