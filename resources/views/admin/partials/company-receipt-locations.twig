{% import 'admin/partials/company-ui.twig' as ui %}
<section class="company-warehouses company-locations" id="locatii-receptie" aria-labelledby="company-locations-title">
  <header class="company-section-heading"><div class="company-section-heading__intro"><span class="company-section-heading__icon">{{ ui.icon('pin') }}</span><div><span class="company-eyebrow">Locul în care primești marfa</span><h2 id="company-locations-title">Locații de recepție</h2><p>Alege locurile folosite în NIR-uri, pentru fiecare gestiune.</p></div></div>
    {% if company and warehouses %}<a class="company-button company-button--soft" href="{{ url('admin/detaliile-firmei/' ~ company.id ~ '/locatii/nou/') }}" data-company-modal-open data-modal-url="{{ url('admin/detaliile-firmei/' ~ company.id ~ '/locatii/nou/modal/') }}">{{ ui.icon('plus') }}<span>Adaugă locație</span></a>{% else %}<button class="company-button company-button--soft" disabled>{{ ui.icon('plus') }}<span>Adaugă locație</span></button>{% endif %}
  </header>
  <div class="company-location-list">
  {% for location in receipt_locations %}
    <article class="company-location-card{{ location.is_default ? ' is-default' : '' }}"><span class="company-location-card__icon">{{ ui.icon('pin') }}</span><div class="company-location-card__identity"><h3>{{ location.name }}</h3><p>{{ ui.icon('warehouse') }}{{ location.warehouse_name }}</p></div>{% if location.is_default %}<span class="company-badge company-badge--default">{{ ui.icon('check') }}Implicită</span>{% else %}<span class="company-warehouse-secondary">Secundară</span>{% endif %}
      <div class="company-row-actions"><a class="company-icon-button" href="{{ url('admin/detaliile-firmei/' ~ company.id ~ '/locatii/' ~ location.id ~ '/editare/') }}" data-company-modal-open data-modal-url="{{ url('admin/detaliile-firmei/' ~ company.id ~ '/locatii/' ~ location.id ~ '/editare/modal/') }}" aria-label="Editează locația {{ location.name }}">{{ ui.icon('edit') }}<span>Editează</span></a><a class="company-icon-button company-icon-button--danger" href="{{ url('admin/detaliile-firmei/' ~ company.id ~ '/locatii/' ~ location.id ~ '/sterge/') }}" data-company-modal-open data-modal-url="{{ url('admin/detaliile-firmei/' ~ company.id ~ '/locatii/' ~ location.id ~ '/sterge/modal/') }}" aria-label="Șterge locația {{ location.name }}">{{ ui.icon('trash') }}<span>Șterge</span></a></div>
    </article>
  {% else %}<div class="company-empty company-empty--inline"><span class="company-empty__icon">{{ ui.icon('pin') }}</span><div><h3>{{ company and warehouses ? 'Unde primești produsele?' : 'Întâi firma și gestiunea' }}</h3><p>{{ company and warehouses ? 'Adaugă prima locație. O vom selecta automat la recepțiile noi.' : 'Completează datele firmei și adaugă o gestiune, apoi organizează locațiile de recepție.' }}</p></div></div>{% endfor %}
  </div>
</section>
