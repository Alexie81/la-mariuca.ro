<header class="order-modal-head"><span class="order-modal-head__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M4 12h7M4 17h5M17 5v14M13 15l4 4 4-4"/></svg></span><div><span class="order-kicker">Actualizare comandă</span><h2 id="order-dialog-title">{{ selected_action|default('') == 'cancel' ? 'Anulează comanda' : (order.status == 'cancelled' ? 'Reia comanda' : 'Schimbă statusul') }}</h2><p>{{ order.order_number ?: '#' ~ order.id }} · acum <strong>{{ order.status_label }}</strong></p></div></header>
<form class="order-modal-form" action="{{ url('admin/comenzi/' ~ order.id ~ '/actiune/') }}" method="post" data-order-async-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="status_version" value="{{ order.status_version }}">
  {% if order.available_actions %}
    <div class="order-modal-body">
    <section class="order-modal-section"><div class="order-modal-section__title"><span>1</span><div><small>{{ selected_action|default('') == 'cancel' ? 'Confirmarea anulării' : 'Alege pasul' }}</small><h3>Ce se întâmplă acum?</h3><p>{{ selected_action|default('') == 'cancel' ? 'Anulăm comanda și eliberăm rezervările. Istoricul se păstrează.' : 'Poți alege direct orice pas, inclusiv unul anterior. Istoricul și documentele se păstrează.' }}</p></div></div><div class="order-status-options">{% for action in order.available_actions %}{% if selected_action|default('') != 'cancel' or action.action == 'cancel' %}<label class="order-choice{{ action.action == 'cancel' ? ' order-choice--danger' : '' }}"><input type="radio" name="action" value="{{ action.action }}" required{{ selected_action|default('') == action.action ? ' checked' : '' }} data-order-action-radio><span class="order-choice__check"></span><span><strong>{{ action.label }}</strong><small>{{ action.description }}</small><em>{{ action.status_label }}</em></span></label>{% endif %}{% endfor %}</div></section>
    {% if cancellation_documents.automatic %}
    <section class="order-modal-section" data-cancellation-documents><div class="order-modal-section__title"><span>2</span><div><small>Plată cu cardul confirmată</small><h3>Factura de retur se emite automat</h3><p>Facturile se păstrează. După anulare verifici produsele pentru reintrarea în stoc și NIR. Comanda nu mai poate fi reluată.</p></div></div></section>
    {% elseif cancellation_documents.pending %}
    <section class="order-modal-section" data-cancellation-documents>
      <input type="hidden" name="cancellation_document_version" value="{{ cancellation_documents.version }}"><input type="hidden" name="cancellation_request_key" value="{{ cancellation_request_key }}">
      <div class="order-modal-section__title"><span>2</span><div><small>La anularea comenzii</small><h3>Cum rezolvăm factura emisă?</h3><p>{% for document in cancellation_documents.documents %}{{ document.number }}{{ not loop.last ? ' · ' : '' }}{% endfor %}. Alege ce se întâmplă cu documentele.</p></div></div>
      <div class="order-status-options">
        {% if cancellation_documents.can_delete %}<label class="order-choice"><input type="radio" name="cancellation_document_action" value="delete"><span class="order-choice__check"></span><span><strong>Șterge factura emisă</strong><small>Este ultima eligibilă din serie. Numărul devine disponibil, iar ieșirea contabilă se anulează.</small></span></label>{% endif %}
        <label class="order-choice"><input type="radio" name="cancellation_document_action" value="credit"><span class="order-choice__check"></span><span><strong>Emite factura de retur</strong><small>Factura inițială rămâne în istoric. Apoi verifici produsele pentru reintrarea în stoc și NIR. Comanda nu mai poate fi reluată.</small></span></label>
        <label class="order-choice"><input type="radio" name="cancellation_document_action" value="later" checked><span class="order-choice__check"></span><span><strong>Rezolv mai târziu</strong><small>Anulăm comanda. Avertismentul pentru factură rămâne vizibil până rezolvi documentele.</small></span></label>
      </div>
    </section>
    {% endif %}
    <label class="order-switch"><input type="checkbox" name="notify_customer" value="1" checked><span class="order-switch__control"><i></i></span><span><strong>Trimite e-mail clientului</strong><small>{{ cancellation_documents.automatic ? 'Clientul va primi noul status și factura de retur emisă automat.' : 'Clientul va primi noul status și factura de retur, dacă alegi să o emiți.' }}</small></span></label>
    <section class="order-modal-section"><div class="order-modal-section__title"><span>{{ cancellation_documents.pending or cancellation_documents.automatic ? '3' : '2' }}</span><div><small>Detalii</small><h3>O notă pentru echipă</h3><p>Nota este opțională și rămâne în istoricul intern al comenzii.</p></div></div><div class="order-form-grid"><label class="order-field order-field--wide"><span>Notă pentru actualizare <small>opțional</small></span><textarea name="reason" maxlength="500" rows="3" placeholder="Ex: Colet predat curierului în această dimineață."></textarea></label></div></section>
    <p class="order-modal-feedback" role="status" data-order-form-feedback hidden></p></div><footer class="order-modal-footer"><a href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}" class="order-modal-cancel" data-order-dialog-close>Renunță</a><button type="submit" class="order-modal-submit"><span>Actualizează comanda</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button></footer>
  {% else %}<div class="order-modal-empty"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span><h3>Fluxul este încheiat</h3><p>Starea {{ order.status_label|lower }} nu mai are o tranziție operațională disponibilă.</p><a href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}">Înapoi la comandă</a></div>{% endif %}
</form>
