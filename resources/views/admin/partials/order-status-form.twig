<header class="order-modal-head"><span class="order-modal-head__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M4 12h7M4 17h5M17 5v14M13 15l4 4 4-4"/></svg></span><div><span class="order-kicker">Flux operațional</span><h2 id="order-dialog-title">Schimbă statusul</h2><p>{{ order.order_number ?: '#' ~ order.id }} · acum <strong>{{ order.status_label }}</strong></p></div></header>
<form class="order-modal-form" action="{{ url('admin/comenzi/' ~ order.id ~ '/actiune/') }}" method="post" data-order-async-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}">
  {% if order.available_actions %}
    <section class="order-modal-section"><div class="order-modal-section__title"><span>1</span><div><small>Alege pasul</small><h3>Ce se întâmplă acum?</h3><p>Sunt afișate doar tranzițiile sigure pentru starea curentă.</p></div></div><div class="order-status-options">{% for action in order.available_actions %}<label class="order-choice{{ action.action == 'cancel' ? ' order-choice--danger' : '' }}"><input type="radio" name="action" value="{{ action.action }}"{{ loop.first ? ' checked' : '' }} data-order-action-radio><span class="order-choice__check"></span><span><strong>{{ action.label }}</strong><small>{{ action.description }}</small><em>{{ action.status_label }}</em></span></label>{% endfor %}</div></section>
    <section class="order-modal-section"><div class="order-modal-section__title"><span>2</span><div><small>Detalii</small><h3>Adaugă context, dacă este util</h3><p>Nota este opțională și rămâne în istoricul intern al comenzii.</p></div></div><div class="order-form-grid"><label class="order-field order-field--wide"><span>Notă pentru actualizare <small>opțional</small></span><textarea name="reason" maxlength="500" rows="3" placeholder="Ex: Colet predat curierului în această dimineață."></textarea></label></div></section>
    <label class="order-switch"><input type="checkbox" name="notify_customer" value="1" checked><span class="order-switch__control"><i></i></span><span><strong>Trimite e-mail clientului</strong><small>Mesajul este pus în coadă după salvarea statusului.</small></span></label>
    <p class="order-modal-feedback" data-order-form-feedback hidden></p><footer class="order-modal-footer"><button type="button" class="order-modal-cancel" data-order-dialog-close>Renunță</button><button type="submit" class="order-modal-submit"><span>Actualizează comanda</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button></footer>
  {% else %}<div class="order-modal-empty"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span><h3>Fluxul este încheiat</h3><p>Starea {{ order.status_label|lower }} nu mai are o tranziție operațională disponibilă.</p><a href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}">Înapoi la comandă</a></div>{% endif %}
</form>
