{% import 'admin/partials/nir-ui.twig' as ui %}
{% set doc = document %}
<article class="nir-detail-view" data-nir-detail data-detail-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/') }}">
 <header class="nir-detail-hero"><div class="nir-detail-identity"><span class="nir-form__mark">{{ ui.icon(doc.operation_type|default('') == 'supplier_return' ? 'return' : 'box') }}</span><div><span class="nir-eyebrow">{{ doc.operation_type|default('') == 'supplier_return' ? 'Retur către furnizor' : (doc.operation_type|default('') == 'customer_return' ? 'Recepție retur client' : 'Notă de recepție') }}</span><h1>{{ doc.status == 'draft' ? 'Recepție în lucru' : doc.number|default(doc.final_number|default(doc.temporary_number|default('În lucru'))) }}</h1><p>{% if doc.status == 'draft' %}{{ doc.number }} · {% endif %}{{ doc.supplier.alias|default(doc.supplier_name|default('Furnizor neales')) }} · {{ doc.display_nir_at|default(doc.nir_at) }}</p></div></div>{{ ui.badge(doc.status,doc.operation_type|default('')) }}{% if is_modal|default(false) %}<button type="button" class="nir-close" data-nir-modal-close aria-label="Închide recepția">{{ ui.icon('close') }}</button>{% endif %}</header>
 <div class="nir-detail-actions">{% if doc.status == 'draft' %}{% if permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/editare/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/editare/modal/') }}">{{ ui.icon('edit') }}Editează</a>{% endif %}{% if permissions.confirm|default(false) %}<a class="nir-button nir-button--primary" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/confirma/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/confirma/modal/') }}">{{ ui.icon('check') }}Confirmă recepția</a>{% endif %}{% if permissions.edit|default(false) %}<a class="nir-icon-button is-danger" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/sterge/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/sterge/modal/') }}" aria-label="Șterge documentul în lucru">{{ ui.icon('trash') }}</a>{% endif %}{% else %}{% if doc.can_correct|default(false) and permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/corectie/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/corectie/modal/') }}">{{ ui.icon('edit') }}Corectează</a>{% endif %}{% if doc.can_reverse|default(false) and permissions.reverse|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/storno/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/storno/modal/') }}">{{ ui.icon('return') }}Retur furnizor</a>{% endif %}{% endif %}{% if permissions.export|default(false) %}<div class="nir-export-actions"><a class="nir-button nir-button--cancel" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/export/pdf/') }}" target="_blank" rel="noopener">{{ ui.icon('document') }}PDF</a><a class="nir-button nir-button--cancel" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/export/xlsx/') }}">{{ ui.icon('download') }}Excel</a><a class="nir-button nir-button--cancel" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/export/zip/') }}">{{ ui.icon('download') }}Dosar ZIP</a></div>{% endif %}</div>
 <div class="nir-detail-body" tabindex="0" aria-label="Conținutul recepției">
 <div class="nir-document-state{{ doc.status == 'confirmed' ? ' is-sage' : '' }}">{{ ui.icon(doc.status == 'confirmed' ? 'shield' : 'info') }}<div><strong>{{ doc.status == 'confirmed' ? 'Recepție confirmată, document protejat' : 'Recepția este în lucru' }}</strong><span>{{ doc.status == 'confirmed' ? 'Stocul contabil și loturile păstrează legătura cu această recepție.' : 'Produsele nu au intrat încă în stocul contabil. Verifică datele, apoi confirmă recepția.' }}</span></div></div>
 <div class="nir-detail-grid"><section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Datele documentului</span><h2>Factură și recepție</h2></div>{{ ui.icon('document') }}</header><dl class="nir-info-grid"><div><dt>Furnizor</dt><dd>{{ doc.supplier.company_name|default(doc.supplier.alias|default(doc.supplier_name|default('—'))) }}</dd><small>{{ doc.supplier.tax_id|default('') }}</small></div><div><dt>Factură</dt><dd>{{ doc.invoice_series }} {{ doc.invoice_number }}</dd><small>{{ doc.display_invoice_date|default(doc.invoice_date) }}</small></div><div><dt>Gestiune</dt><dd>{{ doc.warehouse.name|default(doc.warehouse_name|default('—')) }}</dd></div><div><dt>Locație recepție</dt><dd>{{ doc.location.name|default(doc.location_name|default('—')) }}</dd></div><div><dt>Data NIR</dt><dd>{{ doc.display_nir_at|default(doc.nir_at) }}</dd></div><div><dt>Recepție fizică</dt><dd>{{ doc.display_received_at|default(doc.received_at) }}</dd></div><div><dt>Monedă / curs</dt><dd>{{ doc.currency }} · {{ doc.exchange_rate|decimal_ro }} RON</dd><small>{{ doc.exchange_rate_date }}</small></div></dl>{% if doc.notes %}<div class="nir-note"><strong>Observații</strong><p>{{ doc.notes }}</p></div>{% endif %}{% if doc.original_id|default('') %}<div class="nir-note"><strong>Document original</strong><a href="{{ url('admin/nir-uri/' ~ doc.original_id ~ '/') }}">{{ doc.original_number|default('Deschide recepția originală') }}</a></div>{% endif %}</section>
 {% if permissions.costs|default(false) %}<section class="nir-panel nir-receipt"><header><span>{{ ui.icon('money') }}</span><span class="nir-eyebrow">Rezumatul recepției</span><h2>Valori verificate</h2></header><dl><div><dt>Fără TVA</dt><dd>{{ (doc.net_bani|default(0)/100)|number_format(2,',','.') }} {{ doc.currency }}</dd></div><div><dt>TVA</dt><dd>{{ (doc.tax_bani|default(0)/100)|number_format(2,',','.') }} {{ doc.currency }}</dd></div><div class="nir-receipt__total"><dt>Total</dt><dd>{{ (doc.total_bani|default(0)/100)|number_format(2,',','.') }}<small>{{ doc.currency }}</small></dd></div>{% if doc.currency != 'RON' %}<div><dt>Echivalent lei</dt><dd>{{ money(doc.total_ron_bani|default(0)) }}</dd></div>{% endif %}<div><dt>Valoare contabilă</dt><dd>{{ money(doc.inventory_bani|default(0)) }}</dd></div></dl><p>{{ ui.icon('layers') }}{{ doc.lines|length }} {{ doc.lines|length == 1 ? 'poziție' : 'poziții' }} în document</p></section>{% endif %}</div>
 <section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">În această recepție</span><h2>Produsele recepționate</h2><p>Cantitățile de pe document, cele primite și cele acceptate.</p></div><span class="nir-count">{{ doc.lines|length }} {{ doc.lines|length == 1 ? 'poziție' : 'poziții' }}</span></header><div class="nir-detail-products">{% for line in doc.lines %}<article class="nir-detail-product"><div class="nir-detail-product__main"><span class="nir-product-image">{% if line.image_url|default('') %}<img src="{{ line.image_url }}" alt="{{ line.product_name|default(line.supplier_name) }}" loading="lazy">{% else %}{{ ui.icon('box') }}{% endif %}</span><div><span class="nir-eyebrow">Poziția {{ loop.index }}</span><h3>{{ line.supplier_name }}</h3><p>{{ line.product_name|default('Linie documentară') }}{% if line.sku|default('') %} · {{ line.sku }}{% endif %}</p><small>Cod furnizor: {{ line.supplier_code ?: 'Necompletat' }}</small></div>{% if permissions.costs|default(false) %}<strong class="nir-detail-product__price">{{ (line.total_bani|default(0)/100)|number_format(2,',','.') }} <small>{{ doc.currency }}</small></strong>{% endif %}</div><div class="nir-product-measures"><span><small>Pe factură</small><strong>{{ line.invoice_quantity|decimal_ro }} {{ line.purchase_unit }}</strong></span><span><small>Primite</small><strong>{{ line.received_quantity|decimal_ro }} {{ line.purchase_unit }}</strong></span><span class="is-sage"><small>Acceptate</small><strong>{{ line.accepted_quantity|decimal_ro }} {{ line.purchase_unit }}</strong></span><span><small>În stoc</small><strong>{{ (line.tracked is defined ? line.tracked : true) ? (line.stock_quantity|decimal_ro) ~ ' ' ~ line.stock_unit : 'Necontabilizat' }}</strong></span>{% if permissions.costs|default(false) %}<span><small>Preț fără TVA</small><strong>{{ line.unit_price|decimal_ro }} {{ doc.currency }}</strong></span><span><small>TVA</small><strong>{{ line.vat_percent|decimal_ro }}%</strong></span>{% endif %}</div>{% if line.difference_reason|default('') %}<div class="nir-difference-note">{{ ui.icon('warning') }}<span>{{ line.difference_label|default(line.difference_reason) }}{% if line.difference_notes %} · {{ line.difference_notes }}{% endif %}</span></div>{% endif %}</article>{% endfor %}</div></section>
 <div class="nir-file-section"><section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Documentele recepției</span><h2>Fișiere atașate</h2></div>{% if permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/modal/') }}">{{ ui.icon('plus') }}Adaugă</a>{% endif %}</header><div class="nir-attachments">{% for attachment in doc.attachments %}<div><span>{{ ui.icon('document') }}</span>{% if permissions.costs|default(false) %}<a href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/') }}" target="_blank" rel="noopener">{% else %}<div class="nir-attachment-name">{% endif %}<strong>{{ attachment.original_name }}</strong><small>{{ attachment.extension|default('Fișier')|upper }} · {{ (attachment.size_bytes|default(0) / 1024)|number_format(0,',','.') }} KB</small>{% if permissions.costs|default(false) %}</a><a class="nir-icon-button" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/') }}" aria-label="Descarcă {{ attachment.original_name }}">{{ ui.icon('download') }}</a>{% else %}</div>{% endif %}{% if permissions.edit|default(false) %}<a class="nir-icon-button is-danger" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/sterge/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/sterge/modal/') }}" aria-label="Șterge {{ attachment.original_name }}">{{ ui.icon('trash') }}</a>{% endif %}</div>{% else %}<div class="nir-muted-empty">{{ ui.icon('document') }}<p>Niciun fișier atașat încă.</p></div>{% endfor %}</div></section></div>
 {% if permissions.fifo|default(false) and doc.layers|default([]) %}<section class="nir-panel"><header class="nir-panel__heading"><div><span class="nir-eyebrow">Trasabilitate</span><h2>Loturile acestei recepții</h2><p>Cantitatea disponibilă rămâne legată de documentul și costul de intrare.</p></div>{{ ui.icon('layers') }}</header><div class="nir-table-wrap"><table class="nir-table"><thead><tr><th>Produs</th><th>Intrat</th><th>Disponibil</th>{% if permissions.costs %}<th>Cost unitar RON</th>{% endif %}<th>Data recepției</th></tr></thead><tbody>{% for layer in doc.layers %}<tr><td data-label="Produs">{{ layer.product_name|default(layer.sku) }}</td><td data-label="Intrat">{{ layer.initial_quantity|decimal_ro }}</td><td data-label="Disponibil"><span class="nir-badge is-sage">{{ layer.remaining_quantity|decimal_ro }}</span></td>{% if permissions.costs %}<td data-label="Cost unitar">{{ layer.unit_cost_ron|decimal_ro }}</td>{% endif %}<td data-label="Data">{{ layer.display_received_at|default(layer.received_at) }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}

 </div>
</article>
