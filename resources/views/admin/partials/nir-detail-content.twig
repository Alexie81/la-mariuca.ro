{% import 'admin/partials/nir-ui.twig' as ui %}
{% set doc = document %}
{% set is_supplier_return = doc.operation_type|default(doc.type|default('')) == 'supplier_return' %}
<article class="nir-workspace{{ is_supplier_return ? ' nir-workspace--return' : '' }}" data-nir-detail data-detail-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/') }}">
 <section class="nir-overview">
 <header class="nir-detail-hero"><div class="nir-detail-identity"><span class="nir-form__mark">{{ ui.icon(doc.operation_type|default('') == 'supplier_return' ? 'return' : 'box') }}</span><div><span class="nir-eyebrow">{{ doc.operation_type|default('') == 'supplier_return' ? 'Retur către furnizor' : (doc.operation_type|default('') == 'customer_return' ? 'Recepție retur client' : 'Notă de recepție') }}</span><h1>{{ doc.number|default('Draft') }}</h1><p>{{ doc.supplier.alias|default(doc.supplier_name|default('Furnizor neales')) }} · {{ doc.display_nir_at|default(doc.nir_at) }}</p></div></div>{{ ui.badge(doc.status,doc.operation_type|default('')) }}</header>

 <ol class="nir-progress" aria-label="{{ is_supplier_return ? 'Etapele returului' : 'Etapele recepției' }}">
  <li class="is-done"><span class="nir-progress__node">{{ ui.icon('document') }}<i>{{ ui.icon('check') }}</i></span><div><span class="nir-progress__step">Pasul 01</span><strong>Document salvat</strong><small>Datele sunt păstrate</small></div></li>
  <li class="{{ doc.status == 'confirmed' ? 'is-done' : 'is-current' }}"{% if doc.status == 'draft' %} aria-current="step"{% endif %}><span class="nir-progress__node">{{ ui.icon('check') }}</span><div><span class="nir-progress__step">{{ doc.status == 'confirmed' ? 'Pasul 02' : 'Ești aici · Pasul 02' }}</span><strong>{{ doc.status == 'confirmed' ? (is_supplier_return ? 'Retur confirmat' : 'Recepție confirmată') : 'Verifică și confirmă' }}</strong><small>{{ doc.status == 'confirmed' ? doc.display_confirmed_at|default('Verificări încheiate') : 'Compară produsele cu factura' }}</small></div></li>
  <li class="{{ doc.status == 'confirmed' ? 'is-done' : 'is-upcoming' }}"><span class="nir-progress__node">{{ ui.icon('warehouse') }}</span><div><span class="nir-progress__step">Pasul 03</span><strong>Stoc actualizat</strong><small>{{ doc.status == 'confirmed' ? 'Legat de acest document' : (is_supplier_return ? 'După confirmarea returului' : 'După confirmarea recepției') }}</small></div></li>
 </ol>
 <div class="nir-commandbar"><div class="nir-commandbar__edit" aria-label="{{ is_supplier_return ? 'Acțiuni pentru retur' : 'Acțiuni pentru recepție' }}">{% if doc.status == 'draft' %}{% if permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/editare/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/editare/modal/') }}">{{ ui.icon('edit') }}Editează</a>{% endif %}{% if permissions.confirm|default(false) %}<a class="nir-button nir-button--primary" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/confirma/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/confirma/modal/') }}">{{ ui.icon('check') }}{{ is_supplier_return ? 'Confirmă returul' : 'Confirmă recepția' }}</a>{% endif %}{% if permissions.edit|default(false) %}<a class="nir-icon-button is-danger" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/sterge/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/sterge/modal/') }}" aria-label="Șterge draftul">{{ ui.icon('trash') }}</a>{% endif %}{% else %}{% if doc.can_correct|default(false) and permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/corectie/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/corectie/modal/') }}">{{ ui.icon('edit') }}Corectează</a>{% endif %}{% if doc.can_reverse|default(false) and permissions.reverse|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/storno/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/storno/modal/') }}">{{ ui.icon('return') }}Retur furnizor</a>{% endif %}{% if doc.can_delete|default(false) and permissions.edit|default(false) and permissions.confirm|default(false) %}<a class="nir-button nir-button--danger-outline" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/sterge/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/sterge/modal/') }}">{{ ui.icon('trash') }}Șterge documentul</a>{% endif %}{% endif %}</div>{% if permissions.export|default(false) %}<div class="nir-downloads" aria-label="{{ is_supplier_return ? 'Exportă returul' : 'Exportă recepția' }}"><span class="nir-downloads__label">Descarcă</span><a class="nir-download" data-nir-download href="{{ url('admin/nir-uri/' ~ doc.id ~ '/export/pdf/') }}" target="_blank" rel="noopener">{{ ui.icon('document') }}PDF</a><a class="nir-download" data-nir-download href="{{ url('admin/nir-uri/' ~ doc.id ~ '/export/xlsx/') }}">{{ ui.icon('download') }}Excel</a><a class="nir-download" data-nir-download href="{{ url('admin/nir-uri/' ~ doc.id ~ '/export/zip/') }}">{{ ui.icon('download') }}Dosar ZIP</a></div>{% endif %}</div>
 </section>
 <div class="nir-workspace__body" tabindex="0" aria-label="{{ is_supplier_return ? 'Conținutul returului' : 'Conținutul recepției' }}">
 <div class="nir-workspace-help{{ doc.status == 'confirmed' ? ' is-confirmed' : '' }}"><span>{{ ui.icon(doc.status == 'confirmed' ? 'shield' : 'info') }}</span><div><strong>{{ doc.status == 'confirmed' ? (is_supplier_return ? 'Returul este confirmat.' : 'Recepția este confirmată.') : 'Mai întâi verifici. Apoi confirmi.' }}</strong><p>{{ doc.status == 'confirmed' ? 'Documentul și mișcările de stoc sunt păstrate împreună.' : 'Compară produsele și cantitățile cu factura. Produsele intră în stoc numai după confirmare.' }}</p></div>{% if doc.status == 'draft' and permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/editare/') }}" data-nir-modal-open data-editor-step="2" data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/editare/modal/') }}">Verifică produsele{{ ui.icon('arrow') }}</a>{% endif %}</div>
 <nav class="nir-section-links" aria-label="Secțiunile documentului"><a href="#nir-date">{{ ui.icon('document') }}{{ is_supplier_return ? 'Factura corectivă și returul' : 'Factură și recepție' }}</a><a href="#nir-produse">{{ ui.icon('box') }}Produse <span>{{ doc.lines|length }}</span></a><a href="#nir-fisiere">{{ ui.icon('upload') }}Documente <span>{{ doc.attachments|length }}</span></a></nav>
 <div class="nir-facts-layout{{ not permissions.costs|default(false) ? ' is-full' : '' }}"><section class="nir-sheet" id="nir-date"><header class="nir-sheet__heading"><div><span class="nir-eyebrow">Datele documentului</span><h2>{{ is_supplier_return ? 'Factura corectivă și returul' : 'Factură și recepție' }}</h2></div>{{ ui.icon('document') }}</header><dl class="nir-info-grid"><div><dt>Furnizor</dt><dd>{{ doc.supplier.company_name|default(doc.supplier.alias|default(doc.supplier_name|default('—'))) }}</dd><small>{{ doc.supplier.tax_id|default('') }}</small></div><div><dt>{{ is_supplier_return ? 'Factură corectivă' : 'Factură' }}</dt><dd>{{ doc.invoice_series }} {{ doc.invoice_number }}</dd><small>{{ doc.display_invoice_date|default(doc.invoice_date) }}</small></div><div><dt>Gestiune</dt><dd>{{ doc.warehouse.name|default(doc.warehouse_name|default('—')) }}</dd></div><div><dt>{{ is_supplier_return ? 'Locația stocului returnat' : 'Locație recepție' }}</dt><dd>{{ doc.location.name|default(doc.location_name|default('—')) }}</dd></div><div><dt>{{ is_supplier_return ? 'Data documentului' : 'Data NIR' }}</dt><dd>{{ doc.display_nir_at|default(doc.nir_at) }}</dd></div><div><dt>{{ is_supplier_return ? 'Data returului' : 'Recepție fizică' }}</dt><dd>{{ doc.display_received_at|default(doc.received_at) }}</dd></div><div><dt>Monedă / curs</dt><dd>{{ doc.currency }} · {{ doc.exchange_rate|decimal_ro }} RON</dd><small>{{ doc.exchange_rate_date }}</small></div></dl>{% if doc.notes %}<details class="nir-observations"><summary>{{ ui.icon('info') }}<span>Observații</span>{{ ui.icon('chevron') }}</summary><p>{{ doc.notes }}</p></details>{% endif %}{% if doc.original_id|default('') %}<aside class="nir-original" aria-label="Documentul original">
 <span class="nir-original__icon">{{ ui.icon('document') }}</span>
 <div class="nir-original__identity"><span class="nir-original__label">NIR-ul original</span><strong>{{ doc.original_number|default('Document original') }}</strong>{% if doc.display_original_nir_at|default('') %}<span class="nir-original__date">{{ ui.icon('clock') }}{{ doc.display_original_nir_at }}</span>{% endif %}</div>
 {% if doc.original_number|default('') %}<button type="button" class="nir-original__copy" data-nir-copy="{{ doc.original_number }}" aria-label="Copiază numărul NIR-ului original" title="Copiază numărul NIR-ului original">{{ ui.icon('copy') }}<span class="nir-original__copied" aria-hidden="true">{{ ui.icon('check') }}</span></button>{% endif %}
 <a class="nir-original__open" href="{{ url('admin/nir-uri/' ~ doc.original_id ~ '/') }}"><span>Accesează documentul original</span>{{ ui.icon('arrow') }}</a>
</aside>{% endif %}
{% if doc.type == 'supplier_receipt' and doc.reversals|default([])|length %}
<section class="nir-related-returns" aria-label="Retururi către furnizor asociate">
 <header><span>{{ ui.icon('return') }}</span><div><h3>Retururi către furnizor</h3><p>Documentele de retur asociate acestui NIR.</p></div><span class="nir-count">{{ doc.reversals|length }}</span></header>
 <div class="nir-related-returns__list">
 {% for return in doc.reversals %}
 <article class="nir-original nir-original--return" aria-label="Retur {{ return.number }}">
  <span class="nir-original__icon">{{ ui.icon('return') }}</span>
  <div class="nir-original__identity"><span class="nir-original__label">Document de retur</span><strong>{{ return.number }}</strong><span class="nir-original__date">{{ ui.icon('clock') }}{{ return.display_nir_at }}</span>{% if return.invoice_number %}<span class="nir-original__invoice">Factură corectivă: {{ return.invoice_series }} {{ return.invoice_number }}</span>{% endif %}</div>
  <button type="button" class="nir-original__copy" data-nir-copy="{{ return.number }}" aria-label="Copiază numărul {{ return.number }}" title="Copiază numărul documentului de retur">{{ ui.icon('copy') }}<span class="nir-original__copied" aria-hidden="true">{{ ui.icon('check') }}</span></button>
  <a class="nir-original__open" href="{{ url('admin/nir-uri/' ~ return.id ~ '/') }}"><span>Accesează documentul de retur</span>{{ ui.icon('arrow') }}</a>
 </article>
 {% endfor %}
 </div>
</section>
{% endif %}</section>
 {% if permissions.costs|default(false) %}<section class="nir-value-card" aria-label="{{ is_supplier_return ? 'Rezumatul valorilor returului' : 'Rezumatul valorilor recepției' }}">
 <header><div><span>{{ ui.icon('money') }}</span><h2>{{ is_supplier_return ? 'Totalul returului' : 'Totalul recepției' }}</h2></div><p class="nir-value-card__amount">{{ (doc.total_bani|default(0)/100)|number_format(2,',','.') }} <span>{{ doc.currency }}</span></p><p class="nir-value-card__caption">Valoarea produselor, cu TVA inclus</p></header>
 <dl><div><dt>Fără TVA</dt><dd>{{ (doc.net_bani|default(0)/100)|number_format(2,',','.') }} <small>{{ doc.currency }}</small></dd></div><div><dt>TVA</dt><dd>{{ (doc.tax_bani|default(0)/100)|number_format(2,',','.') }} <small>{{ doc.currency }}</small></dd></div>{% if doc.currency != 'RON' %}<div><dt>Echivalent lei</dt><dd>{{ money(doc.total_ron_bani|default(0)) }}</dd></div>{% endif %}<div class="nir-value-card__inventory"><dt>Valoare contabilă</dt><dd>{{ money(doc.inventory_bani|default(0)) }}</dd></div></dl>
 <footer>{{ ui.icon('layers') }}<span>{{ doc.lines|length }} {{ doc.lines|length == 1 ? 'poziție' : 'poziții' }} {{ is_supplier_return ? 'în acest retur' : 'în această recepție' }}</span></footer></section>{% endif %}</div>
 <section class="nir-sheet" id="nir-produse"><header class="nir-sheet__heading"><div><span class="nir-eyebrow">{{ is_supplier_return ? 'În acest retur' : 'În această recepție' }}</span><h2>{{ is_supplier_return ? 'Produsele returnate' : 'Produsele recepționate' }}</h2><p>{{ is_supplier_return ? 'Produsele și cantitățile returnate către furnizor.' : 'Cantitățile de pe document, cele primite și cele acceptate.' }}</p></div><span class="nir-count">{{ doc.lines|length }} {{ doc.lines|length == 1 ? 'poziție' : 'poziții' }}</span></header><div class="nir-items">{% for line in doc.lines %}<article class="nir-item"><div class="nir-item__main">{% if line.image_url|default('') %}<a class="nir-product-image nir-image-zoom" href="{{ line.image_url }}" target="_blank" rel="noopener" data-nir-image-open data-image-name="{{ line.product_name|default(line.supplier_name) }}" aria-label="Mărește imaginea pentru {{ line.product_name|default(line.supplier_name) }}"><img src="{{ line.image_url }}" alt="{{ line.product_name|default(line.supplier_name) }}" loading="lazy"><span>{{ ui.icon('search') }}</span></a>{% else %}<span class="nir-product-image">{{ ui.icon('box') }}</span>{% endif %}<div><h3>{{ line.supplier_name }}</h3><p>{% if line.product_name|default('') and line.product_name != line.supplier_name %}{{ line.product_name }} · {% endif %}{{ line.sku|default('Linie documentară') }}{% if line.product_slug|default('') %}<a class="nir-view-product" href="{{ url('produs/' ~ line.product_slug ~ '/') }}" target="_blank" rel="noopener">Vezi produsul{{ ui.icon('external') }}</a>{% endif %}</p><span class="nir-product-accepted">{{ (is_supplier_return ? line.accepted_quantity|trim('-') : line.accepted_quantity)|decimal_ro }} {{ line.purchase_unit }} {{ is_supplier_return ? 'returnate' : 'acceptate' }}</span>{% if line.supplier_code %}<small>Cod furnizor: {{ line.supplier_code }}</small>{% endif %}</div>{% if permissions.costs|default(false) %}<div class="nir-item__price"><span>Total cu TVA</span><strong>{{ (line.total_bani|default(0)/100)|number_format(2,',','.') }} <small>{{ doc.currency }}</small></strong><small>{{ line.unit_price|decimal_ro }} {{ doc.currency }} / {{ line.purchase_unit }} fără TVA</small></div>{% endif %}</div><details class="nir-item-inspection"{% if line.difference_reason|default('') %} open{% endif %}><summary>Detalii despre cantități și valori{{ ui.icon('chevron') }}</summary><div class="nir-item-measures"><span><small>Pe factură</small><strong>{{ line.invoice_quantity|decimal_ro }} {{ line.purchase_unit }}</strong></span><span><small>{{ is_supplier_return ? 'Returnate fizic' : 'Primite' }}</small><strong>{{ line.received_quantity|decimal_ro }} {{ line.purchase_unit }}</strong></span><span class="is-sage"><small>{{ is_supplier_return ? 'Scăzute din stoc' : 'Acceptate' }}</small><strong>{{ line.accepted_quantity|decimal_ro }} {{ line.purchase_unit }}</strong></span><span><small>{{ doc.status == 'draft' ? 'Pentru stoc' : 'Mișcare de stoc' }}</small><strong>{{ (line.tracked is defined ? line.tracked : true) ? (line.stock_quantity|decimal_ro) ~ ' ' ~ line.stock_unit : 'Necontabilizat' }}</strong></span>{% if permissions.costs|default(false) %}<span><small>Preț fără TVA</small><strong>{{ line.unit_price|decimal_ro }} {{ doc.currency }}</strong></span><span><small>TVA</small><strong>{{ line.vat_percent|decimal_ro }}%</strong></span>{% endif %}</div></details>{% if line.difference_reason|default('') %}<div class="nir-difference-note">{{ ui.icon('warning') }}<span>{{ line.difference_label|default(line.difference_reason) }}{% if line.difference_notes %} · {{ line.difference_notes }}{% endif %}</span></div>{% endif %}</article>{% endfor %}</div></section>
 <div class="nir-file-section"><section class="nir-sheet" id="nir-fisiere"><header class="nir-sheet__heading"><div><span class="nir-eyebrow">{{ is_supplier_return ? 'Documentele returului' : 'Documentele recepției' }}</span><h2>Fișiere atașate</h2></div>{% if permissions.edit|default(false) %}<a class="nir-button nir-button--soft" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/modal/') }}">{{ ui.icon('plus') }}Adaugă</a>{% endif %}</header><div class="nir-attachments">{% for attachment in doc.attachments %}<div><span>{{ ui.icon('document') }}</span>{% if permissions.costs|default(false) %}<a data-nir-download href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/') }}" target="_blank" rel="noopener">{% else %}<div class="nir-attachment-name">{% endif %}<strong>{{ attachment.original_name }}</strong><small>{{ attachment.extension|default('Fișier')|upper }} · {{ (attachment.size_bytes|default(0) / 1024)|number_format(0,',','.') }} KB</small>{% if permissions.costs|default(false) %}</a><a class="nir-icon-button" data-nir-download href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/') }}" aria-label="Descarcă {{ attachment.original_name }}">{{ ui.icon('download') }}</a>{% else %}</div>{% endif %}{% if permissions.edit|default(false) %}<a class="nir-icon-button is-danger" href="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/sterge/') }}" data-nir-modal-open data-modal-url="{{ url('admin/nir-uri/' ~ doc.id ~ '/documente/' ~ attachment.id ~ '/sterge/modal/') }}" aria-label="Șterge {{ attachment.original_name }}">{{ ui.icon('trash') }}</a>{% endif %}</div>{% else %}<div class="nir-muted-empty">{{ ui.icon('document') }}<p>Niciun fișier atașat încă.</p></div>{% endfor %}</div></section></div>
 {% if permissions.fifo|default(false) and doc.layers|default([]) %}<section class="nir-sheet"><header class="nir-sheet__heading"><div><span class="nir-eyebrow">Trasabilitate</span><h2>Loturile acestei recepții</h2><p>Cantitatea disponibilă rămâne legată de documentul și costul de intrare.</p></div>{{ ui.icon('layers') }}</header><div class="nir-table-wrap"><table class="nir-table"><thead><tr><th>Produs</th><th>Intrat</th><th>Disponibil</th>{% if permissions.costs %}<th>Cost unitar RON</th>{% endif %}<th>Data recepției</th></tr></thead><tbody>{% for layer in doc.layers %}<tr><td data-label="Produs">{{ layer.product_name|default(layer.sku) }}</td><td data-label="Intrat">{{ layer.initial_quantity|decimal_ro }}</td><td data-label="Disponibil"><span class="nir-badge is-sage">{{ layer.remaining_quantity|decimal_ro }}</span></td>{% if permissions.costs %}<td data-label="Cost unitar">{{ layer.unit_cost_ron|decimal_ro }}</td>{% endif %}<td data-label="Data">{{ layer.display_received_at|default(layer.received_at) }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}

 </div>
</article>
