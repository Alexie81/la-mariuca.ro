<dialog class="nir-export-loader" data-nir-export-loader aria-labelledby="nir-export-title" aria-describedby="nir-export-copy">
 <div class="nir-export-orbit" aria-hidden="true">
  <svg viewBox="0 0 112 112"><circle class="nir-export-orbit__track" cx="56" cy="56" r="51"/><circle class="nir-export-orbit__arc" cx="56" cy="56" r="51"/></svg>
  <img src="{{ url('assets/images/favicon-lm-192.png') }}" width="74" height="74" alt="">
 </div>
 <span class="nir-export-loader__eyebrow">La Măriuca · Documentele tale</span>
 <h2 id="nir-export-title" data-export-title>Pregătim fișierul tău</h2>
 <p id="nir-export-copy" data-export-copy role="status" aria-live="polite">Un moment, aranjăm documentele pentru descărcare.</p>
 <div class="nir-transfer-progress" data-transfer-progress hidden><progress data-transfer-bar max="100" value="0" aria-label="Progresul încărcării"></progress><span data-transfer-amount>0%</span></div>
 <div class="nir-export-loader__actions"><button type="button" data-export-cancel>Anulează</button><button type="button" data-export-retry hidden>Reîncearcă</button></div>
</dialog>
