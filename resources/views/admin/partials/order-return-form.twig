{% set request_mode = request_mode|default(false) %}
<header class="order-modal-head"><span class="order-modal-head__icon order-modal-head__icon--return"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5M5 12h9a5 5 0 0 1 5 5v1"/></svg></span><div><span class="order-kicker">Post-vânzare</span><h2 id="order-dialog-title">{{ request_mode ? 'Înregistrează o cerere de retur' : (pending_return_request|default(null) ? 'Verifică și acceptă returul' : 'Înregistrează un retur') }}</h2><p>{{ order.order_number ?: '#' ~ order.id }} · {{ order.returnable_quantity }} buc. eligibile</p></div></header>
<form class="order-modal-form" action="{{ url('admin/comenzi/' ~ order.id ~ (request_mode ? '/cerere-retur/' : '/retur/')) }}" method="post" data-order-async-form data-order-return-form data-order-total-bani="{{ order.total_bani }}"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="request_key" value="{{ order.return_request_key }}"><input type="hidden" name="order_version" value="{{ order.updated_at }}">
  <div class="order-modal-body">{% if pending_return_request|default(null) %}<input type="hidden" name="return_request_id" value="{{ pending_return_request.id }}"><p class="order-return-explainer">Cerere client: {{ pending_return_request.reason }}</p>{% endif %}
  <section class="order-modal-section"><div class="order-modal-section__title"><span>1</span><div><small>Produse</small><h3>Alege ce se întoarce</h3><p>Poți înregistra un retur integral sau doar anumite cantități.</p></div></div><div class="order-return-items">{% for item in order.items %}{% if item.returnable_quantity > 0 %}<article><span class="order-return-item__image">{% if item.image_path %}<img src="{{ url(item.image_path) }}" alt="" width="60" height="70">{% else %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7Z"/></svg>{% endif %}</span><div><strong>{{ item.product_name }}</strong><small>{{ item.variant_summary ?: 'SKU ' ~ item.sku }}</small><span>Disponibile: {{ item.returnable_quantity }} buc.</span></div><label><span>Cantitate</span><select name="quantities[{{ item.id }}]" data-return-quantity>{% for quantity in 0..item.returnable_quantity %}<option data-return-bani="{{ return_quotes[item.id][quantity]|default(0) }}" value="{{ quantity }}"{{ pending_return_request.quantities[item.id]|default(0) == quantity ? ' selected' : '' }}>{{ quantity }}</option>{% endfor %}</select></label></article>{% endif %}{% endfor %}</div><button type="button" class="order-return-all" data-order-return-all>Selectează toate cantitățile</button></section>
  <section class="order-modal-section"><div class="order-modal-section__title"><span>2</span><div><small>Detaliile returului</small><h3>Motivul returului</h3><p>Motivul rămâne în istoricul comenzii.</p></div></div><div class="order-form-grid"><label class="order-field order-field--wide"><span>Motivul returului</span><select name="reason" required>{% if pending_return_request|default(null) %}<option selected>{{ pending_return_request.reason }}</option>{% else %}<option value="">Alege motivul…</option>{% endif %}<option>Produs nepotrivit</option><option>Mărime nepotrivită</option><option>Produs deteriorat</option><option>Colet refuzat</option><option>Retur solicitat de client</option><option>Alt motiv</option></select></label>{% if not request_mode %}<label class="order-field order-field--wide"><span>Notă internă <small>opțional</small></span><textarea name="notes" maxlength="2000" rows="3" placeholder="Detalii utile pentru echipă…"></textarea></label>{% endif %}</div></section>
  {% include 'admin/partials/return-destination.twig' with {destination: pending_return_request.refund_details|default({}), original_payment: order.payment_method == 'stripe'} %}
  {% if not request_mode %}{% include 'admin/partials/return-settlement.twig' %}{% endif %}
  {% if not request_mode %}<section class="order-modal-section"><div class="order-modal-section__title"><span>3</span><div><small>Documente</small><h3>Alegi dacă emiți și factura</h3><p>Returul poate fi înregistrat și fără document fiscal.</p></div></div>
    <label class="order-switch"><input type="checkbox" name="issue_invoice" value="1"{{ order.return_invoice_default ? ' checked' : '' }}><span class="order-switch__control"><i></i></span><span><strong>Emite factura de retur</strong><small>{{ order.return_invoice_default ? 'Este selectată pentru că există o factură emisă. Poți dezactiva opțiunea.' : 'Comanda nu are factură. Dacă activezi opțiunea, se emite întâi factura comenzii, apoi factura de retur pentru cantitățile alese.' }}</small></span></label>
    <div class="order-return-explainer"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v1"/></svg><p>Înregistrarea returului nu pune automat marfa în stoc. Vei confirma separat produsele primite și starea lor. <strong>Această acțiune nu transferă bani.</strong></p></div>
    <label class="order-switch"><input type="checkbox" name="notify_customer" value="1" checked><span class="order-switch__control"><i></i></span><span><strong>Anunță clientul prin e-mail</strong><small>Confirmarea se pregătește numai după salvarea returului.</small></span></label>
  </section>
{% else %}<p class="order-return-explainer">Cererea se salvează pentru analiză și clientul primește o confirmare prin email. Produsele, stocul și documentele rămân neschimbate până la acceptare.</p>{% endif %}
  <p class="order-modal-feedback" role="status" data-order-form-feedback hidden></p></div><footer class="order-modal-footer"><span class="order-return-summary" data-return-summary aria-live="polite">Niciun produs selectat</span><a href="{{ url('admin/comenzi/' ~ order.id ~ '/') }}" class="order-modal-cancel" data-order-dialog-close>Renunță</a><button type="submit" class="order-modal-submit"><span>{{ request_mode ? 'Înregistrează cererea' : 'Înregistrează returul' }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button></footer>
</form>
