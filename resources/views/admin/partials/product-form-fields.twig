{% macro category_nodes(nodes, selected_ids, depth) %}
  {% for category in nodes %}
    <div class="admin-category-node" data-admin-category-node data-category-search="{{ (category.name ~ ' ' ~ category.slug)|lower }}" style="--category-depth:{{ depth }}">
      <label class="admin-category-option">
        <input type="checkbox" name="category_ids[]" value="{{ category.id }}" {{ category.id in selected_ids ? 'checked' }} data-admin-category-checkbox>
        <span class="admin-category-option__check" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m3.2 8.2 3 3 6.6-6.5"></path></svg></span>
        <span class="admin-category-option__copy">
          <strong>{{ category.name }}</strong>
          {% if category.status != 'published' %}<small>{{ category.status == 'draft' ? 'Draft' : 'Arhivată' }}</small>{% endif %}
        </span>
        {% if category.children is not empty %}<span class="admin-category-option__branch" aria-label="{{ category.children|length }} subcategorii">{{ category.children|length }}</span>{% endif %}
      </label>
      {% if category.children is not empty %}
        <div class="admin-category-children" data-admin-category-children>{{ _self.category_nodes(category.children, selected_ids, depth + 1) }}</div>
      {% endif %}
    </div>
  {% endfor %}
{% endmacro %}

{% set is_modal = modal_form|default(false) %}
{% set selected_category_ids = product.category_ids|default([]) %}
<form class="admin-product-editor__form{{ is_modal ? ' is-modal' : '' }}" action="{{ form_action }}" method="post" data-admin-product-form>
  <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
  <div class="admin-product-editor__feedback" data-admin-product-form-feedback role="alert" hidden></div>

  <div class="admin-product-editor__sections">
    <section class="admin-product-editor__section" aria-labelledby="product-section-identity{{ is_modal ? '-modal' : '' }}">
      <header>
        <span class="admin-product-editor__section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4.5 7.5 7.5-4 7.5 4v9L12 21l-7.5-4.5v-9Z"/><path d="m4.8 7.7 7.2 4.1 7.2-4.1M12 11.8V21"/></svg></span>
        <div><span>Identitate</span><h3 id="product-section-identity{{ is_modal ? '-modal' : '' }}">Cum apare în boutique</h3></div>
      </header>
      <div class="admin-product-editor__grid">
        <label class="admin-product-field admin-product-field--wide" data-product-name-field data-product-availability="idle">
          <span>Numele produsului <b>*</b></span>
          <input name="name" value="{{ product.name|default('') }}" autocomplete="off" placeholder="Ex: Rochiță de botez Maria" required data-product-name-input data-availability-url="{{ url('admin/produse/verifica-nume/') }}" data-product-id="{{ product.id|default('') }}" aria-describedby="product-name-status{{ is_modal ? '-modal' : '' }}">
          <small id="product-name-status{{ is_modal ? '-modal' : '' }}" data-product-name-status data-product-availability-status aria-live="polite">Denumirea pe care o vede clientul.</small>
        </label>
        <label class="admin-product-field" data-product-slug-field data-product-availability="idle">
          <span>Slug (numele linkului)</span>
          <input name="slug" value="{{ product.slug|default('') }}" autocomplete="off" placeholder="Se generează din nume" data-product-slug-input data-slug-autofill="{{ product ? 'false' : 'true' }}" data-availability-url="{{ url('admin/produse/verifica-slug/') }}" data-product-id="{{ product.id|default('') }}" aria-describedby="product-slug-status{{ is_modal ? '-modal' : '' }}">
          <small id="product-slug-status{{ is_modal ? '-modal' : '' }}" data-product-slug-status data-product-availability-status aria-live="polite">Se generează automat din titlu, dar îl poți modifica.</small>
        </label>
        <label class="admin-product-field" data-product-sku-field data-product-availability="idle">
          <span>SKU principal <em>opțional</em></span>
          <input name="primary_sku" value="{{ product.primary_sku|default('') }}" autocomplete="off" placeholder="Se generează automat" data-product-sku-input data-product-primary-sku-input data-sku-scope="primary" data-availability-url="{{ url('admin/produse/verifica-sku/') }}" data-product-id="{{ product.id|default('') }}">
          <small data-product-sku-status data-product-availability-status aria-live="polite">Codul stabil al produsului-mamă. Lasă gol pentru generare automată.</small>
        </label>
        <label class="admin-product-field">
          <span>Furnizor <em>opțional</em></span>
          <select name="supplier_id">
            <option value="">Fără furnizor asociat</option>
            {% for supplier in suppliers|default([]) %}
              <option value="{{ supplier.id }}" {{ product and product.supplier_id|default(0) == supplier.id ? 'selected' }}>
                {{ supplier.alias }}{{ supplier.company_name ? ' — ' ~ supplier.company_name : '' }}
              </option>
            {% endfor %}
          </select>
          <small>Administrat din CRM-ul de furnizori.</small>
        </label>
        <label class="admin-product-field">
          <span>Brand / Producător <em>opțional</em></span>
          <input name="brand" value="{{ product.brand|default('') }}" maxlength="190" autocomplete="organization" placeholder="Ex: La Măriuca">
          <small>Este vizibil clienților și este transmis către Google Merchant când este completat.</small>
        </label>
        <div class="admin-product-field admin-product-field--wide">
          <span>Categorii <b>*</b></span>
          <details class="admin-category-picker" data-admin-category-picker>
            <summary data-admin-category-toggle>
              <span class="admin-category-picker__summary-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5h6l1.6 2H20v9.5H4z"></path><path d="M4 10h16"></path></svg></span>
              <span class="admin-category-picker__summary-copy">
                <strong data-admin-category-summary>{{ selected_category_ids is empty ? 'Alege una sau mai multe categorii' : selected_category_ids|length ~ (selected_category_ids|length == 1 ? ' categorie selectată' : ' categorii selectate') }}</strong>
                <small data-admin-category-preview>Structură pe categorii și subcategorii</small>
              </span>
              <span class="admin-category-picker__summary-count" data-admin-category-count>{{ selected_category_ids|length }}</span>
              <svg class="admin-category-picker__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg>
            </summary>
            <button class="admin-category-picker__backdrop" type="button" aria-label="Închide selectorul de categorii" data-admin-category-close></button>
            <div class="admin-category-picker__panel">
              <header class="admin-category-picker__header">
                <span><small>Catalog</small><strong>Alege categoriile</strong></span>
                <button type="button" aria-label="Închide" data-admin-category-close><svg viewBox="0 0 24 24"><path d="m6.5 6.5 11 11M17.5 6.5l-11 11"></path></svg></button>
              </header>
              <div class="admin-category-picker__search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
                <input type="search" aria-label="Caută o categorie sau subcategorie" placeholder="Caută o categorie sau subcategorie…" autocomplete="off" data-admin-category-search>
                <button type="button" class="admin-category-picker__search-clear" aria-label="Șterge căutarea" data-admin-category-search-clear hidden><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg></button>
              </div>
              <div class="admin-category-picker__tree" role="group" aria-label="Categorii disponibile" data-admin-category-tree>
                {{ _self.category_nodes(categories, selected_category_ids, 0) }}
                <p class="admin-category-picker__empty" data-admin-category-empty hidden>Nu am găsit nicio categorie potrivită.</p>
              </div>
              <footer class="admin-category-picker__footer">
                <span data-admin-category-status>{{ selected_category_ids is empty ? 'Selectează cel puțin o categorie.' : selected_category_ids|length ~ ' selectate' }}</span>
                <button type="button" data-admin-category-done aria-label="Închide selectorul de categorii"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg></button>
              </footer>
            </div>
          </details>
          <small>Poți asocia produsul cu mai multe categorii și subcategorii.</small>
        </div>
      </div>
    </section>

    {% set option_groups = product.option_groups|default([]) %}
    <section class="admin-product-editor__section admin-product-options" aria-labelledby="product-section-options{{ is_modal ? '-modal' : '' }}" data-product-options-editor>
      <header class="admin-product-editor__section-heading">
        <span class="admin-product-editor__section-icon is-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 6h14M5 12h14M5 18h14"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="11" cy="18" r="2"/></svg></span>
        <div><span>Configurare simplă</span><h3 id="product-section-options{{ is_modal ? '-modal' : '' }}">Opțiunile produsului</h3></div>
        <button type="button" class="admin-product-options__add-group" data-product-option-group-add>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg>
          <span>Adaugă o alegere</span>
        </button>
      </header>
      <p class="admin-product-options__intro">Folosește această zonă numai dacă familia trebuie să aleagă ceva înainte de a pune produsul în coș, de exemplu mărimea sau culoarea.</p>
      <div class="admin-product-options__summary" data-product-options-summary>
        <span aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m4 10 3.2 3.2L16 5.8"/></svg></span>
        <strong data-product-options-summary-title>{{ option_groups is empty ? 'Produs simplu, fără opțiuni' : option_groups|length ~ (option_groups|length == 1 ? ' alegere configurată' : ' alegeri configurate') }}</strong>
        <small data-product-options-summary-detail>{{ option_groups is empty ? 'Clientul vede direct butonul de adăugare în coș.' : 'Combinațiile sunt create automat mai jos.' }}</small>
      </div>
      <div class="admin-product-options__empty" data-product-options-empty {{ option_groups is not empty ? 'hidden' }}>
        <span class="admin-product-options__empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/><path d="M18 15v6M15 18h6"/></svg></span>
        <div><strong>Produsul nu are alegeri</strong><p>Este perfect pentru un produs cu un singur preț și un singur stoc.</p></div>
        <div class="admin-product-options__suggestions" aria-label="Adaugă rapid o alegere">
          <button type="button" data-product-option-preset="Mărime">+ Mărime</button>
          <button type="button" data-product-option-preset="Culoare">+ Culoare</button>
        </div>
      </div>
      <div class="admin-product-options__groups" data-product-option-groups>
        {% for group in option_groups %}
          {% set group_index = loop.index0 %}
          <article class="admin-product-option-group" data-product-option-group>
            <div class="admin-product-option-group__number" aria-hidden="true"><small>Alegerea</small><strong data-product-option-group-number>{{ loop.index }}</strong></div>
            <div class="admin-product-option-group__content">
              <div class="admin-product-option-group__topline">
                <label class="admin-product-field">
                  <span>Ce alege clientul? <b>*</b></span>
                  <input name="option_groups[{{ loop.index0 }}][name]" value="{{ group.name }}" maxlength="80" placeholder="Ex: Mărime" required data-product-option-group-name>
                  <small>Un nume scurt și clar, precum „Mărime” sau „Culoare”.</small>
                </label>
                <button type="button" class="admin-product-option-group__remove" aria-label="Șterge această alegere" data-product-option-group-remove><svg viewBox="0 0 20 20"><path d="m6 6 8 8M14 6l-8 8"/></svg></button>
              </div>
              <div class="admin-product-option-group__values-wrap">
                <div class="admin-product-option-group__values-head">
                  <span class="admin-product-option-group__values-label">Ce variante poate alege? <b>*</b></span>
                  <span class="admin-product-option-group__values-count" data-product-option-value-count>{{ group.values|length }} {{ group.values|length == 1 ? 'opțiune' : 'opțiuni' }}</span>
                </div>
                <div class="admin-product-option-group__values" data-product-option-values>
                  {% for value in group.values %}
                    <label class="admin-product-option-value">
                      <span class="admin-product-option-value__number" aria-hidden="true" data-product-option-value-number>{{ loop.index }}</span>
                      <input name="option_groups[{{ group_index }}][values][{{ loop.index0 }}]" value="{{ value }}" maxlength="100" placeholder="Ex: 3–6 luni" required data-product-option-value>
                      <button type="button" aria-label="Șterge opțiunea {{ value }}" data-product-option-value-remove><svg viewBox="0 0 18 18"><path d="m5 5 8 8M13 5l-8 8"/></svg></button>
                    </label>
                  {% endfor %}
                </div>
                <button type="button" class="admin-product-option-group__add-value" data-product-option-value-add><svg viewBox="0 0 18 18"><path d="M9 3v12M3 9h12"/></svg><span>Adaugă o valoare</span></button>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    {% set form_variants = product.variants|default([]) %}
    {% if form_variants is empty %}
      {% set form_variants = [{id: '', sku: '', ean: '', options_json: '{}', options: {}, full_price_bani: 0, price_bani: 0, stock: 0, stock_unlimited: 0, track_in_conta: 0, discount_enabled: false, discount_type: 'percent', discount_value: 0}] %}
    {% endif %}
    <section class="admin-product-editor__section admin-product-commerce" aria-labelledby="product-section-commerce{{ is_modal ? '-modal' : '' }}" data-product-variants-editor>
      <header>
        <span class="admin-product-editor__section-icon is-gold" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14l-1 13H6L5 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2M9 12h6"/></svg></span>
        <div><span>Comercial</span><h3 id="product-section-commerce{{ is_modal ? '-modal' : '' }}">Preț, stoc și stare</h3><small data-product-variant-count>{{ option_groups is empty ? 'Un singur preț' : form_variants|length ~ (form_variants|length == 1 ? ' combinație' : ' combinații') }}</small></div>
      </header>
      <div class="admin-product-commerce__overview">
        <label class="admin-product-field">
          <span>Stare</span>
          <span class="admin-product-field__select">
            <select name="status"><option value="draft" {{ product.status|default('published') == 'draft' ? 'selected' }}>Draft</option><option value="published" {{ product.status|default('published') == 'published' ? 'selected' }}>Publicat</option><option value="archived" {{ product.status|default('') == 'archived' ? 'selected' }}>Arhivat</option></select>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
          </span>
        </label>
        <label class="admin-product-switch">
          <input type="checkbox" name="featured" {{ product.featured|default(false) ? 'checked' }}>
          <i aria-hidden="true"><b></b></i>
          <span><strong>Ales cu drag</strong><small>Afișează produsul în selecția de pe homepage.</small></span>
        </label>
        <label class="admin-product-track-switch admin-product-parent-track" data-product-parent-track>
          <input type="hidden" name="track_in_conta" value="0">
          <input type="checkbox" name="track_in_conta" value="1" {{ (product.track_in_conta is defined ? product.track_in_conta : true) ? 'checked' }}>
          <i aria-hidden="true"><b></b></i>
          <span><strong>Urmărește SKU-ul principal în Conta</strong><small>Combinațiile fără un SKU contabil propriu vor scădea numai din acest stoc.</small></span>
        </label>
      </div>
      <div class="admin-product-commerce__notice" data-product-variants-notice {{ option_groups is empty ? 'hidden' }}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 9v5M10 6h.01"/></svg>
        <span>Combinațiile sunt generate automat. Completează prețul și stocul pentru fiecare.</span>
      </div>
      <div class="admin-product-variants" data-product-variants>
        {% for variant in form_variants %}
          <article class="admin-product-variant" data-product-variant data-options-json="{{ variant.options_json|default('{}')|e('html_attr') }}">
            <input type="hidden" name="variants[{{ loop.index0 }}][id]" value="{{ variant.id|default('') }}" data-product-variant-id>
            <input type="hidden" name="variants[{{ loop.index0 }}][options_json]" value="{{ variant.options_json|default('{}')|e('html_attr') }}" data-product-variant-options>
            <header class="admin-product-variant__header" data-product-variant-header {{ option_groups is empty ? 'hidden' }}>
              <span>Combinația <b data-product-variant-number>{{ loop.index }}</b></span>
              <div class="admin-product-variant__chips" data-product-variant-chips>
                {% for name, value in variant.options|default({}) %}<i><small>{{ name }}</small>{{ value }}</i>{% endfor %}
              </div>
            </header>
            <div class="admin-product-variant__body">
              <label class="admin-product-field admin-product-variant__sku" data-product-variant-sku-field data-product-sku-field data-product-availability="idle" {{ option_groups is empty ? 'hidden' }}>
                <span>SKU <em>opțional</em></span>
                <input name="variants[{{ loop.index0 }}][sku]" value="{{ variant.sku|default('') }}" autocomplete="off" placeholder="Se generează automat" data-product-sku-input data-availability-url="{{ url('admin/produse/verifica-sku/') }}" data-variant-id="{{ variant.id|default('') }}">
                <small data-product-sku-status data-product-availability-status aria-live="polite">Lasă gol pentru generare automată.</small>
              </label>
              <label class="admin-product-field admin-product-variant__price">
                <span>Preț întreg <b>*</b></span>
                <span class="admin-product-field__suffix"><input name="variants[{{ loop.index0 }}][full_price]" inputmode="decimal" value="{{ variant.full_price_bani ? '%d,%02d'|format(variant.full_price_bani // 100, variant.full_price_bani % 100) : '' }}" placeholder="0,00" required data-product-variant-full-price><em>RON</em></span>
                <small>Prețul înainte de o eventuală reducere.</small>
              </label>
              <div class="admin-product-variant__stock">
                <label class="admin-product-field">
                  <span>Stoc disponibil <b>*</b></span>
                  <span class="admin-product-field__suffix"><input type="number" min="0" name="variants[{{ loop.index0 }}][stock]" value="{{ variant.stock|default(0) }}" required data-product-variant-stock><em>buc.</em></span>
                </label>
                <label class="admin-product-mini-switch">
                  <input type="hidden" name="variants[{{ loop.index0 }}][stock_unlimited]" value="0">
                  <input type="checkbox" name="variants[{{ loop.index0 }}][stock_unlimited]" value="1" {{ variant.stock_unlimited|default(false) ? 'checked' }} data-product-stock-unlimited>
                  <i aria-hidden="true"><b></b></i><span>Stoc nelimitat</span>
                </label>
              </div>
              <label class="admin-product-field admin-product-variant__ean">
                <span>EAN / cod de bare <em>opțional</em></span>
                <input name="variants[{{ loop.index0 }}][ean]" value="{{ variant.ean|default('') }}" placeholder="Ex: 5941234567890">
                <small>Poți introduce codul exact așa cum este furnizat.</small>
              </label>
              <label class="admin-product-track-switch" data-product-variant-track {{ option_groups is empty ? 'hidden' }}>
                <input type="hidden" name="variants[{{ loop.index0 }}][track_in_conta]" value="0">
                <input type="checkbox" name="variants[{{ loop.index0 }}][track_in_conta]" value="1" {{ variant.track_in_conta|default(false) ? 'checked' }} data-product-variant-track-input>
                <i aria-hidden="true"><b></b></i>
                <span><strong>Folosește SKU-ul acestei combinații în Conta</strong><small>Înlocuiește SKU-ul principal numai pentru această combinație. Stocul nu se scade de două ori.</small></span>
              </label>
              <div class="admin-product-discount" data-product-discount>
                <label class="admin-product-discount__toggle">
                  <input type="hidden" name="variants[{{ loop.index0 }}][discount_enabled]" value="0">
                  <input type="checkbox" name="variants[{{ loop.index0 }}][discount_enabled]" value="1" {{ variant.discount_enabled|default(false) ? 'checked' }} data-product-discount-toggle>
                  <i aria-hidden="true"><b></b></i>
                  <span><strong>Aplică o reducere</strong><small>Doar pentru această combinație.</small></span>
                </label>
                <div class="admin-product-discount__fields" data-product-discount-fields {{ not variant.discount_enabled|default(false) ? 'hidden' }}>
                  <label><span>Tip</span><select name="variants[{{ loop.index0 }}][discount_type]" data-product-discount-type {{ not variant.discount_enabled|default(false) ? 'disabled' }}><option value="percent" {{ variant.discount_type|default('percent') == 'percent' ? 'selected' }}>Procent (%)</option><option value="fixed" {{ variant.discount_type|default('') == 'fixed' ? 'selected' }}>Sumă fixă (lei)</option></select></label>
                  <label><span>Valoare</span><span class="admin-product-discount__value"><input name="variants[{{ loop.index0 }}][discount_value]" inputmode="decimal" value="{% if variant.discount_enabled|default(false) %}{{ variant.discount_type == 'fixed' ? '%d,%02d'|format(variant.discount_value // 100, variant.discount_value % 100) : '%d,%02d'|format(variant.discount_value // 100, variant.discount_value % 100) }}{% endif %}" placeholder="0,00" data-product-discount-value {{ not variant.discount_enabled|default(false) ? 'disabled' }}><em data-product-discount-unit>{{ variant.discount_type|default('percent') == 'fixed' ? 'LEI' : '%' }}</em></span></label>
                  <div class="admin-product-discount__result"><span>Preț final</span><strong data-product-discount-result>{{ '%d,%02d'|format(variant.price_bani|default(0) // 100, variant.price_bani|default(0) % 100) }} RON</strong></div>
                </div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="admin-product-editor__section admin-product-global-discount" aria-labelledby="product-section-global-discount{{ is_modal ? '-modal' : '' }}" data-product-global-discount>
      <div class="admin-product-global-discount__top">
        <div class="admin-product-global-discount__copy">
          <span>Ofertă specială</span>
          <h3 id="product-section-global-discount{{ is_modal ? '-modal' : '' }}">Reducere generală</h3>
          <p>Aplică aceeași reducere tuturor combinațiilor dintr-un singur pas. După aplicare, poți modifica separat orice combinație.</p>
        </div>
        <label class="admin-product-global-discount__switch">
          <input type="checkbox" data-product-global-discount-toggle aria-controls="product-global-discount-fields{{ is_modal ? '-modal' : '' }}" aria-expanded="false">
          <i aria-hidden="true"><b></b></i>
          <span><strong>Aplică tuturor variantelor</strong><small>Deschide configurarea ghidată.</small></span>
        </label>
      </div>
      <div class="admin-product-global-discount__fields" id="product-global-discount-fields{{ is_modal ? '-modal' : '' }}" data-product-global-discount-fields hidden>
        <div class="admin-product-global-discount__guide">
          <span aria-hidden="true">%</span>
          <div><strong>Alege cum vrei să reduci prețurile</strong><small>Poți folosi un procent sau aceeași sumă în lei pentru toate combinațiile.</small></div>
        </div>
        <label class="admin-product-global-discount__field">
          <span>Tipul reducerii</span>
          <span class="admin-product-global-discount__select">
            <select data-product-global-discount-type>
              <option value="percent">Procent (%)</option>
              <option value="fixed">Sumă fixă (lei)</option>
            </select>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
          </span>
        </label>
        <label class="admin-product-global-discount__field">
          <span>Valoarea reducerii</span>
          <span class="admin-product-global-discount__value"><input inputmode="decimal" placeholder="0,00" data-product-global-discount-value><em data-product-global-discount-unit>%</em></span>
        </label>
        <button type="button" class="admin-product-global-discount__apply" data-product-global-discount-apply>
          <span>Aplică reducerea</span>
          <i aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m7 5 5 5-5 5"/></svg></i>
        </button>
        <p class="admin-product-global-discount__feedback" data-product-global-discount-feedback aria-live="polite">Reducerea va fi copiată în toate combinațiile după ce apeși „Aplică reducerea”.</p>
      </div>
    </section>

    <section class="admin-product-editor__section" aria-labelledby="product-section-story{{ is_modal ? '-modal' : '' }}">
      <header>
        <span class="admin-product-editor__section-icon is-rose" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10Z"/></svg></span>
        <div><span>Editorial</span><h3 id="product-section-story{{ is_modal ? '-modal' : '' }}">Povestea produsului</h3></div>
      </header>
      <div class="admin-product-editor__grid">
        <label class="admin-product-field admin-product-field--full">
          <span>Descriere scurtă</span>
          <textarea name="short_description" rows="3" maxlength="200" placeholder="O frază caldă și clară despre produs…" data-product-short-description aria-describedby="product-short-description-help{{ is_modal ? '-modal' : '' }}">{{ product.short_description|default('') }}</textarea>
          <small class="admin-product-field__hint-row" id="product-short-description-help{{ is_modal ? '-modal' : '' }}">
            <span>Apare în zona editorială de lângă titlul produsului.</span>
            <span class="admin-product-field__character-count"><strong data-product-short-description-count>{{ product.short_description|default('')|length }}</strong>/200 caractere</span>
          </small>
        </label>
        <div class="admin-product-field admin-product-field--full admin-product-rich-field">
          <span id="product-description-label{{ is_modal ? '-modal' : '' }}">Descriere completă</span>
          <small class="admin-product-rich-field__intro">Scrie povestea produsului, formatează ideile importante și așază imaginile exact unde dorești.</small>
          <div
            class="admin-rich-editor"
            data-product-rich-editor
            data-upload-url="{{ url('admin/produse/descriere-imagine/') }}"
            aria-labelledby="product-description-label{{ is_modal ? '-modal' : '' }}"
            hidden
          >
            <div class="admin-rich-editor__toolbar" role="toolbar" aria-label="Formatarea descrierii complete">
              <div class="admin-rich-editor__format-actions">
                <button type="button" data-rich-command="bold" aria-label="Text îngroșat" title="Text îngroșat"><strong>B</strong></button>
                <button type="button" data-rich-command="italic" aria-label="Text cursiv" title="Text cursiv"><em>I</em></button>
                <button type="button" data-rich-command="underline" aria-label="Text subliniat" title="Text subliniat"><u>U</u></button>
                <span class="admin-rich-editor__divider" aria-hidden="true"></span>
                <button type="button" class="admin-rich-editor__wide-action" data-rich-command="insertUnorderedList" aria-label="Listă cu buline">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="3" cy="5" r="1"/><circle cx="3" cy="10" r="1"/><circle cx="3" cy="15" r="1"/><path d="M7 5h10M7 10h10M7 15h10"/></svg><span>Listă</span>
                </button>
                <button type="button" class="admin-rich-editor__wide-action" data-rich-command="insertOrderedList" aria-label="Listă numerotată">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 4h2v3M2 11c2-1 3 0 1 2l-1 2h3M8 5h9M8 10h9M8 15h9"/></svg><span>1. Listă</span>
                </button>
              </div>
              <div class="admin-rich-editor__image-actions">
                <button type="button" class="admin-rich-editor__add-image" data-rich-image-add>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v14M3 10h14"/></svg><span>Imagine</span>
                </button>
                <button type="button" data-rich-image-up disabled aria-label="Mută imaginea mai sus" title="Mută imaginea mai sus"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5"/></svg></button>
                <button type="button" data-rich-image-down disabled aria-label="Mută imaginea mai jos" title="Mută imaginea mai jos"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5"/></svg></button>
                <button type="button" class="admin-rich-editor__image-settings" data-rich-image-settings disabled aria-expanded="false">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M4 10h12M4 14h12M7 4v4M13 8v4M9 12v4"/></svg><span>Mărime</span>
                </button>
              </div>
            </div>
            <div class="admin-rich-editor__hint">
              <span><i aria-hidden="true"></i> Poți lipi direct text și imagini</span>
              <span data-rich-editor-status aria-live="polite">Totul este pregătit</span>
            </div>
            <div
              class="admin-rich-editor__canvas"
              contenteditable="true"
              role="textbox"
              aria-multiline="true"
              aria-label="Descrierea completă a produsului"
              data-placeholder="Începe cu materialul, beneficiile și povestea produsului…"
              data-rich-editor-canvas
            ></div>
            <aside class="admin-rich-editor__image-panel" data-rich-image-panel hidden>
              <header>
                <div><span>Imagine selectată</span><strong>Așezare în descriere</strong></div>
                <button type="button" data-rich-image-panel-close aria-label="Închide opțiunile imaginii"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"/></svg></button>
              </header>
              <div class="admin-rich-editor__image-panel-grid">
                <label class="admin-rich-editor__size-control">
                  <span>Mărime <output data-rich-image-size-output>100%</output></span>
                  <input type="range" min="30" max="100" step="1" value="100" data-rich-image-size>
                </label>
                <fieldset class="admin-rich-editor__alignment">
                  <legend>Aliniere</legend>
                  <button type="button" data-rich-image-align="left" aria-label="Aliniază la stânga"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14M3 8h9M3 12h14M3 16h9"/></svg></button>
                  <button type="button" data-rich-image-align="center" aria-label="Centrează"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14M5 8h10M3 12h14M5 16h10"/></svg></button>
                  <button type="button" data-rich-image-align="right" aria-label="Aliniază la dreapta"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14M8 8h9M3 12h14M8 16h9"/></svg></button>
                </fieldset>
                <label class="admin-rich-editor__alt-control"><span>Descriere imagine <small>pentru accesibilitate</small></span><input type="text" maxlength="250" placeholder="Ex: Detaliu al rochiței roz" data-rich-image-alt></label>
                <button type="button" class="admin-rich-editor__remove-image" data-rich-image-remove><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 6V4h4v2M6 6l1 10h6l1-10M9 9v4M11 9v4"/></svg><span>Șterge imaginea</span></button>
              </div>
            </aside>
            <input type="file" accept="image/jpeg,image/png,image/webp" data-rich-image-input hidden>
          </div>
          <textarea name="description" rows="7" placeholder="Materiale, beneficii, ocazii și toate detaliile care ajută familia să aleagă…" data-rich-editor-source>{{ product.description|default('')|product_description_html|e }}</textarea>
          <small class="admin-product-rich-field__help">Imaginile sunt optimizate automat. Apasă sau fă click dreapta pe o imagine pentru mărime, aliniere și descriere.</small>
        </div>
      </div>
    </section>

    <section class="admin-product-editor__section" aria-labelledby="product-section-details{{ is_modal ? '-modal' : '' }}">
      <header>
        <span class="admin-product-editor__section-icon is-sage" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18H6zM9 7h6M9 11h6M9 15h4"/></svg></span>
        <div><span>Detalii utile</span><h3 id="product-section-details{{ is_modal ? '-modal' : '' }}">Tot ce trebuie știut</h3></div>
      </header>
      <div class="admin-product-editor__grid">
        <label class="admin-product-field"><span>Compoziție</span><input name="composition" value="{{ product.composition|default('') }}" placeholder="Ex: 100% bumbac"></label>
        <label class="admin-product-field"><span>Ghid de mărimi</span><input name="size_guide" value="{{ product.size_guide|default('') }}" placeholder="Recomandări pentru alegerea mărimii"></label>
        <label class="admin-product-field admin-product-field--full"><span>Notă informativă</span><input name="excluded_accessories" value="{{ product.excluded_accessories|default('') }}" placeholder="Ex: Elementele decorative din fotografie nu sunt incluse"></label>
      </div>
    </section>

    {% set seo_title_value = product.seo_title|default('') %}
    {% set seo_description_value = product.meta_description|default('') %}
    {% set seo_preview_title = seo_title_value ? seo_title_value : product.name|default('Titlul produsului') %}
    {% set seo_preview_description = seo_description_value ? seo_description_value : product.short_description|default('Descrierea produsului va apărea aici pentru a ajuta familia să aleagă.') %}
    <section class="admin-product-editor__section admin-product-seo" aria-labelledby="product-section-seo{{ is_modal ? '-modal' : '' }}" data-product-seo>
      <header class="admin-product-seo__heading">
        <span class="admin-product-editor__section-icon is-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg></span>
        <div class="admin-product-seo__heading-copy">
          <span>Căutare</span>
          <h3 id="product-section-seo{{ is_modal ? '-modal' : '' }}">Prezentare pentru Google</h3>
          <p>Completează simplu, iar în dreapta vezi imediat cum poate apărea produsul.</p>
        </div>
        <span class="admin-product-seo__live-pill"><i aria-hidden="true"></i>Previzualizare live</span>
      </header>

      <div class="admin-product-seo__layout">
        <div class="admin-product-seo__fields">
          <label class="admin-product-field admin-product-seo__field">
            <span class="admin-product-seo__field-label"><span>Titlul din Google</span><em>recomandat: max. 60</em></span>
            <input name="seo_title" value="{{ seo_title_value }}" placeholder="Ex: Iepuraș textil «Nani» pentru copii" data-product-seo-title aria-describedby="product-seo-title-help{{ is_modal ? '-modal' : '' }}">
            <small class="admin-product-seo__field-help" id="product-seo-title-help{{ is_modal ? '-modal' : '' }}">
              <span>Lasă-l gol pentru a folosi automat numele produsului.</span>
              <span class="admin-product-seo__counter" data-product-seo-title-count><strong>{{ seo_title_value|length }}</strong>/60</span>
            </small>
          </label>

          <label class="admin-product-field admin-product-seo__field">
            <span class="admin-product-seo__field-label"><span>Descrierea din Google</span><em>recomandat: max. 160</em></span>
            <textarea name="meta_description" rows="4" placeholder="Spune pe scurt ce face produsul special…" data-product-seo-description aria-describedby="product-seo-description-help{{ is_modal ? '-modal' : '' }}">{{ seo_description_value }}</textarea>
            <small class="admin-product-seo__field-help" id="product-seo-description-help{{ is_modal ? '-modal' : '' }}">
              <span>Las-o goală pentru a folosi automat descrierea scurtă.</span>
              <span class="admin-product-seo__counter" data-product-seo-description-count><strong>{{ seo_description_value|length }}</strong>/160</span>
            </small>
          </label>
        </div>

        <aside class="admin-product-seo__preview" aria-label="Previzualizarea rezultatului Google" data-product-seo-base-url="{{ url('produs/') }}">
          <div class="admin-product-seo__preview-topline">
            <span>Rezultatul văzut de client</span>
            <i aria-hidden="true"></i>
          </div>
          <div class="admin-product-seo__preview-source">
            <span class="admin-product-seo__google-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.6h3.3c1.9-1.8 2.9-4.4 2.9-7.5Z"/>
                <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.3l-3.3-2.6c-.9.6-2.1 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3v2.7A10 10 0 0 0 12 22Z"/>
                <path fill="#FBBC05" d="M6.4 13.9A6 6 0 0 1 6.1 12c0-.7.1-1.3.3-1.9V7.4H3A10 10 0 0 0 2 12c0 1.7.4 3.2 1 4.6l3.4-2.7Z"/>
                <path fill="#EA4335" d="M12 5.9c1.5 0 2.9.5 3.9 1.5l2.9-2.9A9.8 9.8 0 0 0 12 2a10 10 0 0 0-9 5.4l3.4 2.7C7.2 7.7 9.4 5.9 12 5.9Z"/>
              </svg>
            </span>
            <span><strong data-product-seo-preview-host>La Măriuca Boutique</strong><small data-product-seo-preview-url>{{ url('produs/' ~ (product.slug|default('numele-produsului')) ~ '/') }}</small></span>
          </div>
          <strong class="admin-product-seo__preview-title" data-product-seo-preview-title>{{ seo_preview_title }}</strong>
          <p data-product-seo-preview-description>{{ seo_preview_description }}</p>
          <small class="admin-product-seo__preview-note"><i aria-hidden="true"></i>Previzualizarea se actualizează pe măsură ce scrii.</small>
        </aside>
      </div>

      <label class="admin-product-seo__visibility">
        <input type="checkbox" name="indexable" data-product-seo-indexable {{ not product or product.indexable ? 'checked' }}>
        <i class="admin-product-seo__toggle" aria-hidden="true"><b></b></i>
        <span>
          <strong>Permite afișarea în Google</strong>
          <small>Google poate analiza și include această pagină în rezultatele căutării.</small>
        </span>
        <em data-product-seo-visibility-status><i aria-hidden="true"></i><span>{{ not product or product.indexable ? 'Vizibilitate activă' : 'Vizibilitate oprită' }}</span></em>
      </label>
    </section>
  </div>

  <footer class="admin-product-editor__footer">
    <span class="admin-product-editor__save-status" data-admin-product-save-status role="status" aria-live="polite"><i aria-hidden="true"></i><span data-admin-product-save-status-label>Up to date</span></span>
    <div class="admin-product-editor__footer-actions">
      {% if is_modal %}<button type="button" class="admin-product-editor__cancel" data-admin-product-editor-close>Renunță</button>{% endif %}
      <button type="submit" class="admin-product-editor__submit" data-admin-product-submit>
        <span>{{ product ? 'Salvează modificările' : 'Adaugă produsul' }}</span>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></i>
      </button>
    </div>
  </footer>
</form>
