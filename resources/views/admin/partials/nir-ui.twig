{% macro icon(name) %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">{% if name == 'box' %}<path d="m3 7 9-5 9 5v10l-9 5-9-5V7Zm0 0 9 5 9-5M12 12v10M7.5 4.5l9 5"/>{% elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>{% elseif name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>{% elseif name == 'close' %}<path d="m6 6 12 12M18 6 6 18"/>{% elseif name == 'arrow' %}<path d="M5 12h14m-5-5 5 5-5 5"/>{% elseif name == 'back' %}<path d="M19 12H5m5-5-5 5 5 5"/>{% elseif name == 'download' %}<path d="M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4"/>{% elseif name == 'upload' %}<path d="M12 16V3m-5 5 5-5 5 5M4 16v4h16v-4"/>{% elseif name == 'edit' %}<path d="m4 20 4-1L20 7l-3-3L5 16l-1 4ZM14 7l3 3"/>{% elseif name == 'trash' %}<path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>{% elseif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{% elseif name == 'warehouse' %}<path d="m3 9 9-6 9 6v12H3V9ZM7 21V11h10v10M7 15h10M7 18h10"/>{% elseif name == 'supplier' %}<path d="M4 21V5h11v16M15 11h5v10M2 21h20M8 9h3M8 13h3M8 17h3"/>{% elseif name == 'shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>{% elseif name == 'info' %}<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/>{% elseif name == 'warning' %}<path d="m12 3 10 18H2L12 3ZM12 9v5M12 17h.01"/>{% elseif name == 'layers' %}<path d="m3 7 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5M3 17l9 5 9-5"/>{% elseif name == 'image' %}<rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 5-5 4 4 4-6 5 7"/>{% elseif name == 'return' %}<path d="M9 5 3 11l6 6M3 11h11a6 6 0 0 1 6 6v3"/>{% elseif name == 'chevron' %}<path d="m9 5 7 7-7 7"/>{% elseif name == 'external' %}<path d="M14 3h7v7m0-7L10 14M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/>{% elseif name == 'link' %}<path d="m10 13 4-4M8 15l-2 2a3 3 0 0 1-4-4l4-4a3 3 0 0 1 4 0m4 0 2-2a3 3 0 0 1 4 4l-4 4a3 3 0 0 1-4 0"/>{% elseif name == 'copy' %}<rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>{% elseif name == 'money' %}<rect x="2" y="5" width="20" height="14" rx="3"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/>{% else %}<path d="M5 3h10l4 4v14H5V3ZM14 3v5h5M9 12h6M9 16h6"/>{% endif %}</svg>{% endmacro %}

{% macro field(name, label, value, errors = {}, options = {}) %}<label class="nir-field{{ options.wide|default(false) ? ' nir-field--wide' : '' }}"><span>{{ label }}{% if options.required|default(false) %}<b aria-hidden="true">*</b>{% endif %}</span>{% if options.type|default('text') == 'textarea' %}<textarea name="{{ name }}" rows="{{ options.rows|default(2) }}" maxlength="{{ options.max|default(2000) }}"{% if options.required|default(false) %} required{% endif %} placeholder="{{ options.placeholder|default('') }}">{{ value }}</textarea>{% else %}<input name="{{ name }}" type="{{ options.type|default('text') }}" value="{{ value }}"{% if options.inputmode|default('') %} inputmode="{{ options.inputmode }}"{% endif %}{% if options.step|default('') %} step="{{ options.step }}"{% endif %}{% if options.min is defined %} min="{{ options.min }}"{% endif %}{% if options.max is defined %} maxlength="{{ options.max }}"{% endif %}{% if options.required|default(false) %} required{% endif %} placeholder="{{ options.placeholder|default('') }}"{% if options.readonly|default(false) %} readonly{% endif %}{% if attribute(errors,name)|default('') %} aria-invalid="true"{% endif %}>{% endif %}{% if options.help|default('') %}<small>{{ options.help }}</small>{% endif %}<small class="nir-field-error" data-field-error="{{ name }}"{% if not attribute(errors,name)|default('') %} hidden{% endif %}>{{ attribute(errors,name)|default('') }}</small></label>{% endmacro %}

{% macro badge(status, type = '') %}<span class="nir-badge {{ type == 'supplier_return' ? 'is-return' : (status == 'confirmed' ? 'is-sage' : 'is-amber') }}"><i></i>{{ status == 'confirmed' ? 'Confirmat' : (status == 'reversed' ? 'Stornat' : 'Draft') }}</span>{% endmacro %}

{% macro pagination(pagination, filters) %}<nav class="nir-pagination" aria-label="Paginarea registrului"><span><strong>{{ pagination.from|default(0) }}–{{ pagination.to|default(0) }}</strong> din {{ pagination.total|default(0) }} documente</span><div>{% if pagination.previous_url|default('') %}<a href="{{ pagination.previous_url }}" class="nir-icon-button" aria-label="Pagina anterioară">{{ _self.icon('back') }}</a>{% else %}<button class="nir-icon-button" disabled aria-label="Pagina anterioară">{{ _self.icon('back') }}</button>{% endif %}<span>Pagina <strong>{{ pagination.page|default(1) }}</strong> / {{ pagination.pages|default(1) }}</span>{% if pagination.next_url|default('') %}<a href="{{ pagination.next_url }}" class="nir-icon-button" aria-label="Pagina următoare">{{ _self.icon('arrow') }}</a>{% else %}<button class="nir-icon-button" disabled aria-label="Pagina următoare">{{ _self.icon('arrow') }}</button>{% endif %}</div></nav>{% endmacro %}

{% macro modal_shell() %}<dialog class="nir-dialog" data-nir-dialog aria-label="Document de stoc"><div data-nir-dialog-content></div></dialog><div class="nir-toast" role="status" data-nir-toast hidden>{{ _self.icon('check') }}<span></span></div>{% endmacro %}
