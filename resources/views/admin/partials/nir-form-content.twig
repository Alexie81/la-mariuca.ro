{% import 'admin/partials/nir-ui.twig' as ui %}
{% set values = values|default({}) %}{% set errors = errors|default({}) %}
<form class="nir-form" action="{{ form_action }}" method="post" enctype="multipart/form-data" data-nir-form data-product-url="{{ url('admin/nir-uri/produse/') }}" data-import-url="{{ url('admin/nir-uri/import/') }}" data-rate-url="{{ url('admin/nir-uri/curs/') }}" data-supplier-url="{{ url('admin/nir-uri/furnizor/') }}" data-location-url="{{ url('admin/nir-uri/locatii/') }}" data-match-url="{{ url('admin/nir-uri/asociere/') }}">
 <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="row_version" value="{{ values.row_version|default(document.row_version|default(0)) }}"><input type="hidden" name="idempotency_key" value="{{ idempotency_key|default('') }}">
 <header class="nir-form__header"><span class="nir-form__mark">{{ ui.icon(is_correction|default(false) ? 'shield' : 'box') }}</span><div><span class="nir-eyebrow">{{ is_correction|default(false) ? 'Corectare controlată' : 'Recepție furnizor' }}</span><h2>{{ is_correction|default(false) ? 'Corectează recepția' : (is_edit|default(false) ? 'Continuă recepția' : 'O nouă intrare în stoc') }}</h2><p>{{ document.number|default('Factura, produsele și recepția — pas cu pas.') }}</p></div><a class="nir-close" href="{{ back_url|default(url('admin/nir-uri/')) }}" data-nir-modal-close aria-label="Închide formularul">{{ ui.icon('close') }}</a></header>
 <div class="nir-form__body">
  <div class="nir-form-errors" data-nir-errors tabindex="-1" role="alert"{% if not errors %} hidden{% endif %}>{% for error in errors %}<p>{{ error }}</p>{% endfor %}</div>
  <div class="nir-guidance">{{ ui.icon('shield') }}<p><strong>{{ is_correction|default(false) ? 'Recepția actuală rămâne protejată până la aplicarea corecției.' : 'Poți salva în lucru și reveni oricând.' }}</strong><span>{{ is_correction|default(false) ? 'La salvare, stocul și loturile sunt refăcute împreună, numai dacă verificările sunt îndeplinite.' : 'Salvarea nu modifică stocul. Îl actualizezi ulterior, prin confirmarea recepției.' }}</span></p></div>
  <section class="nir-form-section"><header><span class="nir-step">01</span><div><span class="nir-eyebrow">Documentul de pornire</span><h3>Furnizor și factură</h3><p>Folosește informațiile de pe factura primită.</p></div>{{ ui.icon('document') }}</header>
   <label class="nir-field"><span>Furnizor <b>*</b></span><select name="supplier_id" required data-nir-supplier><option value="">Alege furnizorul</option>{% for supplier in suppliers %}<option value="{{ supplier.id }}"{{ values.supplier_id|default('') == supplier.id ? ' selected' : '' }}>{{ supplier.alias }}{{ supplier.company_name|default('') ? ' · ' ~ supplier.company_name : '' }}{{ supplier.tax_id|default('') ? ' · ' ~ supplier.tax_id : '' }}</option>{% endfor %}</select></label>
   {% if permissions.suppliers|default(false) %}<details class="nir-inline-create"{{ values.new_supplier.alias|default('') or values.new_supplier.company_name|default('') ? ' open' : '' }}><summary>{{ ui.icon('plus') }}Furnizor nou? Adaugă-l aici.</summary><div class="nir-fields">{% for name,label in {'alias':'Nume afișat *','company_name':'Denumire juridică *','tax_id':'CUI / CIF','trade_register':'Registrul Comerțului','contact_name':'Persoană de contact','phone':'Telefon','email':'Email','website':'Website','address':'Adresă','notes':'Note'} %}{{ ui.field('new_supplier[' ~ name ~ ']', label, attribute(values.new_supplier|default({}),name)|default(''), {}, {type: name in ['address','notes'] ? 'textarea' : (name == 'email' ? 'email' : 'text')}) }}{% endfor %}<input type="hidden" name="new_supplier[status]" value="active"></div><button type="submit" name="intent" value="add_supplier" class="nir-button nir-button--soft" formnovalidate data-nir-add-supplier>{{ ui.icon('plus') }}Salvează furnizorul</button><small>Numele afișat și denumirea juridică sunt obligatorii pentru furnizorul nou.</small><small data-supplier-error role="alert"></small></details>{% endif %}
   <div class="nir-fields nir-fields--three">{{ ui.field('invoice_series','Serie factură',values.invoice_series|default(''),errors,{max:50,placeholder:'Opțional'}) }}{{ ui.field('invoice_number','Număr factură',values.invoice_number|default(''),errors,{required:true,max:100,placeholder:'Ex. 1024'}) }}{{ ui.field('invoice_date','Data facturii',values.invoice_date|default(''),errors,{required:true,type:'date'}) }}</div>
  </section>
  <section class="nir-form-section"><header><span class="nir-step">02</span><div><span class="nir-eyebrow">Loc și moment</span><h3>Unde ajung produsele?</h3><p>Alege gestiunea și verifică momentul recepției.</p></div>{{ ui.icon('warehouse') }}</header><div class="nir-fields"><label class="nir-field"><span>Gestiune <b>*</b></span><select name="warehouse_id" required data-nir-warehouse><option value="">Alege gestiunea</option>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}"{{ values.warehouse_id|default('') == warehouse.id ? ' selected' : '' }}>{{ warehouse.name }}{{ warehouse.is_default|default(false) ? ' · implicită' : '' }}</option>{% endfor %}</select>{% if not warehouses %}<small><a href="{{ url('admin/detaliile-firmei/') }}" target="_blank" rel="noopener">Adaugă întâi o gestiune în Detaliile firmei.</a></small>{% endif %}</label><label class="nir-field"><span>Locație de recepție <b>*</b></span><select name="location_id" required data-nir-location><option value="">Alege locația</option>{% for location in locations %}<option value="{{ location.id }}" data-warehouse="{{ location.warehouse_id }}"{{ values.location_id|default('') == location.id ? ' selected' : '' }}>{{ location.name }}{{ location.address|default('') ? ' · ' ~ location.address : '' }}</option>{% endfor %}</select></label>{{ ui.field('nir_at','Data și ora NIR',values.nir_at|default(''),errors,{type:'datetime-local',required:true}) }}{{ ui.field('received_at','Recepția fizică',values.received_at|default(''),errors,{type:'datetime-local',required:true}) }}</div>
  <details class="nir-inline-create"{{ values.new_location.name|default('') ? ' open' : '' }}><summary>{{ ui.icon('plus') }}Adaugă o locație de recepție</summary><div class="nir-fields">{{ ui.field('new_location[name]','Denumire locație *',values.new_location.name|default(''),{}, {placeholder:'De exemplu, Depozit · recepție'}) }}{{ ui.field('new_location[address]','Adresă',values.new_location.address|default('')) }}</div><button class="nir-button nir-button--soft" type="submit" name="intent" value="add_location" formnovalidate data-nir-add-location>{{ ui.icon('plus') }}Salvează locația</button><small data-location-error role="alert"></small></details>
  </section>
  <section class="nir-form-section"><header><span class="nir-step">03</span><div><span class="nir-eyebrow">Valoarea documentului</span><h3>Monedă și curs</h3><p>În lei, cursul este întotdeauna 1. Pentru valută poți prelua cursul BNR.</p></div>{{ ui.icon('money') }}</header><div class="nir-fields nir-fields--three"><label class="nir-field"><span>Monedă <b>*</b></span><input name="currency" value="{{ values.currency|default('RON') }}" maxlength="3" pattern="[A-Za-z]{3}" list="nir-currencies" required data-nir-currency><datalist id="nir-currencies"><option value="RON"><option value="EUR"><option value="USD"><option value="GBP"><option value="CHF"></datalist></label>{{ ui.field('exchange_rate','Curs în RON',values.exchange_rate|default('1'),errors,{inputmode:'decimal',required:true}) }}{{ ui.field('exchange_rate_date','Data cursului',values.exchange_rate_date|default(''),errors,{type:'date',required:true}) }}</div><div class="nir-rate-help"><button type="button" class="nir-button nir-button--soft nir-js-only" data-nir-fetch-rate>{{ ui.icon('download') }}Preia cursul BNR</button><small data-rate-message>Poți introduce manual un curs verificat, dacă este necesar.</small></div>{% if permissions.costs|default(false) %}<div class="nir-vat-cost"><label class="nir-toggle"><input type="hidden" name="vat_in_cost" value="0"><input type="checkbox" name="vat_in_cost" value="1" role="switch"{{ values.vat_in_cost|default(false) ? ' checked' : '' }}><span class="nir-toggle__track"></span><span>Include TVA în costul de intrare</span></label><p>Valoarea contabilă va include TVA, alături de costurile suplimentare alocate. Lasă opțiunea oprită pentru un cost calculat fără TVA.</p></div>{% endif %}</section>
  <section class="nir-form-section"><header><span class="nir-step">04</span><div><span class="nir-eyebrow">Factura și dovezile recepției</span><h3>Documente atașate</h3><p>Alege fișierele sau fotografiază factura. Le salvăm odată cu documentul.</p></div>{{ ui.icon('upload') }}</header><div class="nir-upload" data-nir-dropzone><span>{{ ui.icon('upload') }}</span><div><strong>Alege fișiere sau trage-le aici</strong><p>PDF, JPG, PNG, WebP, XLSX, XML · maximum 15 MB / fișier</p></div><label class="nir-button nir-button--soft"><input type="file" name="attachments[]" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xml" data-nir-files><span>Alege fișiere</span></label><label class="nir-button nir-button--cancel nir-camera-button"><input type="file" name="attachments[]" accept="image/jpeg,image/png,image/webp" capture="environment" data-nir-camera>{{ ui.icon('image') }}Fotografiază</label></div><div class="nir-file-list" data-nir-file-list>{% for attachment in document.attachments|default([]) %}<span>{{ ui.icon('document') }}{{ attachment.original_name }}</span>{% endfor %}</div><div class="nir-import-note">{{ ui.icon('info') }}<span><strong>Ai o factură XML sau Excel?</strong> Poți importa pozițiile, apoi verifici produsele și valorile.</span><label class="nir-button nir-button--soft nir-js-only"><input type="file" accept=".xml,.xlsx" data-nir-import>Importă poziții</label></div><div class="nir-import-status" data-import-status role="status" hidden></div></section>
  <section class="nir-form-section nir-form-section--lines"><header><span class="nir-step">05</span><div><span class="nir-eyebrow">Verifică fiecare produs</span><h3>Produsele recepționate</h3><p>Asociază varianta din magazin, apoi verifică numărul de bucăți și prețul.</p></div><span class="nir-count" data-line-count>{{ values.lines|default([{}])|length }} poziții</span></header><div data-nir-lines>{% for line in values.lines|default([{}]) %}{% include 'admin/partials/nir-line.twig' with {index:loop.index0,line:line} %}{% endfor %}</div><template data-nir-line-template>{% include 'admin/partials/nir-line.twig' with {index:'__INDEX__',line:{}} %}</template><button type="submit" name="intent" value="add_line" formnovalidate class="nir-button nir-button--add" data-nir-add-line>{{ ui.icon('plus') }}Adaugă un produs</button></section>
  <section class="nir-form-section"><header><span class="nir-step">06</span><div><span class="nir-eyebrow">Ultima privire</span><h3>Rezumat și observații</h3><p>Valorile finale sunt recalculate și verificate la salvare.</p></div>{{ ui.icon('check') }}</header>{% if permissions.costs|default(false) %}<div class="nir-form-summary"><div><span>Fără TVA</span><strong data-summary-net>{{ values.net_bani is defined ? (values.net_bani / 100)|number_format(2,',','.') ~ ' ' ~ values.currency|default('RON') : 'La salvare' }}</strong></div><div><span>TVA</span><strong data-summary-tax>{{ values.tax_bani is defined ? (values.tax_bani / 100)|number_format(2,',','.') ~ ' ' ~ values.currency|default('RON') : 'La salvare' }}</strong></div><div><span>Total document</span><strong data-summary-total>{{ values.total_bani is defined ? (values.total_bani / 100)|number_format(2,',','.') ~ ' ' ~ values.currency|default('RON') : 'La salvare' }}</strong></div></div>{% endif %}{{ ui.field('notes','Observații interne',values.notes|default(''),errors,{type:'textarea',rows:3,placeholder:'Detalii utile despre factură, recepție sau produse…'}) }}{% if is_correction|default(false) %}{{ ui.field('correction_reason','Motivul corecției',values.correction_reason|default(''),errors,{type:'textarea',required:true,max:500}) }}{% endif %}</section>
  {% if warnings|default([]) %}<div class="nir-warnings" data-nir-warnings>{% for warning in warnings %}<p>{{ ui.icon('warning') }}{{ warning.message|default(warning) }}</p>{% endfor %}</div><label class="nir-acknowledge" data-nir-acknowledge><input type="checkbox" name="accept_warnings" value="1" required><span>Am verificat avertismentele și doresc să continui.</span></label>{% endif %}
 </div>
 <footer class="nir-form__footer"><a class="nir-button nir-button--cancel" href="{{ back_url|default(url('admin/nir-uri/')) }}" data-nir-modal-close>Renunță</a><p>{{ ui.icon('shield') }}<span>{{ is_correction|default(false) ? 'Corecție verificată înainte de aplicare' : 'Salvare în lucru · fără modificări de stoc' }}</span></p><button class="nir-button nir-button--primary" type="submit" name="intent" value="save">{{ ui.icon('check') }}<span>{{ is_correction|default(false) ? 'Aplică corecția' : 'Salvează în lucru' }}</span></button></footer>
 <div class="nir-product-picker" data-nir-product-panel hidden><header><div><span class="nir-eyebrow">Catalog La Măriuca</span><h3>Alege produsul potrivit</h3></div><button type="button" class="nir-close" data-product-close aria-label="Închide selectorul">{{ ui.icon('close') }}</button></header><label class="nir-picker-search">{{ ui.icon('search') }}<input type="search" placeholder="Nume, SKU sau cod de bare…" data-product-search aria-label="Caută produsul"></label><p class="nir-picker-help">Selectează varianta exactă. Sugestiile se aplică numai după alegerea ta.</p><div class="nir-product-results" data-product-results role="list"></div></div>
</form>
