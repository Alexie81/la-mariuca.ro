{% import 'admin/partials/review-icons.twig' as r %}
<div class="rv-editor" data-review-content data-review-author="{{ review.author_name|default('') }}" data-review-product="{{ review.product_name|default('') }}">
  <header class="rv-editor__header"><span class="rv-mark">{{ r.icon('message') }}</span><div><span class="rv-eyebrow">Vocea clienților{% if review %} · #{{ review.id }}{% endif %}</span><h2 id="rv-dialog-title">{{ review ? 'O părere care contează' : 'Recenzia nu este disponibilă' }}</h2><p>{{ review ? 'Citește, moderează și răspunde cu grijă.' : 'Este posibil ca această recenzie să fi fost retrasă.' }}</p></div><a class="rv-icon-button" href="{{ return_url }}" data-review-close aria-label="Închide detaliile recenziei">{{ r.icon('close') }}</a></header>
  {% if review %}
  <nav class="rv-editor__tabs" aria-label="Secțiunile recenziei">{% for key,label in {'review':'Recenzie','reply':'Răspuns public','history':'Istoric'} %}<a href="{{ url('admin/recenzii/' ~ review.id ~ '/') }}?{{ filters|merge({'panel':key})|url_encode }}" data-review-open{% if panel == key %} aria-current="page"{% endif %}>{{ r.icon(key == 'review' ? 'message' : (key == 'reply' ? 'reply' : 'clock')) }}{{ label }}</a>{% endfor %}</nav>
  <div class="rv-editor__scroll">
    <div class="rv-editor__product"><a href="{{ url('admin/produse/' ~ review.product_id ~ '/') }}" class="rv-product__image">{% if review.product_image %}<img src="{{ url(review.product_image) }}" alt="{{ review.product_name }}">{% else %}{{ r.icon('box') }}{% endif %}</a><div><a href="{{ url('admin/produse/' ~ review.product_id ~ '/') }}">{{ review.product_name }}</a><small>{{ review.created_at|date('d.m.Y · H:i','Europe/Bucharest') }}</small></div>{{ r.status(review.status) }}</div>
    <p class="rv-form-error" data-review-error role="alert"{{ error|default('') ? '' : ' hidden' }}>{{ error|default('') }}</p>
    {% if panel == 'review' %}
      <section class="rv-reading"><header><div class="rv-author"><span class="rv-avatar">{{ review.author_name|slice(0,1)|upper }}</span><div><strong>{{ review.author_name }}</strong><small>{{ review.author_email }}</small></div></div><span class="rv-rating">{{ r.icon('star') }}<strong>{{ review.rating }}</strong><small>/ 5</small></span></header>{% if review.title %}<h3>{{ review.title }}</h3>{% endif %}<p class="rv-reading__body">{{ review.body }}</p><div class="rv-evidence">{% if review.is_verified_purchase %}<span class="is-verified">{{ r.icon('shield') }} Achiziție verificată</span>{% endif %}{% if review.order_id %}<a href="{{ url('admin/comenzi/' ~ review.order_id ~ '/') }}">Comanda {{ review.order_number }} {{ r.icon('right') }}</a>{% elseif review.order_number %}<span>Comanda {{ review.order_number }}</span>{% endif %}{% if review.is_demo %}<span>Conținut demonstrativ</span>{% endif %}</div></section>
      {% if review.admin_response %}<section class="rv-published-reply"><header>{{ r.icon('reply') }}<strong>Răspunsul magazinului</strong><a href="{{ url('admin/recenzii/' ~ review.id ~ '/') }}?{{ filters|merge({'panel':'reply'})|url_encode }}" data-review-open>Editează</a></header><p>{{ review.admin_response }}</p><small>{{ review.responded_at|date('d.m.Y · H:i','Europe/Bucharest') }}</small></section>{% endif %}
      <section class="rv-moderate"><div><h3>Vizibilitatea recenziei</h3><p>{{ review.status == 'approved' ? 'Recenzia este afișată în pagina produsului.' : 'Recenzia nu este vizibilă în magazin.' }}</p></div><form action="{{ url('admin/recenzii/' ~ review.id ~ '/actiune/') }}" method="post" data-review-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="return_query" value="{{ filters|url_encode }}"><div class="rv-moderation-actions">{% if review.status != 'approved' %}<button class="rv-button rv-button--approve" name="action" value="approve">{{ r.icon('check') }} Aprobă</button>{% endif %}{% if review.status != 'pending' %}<button class="rv-button" name="action" value="pending">{{ r.icon('clock') }} În așteptare</button>{% endif %}{% if review.status != 'rejected' %}<button class="rv-button rv-button--reject" name="action" value="reject">{{ r.icon('close') }} Respinge</button>{% endif %}</div></form></section>
    {% elseif panel == 'reply' %}
      <div class="rv-reply-context"><strong>{{ review.author_name }} <span>· {{ review.rating }}/5 ★</span></strong><p>{{ review.body }}</p></div>
      {% if review.status == 'approved' %}<form class="rv-reply-form" id="rv-response-form" action="{{ url('admin/recenzii/' ~ review.id ~ '/actiune/') }}" method="post" data-review-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="return_query" value="{{ filters|url_encode }}"><input type="hidden" name="action" value="respond"><label for="rv-response">Răspunsul La Măriuca</label><textarea id="rv-response" name="admin_response" rows="6" maxlength="1500" minlength="2" required placeholder="Mulțumim pentru gândurile frumoase…" aria-describedby="rv-response-hint" data-review-response>{{ response_value is defined ? response_value : review.admin_response }}</textarea><div class="rv-reply-form__hint"><span id="rv-response-hint">Va fi afișat public sub recenzia clientului.</span><span data-review-counter>{{ (response_value is defined ? response_value : review.admin_response)|length }} / 1.500</span></div></form>{% else %}<div class="rv-notice">{{ r.icon('shield') }}<div><strong>Aprobă recenzia pentru a răspunde.</strong><p>Răspunsurile se publică doar alături de recenzii aprobate.</p><a href="{{ url('admin/recenzii/' ~ review.id ~ '/') }}?{{ filters|merge({'panel':'review'})|url_encode }}" data-review-open>Deschide moderarea {{ r.icon('right') }}</a></div></div>{% endif %}
    {% else %}
      <section class="rv-history"><h3>Istoricul moderării</h3><p>Ultimele 50 de acțiuni, de la cea mai recentă.</p><ol>{% for event in review.moderation_history %}<li><span>{{ r.icon(event.action == 'review.responded' ? 'reply' : 'clock') }}</span><div><strong>{{ event.action|replace({'review.':'','approved':'Recenzie aprobată','rejected':'Recenzie respinsă','pending':'Mutată în așteptare','responded':'Răspuns publicat','removed':'Recenzie retrasă'}) }}</strong><small>{{ (event.actor_first_name ~ ' ' ~ event.actor_last_name)|trim ?: 'Sistem' }} · {{ event.created_at|date('d.m.Y · H:i','Europe/Bucharest') }}</small></div></li>{% else %}<li><span>{{ r.icon('message') }}</span><div><strong>Încă nu există acțiuni de moderare.</strong><small>Deciziile și răspunsurile viitoare vor apărea aici.</small></div></li>{% endfor %}</ol></section>
    {% endif %}
  </div>
  <footer class="rv-editor__footer"><a class="rv-button" href="{{ return_url }}" data-review-close>Închide</a>{% if panel == 'reply' and review.status == 'approved' %}<button type="submit" form="rv-response-form" class="rv-button rv-button--primary">{{ r.icon('check') }} {{ review.admin_response ? 'Salvează răspunsul' : 'Publică răspunsul' }}</button>{% elseif panel == 'review' %}<form action="{{ url('admin/recenzii/' ~ review.id ~ '/actiune/') }}" method="post" data-review-form><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="return_query" value="{{ filters|url_encode }}"><button name="action" value="remove" class="rv-button rv-button--quiet">{{ r.icon('archive') }} Retrage recenzia</button></form>{% endif %}</footer>
  {% else %}<div class="rv-editor__scroll"><a class="rv-button" href="{{ return_url }}" data-review-close>Înapoi la recenzii</a></div>{% endif %}
</div>
