{% import 'admin/partials/nir-ui.twig' as ui %}
{% set prefix = 'lines[' ~ index ~ ']' %}
<article class="nir-line" data-nir-line data-index="{{ index }}">
 <header class="nir-line__head"><span class="nir-line__number" data-line-number>{{ index == '__INDEX__' ? '1' : index + 1 }}</span><div><h4 data-line-title>{{ line.supplier_name|default('Produs nou') ?: 'Produs nou' }}</h4><p data-line-subtitle>{{ line.sku|default('Completează datele de pe factura furnizorului') }}</p></div><button class="nir-icon-button nir-js-only" type="button" data-nir-remove-line aria-label="Elimină poziția">{{ ui.icon('trash') }}</button></header>
 <div class="nir-product-match" data-product-match><span class="nir-product-match__image">{% if line.image_url|default('') %}<img src="{{ line.image_url }}" alt="" loading="lazy">{% else %}{{ ui.icon('image') }}{% endif %}</span><div class="nir-product-match__main"><span class="nir-eyebrow">1. Alege produsul din magazin</span><strong data-product-label>{{ line.product_name|default('Alege produsul și varianta') ?: 'Alege produsul și varianta' }}</strong><span data-product-meta>{{ line.sku|default('Alege varianta exactă: mărime, culoare sau model.') }}</span><input type="hidden" name="{{ prefix }}[product_id]" value="{{ line.product_id|default('') }}"><input type="hidden" name="{{ prefix }}[variant_id]" value="{{ line.variant_id|default('') }}"></div><button class="nir-button nir-button--soft nir-js-only" type="button" data-nir-product-picker>{{ ui.icon('link') }}<span>{{ line.variant_id|default('') ? 'Schimbă' : 'Alege produsul' }}</span></button><noscript><label class="nir-field"><span>Produs și variantă</span><select name="{{ prefix }}[variant_id_fallback]"><option value="">Alege produsul</option>{% for product in products|default([]) %}<option value="{{ product.variant_id }}"{{ line.variant_id|default('') == product.variant_id ? ' selected' : '' }}>{{ product.product_name }} · {{ product.option_summary|default(product.sku) }}</option>{% endfor %}</select></label></noscript></div>
 <div class="nir-line-error" role="alert" data-line-error hidden></div>
 <details class="nir-line-identity-options"><summary>{{ ui.icon('document') }}Denumirea și codurile de pe factură{{ ui.icon('chevron') }}</summary> <div class="nir-line__identity">
  <label class="nir-field nir-line-name"><span>Denumire pe factură <b>*</b></span><input name="{{ prefix }}[supplier_name]" value="{{ line.supplier_name|default('') }}" maxlength="500" placeholder="Denumirea exactă a produsului" data-line-name required></label>
  {{ ui.field(prefix ~ '[supplier_code]', 'Cod furnizor', line.supplier_code|default(''), {}, {placeholder:'Codul de pe factură'}) }}
  {{ ui.field(prefix ~ '[supplier_ean]', 'EAN / cod de bare', line.supplier_ean|default(''), {}, {max:64}) }}
 </div>
</details>
 <div class="nir-line-switches"><label class="nir-toggle"><input type="hidden" name="{{ prefix }}[tracked]" value="0"><input type="checkbox" name="{{ prefix }}[tracked]" value="1"{{ (line.tracked is defined ? line.tracked : true) ? ' checked' : '' }} data-line-tracked role="switch"><span class="nir-toggle__track"></span><span>Intră în stocul contabil</span></label>{% if permissions.references|default(false) %}<label class="nir-mini-check"><input type="checkbox" name="{{ prefix }}[save_reference]" value="1"{{ line.save_reference|default(false) ? ' checked' : '' }}><span>Memorează asocierea pentru acest furnizor</span></label>{% endif %}</div>
 <div class="nir-line__quantities"><span class="nir-line-caption">2. Verifică numărul de bucăți</span><div class="nir-fields nir-fields--four">{% for key,label in {'invoice_quantity':'Pe factură','received_quantity':'Primite fizic','accepted_quantity':'Acceptate','rejected_quantity':'Respinse'} %}{{ ui.field(prefix ~ '[' ~ key ~ ']', label, attribute(line,key)|default(key == 'rejected_quantity' ? '0' : '1'), {}, {inputmode:'decimal',required:true}) }}{% endfor %}</div></div>
 <details class="nir-line-details"{% if line.difference_reason|default('') %} open{% endif %}><summary>{{ ui.icon('layers') }}Unități, conversie și diferențe<span>{{ ui.icon('chevron') }}</span></summary><div class="nir-fields nir-fields--three">{{ ui.field(prefix ~ '[purchase_unit]', 'UM achiziție', line.purchase_unit|default('buc'), {}, {max:30}) }}{{ ui.field(prefix ~ '[stock_unit]', 'UM stoc', line.stock_unit|default('buc'), {}, {max:30}) }}{{ ui.field(prefix ~ '[conversion_factor]', 'Factor de conversie', line.conversion_factor|default('1'), {}, {inputmode:'decimal',help:'1 unitate cumpărată = acest număr de unități în stoc.'}) }}</div><div class="nir-fields"><label class="nir-field"><span>Motivul diferenței</span><select name="{{ prefix }}[difference_reason]"><option value="">Fără diferențe</option>{% for key,label in {'shortage':'Lipsă','excess':'Plus','damaged':'Deteriorat','wrong_product':'Produs greșit','price_difference':'Diferență de preț','vat_difference':'Diferență TVA','other':'Alt motiv'} %}<option value="{{ key }}"{{ line.difference_reason|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select><small>Obligatoriu când cantitățile sunt diferite.</small></label>{{ ui.field(prefix ~ '[difference_notes]', 'Explicație', line.difference_notes|default(''), {}, {type:'textarea',placeholder:'Descrie pe scurt ce ai constatat.'}) }}</div></details>
 {% if permissions.costs|default(false) %}<div class="nir-line__pricing"><div class="nir-line__pricing-head"><span class="nir-line-caption">3. Completează valorile de pe factură</span><label class="nir-price-mode"><span>Introduc</span><select name="{{ prefix }}[price_mode]" data-price-mode>{% for key,label in {'unit':'Prețul unitar','line_net':'Valoarea fără TVA','exact_vat':'Net + TVA exact','gross':'Totalul cu TVA'} %}<option value="{{ key }}"{{ line.price_mode|default('unit') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label></div><div class="nir-fields nir-fields--four"><div data-price-field="unit">{{ ui.field(prefix ~ '[unit_price]', 'Preț unitar, fără TVA', line.unit_price|default('0'), {}, {inputmode:'decimal'}) }}</div><div data-price-field="line_net exact_vat">{{ ui.field(prefix ~ '[net_override]', 'Valoare fără TVA', line.net_override|default(''), {}, {inputmode:'decimal'}) }}</div><div data-price-field="exact_vat">{{ ui.field(prefix ~ '[tax_override]', 'TVA exact', line.tax_override|default(''), {}, {inputmode:'decimal'}) }}</div><div data-price-field="gross">{{ ui.field(prefix ~ '[gross_override]', 'Total cu TVA', line.gross_override|default(''), {}, {inputmode:'decimal'}) }}</div>{{ ui.field(prefix ~ '[discount_percent]', 'Discount %', line.discount_percent|default('0'), {}, {inputmode:'decimal'}) }}{{ ui.field(prefix ~ '[vat_percent]', 'TVA %', line.vat_percent|default('21'), {}, {inputmode:'decimal'}) }}{{ ui.field(prefix ~ '[extra_cost_ron]', 'Cost suplimentar (RON)', line.extra_cost_ron|default('0'), {}, {inputmode:'decimal'}) }}</div><div class="nir-line-total"><span><small>Cantitate pentru stoc</small><strong data-line-stock>{{ line.stock_quantity|default('1') }} {{ line.stock_unit|default('buc') }}</strong></span><span><small>Cost unitar în stoc</small><strong data-line-cost>{{ line.unit_cost_ron|default(0)|decimal_ro }} RON</strong></span><span><small>Total cu TVA</small><strong data-line-total>{{ (line.total_bani|default(0) / 100)|number_format(2,',','.') }} {{ values.currency|default('RON') }}</strong></span></div><div class="nir-price-history" data-price-history{% if not line.price_history.same_supplier|default(null) and not line.price_history.any_supplier|default(null) and not line.price_history.minimum_recent|default(null) %} hidden{% endif %}>{% for key,label in {'same_supplier':'Ultimul preț la acest furnizor','any_supplier':'Ultimul preț de achiziție','minimum_recent':'Minimul recent'} %}{% set history = attribute(line.price_history|default({}),key)|default(null) %}{% if history %}<span>{{ label }}: <strong>{{ history.unit_price|decimal_ro }} {{ history.currency }}</strong></span>{% endif %}{% endfor %}</div></div>{% endif %}
</article>
