{% import 'admin/partials/nir-ui.twig' as ui %}{% set doc = document|default({}) %}{% set is_supplier_return = doc.operation_type|default(doc.type|default('')) == 'supplier_return' %}{% set kind = action_kind|default('confirm') %}{% set values = values|default({}) %}{% if kind == 'customer_return' %}{% set form_title = 'Recepționează returul' %}{% endif %}
<form class="nir-form nir-action-form{{ kind == 'reverse' ? ' nir-supplier-return' : '' }}{{ kind == 'confirm' ? ' nir-confirmation-form' : '' }}{{ kind in ['delete','delete_attachment'] ? ' nir-removal-form' : '' }}{{ kind in ['confirm','delete','delete_attachment'] ? ' nir-action-form--compact nir-decision-form' : '' }}" method="{{ kind == 'export' ? 'get' : 'post' }}" action="{{ form_action }}"{% if kind in ['attachments','reverse'] %} enctype="multipart/form-data"{% endif %}{% if kind != 'export' %} data-nir-form{% else %} data-nir-export-form{% endif %}>
{% if kind != 'export' %}<input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="row_version" value="{{ doc.row_version|default(0) }}"><input type="hidden" name="idempotency_key" value="{{ idempotency_key|default('') }}">{% endif %}
<header class="nir-form__header"><span class="nir-form__mark{{ kind in ['delete','reverse','delete_attachment'] ? ' is-amber' : '' }}">{{ ui.icon(kind == 'export' ? 'download' : (kind == 'reverse' ? 'return' : (kind in ['delete','delete_attachment'] ? 'trash' : (kind == 'attachments' ? 'upload' : (kind == 'opening' ? 'layers' : 'check'))))) }}</span><div><span class="nir-eyebrow">{{ kind in ['delete','delete_attachment'] ? (is_supplier_return ? 'Dosarul returului' : 'Dosarul recepției') : (kind == 'confirm' ? 'Intrare în stoc' : (kind == 'export' ? 'Documente la îndemână' : doc.number|default('Stoc și achiziții'))) }}</span><h2>{{ form_title|default(kind == 'export' ? 'Exportă registrul' : (kind == 'reverse' ? 'Retur către furnizor' : (kind == 'delete' ? (doc.status|default('draft') == 'confirmed' ? 'Ștergi ultimul NIR?' : 'Ștergi acest draft?') : (kind == 'attachments' ? 'Adaugă documente' : (kind == 'opening' ? 'Sold inițial' : (kind == 'delete_attachment' ? 'Ștergi acest fișier?' : 'Confirmi recepția?')))))) }}</h2></div><a class="nir-close" href="{{ back_url }}" data-nir-modal-close aria-label="Închide">{{ ui.icon('close') }}</a></header>
<div class="nir-form__body"><div class="nir-form-errors" data-nir-errors role="alert" tabindex="-1"{% if not errors|default([]) %} hidden{% endif %}>{% for error in errors|default([]) %}<p>{{ error }}</p>{% endfor %}</div>
{% if kind == 'confirm' %}
<div class="nir-confirm-summary">
 <div class="nir-confirm-supplier"><span>{{ ui.icon('box') }}</span><div><small>Furnizor</small><strong>{{ doc.supplier.alias|default(doc.supplier_name|default('Recepție furnizor')) }}</strong><p>Factura {{ doc.invoice_series|default('') }} {{ doc.invoice_number|default('') }}</p></div></div>
 <div class="nir-confirm-summary__bottom"><span>{{ doc.lines|default([])|length }} {{ doc.lines|default([])|length == 1 ? 'poziție' : 'poziții' }}</span>{% if permissions.costs|default(false) %}<div><small>Total recepție</small><strong>{{ (doc.total_bani|default(0)/100)|number_format(2,',','.') }} <small>{{ doc.currency|default('RON') }}</small></strong></div>{% endif %}</div>
</div>
<p class="nir-confirm-description">Produsele acceptate intră în stoc. NIR-ul primește numărul final.</p>
<div class="nir-confirm-protection">{{ ui.icon('shield') }}<span>Doar ultimul NIR confirmat poate fi șters, cu anularea efectului său asupra stocului.</span></div>
<div class="nir-warnings" data-nir-warnings{% if not warnings|default([]) %} hidden{% endif %}>{% for warning in warnings|default([]) %}<p>{{ ui.icon('warning') }}{{ warning.message|default(warning) }}</p>{% endfor %}</div><label class="nir-acknowledge" data-nir-acknowledge{% if not warnings|default([]) %} hidden{% endif %}><input type="checkbox" name="accept_warnings" value="1"{% if warnings|default([]) %} required{% endif %}><span>Am verificat avertismentele și doresc să continui.</span></label>
{% elseif kind in ['delete','delete_attachment'] %}
<div class="nir-removal-file"><span>{{ ui.icon(kind == 'delete_attachment' ? 'document' : 'box') }}</span><div><small>{{ kind == 'delete_attachment' ? 'Fișier selectat' : (doc.status|default('draft') == 'confirmed' ? 'Ultimul document confirmat' : 'Draft selectat') }}</small><strong>{{ kind == 'delete_attachment' ? attachment.original_name|default('Fișierul selectat') : doc.display_number|default(doc.number|default('Draft')) }}</strong>{% if kind == 'delete_attachment' %}<p>{{ attachment.extension|default('Fișier')|upper }} · {{ (attachment.size_bytes|default(0)/1024)|number_format(0,',','.') }} KB</p>{% endif %}</div></div>
<p class="nir-removal-description">{{ kind == 'delete_attachment' ? 'Acest fișier va fi eliminat din document. Îl poți încărca din nou dacă ai nevoie.' : (doc.status|default('draft') == 'confirmed' ? 'Documentul și atașamentele sale vor fi șterse. Cantitățile lui se scad din stocul contabil; pentru un retur, se adaugă înapoi. Numărul devine disponibil pentru următorul NIR.' : 'Draftul și fișierele atașate vor fi șterse. Drafturile rămase se renumerotează automat.') }}</p>
<div class="nir-removal-assurance">{{ ui.icon('shield') }}<span>{{ kind == 'delete_attachment' ? 'Produsele, valorile și stocul rămân neschimbate.' : (doc.status|default('draft') == 'confirmed' ? 'Stocul contabil poate deveni negativ. Comenzile, vânzările și disponibilitatea din magazin nu se modifică.' : 'Stocul rămâne neschimbat.') }}</span></div>
{% if kind == 'delete' and doc.status|default('draft') == 'confirmed' %}
<div class="nir-delete-impact"><header>{{ ui.icon('layers') }}<strong>Stocul după ștergere</strong></header>{% for item in doc.delete_stock_impact|default([]) %}<div><span><strong>{{ item.product_name }}</strong><small>{{ item.sku }}</small></span><span>{{ item.before|decimal_ro }} {{ ui.icon('arrow') }}<b class="{{ item.after < 0 ? 'is-negative' : '' }}">{{ item.after|decimal_ro }} {{ item.unit }}</b></span></div>{% else %}<p>Acest document nu conține produse urmărite în stoc.</p>{% endfor %}</div>
<p class="nir-removal-description">Se inversează doar efectul acestui NIR. Celelalte intrări rămân neschimbate. Ștergerea nu poate fi anulată.</p>
{% endif %}
{% elseif kind == 'reverse' %}
<div class="nir-return-note">{{ ui.icon('shield') }}<p>Returul primește un document separat. <strong>Documentul original rămâne în istoric.</strong></p></div>
<section class="nir-return-section">
 <header><span class="nir-return-step">1</span><div><h3>Factura corectivă</h3><p>Completează datele documentului primit de la furnizor.</p></div>{{ ui.icon('document') }}</header>
 <div class="nir-fields nir-fields--three">{{ ui.field('invoice_series','Serie factură',values.invoice_series|default(''),{}, {placeholder:'Opțional'}) }}{{ ui.field('invoice_number','Număr factură',values.invoice_number|default(''),{}, {required:true,placeholder:'De exemplu, 124'}) }}{{ ui.field('invoice_date','Data facturii',values.invoice_date|default(today|default('')),{}, {type:'date',required:true}) }}</div>
</section>
<section class="nir-return-section">
 <header><span class="nir-return-step">2</span><div><h3>Ce returnezi?</h3><p>Activează produsele, apoi alege cantitatea pentru fiecare.</p></div>{{ ui.icon('box') }}</header>
 <div class="nir-return-stock-notice" role="note">{{ ui.icon('shield') }}<div><strong>Vezi cât poți returna din fiecare produs.</strong><p>Dacă bucățile din acest NIR au fost vândute, poți folosi stoc din alte intrări ale aceluiași produs, de la același furnizor și la același preț de achiziție. Vei confirma această alegere înainte de emitere.</p></div><button type="button" class="nir-stock-help-trigger" data-nir-stock-help aria-haspopup="dialog" aria-controls="nir-stock-help" aria-label="Ce înseamnă stoc disponibil pentru retur?">{{ ui.icon('info') }}</button></div>
 <noscript><p>Introdu o cantitate mai mare decât zero numai la produsele pe care le returnezi.</p></noscript>
 <div class="nir-reverse-lines">{% for line in doc.lines %}
 {% set available = line.returnable_quantity|default(line.available_quantity|default(line.accepted_quantity)) %}
 {% set selected_quantity = attribute(values.quantities|default({}),line.id)|default('0') %}
 <div class="nir-reverse-row{{ selected_quantity > 0 ? ' is-selected' : '' }}">
  <div class="nir-return-product-image">{% if line.image_url|default('') %}<img src="{{ line.image_url }}" alt="" loading="lazy">{% else %}{{ ui.icon('box') }}{% endif %}</div>
  <div class="nir-return-product-copy"><strong>{{ line.supplier_name }}</strong><small>{{ line.sku|default('Fără SKU') }}</small><span class="nir-return-available">Poți returna {{ available|decimal_ro }} {{ line.purchase_unit }}</span><dl class="nir-return-stock-breakdown"><div><dt>Pe stoc din acest NIR</dt><dd>{{ line.available_quantity|default(0)|decimal_ro }} {{ line.purchase_unit }}</dd></div><div><dt>Din alte intrări compatibile</dt><dd>{{ line.compatible_quantity|default(0)|decimal_ro }} {{ line.purchase_unit }}</dd></div></dl></div>
  <label class="nir-return-switch"><input type="checkbox" role="switch" data-reverse-select{{ selected_quantity > 0 ? ' checked' : '' }} aria-label="Returnează {{ line.supplier_name }}" aria-controls="return-quantity-{{ line.id }}"><span aria-hidden="true"><i>{{ ui.icon('check') }}</i></span></label>
  <div class="nir-return-quantity"><label class="nir-field" for="return-quantity-{{ line.id }}"><span>Cantitate retur</span><span class="nir-return-quantity-input"><input id="return-quantity-{{ line.id }}" aria-describedby="return-hint-{{ line.id }}" name="quantities[{{ line.id }}]" type="number" value="{{ selected_quantity }}" min="0" max="{{ available }}" step="0.0001" inputmode="decimal" data-reverse-quantity data-unit="{{ line.purchase_unit }}" data-original-available="{{ line.available_quantity|default(0) }}"><span>{{ line.purchase_unit }}</span></span></label><small id="return-hint-{{ line.id }}" data-reverse-hint>Activează produsul pentru retur</small></div>
 </div>{% endfor %}</div>
 <label class="nir-return-alternative" data-reverse-alternative><input type="checkbox" name="accept_alternative_stock" value="1"{{ values.accept_alternative_stock|default(false) ? ' checked' : '' }}><span><strong>Pot folosi și alte intrări compatibile</strong><small>Confirm că returnez produse identice, de la același furnizor și la același preț de achiziție. Documentele originale rămân neschimbate.</small></span></label>
</section>
<section class="nir-return-section nir-return-evidence">
 <header><span class="nir-return-step">3</span><div><h3>Motiv și documente</h3><p>Explică returul și atașează cel puțin un fișier justificativ.</p></div>{{ ui.icon('upload') }}</header>
 {{ ui.field('reason','Motivul returului',values.reason|default(''),{}, {type:'textarea',required:true,max:500,rows:3,placeholder:'De exemplu, produse deteriorate sau cantități livrate greșit.'}) }}
 <div class="nir-upload nir-return-upload" data-nir-dropzone><span>{{ ui.icon('upload') }}</span><div><strong>Documente justificative <b aria-hidden="true">*</b></strong><p>Factura corectivă sau dovada returului</p><small>PDF, Excel, XML sau imagini · minimum un fișier</small></div><label class="nir-button nir-button--soft"><input type="file" name="attachments[]" multiple required accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xml" data-nir-files aria-label="Documente justificative pentru retur" aria-describedby="return-files-help">{{ ui.icon('plus') }}<span>Alege fișiere</span></label></div>
 <div class="nir-file-list" data-nir-file-list></div><p id="return-files-help" class="nir-return-file-help">Poți adăuga mai multe fișiere. Returul poate fi emis numai după atașarea unui document.</p>
</section>
{% elseif kind == 'export' %}<p class="nir-action-intro">Alege perioada și formatul. Arhiva completă include registrul, documentele PDF și Excel și fișierele originale.</p><div class="nir-export-choices"><label><input type="radio" name="format" value="xlsx" checked><span>{{ ui.icon('document') }}<strong>Registru Excel</strong><small>Documente și valori, într-un singur fișier</small></span></label><label><input type="radio" name="format" value="zip"><span>{{ ui.icon('box') }}<strong>Dosar complet ZIP</strong><small>Registru, recepții și toate atașamentele</small></span></label></div><label class="nir-field"><span>Perioada exportată</span><select name="period" data-export-period>{% for key,label in {'month':'Luna curentă','previous_month':'Luna anterioară','3months':'Ultimele 3 luni','6months':'Ultimele 6 luni','year':'Anul curent','all':'Toate documentele','custom':'Aleg o perioadă'} %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label><div class="nir-fields" data-export-dates>{{ ui.field('from','De la','',{}, {type:'date'}) }}{{ ui.field('to','Până la','',{}, {type:'date'}) }}</div><label class="nir-field"><span>Documente incluse</span><select name="status"><option value="">Toate stările</option><option value="confirmed">Numai confirmate</option><option value="draft">Numai în lucru</option><option value="supplier_return">Storno / retur</option></select></label><p data-export-progress hidden class="nir-export-progress" role="status">Pregătim documentele pentru descărcare…</p>
{% elseif kind == 'attachments' %}<div class="nir-guidance">{{ ui.icon('shield') }}<p><strong>{{ is_supplier_return ? 'Completează dosarul returului.' : 'Completează dosarul recepției.' }}</strong><span>Adăugarea fișierelor nu modifică produsele sau stocul.</span></p></div><div class="nir-upload" data-nir-dropzone><span>{{ ui.icon('upload') }}</span><div><strong>Alege fișierele</strong><p>PDF, JPG, PNG, WebP, XLSX, XML</p></div><label class="nir-button nir-button--soft"><input type="file" name="attachments[]" multiple required accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xml" data-nir-files>Alege fișiere</label></div><div class="nir-file-list" data-nir-file-list></div>
{% elseif kind == 'opening' %}<div class="nir-guidance">{{ ui.icon('info') }}<p><strong>Pentru stocul existent înaintea primei recepții.</strong><span>Introdu cantitatea reală și costul documentat. Această operațiune este separată de NIR-uri.</span></p></div><div class="nir-fields"><label class="nir-field"><span>Gestiune <b>*</b></span><select name="warehouse_id" required>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}"{{ values.warehouse_id|default('') == warehouse.id ? ' selected' : '' }}>{{ warehouse.name }}</option>{% endfor %}</select></label><label class="nir-field"><span>Produs și variantă <b>*</b></span><select name="variant_id" required><option value="">Alege produsul</option>{% for product in products|default([]) %}<option value="{{ product.variant_id }}"{{ values.variant_id|default('') == product.variant_id ? ' selected' : '' }}>{{ product.product_name }} · {{ product.option_summary|default(product.sku) }}</option>{% endfor %}</select></label>{{ ui.field('quantity','Cantitate',values.quantity|default(''),{}, {inputmode:'decimal',required:true}) }}{{ ui.field('unit_cost_ron','Cost unitar real (RON)',values.unit_cost_ron|default(''),{}, {inputmode:'decimal',required:true}) }}{{ ui.field('date','Data stocului',values.date|default(today|default('')),{}, {type:'date',required:true}) }}</div>{{ ui.field('reason','Explicație și document justificativ',values.reason|default(''),{}, {type:'textarea',required:true,max:500}) }}
{% elseif kind == 'customer_return' %}<div class="nir-guidance">{{ ui.icon('return') }}<p><strong>Recepție fizică pentru {{ return_document.order_number }}.</strong><span>Intră în stoc numai produsele efectiv primite, cu costurile originale păstrate.</span></p></div><div class="nir-fields"><label class="nir-field"><span>Gestiune <b>*</b></span><select name="warehouse_id" required data-nir-warehouse><option value="">Alege gestiunea</option>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}"{{ values.warehouse_id|default('') == warehouse.id ? ' selected' : '' }}>{{ warehouse.name }}</option>{% endfor %}</select></label><label class="nir-field"><span>Locație recepție <b>*</b></span><select name="location_id" required><option value="">Alege locația</option>{% for location in locations %}<option value="{{ location.id }}" data-warehouse="{{ location.warehouse_id }}"{{ values.location_id|default('') == location.id ? ' selected' : '' }}>{{ location.name }}</option>{% endfor %}</select></label>{{ ui.field('invoice_number','Număr factură de retur',values.invoice_number|default(return_document.invoice_number|default('')),{}, {required:true}) }}{{ ui.field('invoice_date','Data facturii de retur',values.invoice_date|default(return_document.invoice_date|default(today|default(''))),{}, {type:'date',required:true}) }}</div><div class="nir-return-items">{% for item in return_document.items|default([]) %}<p><strong>{{ item.product_name|default(item.name|default('Produs returnat')) }}</strong><span>{{ item.quantity }} buc.</span></p>{% endfor %}</div><label class="nir-acknowledge"><input type="checkbox" name="physically_received" value="1"{{ values.physically_received|default(false) ? ' checked' : '' }} required><span>Confirm că produsele au fost primite fizic și sunt eligibile pentru reintrarea în gestiune.</span></label>
{% endif %}{% if kind != 'confirm' and warnings|default([]) %}<div class="nir-warnings" data-nir-warnings>{% for warning in warnings %}<p>{{ ui.icon('warning') }}{{ warning.message|default(warning) }}</p>{% endfor %}</div><label class="nir-acknowledge" data-nir-acknowledge><input type="checkbox" name="accept_warnings" value="1" required><span>Am verificat avertismentele și doresc să continui.</span></label>{% endif %}</div><footer class="nir-form__footer">{% if kind == 'reverse' %}<span class="nir-return-footer-note">{{ ui.icon('box') }}<span data-reverse-summary>Niciun produs selectat</span></span>{% endif %}<a class="nir-button nir-button--cancel" href="{{ back_url }}" data-nir-modal-close>Renunță</a><button type="submit" class="nir-button {{ kind in ['delete','reverse','delete_attachment'] ? 'nir-button--danger' : 'nir-button--primary' }}">{{ ui.icon(kind == 'export' ? 'download' : (kind in ['delete','delete_attachment'] ? 'trash' : 'check')) }}<span>{{ kind == 'export' ? 'Descarcă exportul' : (kind == 'reverse' ? 'Emite returul' : (kind in ['delete','delete_attachment'] ? (kind == 'delete_attachment' ? 'Șterge fișierul' : (doc.status|default('draft') == 'confirmed' ? 'Șterge și recalculează' : 'Șterge draftul')) : (kind == 'attachments' ? 'Salvează fișierele' : (kind == 'opening' ? 'Înregistrează soldul' : (kind == 'confirm' ? 'Confirmă NIR' : 'Confirmă recepția'))))) }}</span></button></footer></form>
