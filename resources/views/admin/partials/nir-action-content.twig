{% import 'admin/partials/nir-ui.twig' as ui %}{% set doc = document|default({}) %}{% set kind = action_kind|default('confirm') %}{% set values = values|default({}) %}{% if kind == 'customer_return' %}{% set form_title = 'Recepționează returul' %}{% endif %}
<form class="nir-form nir-action-form{{ kind in ['confirm','delete','delete_attachment'] ? ' nir-action-form--compact' : '' }}" method="{{ kind == 'export' ? 'get' : 'post' }}" action="{{ form_action }}"{% if kind in ['attachments','reverse'] %} enctype="multipart/form-data"{% endif %}{% if kind != 'export' %} data-nir-form{% else %} data-nir-export-form{% endif %}>
{% if kind != 'export' %}<input type="hidden" name="_csrf" value="{{ csrf_token() }}"><input type="hidden" name="row_version" value="{{ doc.row_version|default(0) }}"><input type="hidden" name="idempotency_key" value="{{ idempotency_key|default('') }}">{% endif %}
<header class="nir-form__header"><span class="nir-form__mark{{ kind in ['delete','reverse','delete_attachment'] ? ' is-amber' : '' }}">{{ ui.icon(kind == 'export' ? 'download' : (kind == 'reverse' ? 'return' : (kind in ['delete','delete_attachment'] ? 'trash' : (kind == 'attachments' ? 'upload' : (kind == 'opening' ? 'layers' : 'check'))))) }}</span><div><span class="nir-eyebrow">{{ kind == 'export' ? 'Documente la îndemână' : doc.number|default('Stoc și achiziții') }}</span><h2>{{ form_title|default(kind == 'export' ? 'Exportă registrul' : (kind == 'reverse' ? 'Retur către furnizor' : (kind == 'delete' ? 'Ștergi documentul în lucru?' : (kind == 'attachments' ? 'Adaugă documente' : (kind == 'opening' ? 'Sold inițial FIFO' : (kind == 'delete_attachment' ? 'Ștergi acest fișier?' : 'Confirmi recepția?')))))) }}</h2></div><a class="nir-close" href="{{ back_url }}" data-nir-modal-close aria-label="Închide">{{ ui.icon('close') }}</a></header>
<div class="nir-form__body"><div class="nir-form-errors" data-nir-errors role="alert" tabindex="-1"{% if not errors|default([]) %} hidden{% endif %}>{% for error in errors|default([]) %}<p>{{ error }}</p>{% endfor %}</div>
{% if kind == 'confirm' %}<div class="nir-confirm-card"><span>{{ ui.icon('box') }}</span><div><strong>{{ doc.supplier.alias|default(doc.supplier_name|default('Recepție furnizor')) }}</strong><p>{{ doc.lines|default([])|length }} {{ doc.lines|default([])|length == 1 ? 'poziție' : 'poziții' }} · Factura {{ doc.invoice_series|default('') }} {{ doc.invoice_number|default('') }}</p></div>{% if permissions.costs|default(false) %}<b>{{ (doc.total_bani|default(0)/100)|number_format(2,',','.') }} {{ doc.currency|default('RON') }}</b>{% endif %}</div><p class="nir-action-intro">La confirmare, produsele acceptate intră în stocul contabil și primesc loturi FIFO. Documentul primește număr final și devine protejat.</p><ul class="nir-confirm-checks"><li>{{ ui.icon('check') }}Stocul, loturile și istoricul se salvează împreună</li><li>{{ ui.icon('shield') }}Recepția confirmată nu poate fi ștearsă</li></ul><div class="nir-warnings" data-nir-warnings{% if not warnings|default([]) %} hidden{% endif %}>{% for warning in warnings|default([]) %}<p>{{ ui.icon('warning') }}{{ warning.message|default(warning) }}</p>{% endfor %}</div><label class="nir-acknowledge" data-nir-acknowledge{% if not warnings|default([]) %} hidden{% endif %}><input type="checkbox" name="accept_warnings" value="1"{% if warnings|default([]) %} required{% endif %}><span>Am verificat avertismentele și doresc să continui.</span></label>
{% elseif kind in ['delete','delete_attachment'] %}<div class="nir-delete-mark">{{ ui.icon('trash') }}</div><p class="nir-action-intro">{{ kind == 'delete' ? 'Documentul în lucru și fișierele sale vor fi eliminate. Stocul nu este afectat, deoarece recepția nu a fost confirmată.' : 'Fișierul va fi eliminat din dosarul recepției. Produsele, valorile și stocul rămân neschimbate.' }}</p><div class="nir-confirm-card"><strong>{{ kind == 'delete_attachment' ? attachment.original_name|default('Fișierul selectat') : doc.number|default('Document în lucru') }}</strong></div>
{% elseif kind == 'reverse' %}<div class="nir-guidance">{{ ui.icon('info') }}<p><strong>Se creează un document separat de retur.</strong><span>Selectează numai cantitățile pe care le returnezi. Recepția originală rămâne în istoric.</span></p></div><div class="nir-fields nir-fields--three">{{ ui.field('invoice_series','Serie factură corectivă',values.invoice_series|default('')) }}{{ ui.field('invoice_number','Număr factură corectivă',values.invoice_number|default(''),{}, {required:true}) }}{{ ui.field('invoice_date','Data facturii corective',values.invoice_date|default(today|default('')),{}, {type:'date',required:true}) }}</div><div class="nir-reverse-lines">{% for line in doc.lines %}<div class="nir-reverse-row"><span class="nir-mini-check"><input type="checkbox" data-reverse-select{{ attribute(values.quantities|default({}),line.id)|default(0) > 0 ? ' checked' : '' }} aria-label="Selectează {{ line.supplier_name }}"><span><strong>{{ line.supplier_name }}</strong><small>{{ line.sku|default('') }} · {{ line.available_quantity|default(line.remaining_quantity|default(line.accepted_quantity))|decimal_ro }} {{ line.purchase_unit }} disponibile</small></span></span><span class="nir-field"><span>Cantitate retur</span><input name="quantities[{{ line.id }}]" type="number" value="{{ attribute(values.quantities|default({}),line.id)|default('0') }}" min="0" max="{{ line.available_quantity|default(line.remaining_quantity|default(line.accepted_quantity)) }}" step="0.0001" inputmode="decimal" data-reverse-quantity></span></div>{% endfor %}</div>{{ ui.field('reason','Motivul returului',values.reason|default(''),{}, {type:'textarea',required:true,max:500,placeholder:'Descrie de ce returnezi aceste produse.'}) }}<div class="nir-upload" data-nir-dropzone><span>{{ ui.icon('upload') }}</span><div><strong>Documente justificative</strong><p>Factura corectivă sau dovezile returului · maximum 15 MB / fișier</p></div><label class="nir-button nir-button--soft"><input type="file" name="attachments[]" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xml" data-nir-files><span>Alege fișiere</span></label></div><div class="nir-file-list" data-nir-file-list></div>
{% elseif kind == 'export' %}<p class="nir-action-intro">Alege perioada și formatul. Arhiva completă include registrul, documentele PDF și Excel și fișierele originale.</p><div class="nir-export-choices"><label><input type="radio" name="format" value="xlsx" checked><span>{{ ui.icon('document') }}<strong>Registru Excel</strong><small>Documente și valori, într-un singur fișier</small></span></label><label><input type="radio" name="format" value="zip"><span>{{ ui.icon('box') }}<strong>Dosar complet ZIP</strong><small>Registru, recepții și toate atașamentele</small></span></label></div><label class="nir-field"><span>Perioada exportată</span><select name="period" data-export-period>{% for key,label in {'month':'Luna curentă','previous_month':'Luna anterioară','3months':'Ultimele 3 luni','6months':'Ultimele 6 luni','year':'Anul curent','all':'Toate documentele','custom':'Aleg o perioadă'} %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label><div class="nir-fields" data-export-dates>{{ ui.field('from','De la','',{}, {type:'date'}) }}{{ ui.field('to','Până la','',{}, {type:'date'}) }}</div><label class="nir-field"><span>Documente incluse</span><select name="status"><option value="">Toate stările</option><option value="confirmed">Numai confirmate</option><option value="draft">Numai în lucru</option><option value="supplier_return">Storno / retur</option></select></label><p data-export-progress hidden class="nir-export-progress" role="status">Pregătim documentele pentru descărcare…</p>
{% elseif kind == 'attachments' %}<div class="nir-guidance">{{ ui.icon('shield') }}<p><strong>Completează dosarul recepției.</strong><span>Adăugarea fișierelor nu modifică produsele sau stocul.</span></p></div><div class="nir-upload" data-nir-dropzone><span>{{ ui.icon('upload') }}</span><div><strong>Alege fișierele</strong><p>PDF, JPG, PNG, WebP, XLSX, XML · maximum 15 MB / fișier</p></div><label class="nir-button nir-button--soft"><input type="file" name="attachments[]" multiple required accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xml" data-nir-files>Alege fișiere</label></div><div class="nir-file-list" data-nir-file-list></div>
{% elseif kind == 'opening' %}<div class="nir-guidance">{{ ui.icon('info') }}<p><strong>Pentru stocul existent înaintea primei recepții.</strong><span>Introdu cantitatea reală și costul documentat. Această operațiune este separată de NIR-uri.</span></p></div><div class="nir-fields"><label class="nir-field"><span>Gestiune <b>*</b></span><select name="warehouse_id" required>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.name }}</option>{% endfor %}</select></label><label class="nir-field"><span>Produs și variantă <b>*</b></span><select name="variant_id" required><option value="">Alege produsul</option>{% for product in products|default([]) %}<option value="{{ product.variant_id }}">{{ product.product_name }} · {{ product.option_summary|default(product.sku) }}</option>{% endfor %}</select></label>{{ ui.field('quantity','Cantitate','',{}, {inputmode:'decimal',required:true}) }}{{ ui.field('unit_cost_ron','Cost unitar real (RON)','',{}, {inputmode:'decimal',required:true}) }}{{ ui.field('date','Data stocului',values.date|default(today|default('')),{}, {type:'date',required:true}) }}</div>{{ ui.field('reason','Explicație și document justificativ','',{}, {type:'textarea',required:true,max:500}) }}
{% elseif kind == 'customer_return' %}<div class="nir-guidance">{{ ui.icon('return') }}<p><strong>Recepție fizică pentru {{ return_document.order_number }}.</strong><span>Intră în stoc numai produsele efectiv primite, cu costurile originale păstrate.</span></p></div><div class="nir-fields"><label class="nir-field"><span>Gestiune <b>*</b></span><select name="warehouse_id" required data-nir-warehouse><option value="">Alege gestiunea</option>{% for warehouse in warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.name }}</option>{% endfor %}</select></label><label class="nir-field"><span>Locație recepție <b>*</b></span><select name="location_id" required><option value="">Alege locația</option>{% for location in locations %}<option value="{{ location.id }}" data-warehouse="{{ location.warehouse_id }}">{{ location.name }}</option>{% endfor %}</select></label>{{ ui.field('invoice_number','Număr factură de retur',return_document.invoice_number|default(''),{}, {required:true}) }}{{ ui.field('invoice_date','Data facturii de retur',return_document.invoice_date|default(today|default('')),{}, {type:'date',required:true}) }}</div><div class="nir-return-items">{% for item in return_document.items|default([]) %}<p><strong>{{ item.product_name|default(item.name|default('Produs returnat')) }}</strong><span>{{ item.quantity }} buc.</span></p>{% endfor %}</div><label class="nir-acknowledge"><input type="checkbox" name="physically_received" value="1" required><span>Confirm că produsele au fost primite fizic și sunt eligibile pentru reintrarea în gestiune.</span></label>
{% endif %}{% if kind != 'confirm' and warnings|default([]) %}<div class="nir-warnings" data-nir-warnings>{% for warning in warnings %}<p>{{ ui.icon('warning') }}{{ warning.message|default(warning) }}</p>{% endfor %}</div><label class="nir-acknowledge" data-nir-acknowledge><input type="checkbox" name="accept_warnings" value="1" required><span>Am verificat avertismentele și doresc să continui.</span></label>{% endif %}</div><footer class="nir-form__footer"><a class="nir-button nir-button--cancel" href="{{ back_url }}" data-nir-modal-close>Renunță</a><button type="submit" class="nir-button {{ kind in ['delete','reverse','delete_attachment'] ? 'nir-button--danger' : 'nir-button--primary' }}">{{ ui.icon(kind == 'export' ? 'download' : (kind in ['delete','delete_attachment'] ? 'trash' : 'check')) }}<span>{{ kind == 'export' ? 'Descarcă exportul' : (kind == 'reverse' ? 'Emite returul' : (kind in ['delete','delete_attachment'] ? 'Da, șterge' : (kind == 'attachments' ? 'Salvează fișierele' : (kind == 'opening' ? 'Înregistrează soldul' : 'Confirmă recepția')))) }}</span></button></footer></form>
