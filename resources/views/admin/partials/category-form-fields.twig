{% macro parent_nodes(items, selected_id, depth) %}
  {% for item in items %}
    <div class="admin-category-node admin-category-parent-node" data-admin-category-node data-admin-category-parent-node style="--category-depth:{{ depth }};--parent-depth:{{ depth }}" data-category-search="{{ (item.name ~ ' ' ~ item.slug)|lower }}" data-parent-search="{{ (item.name ~ ' ' ~ item.slug)|lower }}">
      <label class="admin-category-option admin-category-parent-option">
        <input type="radio" name="parent_id" value="{{ item.id }}" {{ selected_id == item.id ? 'checked' }} data-admin-category-parent-radio data-parent-name="{{ item.name }}" data-parent-depth="{{ depth }}">
        <span class="admin-category-option__check admin-category-parent-option__radio" aria-hidden="true"></span>
        <span class="admin-category-option__copy">
          <strong>{{ item.name }}</strong>
          <small>{{ item.slug }}</small>
        </span>
        {% if item.children is not empty %}<span class="admin-category-option__branch" aria-label="{{ item.children|length }} subcategorii">{{ item.children|length }}</span>{% endif %}
      </label>
      {% if item.children is not empty %}<div class="admin-category-children admin-category-parent-node__children" data-admin-category-children>{{ _self.parent_nodes(item.children, selected_id, depth + 1) }}</div>{% endif %}
    </div>
  {% endfor %}
{% endmacro %}

{% set selected_parent_id = category.parent_id|default(null) %}
{% set category_name = category.name|default('') %}
{% set category_status = category.status|default('published') %}
{% set allow_card = category.allow_card is defined ? category.allow_card == 1 : true %}
{% set allow_cod = category.allow_cod is defined ? category.allow_cod == 1 : true %}
{% set seo_title_auto = not category or not category.seo_title or category.seo_title == category.name %}
{% set seo_description_auto = not category or not category.meta_description or category.meta_description == category.name %}
<form class="admin-category-form" action="{{ form_action }}" method="post" enctype="multipart/form-data" data-admin-category-form data-category-id="{{ category.id|default('') }}" data-name-check-url="{{ url('admin/categorii/verifica-nume/') }}" data-slug-check-url="{{ url('admin/categorii/verifica-slug/') }}">
  <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
  <input type="hidden" name="image_media_id" value="{{ category.image_media_id|default('') }}" data-admin-category-image-id>
  <input type="hidden" name="remove_image" value="0" data-admin-category-remove-image>
  <input type="hidden" name="payment_rules_present" value="1">
  <nav class="admin-category-editor-nav" aria-label="Secțiunile formularului" data-admin-category-editor-nav>
    <a href="#category-identity" data-category-section-link="identity" aria-current="step"><b>01</b><span>Identitate</span></a>
    <a href="#category-placement" data-category-section-link="placement"><b>02</b><span>Organizare</span></a>
    <a href="#category-payment" data-category-section-link="payment"><b>03</b><span>Plată</span></a>
    <a href="#category-presentation" data-category-section-link="presentation"><b>04</b><span>Prezentare</span></a>
    <a href="#category-google" data-category-section-link="google"><b>05</b><span>Google</span></a>
  </nav>
  {% if category_modal|default(false) %}<div class="admin-category-form__scroll">{% endif %}

  <section class="admin-category-form__section" id="category-identity" data-category-section="identity">
    <header><span class="admin-category-form__step" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h7l9 9-6 6-10-10V5Z"/><circle cx="8" cy="9" r="1"/></svg></span><div><small>01 · Identitate</small><h3>Începe cu un nume</h3><p>Așa va apărea categoria în magazin. Linkul se completează automat.</p></div></header>
    <div class="admin-category-form__grid">
      <label class="admin-category-field" data-category-availability="idle"><span>Nume categorie <b>*</b></span><input name="name" value="{{ category_name }}" maxlength="190" autocomplete="off" placeholder="Ex: Rochițe de vară" required data-admin-category-name><small data-admin-category-name-status>Scrie denumirea pe care o va vedea clientul.</small></label>
      <label class="admin-category-field" data-category-availability="idle"><span>Link categorie (slug) <b>*</b><em>Automat, editabil</em></span><div class="admin-category-field__prefix"><i>/categorie/</i><input name="slug" value="{{ category.slug|default('') }}" maxlength="190" autocomplete="off" placeholder="rochite-de-vara" required data-admin-category-slug data-slug-auto="{{ not category ? 'true' : 'false' }}"></div><small data-admin-category-slug-status>Se generează din nume, dar îl poți edita.</small></label>
    </div>
  </section>

  <section class="admin-category-form__section" id="category-placement" data-category-section="placement">
    <header><span class="admin-category-form__step" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3h6v5H9zM3 16h6v5H3zM15 16h6v5h-6zM12 8v4M6 16v-4h12v4"/></svg></span><div><small>02 · Organizare</small><h3>Alege locul în catalog</h3><p>Creează o categorie principală sau așaz-o sub o categorie existentă.</p></div></header>
    <div class="admin-category-placement">
      <details class="admin-category-picker admin-category-parent-picker has-selection" data-admin-category-parent-picker>
        <summary data-admin-category-parent-toggle aria-expanded="false">
          <span class="admin-category-picker__summary-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5h6l1.6 2H20v9.5H4z"></path><path d="M4 10h16"></path></svg></span>
          <span class="admin-category-picker__summary-copy">
            <strong data-admin-category-parent-label>{{ category and category.parent_id ? category.parent_name|default('Categorie selectată') : 'Categorie principală' }}</strong>
            <small data-admin-category-parent-preview>{{ category and category.parent_id ? 'Părinte selectat în arbore' : 'Primul nivel al magazinului' }}</small>
          </span>
          <span class="admin-category-picker__summary-count" data-admin-category-level-preview>{{ category and category.parent_id ? 'Subcategorie' : 'Principală' }}</span>
          <svg class="admin-category-picker__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg>
        </summary>
        <button class="admin-category-picker__backdrop" type="button" aria-label="Închide selectorul categoriei părinte" data-admin-category-parent-close></button>
        <div class="admin-category-picker__panel admin-category-parent-picker__panel">
          <header class="admin-category-picker__header">
            <span><small>Catalog</small><strong>Alege categoria părinte</strong></span>
            <button type="button" aria-label="Închide" data-admin-category-parent-close><svg viewBox="0 0 24 24"><path d="m6.5 6.5 11 11M17.5 6.5l-11 11"></path></svg></button>
          </header>
          <div class="admin-category-picker__search admin-category-parent-picker__search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
            <input type="search" aria-label="Caută o categorie părinte" placeholder="Caută o categorie sau subcategorie…" autocomplete="off" data-admin-category-search data-admin-category-parent-search>
            <button type="button" class="admin-category-picker__search-clear" aria-label="Șterge căutarea" data-admin-category-search-clear data-admin-category-parent-search-clear hidden><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg></button>
          </div>
          <div class="admin-category-picker__tree admin-category-parent-picker__tree" role="radiogroup" aria-label="Categorii părinte disponibile" data-admin-category-tree data-admin-category-parent-tree>
            <div class="admin-category-node admin-category-parent-node is-root" data-admin-category-node data-admin-category-parent-node data-category-search="categorie principala radacina primul nivel" data-parent-search="categorie principala radacina primul nivel" style="--category-depth:0;--parent-depth:-1">
              <label class="admin-category-option admin-category-parent-option admin-category-parent-option--root">
                <input type="radio" name="parent_id" value="" {{ not selected_parent_id ? 'checked' }} data-admin-category-parent-radio data-parent-name="Categorie principală" data-parent-depth="-1">
                <span class="admin-category-option__check admin-category-parent-option__radio" aria-hidden="true"></span>
                <span class="admin-category-option__copy"><strong>Categorie principală</strong><small>Primul nivel al magazinului</small></span>
                <span class="admin-category-option__branch admin-category-parent-option__root-badge">Rădăcină</span>
              </label>
            </div>
            {{ _self.parent_nodes(parent_categories, selected_parent_id, 0) }}
            <p class="admin-category-picker__empty" data-admin-category-empty data-admin-category-parent-empty hidden>Nu am găsit nicio categorie potrivită.</p>
          </div>
          <footer class="admin-category-picker__footer admin-category-parent-picker__footer">
            <span><strong data-admin-category-parent-status>{{ category and category.parent_id ? category.parent_name|default('Părinte selectat') : 'Categorie principală' }}</strong><small>O singură alegere</small></span>
            <button type="button" data-admin-category-done data-admin-category-parent-done aria-label="Închide selectorul categoriei părinte"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg></button>
          </footer>
        </div>
      </details>

      <label class="admin-category-order-field"><span>Ordine în meniu</span><input type="number" name="position" value="{{ category.position|default(suggested_position) }}" min="0" max="999" inputmode="numeric" {{ selected_parent_id ? 'disabled' }} data-admin-category-position><small data-admin-category-position-help>{{ selected_parent_id ? 'Ordinea este stabilită de categoria părinte.' : 'Numerele mici apar primele. Doar pentru categoriile principale.' }}</small></label>
      <div class="admin-category-placement__preview" aria-live="polite"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h6v5H4zM14 14h6v5h-6zM4 14h6v5H4z"/><path d="M7 10v2h10v2M7 12v2"/></svg></span><div><small>Poziție rezultată</small><strong data-admin-category-placement-text>{{ selected_parent_id ? 'Subcategorie în ' ~ category.parent_name|default('categoria aleasă') : 'Categorie principală' }}</strong><p>Locul din arbore se actualizează automat după salvare.</p></div></div>
    </div>
    <div class="admin-category-form__grid admin-category-form__grid--compact">
      <label class="admin-category-field admin-category-field--setting"><span>Starea categoriei</span><select name="status"><option value="draft" {{ category_status == 'draft' ? 'selected' }}>Ciornă</option><option value="published" {{ category_status == 'published' ? 'selected' }}>Publicată</option><option value="archived" {{ category_status == 'archived' ? 'selected' }}>Arhivată</option></select><small data-admin-category-status-help>{{ category_status == 'published' ? 'Categoria este disponibilă în magazin.' : (category_status == 'archived' ? 'Categoria este retrasă din magazin.' : 'O ciornă este vizibilă doar în administrare.') }}</small></label>
      <label class="admin-category-field admin-category-field--setting"><span>Afișare în meniu</span><select name="visibility"><option value="public" {{ category.visibility|default('public') == 'public' ? 'selected' }}>Vizibilă în meniu</option><option value="hidden" {{ category.visibility|default('') == 'hidden' ? 'selected' }}>Ascunsă din meniu</option></select><small>Alege dacă apare în navigarea magazinului.</small></label>
    </div>
  </section>

  <section class="admin-category-form__section admin-category-payment" id="category-payment" data-category-section="payment">
    <header><span class="admin-category-form__step" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h4"/></svg></span><div><small>03 · Metode de plată</small><h3>Cum se pot plăti produsele?</h3><p>Alege metodele permise pentru această categorie și pentru toate subcategoriile ei.</p></div></header>
    <fieldset class="admin-category-payment__choices" aria-describedby="category-payment-help category-payment-notice">
      <legend>Metode permise în această categorie</legend>
      <label class="admin-category-payment-card">
        <input type="checkbox" role="switch" name="allow_card" value="1" {{ allow_card ? 'checked' }} aria-label="Permite plata cu cardul online" data-admin-category-payment>
        <span class="admin-category-payment-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h4"/></svg></span>
        <span class="admin-category-payment-card__copy"><strong>Card online</strong><small>Plată la finalizarea comenzii.</small><em data-category-payment-state>{{ allow_card ? 'Permisă' : 'Oprită' }}</em></span>
        <span class="admin-category-payment-card__switch" aria-hidden="true"></span>
      </label>
      <label class="admin-category-payment-card">
        <input type="checkbox" role="switch" name="allow_cod" value="1" {{ allow_cod ? 'checked' }} aria-label="Permite plata ramburs" data-admin-category-payment>
        <span class="admin-category-payment-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="3"/><circle cx="12" cy="12" r="3"/><path d="M6 9h.01M18 15h.01"/></svg></span>
        <span class="admin-category-payment-card__copy"><strong>Ramburs</strong><small>Plată la primirea coletului.</small><em data-category-payment-state>{{ allow_cod ? 'Permisă' : 'Oprită' }}</em></span>
        <span class="admin-category-payment-card__switch" aria-hidden="true"></span>
      </label>
    </fieldset>
    <p class="admin-category-payment__notice" id="category-payment-notice" role="status" aria-live="polite" data-admin-category-payment-notice hidden></p>
    <div class="admin-category-payment__help" id="category-payment-help"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4 4 7 8 9 4-2 8-5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg></span><div><strong>Cel puțin o metodă rămâne activă</strong><p>Regulile se aplică acestei categorii și subcategoriilor, împreună cu regulile categoriilor părinte. Când regulile diferă, cardul are prioritate; dacă plata online nu este disponibilă în magazin, se folosește rambursul când este activ.</p><small>Setările generale ale magazinului pot limita metodele disponibile la comandă, fără să schimbe aceste opțiuni.</small></div></div>
  </section>

  <section class="admin-category-form__section" id="category-presentation" data-category-section="presentation">
    <header><span class="admin-category-form__step" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="8" cy="9" r="1.5"/><path d="m4 17 5-5 4 4 3-3 5 5"/></svg></span><div><small>04 · Prezentare</small><h3>O primă impresie frumoasă</h3><p>Adaugă o fotografie și o descriere scurtă. Le poți completa și mai târziu.</p></div></header>
    <div class="admin-category-media-grid">
      <div class="admin-category-image {{ category.image_path|default('') ? 'has-image' : '' }}" data-admin-category-image>
        <div class="admin-category-image__preview"><img src="{{ category.image_path|default('') ? url(category.image_path) : '' }}" alt="" {{ not category.image_path|default('') ? 'hidden' }} data-admin-category-image-preview><span data-admin-category-image-empty {{ category.image_path|default('') ? 'hidden' }}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h6l2 2h8v11H4z"/><circle cx="9" cy="12" r="1.5"/><path d="m7 17 3-3 2 2 2-2 3 3"/></svg><strong>Nicio fotografie încă</strong><small>JPG, PNG sau WebP · maximum 8 MB</small></span></div>
        <div class="admin-category-image__actions"><label><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-admin-category-image-input><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4"/></svg><span>{{ category.image_path|default('') ? 'Schimbă fotografia' : 'Alege fotografia' }}</span></label><button class="admin-category-image__remove" type="button" data-admin-category-image-remove {{ not category.image_path|default('') ? 'hidden' }}>Elimină</button></div>
        <label class="admin-category-image__alt"><span>Text alternativ <em>opțional</em></span><input name="image_alt" value="{{ category.image_alt|default('') }}" maxlength="500" placeholder="Se folosește numele categoriei dacă rămâne gol"></label>
      </div>
      <div class="admin-category-presentation-copy"><label class="admin-category-description"><span>Descriere scurtă <em>maximum 100</em></span><textarea name="description" rows="5" maxlength="100" placeholder="Ex: Hăinuțe moi și delicate pentru primele zile împreună." data-admin-category-description>{{ category.description|default('') }}</textarea><small><strong data-admin-category-description-count>{{ category.description|default('')|length }}</strong>/100 caractere</small></label><aside class="admin-category-tip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6m-6 3h6M8 14a7 7 0 1 1 8 0l-1 2H9l-1-2Z"/></svg><div><strong>Puține cuvinte, o idee clară</strong><p>Spune ce găsește clientul în această categorie. O singură propoziție este suficientă.</p></div></aside></div>
    </div>
  </section>

  <section class="admin-category-form__section admin-category-form__section--seo" id="category-google" data-category-section="google">
    <header><span class="admin-category-form__step" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></span><div><small>05 · Google</small><h3>Pregătită să fie descoperită</h3><p>Textele se completează din nume. Le poți personaliza oricând.</p></div></header>
    <div class="admin-category-seo">
      <div class="admin-category-seo__fields">
        <label class="admin-category-field"><span>Meta titlu <em>automat sau manual</em></span><input name="seo_title" value="{{ category.seo_title|default(category_name) }}" maxlength="255" data-admin-category-seo-title data-seo-auto="{{ seo_title_auto ? 'true' : 'false' }}"><small><b data-admin-category-seo-title-count>{{ category.seo_title|default(category_name)|length }}</b> caractere · golește pentru revenire la automat</small></label>
        <label class="admin-category-field"><span>Meta descriere <em>automat sau manual</em></span><textarea name="meta_description" rows="4" maxlength="500" data-admin-category-seo-description data-seo-auto="{{ seo_description_auto ? 'true' : 'false' }}">{{ category.meta_description|default(category_name) }}</textarea><small><b data-admin-category-seo-description-count>{{ category.meta_description|default(category_name)|length }}</b> caractere · golește pentru revenire la automat</small></label>
        <label class="admin-category-indexable"><input type="checkbox" name="indexable" {{ not category or category.indexable ? 'checked' }}><span><b aria-hidden="true"></b><strong>Permite indexarea în Google</strong><small>Recomandat pentru categoriile publicate cu produse relevante.</small></span></label>
      </div>
      <div class="admin-category-search-preview"><header><span>Previzualizare Google</span><small><i aria-hidden="true"></i> Se actualizează live</small></header><div class="admin-category-google-preview" aria-label="Previzualizare Google"><div><span class="admin-category-google-preview__g"><img src="{{ url('assets/images/google-g.svg') }}" width="22" height="22" alt="Google"></span><span><strong>La Măriuca Boutique</strong><small data-admin-category-preview-url>la-mariuca.ro/categorie/{{ category.slug|default('numele-categoriei') }}/</small></span></div><h4 data-admin-category-preview-title>{{ category.seo_title|default(category_name ?: 'Numele categoriei') }}</h4><p data-admin-category-preview-description>{{ category.meta_description|default(category_name ?: 'Descrierea categoriei va apărea aici.') }}</p></div><p>O previzualizare orientativă a rezultatului din căutare.</p></div>
    </div>
  </section>

  <p class="admin-category-form__feedback" data-admin-category-form-feedback hidden></p>
  {% if category_modal|default(false) %}</div>{% endif %}
  <footer class="admin-category-form__actions"><span class="admin-category-save-note"><i aria-hidden="true"></i>Modificările se păstrează la salvare.</span><div class="admin-category-form__buttons"><a class="admin-category-cancel" href="{{ url('admin/categorii/') }}" data-admin-category-editor-close>Renunță</a><button class="admin-category-save" type="submit" data-admin-category-submit><span>{{ category ? 'Salvează modificările' : 'Creează categoria' }}</span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></i></button></div></footer>
</form>
