<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<title>{{ number }} · {{ nir.company.trade_name|default('La Măriuca Boutique', true) }}</title>
<style>
@page { margin:7mm 7mm 12mm; }
body { margin:0; color:#493b42; font-family:"DejaVu Sans",sans-serif; font-size:9px; line-height:1.35; }
table { width:100%; table-layout:fixed; border-collapse:collapse; }
td { vertical-align:middle; }
.brand { margin-bottom:8px; }
.brand > tbody > tr > td { height:72px; padding:0; }
.brand-company { width:38%; }
.brand-heading { width:42%; text-align:center; }
.brand-code { width:20%; padding-left:15px !important; }
.identity td { padding:0; }
.identity-logo { width:190px; padding-right:14px !important; text-align:center; vertical-align:middle; }
.logo { width:172px; max-width:172px; height:auto; max-height:82px; vertical-align:middle; }
.trade-name { color:#805264; font-size:17px; line-height:1.15; font-weight:bold; margin-bottom:7px; }
.legal-name { font-size:9.5px; font-weight:bold; margin-bottom:7px; }
.company-reference { color:#796771; font-size:8px; line-height:1.45; }
h1 { color:#684552; font-size:19px; font-weight:bold; line-height:1.3; margin:0; }
.nir-caption { color:#b17888; font-size:17px; font-weight:bold; margin-top:3px; }
.form-code { padding:13px 8px; border-radius:10px; background:#faf3f5; text-align:center; color:#80606d; }
.form-code .code-icon { height:22px; width:22px; vertical-align:middle; margin-right:5px; }
.form-code strong { display:block; font-size:11px; color:#684552; margin-top:6px; }
.form-state { font-size:7px; color:#a47a87; margin-top:4px; }
.document-band { border:1px solid #dfccd3; border-radius:8px; margin-bottom:6px; }
.document-band td { padding:8px 14px; height:32px; }
.document-band .number { width:24%; background:#805264; color:white; border-right:1px solid #a77e8e; border-radius:7px 0 0 7px; }
.document-band .date { width:24%; background:#805264; color:white; border-radius:0 28px 28px 0; }
.document-band .space { width:52%; padding:0; }
.band-icon { height:23px; width:23px; float:left; margin:3px 11px 0 0; }
.band-label { font-size:8px; color:#f4e4eb; margin-bottom:4px; }
.band-value { font-size:14px; font-weight:bold; line-height:1.15; }
.metadata { margin-bottom:6px; }
.metadata > tbody > tr > td { width:50%; vertical-align:top; }
.metadata .left { padding:0 4px 0 0; }
.metadata .right { padding:0 0 0 4px; }
.metadata-card { border:1px solid #dfccd3; border-radius:7px; padding:6px 10px; }
.metadata-card td { padding:4px 0; vertical-align:middle; word-wrap:break-word; }
.meta-label { width:43%; font-weight:bold; color:#684b57; padding-right:7px !important; }
.meta-value { width:57%; color:#51454a; }
.meta-icon { width:13px; height:13px; margin-right:6px; vertical-align:middle; }
.lines { font-size:8.3px; }
.lines thead { display:table-header-group; }
.lines th { color:#fff; background:#805264; border:1px solid #b99ba7; font-size:7.8px; text-align:center; line-height:1.4; padding:7px 3px; font-weight:bold; vertical-align:middle; }
.lines td { border:1px solid #dfd3d8; padding:7px 4px; vertical-align:middle; word-wrap:break-word; }
.lines tbody tr { page-break-inside:avoid; }
.lines .index { color:#a86478; font-size:10px; font-weight:bold; text-align:center; }
.lines .sku { font-size:8px; }
.lines .image-cell { text-align:center; }
.product { max-width:44px; max-height:44px; }
.image-placeholder { color:#b8a8af; font-size:7px; }
.lines .product-name { line-height:1.55; }
.line-note-hint { color:#9b818d; font-size:7px; margin-top:3px; }
.center { text-align:center; }
.amount { text-align:right; }
.good { color:#43866b; font-weight:bold; }
.minus { color:#b34e68; font-weight:bold; }
.plus { color:#ac7e3f; font-weight:bold; }
.totals-row td { background:#f7f0f3; padding:8px 4px; font-size:10px; font-weight:bold; color:#684552; }
.totals-row .total-label { text-align:right; }
.totals-row .grand-total { background:#b27286; color:#fff; font-size:10.5px; }
.protected { color:#aa939d; font-weight:normal; }
.notes { margin-top:6px; padding:7px 11px; border:1px solid #e3c8ad; border-radius:8px; background:#fffbf5; min-height:38px; }
.notes-heading { font-size:9px; font-weight:bold; color:#73515e; margin-bottom:5px; }
.notes-heading .meta-icon { width:16px; height:16px; }
.notes p { margin:3px 0 0; line-height:1.5; word-wrap:break-word; }
.line-observation { margin:4px 0 0; font-size:8px; line-height:1.5; }
.stamp-area { margin-top:6px; padding:7px 18px; border:1px solid #dfccd3; border-radius:7px; height:69px; text-align:right; page-break-inside:avoid; }
.stamp { max-height:67px; max-width:110px; }
</style>
</head>
<body>
{% macro decimal(value) -%}
    {%- set text = value|default('0', true) ~ '' -%}
    {%- if '.' in text -%}{%- set text = text|trim('0', 'right')|trim('.', 'right') -%}{%- endif -%}
    {{- (text == '-0' ? '0' : text)|replace({'.': ','}) -}}
{%- endmacro %}
{% macro icon(name, class, color = '#805264') %}
    {% set paths = {
        document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 15l3 3 5-6"/>',
        calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h1M15 15h1M8 18h1M15 18h1"/>',
        person: '<circle cx="12" cy="7" r="4"/><path d="M4 21v-3a8 8 0 0 1 16 0v3"/>',
        identity: '<rect x="2" y="4" width="20" height="16" rx="2"/><circle cx="8" cy="10" r="2"/><path d="M5 16a3 3 0 0 1 6 0M14 9h5M14 13h5M14 17h3"/>',
        warehouse: '<path d="M3 21V8l9-6 9 6v13zM7 21V11h10v10M7 15h10M7 18h10"/>',
        pin: '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
        invoice: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 12h8M8 16h8"/>',
        case: '<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3M3 12c5 4 13 4 18 0"/>',
        info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/>',
        clipboard: '<rect x="5" y="4" width="14" height="18" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M9 11h6M9 15h6M9 19h3"/>'
    } %}
    <img class="{{ class }}" alt="" src="data:image/svg+xml,{{ ('<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="' ~ color ~ '" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' ~ paths[name] ~ '</svg>')|url_encode }}">
{% endmacro %}
{% set company = nir.company|default({}) %}
{% set supplier = nir.supplier|default({}) %}
{% set preview = nir.preview|default(false) %}
{% set currency = nir.currency|default('RON', true) %}
{% set money_label = currency == 'RON' ? 'lei' : currency %}
{% set vat_rates = [] %}
{% for line in lines %}{% set rate = line.vat_percent|default('0') + 0 %}{% if rate not in vat_rates %}{% set vat_rates = vat_rates|merge([rate]) %}{% endif %}{% endfor %}
<table class="brand"><tbody><tr>
    <td class="brand-company"><table class="identity"><tr>
        {% if logo %}<td class="identity-logo"><img class="logo" src="{{ logo }}" alt="La Măriuca Boutique"></td>{% endif %}
        <td><div class="trade-name">{{ company.trade_name|default('La Măriuca Boutique', true) }}</div><div class="legal-name">{{ company.legal_name|default('', true) }}</div><div class="company-reference">CUI {{ company.tax_id|default('—', true) }}{% if company.trade_register|default('') %}<br>Reg. Com. {{ company.trade_register }}{% endif %}</div></td>
    </tr></table></td>
    <td class="brand-heading"><h1>NOTĂ DE RECEPȚIE ȘI<br>CONSTATARE DE DIFERENȚE</h1><div class="nir-caption">(NIR)</div></td>
    <td class="brand-code"><div class="form-code">{{ _self.icon('document', 'code-icon', '#b17888') }} Cod formular:<strong>NIR</strong>{% if preview or nir.status|default('draft') != 'confirmed' %}<div class="form-state">{{ preview ? 'PREVIZUALIZARE' : status_label }}{% if preview or nir.status|default('draft') == 'draft' %}<br>Fără intrare în stoc{% endif %}</div>{% endif %}</div></td>
</tr></tbody></table>
<table class="document-band"><tr>
    <td class="number">{{ _self.icon('document', 'band-icon', '#f2d8c5') }}<div class="band-label">Nr. NIR</div><div class="band-value">{{ number }}</div></td>
    <td class="date">{{ _self.icon('calendar', 'band-icon', '#f2d8c5') }}<div class="band-label">din data de</div><div class="band-value">{{ nir_date|split(' ')|first|trim(',') }}</div></td>
    <td class="space"></td>
</tr></table>
<table class="metadata"><tbody><tr>
    <td class="left"><div class="metadata-card"><table><tr><td class="meta-label">{{ _self.icon('person', 'meta-icon') }}Furnizor:</td><td class="meta-value">{{ supplier.company_name|default(supplier.alias|default('', true), true) }}</td></tr>
        <tr><td class="meta-label">{{ _self.icon('identity', 'meta-icon') }}CUI furnizor:</td><td class="meta-value">{{ supplier.tax_id|default('') }}</td></tr>
        <tr><td class="meta-label">{{ _self.icon('warehouse', 'meta-icon') }}Gestiune:</td><td class="meta-value">{{ nir.warehouse.name|default('') }}</td></tr>
        <tr><td class="meta-label">{{ _self.icon('pin', 'meta-icon') }}Loc recepție:</td><td class="meta-value">{{ nir.location.name|default('') }}</td></tr></table></div></td>
    <td class="right"><div class="metadata-card"><table><tr><td class="meta-label">{{ _self.icon('invoice', 'meta-icon') }}Factura furnizor nr. / data:</td><td class="meta-value">{{ nir.invoice_series|default('') }} {{ nir.invoice_number|default('') }}{% if nir.invoice_date|default('') %} / {{ nir.invoice_date|date('d.m.Y') }}{% endif %}</td></tr>
        <tr><td class="meta-label">{{ _self.icon('invoice', 'meta-icon') }}Factura inițială stornată nr. / data:</td><td class="meta-value">{{ nir.original_invoice_series|default('') }} {{ nir.original_invoice_number|default('') }}{% if nir.original_invoice_date|default('') %} / {{ nir.original_invoice_date|date('d.m.Y') }}{% endif %}</td></tr>
        <tr><td class="meta-label">{{ _self.icon('case', 'meta-icon') }}Tip operațiune:</td><td class="meta-value">{{ type_label }}</td></tr>
        <tr><td class="meta-label">{{ _self.icon('info', 'meta-icon') }}Motiv storno / retur / diferență:</td><td class="meta-value">{{ nir.reason|default('') }}</td></tr></table></div></td>
</tr></tbody></table>
<table class="lines"><thead><tr>
    <th>Nr.<br>crt.</th><th>Cod / SKU</th><th>Imagine</th><th>Denumirea<br>bunurilor<br>recepționate</th><th>U.M.</th><th>Cantitate<br>document</th><th>Cantitate<br>recepționată</th><th>Diferență<br>cantitativă</th><th>Preț unitar<br>fără TVA</th><th>Valoare<br>fără TVA</th><th>TVA<br>%</th><th>Valoare<br>TVA</th><th>Valoare<br>totală</th>
</tr></thead><tbody>
{% for line in lines %}{% set unit_price = line.price_mode|default('unit') == 'unit' ? line.unit_price|default(0) : (line.accepted_quantity|default(0) != 0 ? (line.net_bani|default(0) / 100 / line.accepted_quantity)|round(6) : 0) %}<tr>
    <td class="index">{{ loop.index }}</td>
    <td class="sku">{{ line.sku|default(line.supplier_code|default('', true), true) }}</td>
    <td class="image-cell">{% if line.image_data %}<img class="product" src="{{ line.image_data }}" alt="Produs">{% else %}<span class="image-placeholder">—</span>{% endif %}</td>
    <td class="product-name">{{ line.supplier_name }}{% if line.tracked is defined and not line.tracked %}<div class="line-note-hint">Fără intrare în stoc</div>{% endif %}{% if line.difference_notes|default('') or line.accepted_quantity|default(line.received_quantity) != line.received_quantity %}<div class="line-note-hint">Vezi constatări.</div>{% endif %}</td>
    <td class="center">{{ line.purchase_unit|default('buc') }}</td><td class="amount">{{ _self.decimal(line.invoice_quantity|default('0')) }}</td><td class="amount">{{ _self.decimal(line.received_quantity|default('0')) }}</td><td class="amount {{ line.difference < 0 ? 'minus' : (line.difference > 0 ? 'plus' : 'good') }}">{{ line.difference > 0 ? '+' : '' }}{{ _self.decimal(line.difference) }}</td>
    {% if view_costs %}<td class="amount">{{ unit_price|round(2) == unit_price ? unit_price|number_format(2, ',', '.') : _self.decimal(unit_price) }} {{ money_label }}</td><td class="amount">{{ (line.net_bani|default(0) / 100)|number_format(2, ',', '.') }} {{ money_label }}</td><td class="amount">{{ _self.decimal(line.vat_percent|default('0')) }}%</td><td class="amount">{{ (line.tax_bani|default(0) / 100)|number_format(2, ',', '.') }} {{ money_label }}</td><td class="amount">{{ (line.total_bani|default(0) / 100)|number_format(2, ',', '.') }} {{ money_label }}</td>{% else %}<td class="center protected">—</td><td class="center protected">—</td><td class="center protected">—</td><td class="center protected">—</td><td class="center protected">—</td>{% endif %}
</tr>{% else %}<tr><td colspan="13">Nicio poziție completată.</td></tr>{% endfor %}
<tr class="totals-row"><td colspan="9" class="total-label">TOTAL</td>{% if view_costs %}<td class="amount">{{ (nir.net_bani|default(0) / 100)|number_format(2, ',', '.') }} {{ money_label }}</td><td class="center">{% if vat_rates|length == 1 %}{{ _self.decimal(vat_rates|first) }}%{% elseif vat_rates|length > 1 %}Mixt{% endif %}</td><td class="amount">{{ (nir.tax_bani|default(0) / 100)|number_format(2, ',', '.') }} {{ money_label }}</td><td class="amount grand-total">{{ (nir.total_bani|default(0) / 100)|number_format(2, ',', '.') }} {{ money_label }}</td>{% else %}<td colspan="4" class="center protected">Valorile financiare sunt protejate</td>{% endif %}</tr>
</tbody></table>
<div class="notes"><div class="notes-heading">{{ _self.icon('clipboard', 'meta-icon') }}Constatări privind recepția / diferențe calitative sau cantitative:</div>
    {% if nir.notes|default('') %}<p>{{ nir.notes }}</p>{% endif %}
    {% for line in lines %}{% if line.difference_notes|default('') or line.difference_label|default('') or line.accepted_quantity|default(line.received_quantity) != line.received_quantity %}<div class="line-observation"><strong>Poziția {{ loop.index }}{% if line.sku|default('') %} · {{ line.sku }}{% endif %}:</strong>{% if line.accepted_quantity|default(line.received_quantity) != line.received_quantity %} acceptat {{ _self.decimal(line.accepted_quantity) }} {{ line.purchase_unit|default('buc') }}.{% endif %}{% if line.difference_label|default('') %} {{ line.difference_label }}.{% endif %}{% if line.difference_notes|default('') %} {{ line.difference_notes }}{% endif %}</div>{% endif %}{% endfor %}
</div>
<div class="stamp-area">{% if stamp %}<img class="stamp" src="{{ stamp }}" alt="Ștampila firmei">{% endif %}</div>
</body>
</html>
