{% extends 'emails/order-confirmation.twig' %}
{% block introduction %}<h1 class="greeting" style="margin:24px 0 10px;color:#2d333d;font-size:38px;line-height:46px;font-weight:600;letter-spacing:-1px;">Bună, {{ first_name }}!</h1><h2 class="intro-title" style="margin:0 0 14px;color:#414b59;font-size:25px;line-height:34px;font-weight:normal;">{{ message }}</h2><p style="margin:0;color:#697583;font-size:17px;line-height:28px;">{{ introduction }}</p><table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:25px;"><tr><td><!--[if mso]><v:roundrect href="{{ tracking_url }}" style="height:56px;v-text-anchor:middle;width:244px;" arcsize="50%" stroke="f" fillcolor="#b44968"><w:anchorlock xmlns:w="urn:schemas-microsoft-com:office:word"/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:17px;font-weight:bold;">Descarcă factura</center></v:roundrect><![endif]--><!--[if !mso]><!--><a href="{{ tracking_url }}" style="display:inline-block;min-width:198px;padding:17px 22px;background-color:#b44968;border:1px solid #b44968;border-radius:28px;color:#ffffff;font-size:17px;font-weight:bold;line-height:22px;text-align:center;text-decoration:none;">Descarcă factura</a><!--<![endif]--></td></tr></table><p style="margin:12px 0 0;color:#7c8792;font-size:14px;line-height:22px;">PDF-ul este și atașat acestui email. Păstrează linkul privat.</p>{% endblock %}
{% block products_heading %}Pe factura ta{% endblock %}
