{% extends 'emails/order-confirmation.twig' %}

{% block introduction %}
  <h1 class="greeting" style="margin:24px 0 10px;color:#2d333d;font-size:40px;line-height:48px;letter-spacing:-1px;font-weight:600;">Bună{% if first_name %}, {{ first_name }}{% endif %}!</h1>
  <h2 class="intro-title" style="margin:0 0 14px;color:#414b59;font-size:25px;line-height:34px;font-weight:normal;">Comanda ta este {{ status_label }}.</h2>
  {% if custom_message %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#fcf4f7" style="table-layout:fixed;margin-top:24px;background-color:#fcf4f7;border:1px solid #efdee6;border-radius:22px;"><tr><td style="padding:22px 24px;">
      <p style="margin:0 0 13px;color:#9b4e6b;font-size:14px;line-height:22px;font-weight:bold;letter-spacing:.5px;">Mesaj de la magazin</p>
      <div style="color:#4e4150;font-size:18px;line-height:29px;overflow-wrap:anywhere;word-wrap:break-word;">{{ custom_message|nl2br }}</div>
      <p style="margin:18px 0 0;padding-top:15px;border-top:1px solid #ecdce4;color:#92788a;font-size:14px;line-height:22px;">Cu drag, echipa La Măriuca</p>
    </td></tr></table>
  {% else %}
    <p style="margin:0;color:#697583;font-size:17px;line-height:28px;">Te ținem la curent cu fiecare pas. Poți vedea toate detaliile și parcursul comenzii tale folosind butonul de mai jos.</p>
  {% endif %}
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:26px;max-width:100%;"><tr><td>
    <!--[if mso]><v:roundrect href="{{ tracking_url }}" style="height:56px;v-text-anchor:middle;width:244px;" arcsize="50%" stroke="f" fillcolor="#b44968"><w:anchorlock xmlns:w="urn:schemas-microsoft-com:office:word"/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:17px;font-weight:bold;">Urmărește comanda</center></v:roundrect><![endif]-->
    <!--[if !mso]><!--><a href="{{ tracking_url }}" style="display:inline-block;padding:17px 22px;background-color:#b44968;border:1px solid #b44968;border-radius:28px;color:#ffffff;font-size:17px;font-weight:bold;line-height:22px;text-align:center;text-decoration:none;">Urmărește comanda</a><!--<![endif]-->
  </td></tr></table>
  <p style="margin:12px 0 0;color:#7c8792;font-size:14px;line-height:22px;">Toate detaliile, într-un singur loc. Fără autentificare.</p>
{% endblock %}

{% block order_contents %}{% endblock %}
{% block email_origin %}Mesaj trimis de echipa La Măriuca în legătură cu comanda{% endblock %}
