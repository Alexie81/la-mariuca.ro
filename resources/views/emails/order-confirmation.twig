<!doctype html>
<html lang="ro" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting"><meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light">
  <title>{{ subject }}</title>
  <!--[if mso]><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
  <style>
    body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0pt;mso-table-rspace:0pt}table{border-spacing:0}
    img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic}a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important}
    @media screen and (max-width:600px){
      .outer-pad{padding:18px 10px!important}.section-pad{padding:25px 22px!important}.brand-pad{padding:4px 10px 22px!important}
      .greeting{font-size:32px!important;line-height:40px!important}.intro-title{font-size:20px!important;line-height:29px!important}
      .brand-logo{width:164px!important;height:auto!important}.brand-note{font-size:11px!important;line-height:17px!important}
      .order-details{display:block!important;width:100%!important;box-sizing:border-box!important;text-align:left!important}.order-date{padding:7px 0 0!important;font-size:13px!important}
      .photo-cell{width:74px!important}.product-photo{width:74px!important;height:89px!important}.product-copy{padding-left:15px!important;padding-right:0!important}
      .product-name{font-size:16px!important;line-height:23px!important}.product-meta{font-size:13px!important;line-height:20px!important}
      .product-price{font-size:19px!important;line-height:26px!important}.product-pad{padding:16px!important}
      .stack{display:block!important;width:100%!important;box-sizing:border-box!important}.delivery-left{padding-right:0!important;padding-bottom:16px!important}.delivery-right{padding-left:0!important;border-left:0!important;padding-top:16px!important;border-top:1px solid #e9ebee!important}
      .total-number{font-size:28px!important;line-height:36px!important}.payment-title{font-size:16px!important}.payment-copy{padding-left:12px!important}.payment-state{font-size:12px!important;padding:8px 10px!important}
      .section-title{font-size:20px!important;line-height:28px!important}.footer-pad{padding:24px 22px!important}
      .email-footer{table-layout:fixed!important}.footer-pad,.footer-column{text-align:center!important}
      .footer-column{display:block!important;width:100%!important;box-sizing:border-box!important;padding:0!important;border:0!important}
      .footer-column-next{margin-top:19px!important;padding-top:19px!important;border-top:1px solid #e9edf0!important}
      .footer-resource{display:block!important;padding:6px 0!important}.footer-trust-pad{padding:20px 22px!important}
      .footer-contact-address{display:table!important;max-width:100%!important;box-sizing:border-box!important;margin:0 auto 8px!important;padding:10px 15px!important;border:1px solid #f1dfe6!important;border-radius:24px!important;background-color:#fcf3f6!important;font-weight:bold!important}
      .footer-information .footer-resource{display:inline-block!important;max-width:100%!important;box-sizing:border-box!important;padding:5px 6px!important;margin:3px 1px!important;background-color:#f5f7f9!important;border:1px solid #e7ebef!important;border-radius:17px!important;font-size:14px!important;line-height:22px!important}
      .footer-brand,.footer-care{margin-left:auto!important;margin-right:auto!important}
      .footer-trust-column{display:block!important;width:100%!important;box-sizing:border-box!important;text-align:center!important}
      .footer-care-copy{text-align:center!important;padding-right:0!important}.footer-anpc img{margin-left:auto!important;margin-right:auto!important}
      .footer-anpc{margin-top:18px!important;padding-top:18px!important;border-top:1px solid #dce8e1!important}
      .footer-legal{padding:16px 0 0!important}.footer-heading{font-size:22px!important;line-height:30px!important}
      .email-note-pad{padding:16px!important}.email-note-copy{font-size:14px!important;line-height:23px!important}
      .email-copyright{padding:23px 0 6px!important}.copyright-brand{font-size:15px!important;line-height:23px!important}
      .summary-heading{font-size:17px!important;line-height:24px!important}.total-card-pad{padding:17px!important}
      .total-label{display:block!important;width:100%!important;font-size:14px!important}.total-number{display:block!important;width:100%!important;padding:7px 0 0!important;text-align:left!important;font-size:32px!important;line-height:40px!important}
    }
    @media screen and (max-width:360px){
      .section-pad{padding:22px 16px!important}.brand-note{display:none!important}.product-pad{padding:12px 10px!important}
      .photo-cell{width:64px!important}.product-photo{width:64px!important;height:77px!important}.product-copy{padding-left:12px!important;padding-right:0!important}
      .product-price{font-size:18px!important}.product-name{font-size:15px!important}.product-meta{font-size:12px!important}
      .totals-pad{padding:17px!important}.total-number{font-size:24px!important}.summary-label,.summary-value{font-size:13px!important;white-space:nowrap!important}.total-label{font-size:14px!important;white-space:nowrap!important}
      .payment-icon{width:36px!important;height:36px!important}.payment-title{font-size:15px!important}.payment-state{font-size:11px!important;padding:7px 8px!important}
      .summary-heading{font-size:16px!important}.summary-icon-cell{display:none!important}.savings-pill{padding:7px 9px!important;font-size:12px!important}.total-card-pad{padding:14px!important}
      .footer-pad,.footer-trust-pad{padding:22px 18px!important}.care-seal{width:88px!important;height:88px!important}.care-seal-cell{width:100px!important}
    }
  </style>
  <!--[if mso]><style>body,table,td,p,a{font-family:Arial,Helvetica,sans-serif!important}.email-shell{width:100%!important}</style><![endif]-->
</head>
<body style="margin:0;padding:0;width:100%;background-color:#f2f4f7;color:#303740;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f2f4f7" style="background-color:#f2f4f7;"><tr><td class="outer-pad" align="center" style="padding:36px 16px;">
  <!--[if mso]><table role="presentation" align="center" width="760" style="width:100%;max-width:760px;" cellpadding="0" cellspacing="0"><tr><td><![endif]-->
  <table role="presentation" class="email-shell" width="100%" cellpadding="0" cellspacing="0" style="width:100%;max-width:760px;">
    <tr><td class="brand-pad" style="padding:0 12px 25px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td><a href="{{ shop_url }}" style="text-decoration:none;"><img class="brand-logo" src="{{ logo_url }}" width="190" height="64" alt="La Măriuca Boutique" style="display:block;width:190px;height:64px;font-size:20px;color:#ac4f65;"></a></td><td class="brand-note" align="right" style="color:#74808f;font-size:14px;line-height:22px;">{% block brand_note %}Cu grijă pentru<br><span style="color:#465463;">fiecare mică bucurie.</span>{% endblock %}</td></tr></table>
    </td></tr>
    <tr><td class="section-pad" bgcolor="#ffffff" style="padding:34px 36px;background-color:#ffffff;border:1px solid #e8ebef;border-radius:28px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td width="56" valign="middle" style="width:56px;"><img src="{{ status_icon }}" width="56" height="56" alt="" style="display:block;width:56px;height:56px;"></td><td valign="middle" style="padding-left:14px;color:{{ status_color }};font-size:16px;line-height:24px;font-weight:bold;">{{ badge }}</td></tr></table>
      {% block introduction %}
      <h1 class="greeting" style="margin:24px 0 10px;color:#2d333d;font-size:40px;line-height:48px;letter-spacing:-1px;font-weight:600;">Bună{% if first_name %}, {{ first_name }}{% endif %}!</h1>
      <h2 class="intro-title" style="margin:0 0 14px;color:#414b59;font-size:25px;line-height:34px;font-weight:normal;">{{ message }}</h2>
      <p style="margin:0;color:#697583;font-size:17px;line-height:28px;">{{ introduction }}</p>
      <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:25px;"><tr><td>
        <!--[if mso]><v:roundrect href="{{ tracking_url }}" style="height:56px;v-text-anchor:middle;width:244px;" arcsize="50%" stroke="f" fillcolor="#b44968"><w:anchorlock xmlns:w="urn:schemas-microsoft-com:office:word"/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:17px;font-weight:bold;">Urmărește comanda</center></v:roundrect><![endif]-->
        <!--[if !mso]><!--><a href="{{ tracking_url }}" style="display:inline-block;min-width:198px;padding:17px 22px;background-color:#b44968;border:1px solid #b44968;border-radius:28px;color:#ffffff;font-size:17px;font-weight:bold;line-height:22px;text-align:center;text-decoration:none;">Urmărește comanda</a><!--<![endif]-->
      </td></tr></table>
      <p style="margin:12px 0 0;color:#7c8792;font-size:14px;line-height:22px;">Acces direct la detalii, fără autentificare.</p>
      {% endblock %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f6f7f9" style="margin-top:26px;background-color:#f6f7f9;border-radius:16px;"><tr><td style="padding:15px 18px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td class="order-details" style="font-size:16px;line-height:25px;color:#45515e;"><strong>{{ number }}</strong></td><td class="order-details order-date" align="right" style="font-size:15px;line-height:25px;color:#7a8591;">{{ date }}</td></tr></table>
      </td></tr></table>
    </td></tr>
    <tr><td height="16" style="height:16px;font-size:0;line-height:16px;">&nbsp;</td></tr>
    <tr><td class="section-pad" bgcolor="#ffffff" style="padding:28px 30px;background-color:#ffffff;border:1px solid #e8ebef;border-radius:28px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td><h2 class="section-title" style="margin:0;font-size:24px;line-height:32px;letter-spacing:-0.4px;font-weight:600;color:#303740;">{% block products_heading %}Alegerile tale{% endblock %}</h2></td><td align="right" style="font-size:15px;line-height:25px;color:#7a8591;">{{ quantity }} {{ quantity == 1 ? 'bucată' : 'bucăți' }}</td></tr></table>
      {% for item in items %}
      {% set product_url = item.product_url %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f7f8fa" style="margin-top:15px;background-color:#f7f8fa;border-radius:18px;"><tr><td class="product-pad" style="padding:16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;"><tr>
          <td class="photo-cell" width="78" valign="middle" style="width:78px;">
            {% if item.image %}{% if product_url %}<a href="{{ product_url }}" target="_blank" rel="noopener noreferrer" aria-label="Deschide produsul {{ item.name }}" style="display:block;text-decoration:none;border:0;">{% endif %}<img class="product-photo" src="{{ item.image }}" width="78" height="94" alt="{{ item.name }}" style="display:block;width:78px;height:94px;border:0;border-radius:12px;color:#73808c;font-size:14px;line-height:22px;background-color:#f1ece6;">{% if product_url %}</a>{% endif %}{% else %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td height="94" align="center" bgcolor="#f0ece8" style="height:94px;background-color:#f0ece8;border-radius:12px;color:#887264;font-size:14px;line-height:22px;">La Măriuca</td></tr></table>{% endif %}
          </td>
          <td class="product-copy" valign="middle" style="padding:0 0 0 18px;word-wrap:break-word;overflow-wrap:anywhere;">
            <p class="product-name" style="margin:0 0 5px;color:#37414d;font-size:18px;line-height:26px;font-weight:bold;">{% if product_url %}<a href="{{ product_url }}" target="_blank" rel="noopener noreferrer" style="color:#37414d;text-decoration:none;">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}</p>
            {% if item.variant %}<p class="product-meta" style="margin:0 0 3px;color:#73808c;font-size:15px;line-height:23px;">{{ item.variant }}</p>{% endif %}
            <p class="product-meta" style="margin:6px 0 0;color:#83909b;font-size:14px;line-height:22px;">SKU: {{ item.sku }}</p>
          </td>
        </tr></table>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:15px;border-top:1px solid #e5e9ef;"><tr>
          <td valign="top" style="padding-top:12px;"><p style="margin:0;color:#5c6878;font-size:16px;line-height:27px;white-space:nowrap;"><strong>{{ item.quantity }}</strong> &nbsp;×&nbsp; {{ item.unit_price }}</p><p style="margin:2px 0 0;color:#7f8b97;font-size:14px;line-height:22px;">Cantitate × preț unitar</p></td>
          <td align="right" valign="top" style="padding:12px 0 0 8px;"><p class="product-price" style="margin:0;color:#374352;font-size:22px;line-height:27px;font-weight:normal;white-space:nowrap;">{{ item.total }}</p><p style="margin:2px 0 0;color:#7f8b97;font-size:14px;line-height:22px;">Total produs</p></td>
        </tr></table>
      </td></tr></table>
      {% endfor %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#fcf3f6" style="margin-top:22px;background-color:#fcf3f6;border:1px solid #f1e0e7;border-radius:24px;"><tr><td class="totals-pad" style="padding:22px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
          <td class="summary-icon-cell" width="48" style="width:48px;"><img src="{{ summary_icon }}" width="38" height="38" alt="" style="display:block;width:38px;height:38px;"></td>
          <td><p class="summary-heading" style="margin:0;color:#725565;font-size:20px;line-height:28px;font-weight:bold;">Rezumatul comenzii</p></td>
          {% if savings %}<td align="right" style="padding-left:10px;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td class="savings-pill" bgcolor="#e7f3ec" style="padding:8px 12px;background-color:#e7f3ec;border:1px solid #d5e9dc;border-radius:22px;color:#287c51;font-size:15px;line-height:23px;white-space:nowrap;">−{{ savings }}</td></tr></table></td>{% endif %}
        </tr></table>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:18px;">
          {% for row in totals %}<tr><td class="summary-label" style="padding:5px 0;color:{{ row.saving ? '#2e805a' : '#78808d' }};font-size:16px;line-height:25px;">{{ row.label }}</td><td class="summary-value" align="right" style="padding:5px 0 5px 10px;color:{{ row.saving ? '#2e805a' : '#505765' }};font-size:16px;line-height:25px;white-space:nowrap;">{{ row.value }}</td></tr>{% endfor %}
        </table>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="margin-top:19px;background-color:#ffffff;border:1px solid #efdee5;border-radius:18px;"><tr><td class="total-card-pad" style="padding:20px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
            <td class="total-label" style="color:#695361;font-size:17px;line-height:26px;">Total comandă</td>
            <td class="total-number" align="right" style="padding-left:10px;color:#703a50;font-size:36px;line-height:44px;letter-spacing:-0.8px;font-weight:500;white-space:nowrap;">{{ total }}</td>
          </tr></table>
          {% block summary_payment_status %}<table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:12px;"><tr><td style="padding:5px 10px;border-radius:20px;background-color:{{ paid ? '#edf7f0' : '#f6f3f9' }};color:{{ paid ? '#2e805a' : '#85708e' }};font-size:14px;line-height:22px;">{{ paid ? '✓ Achitat integral.' : 'De achitat la livrare' }}</td></tr></table>{% endblock %}
        </td></tr></table>
        {% block savings_notice %}{% if savings %}<table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin:14px auto 0;"><tr><td width="34" valign="middle" style="width:34px;padding-right:7px;"><img src="{{ savings_icon }}" width="28" height="28" alt="" style="display:block;width:28px;height:28px;"></td><td valign="middle" style="color:#7f727b;font-size:14px;line-height:23px;text-align:left;">{% block savings_copy %}Ai economisit <strong style="color:#3e7e5d;white-space:nowrap;">{{ savings }}</strong> la această comandă.{% endblock %}</td></tr></table>{% endif %}{% endblock %}
      </td></tr></table>
    </td></tr>
    <tr><td height="16" style="height:16px;font-size:0;line-height:16px;">&nbsp;</td></tr>
    {% block delivery_and_payment %}
    {% include 'emails/partials/order-delivery.twig' %}
    {% include 'emails/partials/order-payment.twig' %}
    {% endblock %}
    {% block customer_footer %}
    <tr><td height="20" style="height:20px;font-size:0;line-height:20px;">&nbsp;</td></tr>
    <tr><td>
      <table role="presentation" class="email-footer" width="100%" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #e3e8ec;border-radius:26px;">
        <tr><td class="footer-pad" style="padding:28px 30px;">
          <h2 class="footer-heading" style="margin:0;color:#35414d;font-size:25px;line-height:34px;font-weight:600;letter-spacing:-0.4px;">Cu tine, și după comandă.</h2>
          <p style="margin:7px 0 0;color:#6b7885;font-size:15px;line-height:25px;">O întrebare sau un detaliu de corectat? Suntem aici să te ajutăm.</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:25px;table-layout:fixed;"><tr>
            <td class="footer-column" width="35%" valign="top" style="width:35%;padding-right:20px;">
              <p style="margin:0 0 11px;color:#394653;font-size:16px;line-height:24px;font-weight:bold;">Echipa La Măriuca</p>
              <a class="footer-resource footer-contact-address" href="mailto:{{ contact_email }}" style="display:block;padding:4px 0;color:#a74765;font-size:15px;line-height:24px;text-decoration:none;overflow-wrap:anywhere;word-wrap:break-word;">{{ contact_email }}</a>
              <a class="footer-resource" href="{{ contact_url }}" style="display:block;padding:4px 0;color:#5b6977;font-size:15px;line-height:24px;text-decoration:none;">Contact și asistență</a>
              <a class="footer-resource" href="{{ shop_url }}" style="display:block;padding:4px 0;color:#a74765;font-size:15px;line-height:24px;text-decoration:none;font-weight:bold;">la-mariuca.ro</a>
            </td>
            <td class="footer-column footer-column-next footer-information" width="31%" valign="top" style="width:31%;padding:0 19px;border-left:1px solid #e9edf0;">
              <p style="margin:0 0 11px;color:#394653;font-size:16px;line-height:24px;font-weight:bold;">Informații utile</p>
              <a class="footer-resource" href="{{ delivery_url }}" style="display:block;padding:4px 0;color:#5b6977;font-size:15px;line-height:24px;text-decoration:none;">Livrare și retur</a>
              <a class="footer-resource" href="{{ terms_url }}" style="display:block;padding:4px 0;color:#5b6977;font-size:15px;line-height:24px;text-decoration:none;">Termeni și condiții</a>
              <a class="footer-resource" href="{{ privacy_url }}" style="display:block;padding:4px 0;color:#5b6977;font-size:15px;line-height:24px;text-decoration:none;">Confidențialitate</a>
            </td>
            <td class="footer-column footer-column-next" width="34%" valign="top" style="width:34%;padding-left:20px;border-left:1px solid #e9edf0;">
              <p style="margin:0 0 11px;color:#394653;font-size:16px;line-height:24px;font-weight:bold;">Partener tehnic</p>
              <table class="footer-brand" role="presentation" cellpadding="0" cellspacing="0"><tr>
                <td width="43" style="width:43px;"><a href="https://cab-it.ro/" target="_blank" rel="noopener" style="display:block;text-decoration:none;"><img src="{{ cab_logo_url }}" width="34" height="34" alt="CAB IT" style="display:block;width:34px;height:34px;border-radius:50%;color:#277b69;font-size:12px;"></a></td>
                <td valign="middle"><a href="https://cab-it.ro/" target="_blank" rel="noopener" style="color:#32383b;font-size:17px;line-height:25px;font-weight:bold;text-decoration:none;white-space:nowrap;">cab-it.ro</a></td>
              </tr></table>
              <p style="margin:9px 0 0;color:#6b7885;font-size:14px;line-height:23px;">Magazin dezvoltat, susținut și întreținut de CAB IT.</p>
            </td>
          </tr></table>
        </td></tr>
        <tr><td class="footer-trust-pad" bgcolor="#f2f7f4" style="padding:21px 30px;background-color:#f2f7f4;border-top:1px solid #e2ebe6;border-radius:0 0 26px 26px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
            <td class="footer-trust-column" width="60%" valign="middle" style="width:60%;">
              <table class="footer-care" role="presentation" cellpadding="0" cellspacing="0"><tr>
                <td class="care-seal-cell" width="122" style="width:122px;"><img class="care-seal" src="{{ care_badge_url }}" width="108" height="108" alt="Grijă pentru clienți" style="display:block;width:108px;height:108px;color:#386b53;font-size:14px;"></td>
                <td class="footer-care-copy" style="padding-right:14px;"><p style="margin:0;color:#38654f;font-size:16px;line-height:24px;font-weight:bold;">La fiecare pas,<br>aproape de tine.</p><p style="margin:6px 0 0;color:#657a6e;font-size:14px;line-height:23px;">Suport direct.<br>Informații clare.</p></td>
              </tr></table>
            </td>
            <td class="footer-trust-column footer-anpc" width="40%" align="right" valign="middle" style="width:40%;">
              <p style="margin:0 0 9px;color:#62736a;font-size:14px;line-height:22px;">Protecția consumatorilor</p>
              <a href="https://anpc.ro/sal/" target="_blank" rel="noopener" style="display:inline-block;color:#254899;font-size:14px;line-height:22px;text-decoration:none;"><img src="{{ anpc_logo_url }}" width="202" height="50" alt="ANPC — Soluționarea Alternativă a Litigiilor" style="display:block;width:202px;height:50px;max-width:100%;font-size:13px;color:#254899;"></a>
            </td>
          </tr></table>
        </td></tr>
      </table>
    </td></tr>
    <tr><td class="footer-legal" style="padding:18px 0 0;">
      <table role="presentation" class="email-notes" width="100%" cellpadding="0" cellspacing="0" bgcolor="#edf1f5" style="table-layout:fixed;background-color:#edf1f5;border:1px solid #dfe6ed;border-radius:18px;">
        <tr><td class="email-note-pad" style="padding:20px 24px;text-align:left;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
            <td width="32" valign="middle" style="width:32px;"><table role="presentation" width="22" cellpadding="0" cellspacing="0"><tr><td align="center" height="22" style="height:22px;border:1px solid #bccbd8;border-radius:50%;color:#627b91;font-size:14px;line-height:22px;font-weight:bold;">i</td></tr></table></td>
            <td style="color:#4d6377;font-size:15px;line-height:24px;font-weight:bold;">Despre acest email</td>
          </tr></table>
          <p class="email-note-copy" style="margin:10px 0 0;color:#687b8d;font-size:15px;line-height:25px;">Mesaj generat automat pentru comanda <strong style="font-weight:normal;color:#435e76;">{{ number }}</strong> și trimis la:</p>
          <p class="email-note-copy" style="margin:4px 0 0;color:#435e76;font-size:15px;line-height:25px;overflow-wrap:anywhere;word-wrap:break-word;word-break:normal;">{{ email }}</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:15px;border-top:1px solid #dce4ec;"><tr><td style="padding-top:15px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
              <td width="32" valign="middle" style="width:32px;"><table role="presentation" width="22" cellpadding="0" cellspacing="0"><tr><td align="center" height="22" style="height:22px;border:1px solid #bccbd8;border-radius:7px;color:#627b91;font-size:16px;line-height:22px;">↗</td></tr></table></td>
              <td style="color:#4d6377;font-size:15px;line-height:24px;font-weight:bold;">Un link doar pentru tine</td>
            </tr></table>
            <p class="email-note-copy" style="margin:9px 0 0;color:#687b8d;font-size:15px;line-height:25px;">Linkul de urmărire oferă acces la comanda ta. Păstrează-l privat.</p>
          </td></tr></table>
        </td></tr>
      </table>
    </td></tr>
    {% endblock %}
    <tr><td class="email-copyright" align="center" style="padding:26px 12px 6px;">
      <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin:0 auto;"><tr>
        <td width="36" valign="middle" style="width:36px;"><img src="{{ heart_icon_url }}" width="26" height="21" alt="" style="display:block;width:26px;height:21px;"></td>
        <td valign="middle" style="padding-right:12px;color:#7b8390;font-size:14px;line-height:24px;white-space:nowrap;">&copy; {{ year }}</td>
        <td valign="middle" style="padding-left:12px;border-left:1px solid #d7dce4;"><a class="copyright-brand" href="{{ shop_url }}" style="color:#85576b;font-size:17px;line-height:25px;font-weight:bold;text-decoration:none;">La Măriuca Boutique</a></td>
      </tr></table>
      <p style="margin:9px 0 0;color:#87909c;font-size:13px;line-height:21px;">Toate drepturile rezervate.</p>
    </td></tr>
  </table>
